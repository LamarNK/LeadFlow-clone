<Application x:Class="LeadFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LeadFlow.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Theme.xaml" />
                <ResourceDictionary Source="/Resources/Styles.xaml" />
                <ResourceDictionary Source="/Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:ResponseStatusToDisplayConverter x:Key="ResponseStatusToDisplayConverter" />
            <converters:AgeToDisplayConverter x:Key="AgeToDisplayConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:LogLevelToBackgroundConverter x:Key="LogLevelToBackgroundConverter" />
            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
            <converters:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTimeConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
