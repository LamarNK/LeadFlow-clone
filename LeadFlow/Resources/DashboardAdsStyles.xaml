<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Локальная палитра блока «Объявления» (dashboard / CRM-стиль) -->
    <Color x:Key="DashBgColor">#F6F8FB</Color>
    <Color x:Key="DashTextPrimaryColor">#1F2937</Color>
    <Color x:Key="DashTextSecondaryColor">#6B7280</Color>
    <Color x:Key="DashBorderColor">#E5E7EB</Color>
    <Color x:Key="DashCardColor">#FFFFFF</Color>
    <Color x:Key="DashAccentGreenColor">#16A34A</Color>
    <Color x:Key="DashAccentRedColor">#DC2626</Color>
    <Color x:Key="DashAccentOrangeColor">#EA580C</Color>
    <Color x:Key="DashAccentBlueColor">#3B82F6</Color>
    <Color x:Key="DashAccentPurpleColor">#7C3AED</Color>
    <Color x:Key="DashBlockedBgColor">#FEF2F2</Color>

    <SolidColorBrush x:Key="DashBgBrush" Color="{StaticResource DashBgColor}" />
    <SolidColorBrush x:Key="DashTextPrimaryBrush" Color="{StaticResource DashTextPrimaryColor}" />
    <SolidColorBrush x:Key="DashTextSecondaryBrush" Color="{StaticResource DashTextSecondaryColor}" />
    <SolidColorBrush x:Key="DashBorderBrush" Color="{StaticResource DashBorderColor}" />
    <SolidColorBrush x:Key="DashCardBrush" Color="{StaticResource DashCardColor}" />
    <SolidColorBrush x:Key="DashAccentGreenBrush" Color="{StaticResource DashAccentGreenColor}" />
    <SolidColorBrush x:Key="DashAccentRedBrush" Color="{StaticResource DashAccentRedColor}" />
    <SolidColorBrush x:Key="DashAccentOrangeBrush" Color="{StaticResource DashAccentOrangeColor}" />
    <SolidColorBrush x:Key="DashAccentBlueBrush" Color="{StaticResource DashAccentBlueColor}" />
    <SolidColorBrush x:Key="DashAccentPurpleBrush" Color="{StaticResource DashAccentPurpleColor}" />
    <SolidColorBrush x:Key="DashBlockedBgBrush" Color="{StaticResource DashBlockedBgColor}" />

    <Style x:Key="DashboardFilterTabsListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource DashBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DashCardBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
