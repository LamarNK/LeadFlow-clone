<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:converters="clr-namespace:LeadFlow.Converters">
    <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="SecondaryTextColor">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F97316</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <!-- Текстовые ссылки и вторичные акценты (не заливка кнопок) -->
    <SolidColorBrush x:Key="LinkTextBrush" Color="{StaticResource PrimaryColor}" />

    <!-- Минималистичный скроллбар (см. ScrollBarStyles.xaml) -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#64748B" Opacity="0.35" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#64748B" Opacity="0.55" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#2563EB" Opacity="0.45" />

    <Thickness x:Key="PagePadding">8</Thickness>
    <Thickness x:Key="SectionSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="CardInnerGap">0,6,0,0</Thickness>
    <Thickness x:Key="TightSpacing">0,4,0,0</Thickness>

    <!-- Единая высота полей фильтра (дата, поиск, список, сброс) -->
    <sys:Double x:Key="FilterControlMinHeight">38</sys:Double>

    <sys:String x:Key="DatePickerFilterPlaceholder">Выбор даты</sys:String>

    <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
</ResourceDictionary>
