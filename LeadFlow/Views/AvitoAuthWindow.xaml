<Window x:Class="LeadFlow.Views.AvitoAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:LeadFlow.Behaviors"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Авторизация Авито"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding AccountName}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding CurrentUrl}" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding AuthorizationStatus}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Войдите в аккаунт Авито вручную. После успешного входа профиль будет сохранён." Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,16">
            <wv2:WebView2 behaviors:WebView2Behavior.Session="{Binding Session}" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Проверить авторизацию" Command="{Binding CheckAuthorizationCommand}" />
            <Button Content="Закрыть" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
