<UserControl x:Class="LeadFlow.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CompactCardBorderStyle}" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Логи"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Системные записи приложения (аудит и диагностика)."
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="{StaticResource TightSpacing}" />

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,12,0">
                    <StackPanel Margin="0,0,14,0" MinWidth="44">
                        <TextBlock Text="Записей" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding LogEntriesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                    <Border Width="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,4,14,4"
                            VerticalAlignment="Stretch"
                            Opacity="0.85" />
                    <StackPanel MinWidth="44">
                        <TextBlock Text="Целостность" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding TamperedLogEntriesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Padding="14,8"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="{StaticResource CardInnerGap}"
              TextElement.FontFamily="Segoe UI"
              TextElement.FontWeight="Normal"
              TextElement.FontSize="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,10,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Системные логи" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PageFiltersToolbarBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Дата" Style="{StaticResource FilterToolbarLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="Поиск" Style="{StaticResource FilterToolbarLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="Уровень" Style="{StaticResource FilterToolbarLabelStyle}" />

                            <DatePicker Grid.Row="1"
                                        SelectedDate="{Binding SelectedLogDate}"
                                        Style="{StaticResource ToolbarDatePickerStyle}"
                                        Margin="0,6,12,0"
                                        VerticalAlignment="Stretch" />

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,6,12,0"
                                  MinHeight="{StaticResource FilterControlMinHeight}"
                                  VerticalAlignment="Stretch">
                                <TextBox x:Name="JournalLogsFilterSearchTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="Сообщение, источник, TraceId…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=JournalLogsFilterSearchTextBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=JournalLogsFilterSearchTextBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      ItemsSource="{Binding LogLevelFilters}"
                                      SelectedItem="{Binding SelectedLogLevelFilter}"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Margin="0,6,12,0"
                                      VerticalAlignment="Stretch" />

                            <Button Grid.Row="1"
                                    Grid.Column="3"
                                    Content="Сбросить"
                                    Command="{Binding ClearLogFiltersCommand}"
                                    Style="{StaticResource FilterToolbarResetButtonStyle}"
                                    MinWidth="104"
                                    Padding="12,6"
                                    Margin="0,6,0,0"
                                    VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" MinHeight="160">
                        <ListBox ItemsSource="{Binding LogEntriesView}"
                                 SelectedItem="{Binding SelectedLogEntry}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Padding="10,8"
                                                        CornerRadius="12"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F8FBFF" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#E8F0FF" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                CornerRadius="8"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{Binding Level, Converter={StaticResource LogLevelToBackgroundConverter}}">
                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       TextAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Prefix}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding TraceId}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Padding="16"
                                CornerRadius="12"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding ShowJournalLogsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding JournalLogsEmptyHint}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Детали лога" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource DetailSectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Источник" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedLogEntry.Prefix, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="TraceId" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedLogEntry.TraceId, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сообщение" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedLogEntry.Message, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ToolbarSurfaceBorderStyle}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Дополнительные свойства" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedLogDetails}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                        <Button Content="Копировать строку"
                                Command="{Binding CopySelectedLogRowCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Margin="0,0,8,8" />
                        <Button Content="Копировать сообщение"
                                Command="{Binding CopySelectedLogMessageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Margin="8,0,0,8" />
                        <Button Content="Копировать детали"
                                Command="{Binding CopySelectedLogDetailsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,7"
                                Margin="0,0,8,0" />
                        <Border Background="Transparent" Margin="8,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
