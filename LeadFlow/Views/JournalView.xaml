<UserControl x:Class="LeadFlow.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CompactCardBorderStyle}" Padding="24,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Журнал и логи" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="История обработанных откликов и системных записей." Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Padding="16,9"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,10,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Отклики" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding JournalItemsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,10,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Отправлены" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding SentJournalItemsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,10,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Ошибки" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding ErrorJournalItemsCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CompactCardBorderStyle}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Логи" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding LogEntriesCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2"
                    Style="{StaticResource SectionTabControlStyle}"
                    ItemContainerStyle="{StaticResource SectionTabItemStyle}">
            <TabItem Header="Журнал">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Последние обработанные отклики" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                <Button Content="Экспорт CSV" Command="{Binding ExportCommand}" DockPanel.Dock="Right" />
                            </DockPanel>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Padding="14,12" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PhoneRaw}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                       FontWeight="SemiBold" />

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BitrixEntityId}" Style="{StaticResource SubtleTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource SubtleTextStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat=dd.MM HH:mm}" Style="{StaticResource SubtleTextStyle}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="2" Text="{Binding ExportPath}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Запись журнала" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedItem.FullName, TargetNullValue=Запись не выбрана}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
                            <TextBlock Text="{Binding SelectedJournalStatusText}" Foreground="{Binding SelectedItem.Status, Converter={StaticResource StatusToBrushConverter}}" FontWeight="SemiBold" Margin="0,6,0,0" />

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Телефон" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedItem.PhoneRaw, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="Bitrix ID" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedItem.BitrixEntityId, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Создан" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedItem.CreatedAt, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Ошибка / комментарий" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedJournalErrorText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Логи">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.85*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,14,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Системные логи" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceBorderStyle}" Margin="0,14,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Дата" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="Поиск" Style="{StaticResource InfoLabelStyle}" />
                                    <TextBlock Grid.Column="2" Text="Уровень" Style="{StaticResource InfoLabelStyle}" />

                                    <Border Grid.Row="1"
                                            Margin="0,6,12,0"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,0">
                                        <DatePicker SelectedDate="{Binding SelectedLogDate}"
                                                    Height="38"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Margin="0,6,12,0"
                                             MinHeight="38"
                                             VerticalAlignment="Center" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="2"
                                              ItemsSource="{Binding LogLevelFilters}"
                                              SelectedItem="{Binding SelectedLogLevelFilter}"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="0,6,12,0"
                                              MinHeight="38"
                                              VerticalAlignment="Center" />

                                    <Button Grid.Row="1"
                                            Grid.Column="3"
                                            Content="Сбросить"
                                            Command="{Binding ClearLogDateFilterCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            MinWidth="104"
                                            Height="38"
                                            Padding="16,8"
                                            Margin="0,6,0,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding LogEntriesView}"
                                      SelectedItem="{Binding SelectedLogEntry}"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      AutoGenerateColumns="False"
                                      Background="Transparent"
                                      GridLinesVisibility="Horizontal"
                                      RowBackground="#FFFFFF"
                                      AlternatingRowBackground="#F8FAFC"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      RowHeaderWidth="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Padding" Value="12,10" />
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FBFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E8F0FF" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=dd.MM.yyyy HH:mm:ss}" Width="165" />
                                    <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="100" />
                                    <DataGridTextColumn Header="Источник" Binding="{Binding Prefix}" Width="190" />
                                    <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" />
                                    <DataGridTextColumn Header="TraceId" Binding="{Binding TraceId}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Детали лога" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource DetailSectionBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Источник" Style="{StaticResource InfoLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedLogEntry.Prefix, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TraceId" Style="{StaticResource InfoLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedLogEntry.TraceId, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Сообщение" Style="{StaticResource InfoLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedLogEntry.Message, TargetNullValue=Нет данных}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource ToolbarSurfaceBorderStyle}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Дополнительные свойства" Style="{StaticResource InfoLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedLogDetails}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0">
                                <Button Content="Копировать строку"
                                        Command="{Binding CopySelectedLogRowCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,7"
                                        Margin="0,0,8,8" />
                                <Button Content="Копировать сообщение"
                                        Command="{Binding CopySelectedLogMessageCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,7"
                                        Margin="8,0,0,8" />
                                <Button Content="Копировать детали"
                                        Command="{Binding CopySelectedLogDetailsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,7"
                                        Margin="0,0,8,0" />
                                <Border Background="Transparent" Margin="8,0,0,0" />
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
