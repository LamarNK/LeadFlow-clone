<Window x:Class="LeadFlow.Views.AdsPowerProfilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LeadFlow.Converters"
        Title="Профиль AdsPower"
        Width="560"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="LocalInverseBooleanConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Local API AdsPower"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Margin="0,0,0,8" />
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Если в AdsPower включена проверка API Key" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить список"
                    Padding="12,6"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource LocalInverseBooleanConverter}}" />
        </StackPanel>
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Foreground="#64748B" FontSize="12">
                            <Run Text="user_id: " />
                            <Run Text="{Binding UserId}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding GroupName}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Foreground="#475569" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
            <Button Content="Добавить"
                    Padding="12,6"
                    IsDefault="True"
                    Click="Ok_OnClick" />
        </StackPanel>
    </Grid>
</Window>
