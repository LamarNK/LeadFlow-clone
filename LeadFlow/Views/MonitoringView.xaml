<UserControl x:Class="LeadFlow.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CompactCardBorderStyle}" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Мониторинг"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Текущие отклики и их состояние в обработке."
                           Style="{StaticResource SubtleTextStyle}"
                           Margin="{StaticResource TightSpacing}" />

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,12,0">
                    <StackPanel Margin="0,0,14,0" MinWidth="44">
                        <TextBlock Text="Всего" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding TotalResponsesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                    <Border Width="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,4,14,4"
                            VerticalAlignment="Stretch"
                            Opacity="0.85" />
                    <StackPanel Margin="0,0,14,0" MinWidth="44">
                        <TextBlock Text="Новые" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding NewResponsesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                    <Border Width="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,4,14,4"
                            VerticalAlignment="Stretch"
                            Opacity="0.85" />
                    <StackPanel Margin="0,0,14,0" MinWidth="44">
                        <TextBlock Text="Отправлены" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding SentResponsesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                    <Border Width="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,4,14,4"
                            VerticalAlignment="Stretch"
                            Opacity="0.85" />
                    <StackPanel MinWidth="44">
                        <TextBlock Text="Ошибки" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding ErrorResponsesCount}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Margin="{StaticResource TightSpacing}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="0"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Padding="14,8"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PageFiltersToolbarBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Дата" Style="{StaticResource FilterToolbarLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="Поиск" Style="{StaticResource FilterToolbarLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="Статус" Style="{StaticResource FilterToolbarLabelStyle}" />

                            <DatePicker Grid.Row="1"
                                        SelectedDate="{Binding SelectedResponseDate}"
                                        Style="{StaticResource ToolbarDatePickerStyle}"
                                        Margin="0,6,12,0"
                                        VerticalAlignment="Stretch" />

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,6,12,0"
                                  MinHeight="{StaticResource FilterControlMinHeight}"
                                  VerticalAlignment="Stretch">
                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="Имя, телефон, вакансия, город, аккаунт">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Margin="0,6,12,0"
                                      VerticalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedStatusFilter}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Все" Content="Все" IsSelected="True" />
                                <ComboBoxItem Tag="Все, кроме дублей" Content="Все, кроме дублей" />
                                <ComboBoxItem Tag="New" Content="Новый" />
                                <ComboBoxItem Tag="InProgress" Content="В обработке" />
                                <ComboBoxItem Tag="Sent" Content="В CRM" />
                                <ComboBoxItem Tag="Duplicate" Content="Дубль" />
                                <ComboBoxItem Tag="Error" Content="Ошибка" />
                                <ComboBoxItem Tag="ActionRequired" Content="Нужны действия" />
                            </ComboBox>

                            <Button Grid.Row="1"
                                    Grid.Column="3"
                                    Content="Сбросить"
                                    Command="{Binding ClearMonitoringFiltersCommand}"
                                    Style="{StaticResource FilterToolbarResetButtonStyle}"
                                    MinWidth="104"
                                    Padding="12,6"
                                    Margin="0,6,0,0"
                                    VerticalAlignment="Stretch" />

                            <Expander Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="4"
                                      Margin="0,10,0,0"
                                      Padding="0,2,0,0"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <Expander.Header>
                                    <TextBlock Style="{StaticResource FilterToolbarLabelStyle}"
                                               Foreground="{StaticResource LinkTextBrush}">
                                        <Run Text="Ещё фильтры" />
                                        <Run Text="{Binding ExtraFiltersHeaderSuffix, Mode=OneWay}" />
                                    </TextBlock>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Вакансия" Style="{StaticResource FilterToolbarLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="Город" Style="{StaticResource FilterToolbarLabelStyle}" />
                                    <TextBlock Grid.Column="2" Text="Аккаунт" Style="{StaticResource FilterToolbarLabelStyle}" />
                                    <TextBlock Grid.Column="3"
                                               Grid.ColumnSpan="2"
                                               Text="Возраст (от — до)"
                                               Style="{StaticResource FilterToolbarLabelStyle}" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="0"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="0,6,8,0"
                                              ItemsSource="{Binding VacancyFilterOptions}"
                                              SelectedItem="{Binding SelectedVacancyFilter}"
                                              MaxDropDownHeight="220" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="0,6,8,0"
                                              ItemsSource="{Binding CityFilterOptions}"
                                              SelectedItem="{Binding SelectedCityFilter}"
                                              MaxDropDownHeight="220" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="2"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="0,6,8,0"
                                              ItemsSource="{Binding AccountFilterOptions}"
                                              SelectedItem="{Binding SelectedAccountFilter}"
                                              MaxDropDownHeight="220" />

                                    <Grid Grid.Row="1"
                                          Grid.Column="3"
                                          Grid.ColumnSpan="2"
                                          Margin="0,6,0,0"
                                          VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AgeFilterMinText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="{StaticResource FilterControlMinHeight}"
                                                 Margin="0,0,6,0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="От" />
                                        <TextBlock Grid.Column="1"
                                                   Text="—"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Style="{StaticResource FilterToolbarLabelStyle}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AgeFilterMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="{StaticResource FilterControlMinHeight}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="До" />
                                    </Grid>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" MinHeight="200">
                    <ListBox ItemsSource="{Binding ResponsesView}"
                             SelectedItem="{Binding SelectedResponse}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Padding="10,8"
                                                    CornerRadius="12"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Tag = VM списка: из шаблона FindAncestor(ListBox) возможен; ElementName корня UserControl из DataTemplate — нет. -->
                                <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}">
                                    <Grid.ContextMenu>
                                        <!-- PlacementTarget = этот Grid: Tag — команды, DataContext — отклик строки. -->
                                        <ContextMenu>
                                            <MenuItem Header="Копировать телефон"
                                                      Command="{Binding PlacementTarget.Tag.CopyResponsePhoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Открыть чат в Avito"
                                                      Command="{Binding PlacementTarget.Tag.OpenResponseChatInAvitoBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Открыть вакансию в Avito"
                                                      Command="{Binding PlacementTarget.Tag.OpenResponseVacancyInAvitoBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Открыть в Bitrix"
                                                      Command="{Binding PlacementTarget.Tag.OpenResponseInBitrixCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Отправить в Bitrix24…"
                                                      Command="{Binding PlacementTarget.Tag.SendToBitrixManuallyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Копировать ссылку на чат"
                                                      Command="{Binding PlacementTarget.Tag.CopyResponseMessengerUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Копировать ссылку на объявление"
                                                      Command="{Binding PlacementTarget.Tag.CopyResponseVacancyUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Копировать текст карточки"
                                                      Command="{Binding PlacementTarget.Tag.CopyResponseCardSummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Удалить отклик…"
                                                      Command="{Binding PlacementTarget.Tag.DeleteSelectedResponseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource ListRowTitleTextStyle}" />
                                        <TextBlock Text="{Binding Vacancy, TargetNullValue=—}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status, Converter={StaticResource ResponseStatusToDisplayConverter}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                               FontWeight="SemiBold" />

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PhoneRaw}" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding City}" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Age, Converter={StaticResource AgeToDisplayConverter}}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=dd.MM HH:mm}" Style="{StaticResource SubtleTextStyle}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Padding="16"
                            CornerRadius="12"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Visibility="{Binding ShowMonitoringResponsesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding MonitoringResponsesEmptyHint}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Детали отклика" Style="{StaticResource PageTitleTextStyle}" />

                    <Grid Grid.Row="1" Margin="{StaticResource SectionSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedResponse.FullName, TargetNullValue=Отклик не выбран}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Вакансия" Style="{StaticResource InfoLabelStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding SelectedResponse.Vacancy, TargetNullValue=Не указано}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedResponseStatusText}"
                                   Foreground="{Binding SelectedResponse.Status, Converter={StaticResource StatusToBrushConverter}}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Телефон" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.PhoneRaw, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Город" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.City, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Возраст" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.Age, Converter={StaticResource AgeToDisplayConverter}}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Создан" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.CreatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Обработан" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponseProcessedText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="Действия" Style="{StaticResource InfoLabelStyle}" />

                        <TextBlock Text="В Avito"
                                   Style="{StaticResource SubtleTextStyle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,2" />
                        <WrapPanel>
                            <Button Content="Чат"
                                    ToolTip="Открыть чат"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding OpenResponseChatInAvitoBrowserCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                            <Button Content="Объявление"
                                    ToolTip="Открыть объявление"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding OpenResponseVacancyInAvitoBrowserCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                        </WrapPanel>

                        <TextBlock Text="Bitrix24"
                                   Style="{StaticResource SubtleTextStyle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,2" />
                        <WrapPanel>
                            <Button Content="Отправить в Bitrix24"
                                    ToolTip="Повторить проверку дублей и создать сделку (для отложенных или ошибок)"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding SendToBitrixManuallyCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                            <Button Content="Открыть сделку"
                                    ToolTip="Открыть сделку в портале Bitrix24"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding OpenResponseInBitrixCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                        </WrapPanel>

                        <TextBlock Text="Копировать"
                                   Style="{StaticResource SubtleTextStyle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,2" />
                        <WrapPanel>
                            <Button Content="Телефон"
                                    ToolTip="Скопировать номер в буфер"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding CopyResponsePhoneCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                            <Button Content="Ссылка на чат"
                                    ToolTip="Скопировать URL чата в буфер"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding CopyResponseMessengerUrlCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                            <Button Content="Ссылка на объявление"
                                    ToolTip="Скопировать URL объявления в буфер"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding CopyResponseVacancyUrlCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                            <Button Content="Текст карточки"
                                    ToolTip="Скопировать все поля одним текстом"
                                    Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding CopyResponseCardSummaryCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                        </WrapPanel>

                        <TextBlock Text="Удаление"
                                   Style="{StaticResource SubtleTextStyle}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,2" />
                        <WrapPanel>
                            <Button Content="Удалить из журнала"
                                    ToolTip="С подтверждением"
                                    Style="{StaticResource MonitoringCompactDangerButtonStyle}"
                                    Margin="0,0,6,4"
                                    Command="{Binding DeleteSelectedResponseCommand}"
                                    CommandParameter="{Binding SelectedResponse}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <TextBlock Text="Ошибка / комментарий" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding SelectedResponseErrorText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
