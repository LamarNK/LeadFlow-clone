<UserControl x:Class="LeadFlow.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Мониторинг" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Текущие отклики и их состояние в обработке." Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Всего" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding TotalResponsesCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Новые" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding NewResponsesCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Отправлены" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding SentResponsesCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Ошибки" Style="{StaticResource InfoLabelStyle}" />
                    <TextBlock Text="{Binding ErrorResponsesCount}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="0,0,0,18"
                            Padding="12"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            HorizontalAlignment="Left">
                        <WrapPanel VerticalAlignment="Center" ItemHeight="42">
                            <Grid Width="280">
                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Поиск по имени, вакансии или телефону">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Width="170"
                                      Margin="12,0,0,0"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      SelectedValue="{Binding SelectedStatusFilter}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Все" IsSelected="True" />
                                <ComboBoxItem Content="New" />
                                <ComboBoxItem Content="InProgress" />
                                <ComboBoxItem Content="Sent" />
                                <ComboBoxItem Content="Duplicate" />
                                <ComboBoxItem Content="Error" />
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ResponsesView}"
                             SelectedItem="{Binding SelectedResponse}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Padding="14,12"
                                                    CornerRadius="14"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Vacancy}" Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                               FontWeight="SemiBold" />

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PhoneRaw}" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding City}" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat=dd.MM HH:mm}" Style="{StaticResource SubtleTextStyle}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Детали отклика" FontSize="22" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedResponse.FullName, TargetNullValue=Отклик не выбран}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedResponse.Vacancy}" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedResponseStatusText}"
                                   Foreground="{Binding SelectedResponse.Status, Converter={StaticResource StatusToBrushConverter}}"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Телефон" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.PhoneRaw, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Город" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.City, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Создан" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponse.CreatedAt, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=Нет данных}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Обработан" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedResponseProcessedText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <TextBlock Text="Ошибка / комментарий" Style="{StaticResource InfoLabelStyle}" />
                        <TextBlock Text="{Binding SelectedResponseErrorText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
