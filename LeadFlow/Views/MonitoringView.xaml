<UserControl x:Class="LeadFlow.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:models="clr-namespace:LeadFlow.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="MonitoringFilterControlHeight">32</sys:Double>

            <!-- Кнопки панели деталей: компактно, без лишнего синего -->
            <Style x:Key="MonitoringDetailOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimalSegmentedOutlineButtonStyle}">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="30" />
            </Style>

            <Style x:Key="MonitoringDetailPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="30" />
            </Style>

            <Style x:Key="MonitoringDetailSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="30" />
            </Style>

            <Style x:Key="MonitoringDetailGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>

            <Style x:Key="MonitoringDetailDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource MonitoringCompactDangerButtonStyle}">
                <Setter Property="Margin" Value="0,0,6,4" />
            </Style>

            <Style x:Key="MonitoringRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- Бейдж статуса в списке -->
            <Style x:Key="MonitoringListStatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Sent}">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.New}">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.InProgress}">
                        <Setter Property="Background" Value="#EFF6FF" />
                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Duplicate}">
                        <Setter Property="Background" Value="#FFF7ED" />
                        <Setter Property="BorderBrush" Value="#FED7AA" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.ActionRequired}">
                        <Setter Property="Background" Value="#FAF5FF" />
                        <Setter Property="BorderBrush" Value="#E9D5FF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Error}">
                        <Setter Property="Background" Value="#FEF2F2" />
                        <Setter Property="BorderBrush" Value="#FECACA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MonitoringListStatusBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#64748B" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Sent}">
                        <Setter Property="Foreground" Value="#15803D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.InProgress}">
                        <Setter Property="Foreground" Value="#1D4ED8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Duplicate}">
                        <Setter Property="Foreground" Value="#C2410C" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.ActionRequired}">
                        <Setter Property="Foreground" Value="#7E22CE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResponseStatus.Error}">
                        <Setter Property="Foreground" Value="#B91C1C" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Бейдж статуса в шапке деталей -->
            <Style x:Key="MonitoringDetailStatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Sent}">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#BBF7D0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.New}">
                        <Setter Property="Background" Value="#F8FAFC" />
                        <Setter Property="BorderBrush" Value="#E2E8F0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.InProgress}">
                        <Setter Property="Background" Value="#EFF6FF" />
                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Duplicate}">
                        <Setter Property="Background" Value="#FFF7ED" />
                        <Setter Property="BorderBrush" Value="#FED7AA" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.ActionRequired}">
                        <Setter Property="Background" Value="#FAF5FF" />
                        <Setter Property="BorderBrush" Value="#E9D5FF" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Error}">
                        <Setter Property="Background" Value="#FEF2F2" />
                        <Setter Property="BorderBrush" Value="#FECACA" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MonitoringDetailStatusBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#64748B" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Sent}">
                        <Setter Property="Foreground" Value="#15803D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.InProgress}">
                        <Setter Property="Foreground" Value="#1D4ED8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Duplicate}">
                        <Setter Property="Foreground" Value="#C2410C" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.ActionRequired}">
                        <Setter Property="Foreground" Value="#7E22CE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Error}">
                        <Setter Property="Foreground" Value="#B91C1C" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12,10,12,12" Background="{StaticResource DashboardPageChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header-card -->
        <Border Grid.Row="0"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Мониторинг"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Текущие отклики и их состояние в обработке."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="16,0,16,0"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0">
                    <UniformGrid Columns="4" Rows="1">
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Всего"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding TotalResponsesCount}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Новые"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding NewResponsesCount}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Отправлены"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SentResponsesCount}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#15803D" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,7">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ошибки"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding ErrorResponsesCount}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#DC2626" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <Button Grid.Column="2"
                        Content="Обновить"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MonitoringRefreshButtonStyle}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: фильтры + список -->
            <Border Grid.Column="0"
                    Style="{StaticResource MinimalDashSurfaceStyle}"
                    Padding="12,10"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource MinimalSegmentedToolbarBorderStyle}"
                            Margin="0,0,0,8"
                            Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Дата"
                                       Style="{StaticResource FilterToolbarLabelStyle}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="Поиск"
                                       Style="{StaticResource FilterToolbarLabelStyle}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0" />
                            <TextBlock Grid.Column="2"
                                       Text="Статус"
                                       Style="{StaticResource FilterToolbarLabelStyle}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0" />

                            <DatePicker Grid.Row="1"
                                        SelectedDate="{Binding SelectedResponseDate}"
                                        Style="{StaticResource ToolbarDatePickerStyle}"
                                        Margin="0,4,8,0"
                                        MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                        VerticalAlignment="Stretch" />

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="8,4,8,0"
                                  MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                  VerticalAlignment="Stretch">
                                <TextBox x:Name="SearchTextBox"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="Имя, телефон, вакансия…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Style="{StaticResource FilterComboBoxStyle}"
                                      Margin="8,4,8,0"
                                      MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                      VerticalAlignment="Stretch"
                                      SelectedValue="{Binding SelectedStatusFilter}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="Все" Content="Все" IsSelected="True" />
                                <ComboBoxItem Tag="Все, кроме дублей" Content="Все, кроме дублей" />
                                <ComboBoxItem Tag="New" Content="Новый" />
                                <ComboBoxItem Tag="InProgress" Content="В обработке" />
                                <ComboBoxItem Tag="Sent" Content="В CRM" />
                                <ComboBoxItem Tag="Duplicate" Content="Дубль" />
                                <ComboBoxItem Tag="Error" Content="Ошибка" />
                                <ComboBoxItem Tag="ActionRequired" Content="Нужны действия" />
                            </ComboBox>

                            <Button Grid.Row="1"
                                    Grid.Column="3"
                                    Content="Сбросить"
                                    Command="{Binding ClearMonitoringFiltersCommand}"
                                    Style="{StaticResource MonitoringDetailGhostButtonStyle}"
                                    Margin="0,4,0,0"
                                    MinWidth="88"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Stretch" />

                            <Expander Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="4"
                                      Margin="0,6,0,0"
                                      Padding="0"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <Expander.Header>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Cursor="Hand">
                                        <Run Text="Ещё фильтры" />
                                        <Run Text="{Binding ExtraFiltersHeaderSuffix, Mode=OneWay}" />
                                    </TextBlock>
                                </Expander.Header>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Вакансия" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Город" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="Аккаунт" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="3"
                                               Grid.ColumnSpan="2"
                                               Text="Возраст (от — до)"
                                               Style="{StaticResource FilterToolbarLabelStyle}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="0"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="0,4,8,0"
                                              MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                              ItemsSource="{Binding VacancyFilterOptions}"
                                              SelectedItem="{Binding SelectedVacancyFilter}"
                                              MaxDropDownHeight="220" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="8,4,8,0"
                                              MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                              ItemsSource="{Binding CityFilterOptions}"
                                              SelectedItem="{Binding SelectedCityFilter}"
                                              MaxDropDownHeight="220" />

                                    <ComboBox Grid.Row="1"
                                              Grid.Column="2"
                                              Style="{StaticResource FilterComboBoxStyle}"
                                              Margin="8,4,8,0"
                                              MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                              ItemsSource="{Binding AccountFilterOptions}"
                                              SelectedItem="{Binding SelectedAccountFilter}"
                                              MaxDropDownHeight="220" />

                                    <Grid Grid.Row="1"
                                          Grid.Column="3"
                                          Grid.ColumnSpan="2"
                                          Margin="8,4,0,0"
                                          VerticalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AgeFilterMinText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                                 Margin="0,0,6,0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="От" />
                                        <TextBlock Grid.Column="1"
                                                   Text="—"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding AgeFilterMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="{StaticResource MonitoringFilterControlHeight}"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="До" />
                                    </Grid>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" MinHeight="200">
                        <ListBox ItemsSource="{Binding ResponsesView}"
                                 SelectedItem="{Binding SelectedResponse}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0,0,4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Padding="0"
                                                        CornerRadius="10"
                                                        Background="Transparent"
                                                        BorderBrush="#E8EAED"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Rectangle x:Name="Accent"
                                                                   Width="3"
                                                                   Fill="Transparent"
                                                                   HorizontalAlignment="Left"
                                                                   RadiusX="2"
                                                                   RadiusY="2"
                                                                   Margin="0,6,0,6" />
                                                        <ContentPresenter Margin="11,6,10,6" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E2E8F0" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BFDBFE" />
                                                        <Setter TargetName="Accent" Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBox}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Копировать телефон"
                                                          Command="{Binding PlacementTarget.Tag.CopyResponsePhoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Открыть чат в Avito"
                                                          Command="{Binding PlacementTarget.Tag.OpenResponseChatInAvitoBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Открыть вакансию в Avito"
                                                          Command="{Binding PlacementTarget.Tag.OpenResponseVacancyInAvitoBrowserCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Открыть в Bitrix"
                                                          Command="{Binding PlacementTarget.Tag.OpenResponseInBitrixCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Отправить в Bitrix24…"
                                                          Command="{Binding PlacementTarget.Tag.SendToBitrixManuallyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="Копировать ссылку на чат"
                                                          Command="{Binding PlacementTarget.Tag.CopyResponseMessengerUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Копировать ссылку на объявление"
                                                          Command="{Binding PlacementTarget.Tag.CopyResponseVacancyUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Копировать текст карточки"
                                                          Command="{Binding PlacementTarget.Tag.CopyResponseCardSummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Удалить отклик…"
                                                          Command="{Binding PlacementTarget.Tag.DeleteSelectedResponseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Border Grid.Column="1"
                                                Style="{StaticResource MonitoringListStatusBadgeBorderStyle}"
                                                VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource MonitoringListStatusBadgeTextStyle}"
                                                       Text="{Binding Status, Converter={StaticResource ResponseStatusToDisplayConverter}}" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run Text="{Binding Vacancy, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding PhoneRaw, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding City, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Age, Converter={StaticResource AgeToDisplayConverter}, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=dd.MM HH:mm, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Padding="18,14"
                                CornerRadius="12"
                                Background="#FAFBFC"
                                BorderBrush="#E8EAED"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,4,8"
                                Visibility="{Binding ShowMonitoringResponsesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding MonitoringResponsesEmptyHint}"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Правая колонка: детали -->
            <Border Grid.Column="1"
                    Style="{StaticResource MinimalDashSurfaceStyle}"
                    Padding="0"
                    Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,12"
                              CanContentScroll="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="ДЕТАЛИ ОТКЛИКА"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedResponse.FullName, TargetNullValue=Выберите отклик в списке}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource MonitoringDetailStatusBadgeBorderStyle}">
                                <TextBlock Style="{StaticResource MonitoringDetailStatusBadgeTextStyle}"
                                           Text="{Binding SelectedResponseStatusText}" />
                            </Border>
                        </Grid>

                        <!-- Сетка полей 2×3 -->
                        <UniformGrid Grid.Row="2"
                                     Margin="0,14,0,0"
                                     Columns="2">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Вакансия" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponse.Vacancy, TargetNullValue=—}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Телефон" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponse.PhoneRaw, TargetNullValue=—}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Город" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponse.City, TargetNullValue=—}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Возраст" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponse.Age, Converter={StaticResource AgeToDisplayConverter}}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Создан" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponse.CreatedAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=dd.MM.yyyy HH:mm, TargetNullValue=—}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Обработан" Style="{StaticResource FilterToolbarLabelStyle}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedResponseProcessedText}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Grid.Row="3"
                                Margin="0,6,0,0"
                                Background="#F8FAFC"
                                BorderBrush="#EEF2F6"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Действия"
                                           Style="{StaticResource FilterToolbarLabelStyle}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Avito"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Button Content="Чат"
                                            ToolTip="Открыть чат"
                                            Style="{StaticResource MonitoringDetailOutlineButtonStyle}"
                                            Command="{Binding OpenResponseChatInAvitoBrowserCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                    <Button Content="Объявление"
                                            ToolTip="Открыть объявление"
                                            Style="{StaticResource MonitoringDetailOutlineButtonStyle}"
                                            Command="{Binding OpenResponseVacancyInAvitoBrowserCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                </WrapPanel>

                                <TextBlock Text="Bitrix24"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,10,0,4" />
                                <WrapPanel>
                                    <Button Content="Отправить в Bitrix24"
                                            ToolTip="Повторить проверку дублей и создать сделку (для отложенных или ошибок)"
                                            Style="{StaticResource MonitoringDetailPrimaryButtonStyle}"
                                            Command="{Binding SendToBitrixManuallyCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                    <Button Content="Открыть сделку"
                                            ToolTip="Открыть сделку в портале Bitrix24"
                                            Style="{StaticResource MonitoringDetailSecondaryButtonStyle}"
                                            Command="{Binding OpenResponseInBitrixCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                </WrapPanel>

                                <TextBlock Text="Копировать"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,10,0,4" />
                                <WrapPanel>
                                    <Button Content="Телефон"
                                            ToolTip="Скопировать номер в буфер"
                                            Style="{StaticResource MonitoringDetailGhostButtonStyle}"
                                            Command="{Binding CopyResponsePhoneCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                    <Button Content="Ссылка на чат"
                                            ToolTip="Скопировать URL чата в буфер"
                                            Style="{StaticResource MonitoringDetailGhostButtonStyle}"
                                            Command="{Binding CopyResponseMessengerUrlCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                    <Button Content="Ссылка на объявление"
                                            ToolTip="Скопировать URL объявления в буфер"
                                            Style="{StaticResource MonitoringDetailGhostButtonStyle}"
                                            Command="{Binding CopyResponseVacancyUrlCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                    <Button Content="Текст карточки"
                                            ToolTip="Скопировать все поля одним текстом"
                                            Style="{StaticResource MonitoringDetailGhostButtonStyle}"
                                            Command="{Binding CopyResponseCardSummaryCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                </WrapPanel>

                                <TextBlock Text="Удаление"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,10,0,4" />
                                <WrapPanel>
                                    <Button Content="Удалить из журнала"
                                            ToolTip="С подтверждением"
                                            Style="{StaticResource MonitoringDetailDangerOutlineButtonStyle}"
                                            Command="{Binding DeleteSelectedResponseCommand}"
                                            CommandParameter="{Binding SelectedResponse}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ошибка / комментарий -->
                        <Border Grid.Row="4"
                                Margin="0,12,0,0"
                                CornerRadius="10"
                                BorderThickness="1"
                                Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResponse.ErrorMessage, Converter={StaticResource IsNullOrEmptyConverter}}" Value="False">
                                            <Setter Property="Background" Value="#FFF7ED" />
                                            <Setter Property="BorderBrush" Value="#FED7AA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedResponse.Status}" Value="{x:Static models:ResponseStatus.Error}">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Ошибка / комментарий"
                                           Style="{StaticResource FilterToolbarLabelStyle}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding SelectedResponseErrorText}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
