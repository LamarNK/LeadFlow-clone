<UserControl x:Class="LeadFlow.Views.StatisticsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters">
    <UserControl.Resources>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
    </UserControl.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Статистика откликов по дням"
                   Style="{StaticResource PageTitleTextStyle}"
                   FontWeight="Bold" />

        <Border Grid.Row="1" Style="{StaticResource CompactCardBorderStyle}" Padding="12,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeriodRangeText}"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="Всего: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodTotal}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="В CRM: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodSent}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="В обработке: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodInProgress}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="Нужны действия: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodActionRequired}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                            <TextBlock Text="Дубликаты: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodDuplicates}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Ошибки: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeriodErrors}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Top"
                            MinWidth="280">
                    <TextBlock Text="Период (календарь ПК)"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="С"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker SelectedDate="{Binding PeriodStartDate}"
                                    Style="{StaticResource ToolbarDatePickerStyle}"
                                    MinHeight="{StaticResource FilterControlMinHeight}"
                                    Width="132"
                                    VerticalAlignment="Center" />
                        <TextBlock Text="по"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <DatePicker SelectedDate="{Binding PeriodEndDate}"
                                    Style="{StaticResource ToolbarDatePickerStyle}"
                                    MinHeight="{StaticResource FilterControlMinHeight}"
                                    Width="132"
                                    VerticalAlignment="Center" />
                        <Button Content="Обновить"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Padding="14,6"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Быстро:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="7 дн."
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Command="{Binding ApplyQuickRangeCommand}"
                                CommandParameter="7" />
                        <Button Content="14 дн."
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Command="{Binding ApplyQuickRangeCommand}"
                                CommandParameter="14" />
                        <Button Content="30 дн."
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Command="{Binding ApplyQuickRangeCommand}"
                                CommandParameter="30" />
                        <Button Content="90 дн."
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Command="{Binding ApplyQuickRangeCommand}"
                                CommandParameter="90" />
                    </StackPanel>
                    <TextBlock Text="Не более 366 дней; «по» не позже сегодня. Если «с» больше «по», даты выравниваются."
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               MaxWidth="360"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,6">
            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Ошибки" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Дубликаты" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Нужны действия" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="В CRM" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource SecondaryTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="В обработке" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CompactCardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Столбики по дням (снизу вверх: обработка → CRM → нужны действия → дубликаты → ошибки)"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Прокрутите вправо, если дней много."
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,2,0,6" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding DailyRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="56"
                                        Padding="4,0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0"
                                        ToolTipService.InitialShowDelay="200"
                                        ToolTipService.ShowDuration="60000">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Tooltip}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="340"
                                                       FontSize="12" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel>
                                        <Grid Height="128" Width="44" HorizontalAlignment="Center">
                                            <Rectangle Height="2"
                                                       VerticalAlignment="Bottom"
                                                       Fill="#94A3B8"
                                                       HorizontalAlignment="Stretch"
                                                       SnapsToDevicePixels="True" />
                                            <!-- Порядок сверху вниз: ошибки → дубликаты → нужны действия → CRM → обработка (низ у базовой линии) -->
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="22">
                                                <Border Width="20"
                                                        Height="{Binding ErrorHeight}"
                                                        Background="{StaticResource ErrorBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Errors, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="20"
                                                        Height="{Binding DuplicateHeight}"
                                                        Background="{StaticResource WarningBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Duplicates, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="20"
                                                        Height="{Binding ActionRequiredHeight}"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding ActionRequired, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="20"
                                                        Height="{Binding SentHeight}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Sent, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="20"
                                                        Height="{Binding InProgressHeight}"
                                                        Background="{StaticResource SecondaryTextBrush}"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding InProgress, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ShortLabel}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{Binding WeekdayLabel}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="#94A3B8"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CompactCardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Тренд: всего откликов по дням"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="SemiBold" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0">
                    <Canvas Height="110" Width="{Binding TrendCanvasWidth}" ClipToBounds="True">
                        <Canvas.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F1F5F9" Offset="0" />
                                <GradientStop Color="#FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Canvas.Background>
                        <Polyline Points="{Binding TotalTrendPoints}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  StrokeThickness="2.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                    </Canvas>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5"
                   Text="За выбранный период откликов в базе нет — графики появятся после появления данных."
                   Style="{StaticResource CaptionTextStyle}"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
    </Grid>
</UserControl>
