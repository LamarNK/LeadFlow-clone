<UserControl x:Class="LeadFlow.Views.StatisticsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:conv="clr-namespace:LeadFlow.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />

            <sys:Double x:Key="StatsFilterControlHeight">32</sys:Double>

            <Style x:Key="StatsRefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="StatsQuickRangeButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimalSegmentedOutlineButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>

            <Style x:Key="StatsKpiTileBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinWidth" Value="92" />
            </Style>

            <Style x:Key="StatsKpiCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>

            <Style x:Key="StatsKpiValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <Style x:Key="StatsHrCardStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E8EAED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <DataTemplate x:Key="HrMetricRowTemplate">
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Total, StringFormat={} {0}}" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="#15803D"
                               Text="{Binding Sent, StringFormat={} / CRM {0}}" />
                    <TextBlock Grid.Column="3"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="{Binding ConversionText, StringFormat={} ({0})}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AgeMetricRowTemplate">
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Bucket}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Total, StringFormat={} {0}}" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               FontSize="12"
                               Foreground="#15803D"
                               Text="{Binding ConversionText, StringFormat={} / CRM {0}}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12,10,12,12" Background="{StaticResource DashboardPageChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header card -->
        <Border Grid.Row="0"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Статистика по дням"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Отклики, CRM, дубликаты и ошибки за выбранный период."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding PeriodRangeText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">
                    <UniformGrid Columns="6" Rows="1">
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Всего" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodTotal}" Style="{StaticResource StatsKpiValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="В CRM" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodSent}" Style="{StaticResource StatsKpiValueStyle}" Foreground="#15803D" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="В обработке" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodInProgress}" Style="{StaticResource StatsKpiValueStyle}" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Нужны действия" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodActionRequired}" Style="{StaticResource StatsKpiValueStyle}" Foreground="#7E22CE" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Дубликаты" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodDuplicates}" Style="{StaticResource StatsKpiValueStyle}" Foreground="#C2410C" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatsKpiTileBorderStyle}" BorderThickness="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ошибки" Style="{StaticResource StatsKpiCaptionStyle}" />
                                <TextBlock Text="{Binding PeriodErrors}" Style="{StaticResource StatsKpiValueStyle}" Foreground="#DC2626" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>

        <!-- Period filter card -->
        <Border Grid.Row="1"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="С"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                        <DatePicker SelectedDate="{Binding PeriodStartDate}"
                                    Style="{StaticResource ToolbarDatePickerStyle}"
                                    MinHeight="{StaticResource StatsFilterControlHeight}"
                                    Width="138"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="По"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                        <DatePicker SelectedDate="{Binding PeriodEndDate}"
                                    Style="{StaticResource ToolbarDatePickerStyle}"
                                    MinHeight="{StaticResource StatsFilterControlHeight}"
                                    Width="138"
                                    Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0">
                    <Button Content="7 дн."
                            Style="{StaticResource StatsQuickRangeButtonStyle}"
                            Command="{Binding ApplyQuickRangeCommand}"
                            CommandParameter="7" />
                    <Button Content="14 дн."
                            Style="{StaticResource StatsQuickRangeButtonStyle}"
                            Command="{Binding ApplyQuickRangeCommand}"
                            CommandParameter="14" />
                    <Button Content="30 дн."
                            Style="{StaticResource StatsQuickRangeButtonStyle}"
                            Command="{Binding ApplyQuickRangeCommand}"
                            CommandParameter="30" />
                    <Button Content="90 дн."
                            Style="{StaticResource StatsQuickRangeButtonStyle}"
                            Command="{Binding ApplyQuickRangeCommand}"
                            CommandParameter="90" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Обновить"
                        Style="{StaticResource StatsRefreshButtonStyle}"
                        VerticalAlignment="Bottom"
                        Command="{Binding RefreshCommand}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Text="Не более 366 дней; «по» не позже сегодня. Если «с» больше «по», даты выравниваются."
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- Bars card -->
        <Border Grid.Row="2"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Отклики по дням"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Колонки складываются снизу вверх по статусам."
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   ToolTip="Снизу вверх: обработка → CRM → нужны действия → дубликаты → ошибки. Если дней много, столбики переносятся на новую строку." />
                    </StackPanel>

                    <!-- Легенда -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ошибки" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Дубликаты" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Нужны действия" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="В CRM" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="В обработке" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>

                <Border Margin="0,10,0,0"
                        Background="#FAFBFC"
                        BorderBrush="#EEF2F6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,12">
                    <ItemsControl ItemsSource="{Binding DailyRows}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="46"
                                        Padding="2,0"
                                        ToolTipService.InitialShowDelay="200"
                                        ToolTipService.ShowDuration="60000">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Tooltip}"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="340"
                                                       FontSize="12" />
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <StackPanel>
                                        <Grid Height="128" Width="32" HorizontalAlignment="Center">
                                            <Rectangle Height="1"
                                                       VerticalAlignment="Bottom"
                                                       Fill="#CBD5E1"
                                                       HorizontalAlignment="Stretch"
                                                       SnapsToDevicePixels="True" />
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="18">
                                                <Border Width="16"
                                                        Height="{Binding ErrorHeight}"
                                                        Background="#DC2626"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Errors, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="16"
                                                        Height="{Binding DuplicateHeight}"
                                                        Background="#F97316"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Duplicates, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="16"
                                                        Height="{Binding ActionRequiredHeight}"
                                                        Background="#A855F7"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding ActionRequired, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="16"
                                                        Height="{Binding SentHeight}"
                                                        Background="#16A34A"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding Sent, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                <Border Width="16"
                                                        Height="{Binding InProgressHeight}"
                                                        Background="#94A3B8"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding InProgress, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding ShortLabel}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="0,4,0,0"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{Binding WeekdayLabel}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="9"
                                                   Foreground="#94A3B8"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

        <!-- Trend card -->
        <Border Grid.Row="3"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Тренд откликов"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Всего откликов за день."
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding TrendMaxValue, StringFormat=Шкала: 0 … {0}}"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>

                <Border Margin="0,10,0,0"
                        Background="#FAFBFC"
                        BorderBrush="#EEF2F6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,8">
                    <Grid x:Name="TrendHost" SizeChanged="TrendHost_OnSizeChanged">
                        <Canvas Height="128" Width="{Binding TrendCanvasWidth}" ClipToBounds="True" HorizontalAlignment="Stretch">
                            <Line X1="0"
                                  Y1="110"
                                  X2="{Binding TrendCanvasWidth}"
                                  Y2="110"
                                  Stroke="#E2E8F0"
                                  StrokeThickness="1" />
                            <Line X1="0"
                                  Y1="55"
                                  X2="{Binding TrendCanvasWidth}"
                                  Y2="55"
                                  Stroke="#EEF2F6"
                                  StrokeThickness="1"
                                  StrokeDashArray="2,3" />
                            <Polyline Points="{Binding TotalTrendPoints}"
                                      Stroke="{StaticResource PrimaryBrush}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            <ItemsControl ItemsSource="{Binding TrendPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="8" Height="8" Margin="-4,-4,0,0">
                                            <Ellipse Fill="{StaticResource PrimaryBrush}"
                                                     Stroke="White"
                                                     StrokeThickness="1"
                                                     Width="6"
                                                     Height="6"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.InitialShowDelay="100">
                                                <Ellipse.ToolTip>
                                                    <TextBlock Text="{Binding Tooltip}" />
                                                </Ellipse.ToolTip>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TrendPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="114" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Margin="-12,0,0,0"
                                                   FontSize="9"
                                                   Foreground="#94A3B8"
                                                   TextAlignment="Center"
                                                   Width="24" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding TrendStartLabel}"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding TrendEndLabel}"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- HR-метрики -->
        <Border Grid.Row="4"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="HR-метрики"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="Сводка по аудитории за выбранный период."
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Средний возраст"
                                       Style="{StaticResource StatsKpiCaptionStyle}" />
                            <TextBlock Text="{Binding AverageAgeText}"
                                       Margin="0,2,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatsHrCardStyle}" Margin="0,0,6,8">
                        <StackPanel>
                            <TextBlock Text="Топ городов"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="отклики / CRM"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding TopCities}" ItemTemplate="{StaticResource HrMetricRowTemplate}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatsHrCardStyle}" Margin="6,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Топ вакансий"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="отклики / CRM"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding TopVacancies}" ItemTemplate="{StaticResource HrMetricRowTemplate}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatsHrCardStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Топ аккаунтов"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="отклики / CRM"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding TopAccounts}" ItemTemplate="{StaticResource HrMetricRowTemplate}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatsHrCardStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Возрастные группы"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <ItemsControl ItemsSource="{Binding AgeBuckets}" ItemTemplate="{StaticResource AgeMetricRowTemplate}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,10,0,0"
                        Padding="14,10"
                        Background="#FAFBFC"
                        BorderBrush="#E8EAED"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="За выбранный период откликов в базе нет — графики появятся после появления данных."
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
