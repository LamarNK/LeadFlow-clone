<Window x:Class="LeadFlow.Views.BalanceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LeadFlow.Converters"
        Title="Балансы — сводка"
        Width="720"
        Height="640"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DashboardPageChromeBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BalanceToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource MinimalSegmentedOutlineButtonStyle}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="BalanceAccountListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>

            <Style x:Key="BalanceAccountListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BalanceExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E8EAED" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Балансы"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding TotalBalanceDisplay}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#059669"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding SummaryLine}"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding LowBalanceHint}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#C2410C"
                       Margin="0,4,0,0"
                       Visibility="{Binding LowBalanceAccountCount, Converter={StaticResource ZeroToCollapsedConverter}}" />
        </StackPanel>

        <Border Grid.Row="1"
                Height="1"
                Background="#E2E8F0"
                Margin="0,0,0,12" />

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid MinHeight="32" VerticalAlignment="Center">
                <TextBox x:Name="BalanceSearchTextBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         ToolTip="Поиск по имени аккаунта или субпрофиля"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="Аккаунт или субпрофиль">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=BalanceSearchTextBox}" Value="" />
                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BalanceSearchTextBox}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource BalanceToolbarButtonStyle}"
                        Command="{Binding ExpandAllCommand}"
                        Content="Развернуть все" />
                <Button Style="{StaticResource BalanceToolbarButtonStyle}"
                        Command="{Binding CollapseAllCommand}"
                        Content="Свернуть все" />
                <Button Style="{StaticResource BalanceToolbarButtonStyle}"
                        Command="{Binding ExpandLowBalanceOnlyCommand}"
                        Content="Только низкий"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,0,0,8"
              Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Субпрофиль"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="2"
                       Text="Баланс"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Grid>

        <ListBox Grid.Row="4"
                 Style="{StaticResource BalanceAccountListBoxStyle}"
                 ItemContainerStyle="{StaticResource BalanceAccountListItemStyle}"
                 ItemsSource="{Binding AccountsView}"
                 Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Expander Style="{StaticResource BalanceExpanderStyle}"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid Margin="10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding AccountName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="(" />
                                        <Run Text="{Binding SubProfileCount, Mode=OneWay}" />
                                        <Run Text=" субпроф.)" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding TotalBalanceDisplay}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="12,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#059669" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLowBalance}" Value="True">
                                                    <Setter Property="Foreground" Value="#C2410C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Height="4"
                                        CornerRadius="2"
                                        Background="#E2E8F0"
                                        Margin="0,6,0,0">
                                    <Border Width="{Binding BarWidth, Converter={x:Static conv:FactorToWidthConverter.Instance}, ConverterParameter=520}"
                                            CornerRadius="2"
                                            HorizontalAlignment="Left"
                                            SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#059669" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLowBalance}" Value="True">
                                                        <Setter Property="Background" Value="#F97316" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <ItemsControl ItemsSource="{Binding SubProfileBars}"
                                      Margin="10,0,10,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,12,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BalanceDisplay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowBalance}" Value="True">
                                                            <Setter Property="Foreground" Value="#C2410C" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="5"
                   Margin="0,8,0,0"
                   FontSize="10"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   HorizontalAlignment="Right"
                   Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Run Text="Показано " />
            <Run Text="{Binding VisibleAccountCount, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text=" акк." />
        </TextBlock>

        <TextBlock Grid.Row="4"
                   Text="Нет данных о балансах"
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
    </Grid>
</Window>