<Window x:Class="LeadFlow.Views.BalanceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LeadFlow.Converters"
        Title="Балансы — сводка"
        Width="600"
        Height="560"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DashboardPageChromeBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Балансы"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="{Binding TotalBalanceDisplay}"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#059669"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding SummaryLine}"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Height="1"
                Background="#E2E8F0"
                Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Accounts}"
                          Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AccountName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalBalanceDisplay}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#059669" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="18"
                                    Margin="0,4,0,0"
                                    CornerRadius="4"
                                    Background="#F1F5F9"
                                    HorizontalAlignment="Left">
                                <Border Width="{Binding BarWidth, Converter={x:Static conv:FactorToWidthConverter.Instance}, ConverterParameter=400}"
                                        Background="#059669"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True" />
                            </Border>

                            <ItemsControl Grid.Row="2"
                                          Margin="0,4,0,0"
                                          ItemsSource="{Binding SubProfileBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="6" Height="6"
                                                     Fill="#A7F3D0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                             <Border Grid.Column="2"
                                                     Height="12"
                                                     Margin="4,0,8,0"
                                                     CornerRadius="3"
                                                     Background="#F1F5F9"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left">
                                                 <Border Width="{Binding BarWidth, Converter={x:Static conv:FactorToWidthConverter.Instance}, ConverterParameter=200}"
                                                         Background="#A7F3D0"
                                                         CornerRadius="3"
                                                         SnapsToDevicePixels="True" />
                                             </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding BalanceDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
