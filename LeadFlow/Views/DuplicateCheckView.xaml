<UserControl x:Class="LeadFlow.Views.DuplicateCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CompactCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="4. Проверка дублей" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Нормализованные телефоны" Margin="0,8,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Result.PhoneRaw}" IsReadOnly="True"/>
                <TextBlock Grid.Column="1" Text="→" FontSize="22" VerticalAlignment="Center" Margin="10,0" />
                <TextBox Grid.Column="2" Text="{Binding Result.PhoneNormalized}" IsReadOnly="True"/>
            </Grid>
            <Border Style="{StaticResource ToolbarSurfaceBorderStyle}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Проверка в локальной базе и Bitrix24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Result.Summary}" Margin="0,6,0,0" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Если найден дубликат — лид не создаётся" Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
