<UserControl x:Class="LeadFlow.Views.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters"
             xmlns:vm="clr-namespace:LeadFlow.ViewModels"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DashboardAdsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Grid вместо StackPanel: строки получают полную ширину окна при Measure, иначе ListBox сжимается по самому широкому объявлению и выглядит «узкой колонкой» по центру. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,6" Padding="10,8" HorizontalAlignment="Stretch">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock Text="Отклики и CRM" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text=" · "
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="2,0,2,0" />
                    <TextBlock Text="Счётчики за сегодня, динамика и сводка"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <UniformGrid Rows="1" Columns="7" Margin="0,6,0,0">
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Новых откликов"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NewResponses}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Всего за сегодня"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalToday}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="В CRM"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Отправлено в CRM" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SentToCrm}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="В обработке"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InProgress}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDuplicatesAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FFF7ED" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Дубликаты"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Duplicates}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActionRequiredAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FFF7ED" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Нужны действия"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Отложена отправка в CRM или контакт без сделки" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActionRequired}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountsNeedAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FEF2F2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Аккаунты"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Аккаунтов подключено" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectedAccounts}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding RequiresAuthorization, StringFormat=Требует авторизации: {0}}"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding RequiresAuthorization, Converter={StaticResource ZeroToCollapsedConverter}}"
                                       Margin="0,1,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="Настройки"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                </UniformGrid>

                <Border x:Name="ChartActivityHost"
                        Style="{StaticResource CompactCardBorderStyle}"
                        Margin="2,6,2,0"
                        Padding="8,6"
                        Loaded="ChartActivityHost_OnLoaded"
                        SizeChanged="ChartActivityHost_OnSizeChanged">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="Динамика за сегодня"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="По дням — графики"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Подробная статистика по календарным дням" />
                        </StackPanel>
                        <Grid Margin="0,2,0,0" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <!-- Базовая линия общая для всех столбиков — сразу под ними, без зазора -->
                            <Grid Grid.Row="0">
                                <Rectangle Height="2"
                                           VerticalAlignment="Bottom"
                                           Fill="#94A3B8"
                                           HorizontalAlignment="Stretch"
                                           SnapsToDevicePixels="True" />
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="72"
                                                  Margin="2,0"
                                                  ToolTipService.InitialShowDelay="200"
                                                  ToolTipService.ShowDuration="60000">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding ChartTooltip}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="320"
                                                                   FontSize="12" />
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Rectangle Height="{Binding ChartBarHeight}"
                                                           Width="14"
                                                           Fill="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding Activity}"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" ClipToBounds="False">
                                            <!-- Штрих вверх к столбику, визуально из одной линейки с базой -->
                                            <Border Width="1.5"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,0,0"
                                                    Background="#475569"
                                                    SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       Margin="0,0,0,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CompactCardBorderStyle}"
                        Margin="2,6,2,0"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Динамика за неделю"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,2,0,0" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Rectangle Height="2"
                                           VerticalAlignment="Bottom"
                                           Fill="#94A3B8"
                                           HorizontalAlignment="Stretch"
                                           SnapsToDevicePixels="True" />
                                <ItemsControl ItemsSource="{Binding WeeklyActivity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="72"
                                                  Margin="2,0"
                                                  ToolTipService.InitialShowDelay="200"
                                                  ToolTipService.ShowDuration="60000">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding ChartTooltip}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="320"
                                                                   FontSize="12" />
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Rectangle Height="{Binding ChartBarHeight}"
                                                           Width="14"
                                                           Fill="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding WeeklyActivity}"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" ClipToBounds="False">
                                            <Border Width="1.5"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,0,0"
                                                    Background="#475569"
                                                    SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="2,6,2,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Краткая сводка" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="Всего: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalToday}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="В CRM: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SentToCrm}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="Дубликаты: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Duplicates}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ошибки: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Errors}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="AdsSectionHost"
                Grid.Row="1"
                Style="{StaticResource CompactCardBorderStyle}"
                Padding="0"
                HorizontalAlignment="Stretch"
                Loaded="AdsSectionHost_OnLoaded"
                SizeChanged="AdsSectionHost_OnSizeChanged">
            <Grid HorizontalAlignment="Stretch"
                  Background="{StaticResource DashBgBrush}"
                  TextElement.FontFamily="Segoe UI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="240" />
                </Grid.RowDefinitions>

                <!-- Заголовок и карточки статистики (та же иерархия, что у «Отклики и CRM») -->
                <StackPanel Grid.Row="0" Margin="10,8,10,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock Text="Объявления на Avito"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="2,0,2,0" />
                        <TextBlock Text="Сводка по аккаунтам: активные, просмотры, сообщения, статусы"
                                   Style="{StaticResource SubtleTextStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Внешний вид как у плиток CRM (StatCardButtonStyle), без перехода в мониторинг -->
                    <UniformGrid Margin="0,6,0,0" Columns="5" Rows="1">
                        <Button Style="{StaticResource StatCardButtonStyle}"
                                Focusable="False"
                                IsTabStop="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Активные"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActiveAds.Count}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatCardButtonStyle}"
                                Focusable="False"
                                IsTabStop="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Заблокированные"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BlockedAdsCount}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatCardButtonStyle}"
                                Focusable="False"
                                IsTabStop="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Черновики"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DraftsCount}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatCardButtonStyle}"
                                Focusable="False"
                                IsTabStop="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Просмотры"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalActiveViews}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="по активным"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource StatCardButtonStyle}"
                                Focusable="False"
                                IsTabStop="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Сообщения"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalActiveContacts}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="по активным"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0" />
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Фильтры, поиск, сортировка -->
                <Border Grid.Row="1"
                        Padding="10,4,10,16"
                        BorderBrush="{StaticResource DashBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">
                    <Grid MinHeight="52">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="0"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource DashboardFilterTabsListBoxStyle}"
                                 ItemsSource="{Binding AdsFilterTabs}"
                                 SelectedValue="{Binding SelectedAdsFilter, Mode=TwoWay}"
                                 SelectedValuePath="Filter">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="13"
                                               Foreground="{StaticResource DashTextPrimaryBrush}"
                                               Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,12,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Поиск" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Сортировка" />
                        <Grid Grid.Row="1"
                              Grid.Column="1"
                              Width="260"
                              Margin="0,0,12,0"
                              MinHeight="{StaticResource FilterControlMinHeight}"
                              VerticalAlignment="Stretch">
                            <TextBox x:Name="AdsSearchTextBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск по названию, городу или ID объявления"
                                     Text="{Binding AdsSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="Название, город или ID">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=AdsSearchTextBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=AdsSearchTextBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="2"
                                  Width="200"
                                  VerticalAlignment="Stretch"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding AdsSortChoices}"
                                  SelectedValuePath="Option"
                                  SelectedValue="{Binding SelectedAdsSort, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdsSortChoice}">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Список объявлений (прокрутка только здесь) -->
                <Grid Grid.Row="2"
                      Margin="10,4,10,20"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,12"
                               FontSize="13"
                               FontStyle="Italic"
                               Foreground="{StaticResource DashTextSecondaryBrush}"
                               Text="Нет объявлений по выбранному фильтру и поиску. Проверьте аккаунт Avito или обновите данные."
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowStandardAdsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ScrollViewer x:Name="AdsListScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,4,0"
                                  PreviewMouseWheel="AdsListScrollViewer_OnPreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding DisplayedAds}"
                                      HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.ActiveAdsGridColumns, ElementName=DashboardRoot}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DashboardAdDisplayItem}">
                                    <Button Style="{StaticResource StatCardButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Cursor="Hand"
                                            Focusable="False"
                                            IsTabStop="False"
                                            Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Ad}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Ad.Title}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Ad.Title}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Ad.Views}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Active}">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,1,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding Ad.City}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="2,0,2,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="·" />
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding Ad.Status}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="2,0,2,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="·" />
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="сообщ." />
                                                    <TextBlock Margin="2,0,0,0"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Ad.Contacts}" />
                                                    <StackPanel Margin="4,0,0,0" Orientation="Horizontal">
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Text="· ID " />
                                                        <TextBlock FontSize="10"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   Text="{Binding Ad.Id}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#B91C1C"
                                                           Text="{Binding Ad.DeleteDate}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2"
                                                       Text="Открыть на Avito"
                                                       Style="{StaticResource StatLinkTextStyle}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
