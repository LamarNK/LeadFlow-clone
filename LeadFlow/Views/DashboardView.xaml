<UserControl x:Class="LeadFlow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters">
    <UserControl.Resources>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,6" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Отклики и CRM" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Счётчики за сегодня, динамика и сводка."
                           Style="{StaticResource SubtleTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />

                <UniformGrid Columns="4" Margin="0,8,0,0">
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Новых откликов" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding NewResponses}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="К мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Всего за сегодня" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding TotalToday}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="К мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Отправлено в CRM" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding SentToCrm}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Журнал" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="В обработке" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding InProgress}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="К мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Дубликаты" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding Duplicates}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="Журнал" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Padding="10"
                            Margin="4"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Аккаунтов подключено" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding ConnectedAccounts}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding RequiresAuthorization, StringFormat=Требует авторизации: {0}}"
                                       Style="{StaticResource SubtleTextStyle}"
                                       Visibility="{Binding RequiresAuthorization, Converter={StaticResource ZeroToCollapsedConverter}}"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="Настройки" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Style="{StaticResource CompactCardBorderStyle}" Margin="4,8,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Динамика за сегодня" FontWeight="SemiBold" FontSize="13" />
                        <ItemsControl ItemsSource="{Binding Activity}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0"
                                                   Height="{Binding SentCount}"
                                                   Width="14"
                                                   Fill="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="4,8,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Краткая сводка" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding TotalToday, StringFormat=Всего откликов: {0}}" FontSize="12" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding SentToCrm, StringFormat=Успешно отправлено: {0}}" FontSize="12" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Duplicates, StringFormat=Дубликаты: {0}}" FontSize="12" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Errors, StringFormat=Ошибки: {0}}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CompactCardBorderStyle}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Объявления на Avito" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Активные" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Border Background="#DCFCE7" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveAds.Count}" FontWeight="Bold" Foreground="#166534" FontSize="12" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalActiveViews, StringFormat=Просмотры: {0}}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalActiveContacts, StringFormat=Контакты: {0}}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,6,0,0">
                    <ListBox ItemsSource="{Binding ActiveAds}"
                             MinHeight="120"
                             MaxHeight="280"
                             Margin="0"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="6,5" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding City}"
                                                           Foreground="#64748B"
                                                           FontSize="11"
                                                           Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0,0,0">
                                                <TextBlock Text="Просм. " FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding Views}" FontSize="10" Foreground="#64748B" Margin="0,0,4,0" />
                                                <TextBlock Text="Конт. " FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding Contacts}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Нет активных в списке"
                               Foreground="#64748B"
                               FontStyle="Italic"
                               FontSize="12"
                               Margin="0,6,0,0"
                               Visibility="{Binding ActiveAds.Count, Converter={StaticResource ZeroToCollapsedConverter}, ConverterParameter=Invert}" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="10" Padding="12,10" Margin="4,0,4,0" BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Заблокировано" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding BlockedAdsCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="10" Padding="12,10" Margin="4,0,4,0" BorderBrush="#FEF08A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Черновики" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding DraftsCount}" FontSize="22" FontWeight="Bold" Foreground="#CA8A04" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
