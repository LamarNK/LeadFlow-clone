<UserControl x:Class="LeadFlow.Views.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters"
             xmlns:vm="clr-namespace:LeadFlow.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DashboardAdsStyles.xaml" />
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />

            <Style x:Key="DashboardMetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DashboardMetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DashboardRailTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="DashboardRailSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Margin" Value="0,2,0,8" />
            </Style>
            <Style x:Key="DashboardAdsMetricChipStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="TextDecorations" Value="None" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="TextDecorations" Value="Underline" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Grid вместо StackPanel: строки получают полную ширину окна при Measure, иначе ListBox сжимается по самому широкому объявлению и выглядит «узкой колонкой» по центру. -->
    <Grid Background="{StaticResource DashboardPageChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero «Сегодня»: нижняя часть монолита с шапкой MainWindow (без скругления и рамки сверху) -->
        <Border Grid.Row="0"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                CornerRadius="0,0,14,14"
                BorderThickness="1,0,1,1"
                Margin="0,0,0,14"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="СЕГОДНЯ"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalToday}"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,2,0,0"
                               LineHeight="44" />
                    <TextBlock Text="откликов сегодня"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="За календарный день"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0"
                        VerticalAlignment="Center"
                        MinHeight="72">
                    <UniformGrid Columns="5" Rows="1">
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10" MinHeight="72">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="В CRM" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding SentToCrm}" FontSize="17" FontWeight="SemiBold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10" MinHeight="72">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Дубликаты" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Duplicates}" FontSize="17" FontWeight="SemiBold" Foreground="#B45309" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10" MinHeight="72">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Нужны действия" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding ActionRequired}" FontSize="17" FontWeight="SemiBold" Foreground="#C2410C" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,10" MinHeight="72">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Просмотры" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding TotalActiveViews}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,10" MinHeight="72">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Сообщения" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding TotalActiveContacts}" FontSize="17" FontWeight="SemiBold" Foreground="#2563EB" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>

        <!-- Основная аналитика: график слева, статусы справа -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="248" MaxWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource MinimalDashSurfaceStyle}"
                    Padding="16,14"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Отклики по часам"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="Распределение по локальным часам суток"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource MinimalSegmentedToolbarBorderStyle}"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ряд:"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="4,0,6,0" />
                                <ListBox Style="{StaticResource MinimalChartSeriesListBoxStyle}"
                                         ItemsSource="{Binding ChartSeriesTabs}"
                                         DisplayMemberPath="Title"
                                         SelectedValuePath="Series"
                                         SelectedValue="{Binding SelectedChartSeries, Mode=TwoWay}" />
                                <Button Style="{StaticResource MinimalSegmentedOutlineButtonStyle}"
                                        Content="По дням"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Подробная статистика по календарным дням" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ChartActivityHost"
                            Grid.Row="1"
                            Margin="0,2,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Loaded="ChartActivityHost_OnLoaded"
                            SizeChanged="ChartActivityHost_OnSizeChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Height="168"
                                  Margin="0,0,4,20"
                                  VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Text="·" />
                                <TextBlock Grid.Row="1" Text=" " />
                                <TextBlock Grid.Row="2" Text=" " />
                                <TextBlock Grid.Row="3" Text="0" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Style="{StaticResource MinimalAnalyticsPlotAreaStyle}"
                                        Padding="0,6,6,6"
                                        VerticalAlignment="Top">
                                    <Grid Height="156">
                                        <UniformGrid Rows="4" Columns="1" Opacity="0.9">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="Transparent" Background="Transparent" />
                                        </UniformGrid>
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#64748B"
                                                   Margin="0,0,4,0"
                                                   Opacity="0.45"
                                                   SnapsToDevicePixels="True" />
                                        <ItemsControl ItemsSource="{Binding Activity}"
                                                      Margin="0,0,4,3"
                                                      VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="146"
                                                          Margin="1,0"
                                                          VerticalAlignment="Bottom"
                                                          ToolTipService.InitialShowDelay="200"
                                                          ToolTipService.ShowDuration="60000">
                                                        <Grid.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{Binding ChartTooltip}" TextWrapping="Wrap" MaxWidth="320" FontSize="12" />
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <TextBlock Text="{Binding ChartDisplayValue}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Top"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding ChartDisplayValue, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                        <Border Width="18"
                                                                Height="{Binding ChartBarHeight}"
                                                                MinHeight="3"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,0,0,3"
                                                                CornerRadius="5,5,2,2"
                                                                Background="{Binding ChartBarFillHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                                SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Activity}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,6,0"
                                              Height="18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="18" ClipToBounds="False">
                                                <Border Width="1"
                                                        Height="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,0,0"
                                                        Background="#94A3B8"
                                                        SnapsToDevicePixels="True" />
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Недельная динамика: та же сетка оси Y + plot-area, что у почасового графика -->
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Динамика за неделю"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="Отклики по дням за последние 7 дней"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Height="168"
                                  Margin="0,0,4,20"
                                  VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Text="·" />
                                <TextBlock Grid.Row="1" Text=" " />
                                <TextBlock Grid.Row="2"
                                           Text="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Style="{StaticResource MinimalAnalyticsPlotAreaStyle}"
                                        Padding="0,6,6,6"
                                        VerticalAlignment="Top">
                                    <Grid Height="156">
                                        <UniformGrid Rows="3" Columns="1" Opacity="0.9">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="Transparent" Background="Transparent" />
                                        </UniformGrid>
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#64748B"
                                                   Margin="0,0,4,0"
                                                   Opacity="0.45"
                                                   SnapsToDevicePixels="True" />
                                        <ItemsControl ItemsSource="{Binding WeeklyActivity}"
                                                      Margin="0,0,4,3"
                                                      VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="130"
                                                          Margin="1,0"
                                                          VerticalAlignment="Bottom"
                                                          ToolTipService.InitialShowDelay="200"
                                                          ToolTipService.ShowDuration="60000">
                                                        <Grid.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{Binding ChartTooltip}" TextWrapping="Wrap" MaxWidth="280" FontSize="11" />
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <Border Width="14"
                                                                Height="{Binding ChartBarHeight}"
                                                                MinHeight="3"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,0,0,3"
                                                                CornerRadius="5,5,2,2"
                                                                Background="{Binding ChartBarFillHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                                SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding WeeklyActivity}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,6,0"
                                              Height="18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="18" ClipToBounds="False">
                                                <Border Width="1"
                                                        Height="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#94A3B8"
                                                        SnapsToDevicePixels="True" />
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="28,8,12,8"
                            HorizontalAlignment="Stretch"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="Сводка:" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="всего {0} · CRM {1} · дубли {2} · ошибки {3}">
                                        <Binding Path="TotalToday" />
                                        <Binding Path="SentToCrm" />
                                        <Binding Path="Duplicates" />
                                        <Binding Path="Errors" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Stretch">
                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Требуют внимания"
                                       Style="{StaticResource DashboardRailTitleStyle}" />
                            <TextBlock Text="Объявления и CRM"
                                       Style="{StaticResource DashboardRailSubtitleStyle}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Дубликаты" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Duplicates}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#B45309" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Нужны действия" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionRequired}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#C2410C" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Черновики" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding DraftsCount}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Заблокировано" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding BlockedAdsCount}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#DC2626" />
                            </Grid>
                            <Button HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Content="Разобрать"
                                    Command="{Binding GoToAttentionProblemsCommand}"
                                    ToolTip="Открыть мониторинг: отклики «Нужны действия», сортировка по статусу" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Avito"
                                       Style="{StaticResource DashboardRailTitleStyle}" />
                            <TextBlock Text="Активные объявления"
                                       Style="{StaticResource DashboardRailSubtitleStyle}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Активные" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveAds.Count}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#15803D" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Просмотры" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalActiveViews}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сообщения" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalActiveContacts}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#2563EB" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Заблокированные" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding BlockedAdsCount}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#DC2626" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Черновики" Style="{StaticResource DashboardMetricLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding DraftsCount}" Style="{StaticResource DashboardMetricValueStyle}" Foreground="#B45309" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Балансы"
                                               Style="{StaticResource DashboardRailTitleStyle}" />
                                    <TextBlock Text="Авансовые по аккаунтам"
                                               Style="{StaticResource DashboardRailSubtitleStyle}"
                                               Margin="0,2,0,6" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenBalanceDetailsCommand}"
                                        Content="Сводка"
                                        Padding="8,3"
                                        FontSize="10"
                                        MinHeight="24"
                                        VerticalAlignment="Top"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource MinimalSegmentedOutlineButtonStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:N2} ₽}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#059669" />
                            <TextBlock Text="{Binding BalanceSummaryLine}"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,2,0,0" />
                            <TextBlock FontSize="10"
                                       Foreground="#C2410C"
                                       Margin="0,2,0,6"
                                       Visibility="{Binding LowBalanceAccountCount, Converter={StaticResource ZeroToCollapsedConverter}}">
                                <Run Text="Низкий баланс (&lt;5 000 ₽): " />
                                <Run Text="{Binding LowBalanceAccountCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" акк." />
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="168">
                                <ItemsControl ItemsSource="{Binding BalancePreviewAccounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="0,0,0,4"
                                                    BorderBrush="#EEF2F6"
                                                    BorderThickness="0,0,0,1"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Command="{Binding DataContext.OpenBalanceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  MouseAction="LeftClick" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="{Binding AccountName}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding TotalBalanceDisplay}"
                                                               FontSize="11"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#059669" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLowBalance}" Value="True">
                                                                        <Setter Property="Foreground" Value="#C2410C" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                            Height="3"
                                                            CornerRadius="2"
                                                            Background="#E2E8F0"
                                                            Margin="0,3,0,0">
                                                        <Border Width="{Binding BarWidth, Converter={x:Static conv:FactorToWidthConverter.Instance}, ConverterParameter=200}"
                                                                CornerRadius="2"
                                                                HorizontalAlignment="Left"
                                                                SnapsToDevicePixels="True">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#059669" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasLowBalance}" Value="True">
                                                                            <Setter Property="Background" Value="#F97316" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                               Margin="0,3,0,0"
                                                               Text="{Binding CompactSubProfileSummary}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Margin="0,6,0,0"
                                    Command="{Binding OpenBalanceDetailsCommand}"
                                    Content="{Binding BalancePreviewHint}"
                                    FontSize="10"
                                    Padding="0,4"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Cursor="Hand"
                                    Visibility="{Binding HasBalances, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="AdsSectionHost"
                Grid.Row="2"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Margin="0,16,0,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Loaded="AdsSectionHost_OnLoaded"
                SizeChanged="AdsSectionHost_OnSizeChanged">
            <Grid HorizontalAlignment="Stretch"
                  Background="{StaticResource DashBgBrush}"
                  TextElement.FontFamily="Segoe UI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок и компактные метрики -->
                <Border Grid.Row="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        Padding="14,12,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Объявления на Avito"
                                       Style="{StaticResource SectionHeaderTextStyle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" · "
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="2,0,4,0" />
                            <TextBlock Text="сводка по аккаунтам"
                                       Style="{StaticResource SubtleTextStyle}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Orientation="Horizontal">
                            <Border Style="{StaticResource DashboardAdsMetricChipStyle}"
                                    Background="#ECFDF5"
                                    BorderBrush="#D1FAE5"
                                    ToolTip="Активные объявления">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Активные"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ActiveAds.Count}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#15803D"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardAdsMetricChipStyle}"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    ToolTip="Заблокированные объявления">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Заблок."
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding BlockedAdsCount}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ErrorBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardAdsMetricChipStyle}"
                                    Background="#FFF7ED"
                                    BorderBrush="#FDBA74"
                                    ToolTip="Черновики">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Черновики"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DraftsCount}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardAdsMetricChipStyle}"
                                    Background="{StaticResource DashCardBrush}"
                                    BorderBrush="{StaticResource DashBorderBrush}"
                                    ToolTip="Просмотры по активным объявлениям">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Просмотры"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TotalActiveViews}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#475569"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardAdsMetricChipStyle}"
                                    Background="{StaticResource DashCardBrush}"
                                    BorderBrush="{StaticResource DashBorderBrush}"
                                    Margin="0"
                                    ToolTip="Сообщения по активным объявлениям">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Сообщения"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TotalActiveContacts}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#2563EB"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Навигация по аккаунтам и субпрофилям -->
                <Border Grid.Row="1" Grid.RowSpan="2"
                        Width="270"
                        Margin="14,8,0,12"
                        HorizontalAlignment="Left"
                        BorderBrush="{StaticResource DashBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource DashCardBrush}"
                        CornerRadius="8"
                        Panel.ZIndex="2">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="14,12,14,8"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DashTextPrimaryBrush}"
                                   Text="Аккаунты и субпрофили" />
                        <ListBox ItemsSource="{Binding AdsScopeItems}"
                                 SelectedItem="{Binding SelectedAdsScope, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="6,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="12"
                                               Foreground="{StaticResource DashTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Фильтры, поиск, сортировка -->
                <Border Grid.Row="1"
                        Margin="284,0,0,0"
                        Padding="14,8,14,10"
                        BorderBrush="{StaticResource DashBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">
                    <Grid MinHeight="44">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 PreviewMouseWheel="AdsFilterListBox_OnPreviewMouseWheel"
                                 Style="{StaticResource MinimalAdsFilterListBoxStyle}"
                                 ItemsSource="{Binding AdsFilterTabs}"
                                 SelectedValue="{Binding SelectedAdsFilter, Mode=TwoWay}"
                                 SelectedValuePath="Filter">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="13"
                                               Foreground="{StaticResource DashTextPrimaryBrush}"
                                               Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Поиск" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Сортировка" />
                        <Grid Grid.Row="1"
                              Grid.Column="2"
                              Width="260"
                              MinHeight="{StaticResource FilterControlMinHeight}"
                              VerticalAlignment="Stretch">
                            <TextBox x:Name="AdsSearchTextBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск по названию, городу, ID объявления или тексту статуса"
                                     Text="{Binding AdsSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="Название, город, ID или статус">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=AdsSearchTextBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=AdsSearchTextBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="4"
                                  Width="200"
                                  VerticalAlignment="Stretch"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding AdsSortChoices}"
                                  SelectedValuePath="Option"
                                  SelectedValue="{Binding SelectedAdsSort, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdsSortChoice}">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Список объявлений (прокрутка только здесь) -->
                <Grid Grid.Row="2"
                      Margin="298,4,14,12"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Margin="0,0,0,10"
                                Padding="10,8"
                                CornerRadius="8"
                                Visibility="{Binding AdsActionNotice, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdsActionNoticeIsError}" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12"
                                       Text="{Binding AdsActionNotice}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#166534" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdsActionNoticeIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Margin="0,0,0,12"
                                   FontSize="13"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource DashTextSecondaryBrush}"
                                   Text="Нет объявлений по выбранному фильтру и поиску. Проверьте аккаунт Avito или обновите данные."
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowStandardAdsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Margin="0,0,0,8"
                                   FontSize="12"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding AdsScopeNotice}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding AdsScopeNotice, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>

                    <ListBox x:Name="AdsListListBox"
                             Grid.Row="1"
                             MinHeight="200"
                             Padding="0,0,4,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             PreviewMouseWheel="AdsListListBox_OnPreviewMouseWheel"
                             SizeChanged="AdsListListBox_OnSizeChanged"
                             ItemsSource="{Binding DisplayedAdsView}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel SpacingMode="Uniform"
                                                           StretchItems="False"
                                                           IsGridLayoutEnabled="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="{Binding DataContext.ActiveAdsTileWidth, ElementName=DashboardRoot}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DashboardAdDisplayItem}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="3"
                                                Margin="0,0,0,0"
                                                VerticalAlignment="Stretch"
                                                Background="#93C5FD"
                                                Opacity="0.85"
                                                CornerRadius="1,0,0,1"
                                                Visibility="{Binding HasUnreadMessages, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Grid.Column="1"
                                                HorizontalAlignment="Stretch">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource DashboardAdCardBorderStyle}" TargetType="Border" />
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Ad}"
                                                              MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <Grid Margin="0,0,0,0">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding Ad.Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding Ad.Title}" />
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="7,0,0,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="просм."
                                                               FontSize="9"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Ad.Views}"
                                                               FontSize="13"
                                                               FontWeight="Normal"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Active}">
                                                                        <Setter Property="Foreground" Value="#15803D" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Unpublished}">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,2,0,0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding ShowAnyBadgeRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border Padding="5,2"
                                                            CornerRadius="6"
                                                            Margin="0,0,5,0"
                                                            Visibility="{Binding ShowPrimaryStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#DCFCE7" />
                                                                <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Blocked}">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Unpublished}">
                                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                                        <Setter Property="BorderBrush" Value="#FCD34D" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Draft}">
                                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Messages}">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.NeedsAction}">
                                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                                        <Setter Property="BorderBrush" Value="#FDBA74" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusBadgeCaption}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#166534" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Blocked}">
                                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Unpublished}">
                                                                            <Setter Property="Foreground" Value="#92400E" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Draft}">
                                                                            <Setter Property="Foreground" Value="#4B5563" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Messages}">
                                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.NeedsAction}">
                                                                            <Setter Property="Foreground" Value="#C2410C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Padding="4,1"
                                                            CornerRadius="4"
                                                            Background="#F1F5F9"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Visibility="{Binding ShowMessageCountPill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding MessageCountPillText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1} · id {2}">
                                                            <Binding Path="Ad.City" />
                                                            <Binding Path="Ad.Status" />
                                                            <Binding Path="Ad.Id" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Row="3"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#B91C1C"
                                                           Text="{Binding Ad.DeleteDate}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="4"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#B45309"
                                                           Text="{Binding Ad.ErrorReason}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ad.ErrorReason}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Ad.SourceTab}" Value="rejected">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Ad.SourceTab}" Value="inactive">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                 <TextBlock Grid.Row="5"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap">
                                                    <Hyperlink Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Ad}">
                                                        <Run Text="Avito" />
                                                    </Hyperlink>
                                                    <Run Text="  ·  "
                                                         Foreground="#94A3B8" />
                                                    <Hyperlink Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Run Text="Отклики" />
                                                    </Hyperlink>
                                                    <Run Text="  ·  "
                                                         Foreground="#94A3B8" />
                                                    <Hyperlink Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Run Text="Статистика" />
                                                     </Hyperlink>
                                                 </TextBlock>
                                                 <StackPanel Grid.Row="6"
                                                             Grid.ColumnSpan="2"
                                                             Margin="0,8,0,0">
                                                     <Button Padding="10,5"
                                                             HorizontalAlignment="Left"
                                                             Margin="0"
                                                             Style="{StaticResource MonitoringCompactActionButtonStyle}"
                                                             Command="{Binding DataContext.RenewAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"
                                                             Content="{Binding RenewalButtonCaption}"
                                                             IsEnabled="{Binding CanStartRenewal}"
                                                             Visibility="{Binding ShowRenewalAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                     <TextBlock Margin="0,5,0,0"
                                                                FontSize="10"
                                                                Text="{Binding RenewalMessage}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding RenewalMessage, Converter={StaticResource StringToVisibilityConverter}}">
                                                         <TextBlock.Style>
                                                             <Style TargetType="TextBlock">
                                                                 <Setter Property="Foreground" Value="#64748B" />
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding IsRenewalSucceeded}" Value="True">
                                                                         <Setter Property="Foreground" Value="#166534" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding IsRenewalFailed}" Value="True">
                                                                         <Setter Property="Foreground" Value="#991B1B" />
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </TextBlock.Style>
                                                     </TextBlock>
                                                     <TextBlock Margin="0,3,0,0"
                                                                FontSize="10"
                                                                Foreground="#92400E"
                                                                Text="{Binding RenewalUnavailableText}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding ShowRenewalUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                 </StackPanel>
                                             </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
