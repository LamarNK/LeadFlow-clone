<UserControl x:Class="LeadFlow.Views.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters"
             xmlns:vm="clr-namespace:LeadFlow.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DashboardAdsStyles.xaml" />
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="TextDecorations" Value="None" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="TextDecorations" Value="Underline" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Grid вместо StackPanel: строки получают полную ширину окна при Measure, иначе ListBox сжимается по самому широкому объявлению и выглядит «узкой колонкой» по центру. -->
    <Grid Background="{StaticResource DashboardPageChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero «Сегодня»: нижняя часть монолита с шапкой MainWindow (без скругления и рамки сверху) -->
        <Border Grid.Row="0"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                CornerRadius="0,0,14,14"
                BorderThickness="1,0,1,1"
                Margin="0,0,0,12"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="СЕГОДНЯ"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalToday}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="откликов сегодня"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="За календарный день"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="16,0,0,0"
                        Background="#F1F5F9"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0"
                        VerticalAlignment="Center">
                    <UniformGrid Columns="5" Rows="1">
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="В CRM" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SentToCrm}" FontSize="17" FontWeight="SemiBold" Foreground="#15803D" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Дубликаты" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding Duplicates}" FontSize="17" FontWeight="SemiBold" Foreground="#B45309" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Нужны действия" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding ActionRequired}" FontSize="17" FontWeight="SemiBold" Foreground="#C2410C" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="10,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Просмотры" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding TotalActiveViews}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="Сообщения" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding TotalActiveContacts}" FontSize="17" FontWeight="SemiBold" Foreground="#2563EB" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </Grid>
        </Border>

        <!-- Основная аналитика: график слева, статусы справа -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" MinWidth="400" />
                <ColumnDefinition Width="1*" MinWidth="248" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource MinimalDashSurfaceStyle}"
                    Margin="0,0,20,0"
                    Padding="18,12"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Отклики по часам"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="Распределение по локальным часам суток"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Style="{StaticResource MinimalSegmentedToolbarBorderStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ряд:"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="4,0,6,0" />
                                <ListBox Style="{StaticResource MinimalChartSeriesListBoxStyle}"
                                         ItemsSource="{Binding ChartSeriesTabs}"
                                         DisplayMemberPath="Title"
                                         SelectedValuePath="Series"
                                         SelectedValue="{Binding SelectedChartSeries, Mode=TwoWay}" />
                                <Button Style="{StaticResource MinimalSegmentedOutlineButtonStyle}"
                                        Content="По дням"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Подробная статистика по календарным дням" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="ChartActivityHost"
                            Grid.Row="1"
                            Margin="-18,0,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Loaded="ChartActivityHost_OnLoaded"
                            SizeChanged="ChartActivityHost_OnSizeChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Height="168"
                                  Margin="0,0,4,20"
                                  VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Text="·" />
                                <TextBlock Grid.Row="1" Text=" " />
                                <TextBlock Grid.Row="2" Text=" " />
                                <TextBlock Grid.Row="3" Text="0" FontSize="9" Foreground="#94A3B8" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Style="{StaticResource MinimalAnalyticsPlotAreaStyle}"
                                        Padding="0,6,6,6"
                                        VerticalAlignment="Top">
                                    <Grid Height="156">
                                        <UniformGrid Rows="4" Columns="1" Opacity="0.9">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="Transparent" Background="Transparent" />
                                        </UniformGrid>
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#64748B"
                                                   Margin="0,0,4,0"
                                                   Opacity="0.45"
                                                   SnapsToDevicePixels="True" />
                                        <ItemsControl ItemsSource="{Binding Activity}"
                                                      Margin="0,0,4,3"
                                                      VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="146"
                                                          Margin="1,0"
                                                          VerticalAlignment="Bottom"
                                                          ToolTipService.InitialShowDelay="200"
                                                          ToolTipService.ShowDuration="60000">
                                                        <Grid.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{Binding ChartTooltip}" TextWrapping="Wrap" MaxWidth="320" FontSize="12" />
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <TextBlock Text="{Binding ChartDisplayValue}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Top"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding ChartDisplayValue, Converter={StaticResource ZeroToCollapsedConverter}}" />
                                                        <Border Width="18"
                                                                Height="{Binding ChartBarHeight}"
                                                                MinHeight="3"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,0,0,3"
                                                                CornerRadius="5,5,2,2"
                                                                Background="{Binding ChartBarFillHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                                SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Activity}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,6,0"
                                              Height="18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="18" ClipToBounds="False">
                                                <Border Width="1"
                                                        Height="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,0,0"
                                                        Background="#94A3B8"
                                                        SnapsToDevicePixels="True" />
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Недельная динамика: та же сетка оси Y + plot-area, что у почасового графика -->
                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Динамика за неделю"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="Отклики по дням за последние 7 дней"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="-18,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Height="168"
                                  Margin="0,0,4,20"
                                  VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Text="·" />
                                <TextBlock Grid.Row="1" Text=" " />
                                <TextBlock Grid.Row="2"
                                           Text="0"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Style="{StaticResource MinimalAnalyticsPlotAreaStyle}"
                                        Padding="0,6,6,6"
                                        VerticalAlignment="Top">
                                    <Grid Height="156">
                                        <UniformGrid Rows="3" Columns="1" Opacity="0.9">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="Transparent" />
                                            <Border BorderBrush="Transparent" Background="Transparent" />
                                        </UniformGrid>
                                        <Rectangle Height="2"
                                                   VerticalAlignment="Bottom"
                                                   Fill="#64748B"
                                                   Margin="0,0,4,0"
                                                   Opacity="0.45"
                                                   SnapsToDevicePixels="True" />
                                        <ItemsControl ItemsSource="{Binding WeeklyActivity}"
                                                      Margin="0,0,4,3"
                                                      VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="130"
                                                          Margin="1,0"
                                                          VerticalAlignment="Bottom"
                                                          ToolTipService.InitialShowDelay="200"
                                                          ToolTipService.ShowDuration="60000">
                                                        <Grid.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock Text="{Binding ChartTooltip}" TextWrapping="Wrap" MaxWidth="280" FontSize="11" />
                                                            </ToolTip>
                                                        </Grid.ToolTip>
                                                        <Border Width="14"
                                                                Height="{Binding ChartBarHeight}"
                                                                MinHeight="3"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,0,0,3"
                                                                CornerRadius="5,5,2,2"
                                                                Background="{Binding ChartBarFillHex, Converter={StaticResource HexColorToBrushConverter}}"
                                                                SnapsToDevicePixels="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding WeeklyActivity}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,6,0"
                                              Height="18">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="18" ClipToBounds="False">
                                                <Border Width="1"
                                                        Height="5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="#94A3B8"
                                                        SnapsToDevicePixels="True" />
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="44,6,10,6"
                            HorizontalAlignment="Stretch"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="Сводка:" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="всего {0} · CRM {1} · дубли {2} · ошибки {3}">
                                        <Binding Path="TotalToday" />
                                        <Binding Path="SentToCrm" />
                                        <Binding Path="Duplicates" />
                                        <Binding Path="Errors" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#E8EAED"
                    CornerRadius="14"
                    Padding="10"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Требуют внимания"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,8"
                                       Text="Объявления и CRM"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Дубликаты" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Duplicates}" FontSize="13" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Нужны действия" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionRequired}" FontSize="13" FontWeight="SemiBold" Foreground="#C2410C" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Черновики" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DraftsCount}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Заблокировано" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BlockedAdsCount}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" />
                            </Grid>
                            <Button HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Content="Разобрать"
                                    Command="{Binding GoToAttentionProblemsCommand}"
                                    ToolTip="Открыть мониторинг: отклики «Нужны действия», сортировка по статусу" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Avito"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,2,0,8"
                                       Text="Активные объявления"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Активные" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveAds.Count}" FontSize="13" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Просмотры" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalActiveViews}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сообщения" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TotalActiveContacts}" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Заблокированные" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BlockedAdsCount}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Черновики" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DraftsCount}" FontSize="13" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MinimalAnalyticsRailCardStyle}"
                            Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Балансы"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:N2} ₽}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#059669"
                                       Margin="0,0,0,4" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding AccountBalances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3"
                                                  Cursor="Hand">
                                                <Grid.InputBindings>
                                                    <MouseBinding Command="{Binding DataContext.OpenBalanceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  MouseAction="LeftClick" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding AccountName}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding TotalBalanceDisplay}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#059669" />
                                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Height="3"
                                                        CornerRadius="2"
                                                        Background="#E2E8F0"
                                                        Margin="0,2,0,0">
                                                    <Border Width="{Binding BarWidth, Converter={x:Static conv:FactorToWidthConverter.Instance}, ConverterParameter=200}"
                                                            Background="#059669"
                                                            CornerRadius="2"
                                                            HorizontalAlignment="Left"
                                                            SnapsToDevicePixels="True" />
                                                </Border>
                                                <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                              Margin="0,1,0,0"
                                                              ItemsSource="{Binding SubProfiles}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding SubProfileLine}"
                                                                       Margin="0,0,6,0"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="AdsSectionHost"
                Grid.Row="2"
                Style="{StaticResource MinimalDashSurfaceStyle}"
                Margin="0,18,0,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Loaded="AdsSectionHost_OnLoaded"
                SizeChanged="AdsSectionHost_OnSizeChanged">
            <Grid HorizontalAlignment="Stretch"
                  Background="{StaticResource DashBgBrush}"
                  TextElement.FontFamily="Segoe UI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок и компактные метрики в одной зоне (перенос на узком окне) -->
                <Border Grid.Row="0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        Padding="0,0,0,0"
                        Margin="0,0,0,0">
                    <WrapPanel Margin="14,10,14,8"
                               VerticalAlignment="Center"
                               Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,4">
                        <TextBlock Text="Объявления на Avito"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="2,0,4,0" />
                        <TextBlock Text="сводка по аккаунтам"
                                   Style="{StaticResource SubtleTextStyle}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,4">
                        <Border Background="#ECFDF5"
                                BorderBrush="#D1FAE5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7,3"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Активные объявления">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Активные"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ActiveAds.Count}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#15803D"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Заблокированные объявления">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Заблок."
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding BlockedAdsCount}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrorBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF7ED"
                                BorderBrush="#FDBA74"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Черновики">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Черновики"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DraftsCount}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DashCardBrush}"
                                BorderBrush="{StaticResource DashBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Просмотры по активным объявлениям">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Просмотры"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TotalActiveViews}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DashCardBrush}"
                                BorderBrush="{StaticResource DashBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                ToolTip="Сообщения по активным объявлениям">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Сообщения"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding TotalActiveContacts}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2563EB"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </WrapPanel>
                </Border>

                <!-- Фильтры, поиск, сортировка -->
                <Border Grid.Row="1"
                        Padding="8,2,8,6"
                        BorderBrush="{StaticResource DashBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent">
                    <Grid MinHeight="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Row="0"
                                 Grid.RowSpan="2"
                                 Grid.Column="0"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"
                                 PreviewMouseWheel="AdsFilterListBox_OnPreviewMouseWheel"
                                 Style="{StaticResource MinimalAdsFilterListBoxStyle}"
                                 ItemsSource="{Binding AdsFilterTabs}"
                                 SelectedValue="{Binding SelectedAdsFilter, Mode=TwoWay}"
                                 SelectedValuePath="Filter">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe UI"
                                               FontSize="13"
                                               Foreground="{StaticResource DashTextPrimaryBrush}"
                                               Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,12,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Поиск" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource FilterToolbarLabelStyle}"
                                   Text="Сортировка" />
                        <Grid Grid.Row="1"
                              Grid.Column="1"
                              Width="260"
                              Margin="0,0,12,0"
                              MinHeight="{StaticResource FilterControlMinHeight}"
                              VerticalAlignment="Stretch">
                            <TextBox x:Name="AdsSearchTextBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     ToolTip="Поиск по названию, городу, ID объявления или тексту статуса"
                                     Text="{Binding AdsSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="Название, город, ID или статус">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FilterSearchWatermarkStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=AdsSearchTextBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=AdsSearchTextBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="2"
                                  Width="200"
                                  VerticalAlignment="Stretch"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  ItemsSource="{Binding AdsSortChoices}"
                                  SelectedValuePath="Option"
                                  SelectedValue="{Binding SelectedAdsSort, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdsSortChoice}">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Список объявлений (прокрутка только здесь) -->
                <Grid Grid.Row="2"
                      Margin="0,2,0,12"
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,12"
                               FontSize="13"
                               FontStyle="Italic"
                               Foreground="{StaticResource DashTextSecondaryBrush}"
                               Text="Нет объявлений по выбранному фильтру и поиску. Проверьте аккаунт Avito или обновите данные."
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowStandardAdsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ListBox x:Name="AdsListListBox"
                             Grid.Row="1"
                             MinHeight="200"
                             Padding="0,0,4,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             PreviewMouseWheel="AdsListListBox_OnPreviewMouseWheel"
                             SizeChanged="AdsListListBox_OnSizeChanged"
                             ItemsSource="{Binding DisplayedAdsView}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel SpacingMode="Uniform"
                                                           StretchItems="False"
                                                           IsGridLayoutEnabled="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="{Binding DataContext.ActiveAdsTileWidth, ElementName=DashboardRoot}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DashboardAdDisplayItem}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="3"
                                                Margin="0,0,0,0"
                                                VerticalAlignment="Stretch"
                                                Background="#93C5FD"
                                                Opacity="0.85"
                                                CornerRadius="1,0,0,1"
                                                Visibility="{Binding HasUnreadMessages, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Grid.Column="1"
                                                HorizontalAlignment="Stretch">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource DashboardAdCardBorderStyle}" TargetType="Border" />
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Ad}"
                                                              MouseAction="LeftClick" />
                                            </Border.InputBindings>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding Ad.Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding Ad.Title}" />
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Margin="7,0,0,0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="просм."
                                                               FontSize="9"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Ad.Views}"
                                                               FontSize="13"
                                                               FontWeight="Normal"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Active}">
                                                                        <Setter Property="Foreground" Value="#15803D" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,2,0,0"
                                                            Orientation="Horizontal"
                                                            Visibility="{Binding ShowAnyBadgeRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border Padding="5,2"
                                                            CornerRadius="6"
                                                            Margin="0,0,5,0"
                                                            Visibility="{Binding ShowPrimaryStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#DCFCE7" />
                                                                <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Blocked}">
                                                                        <Setter Property="Background" Value="#FEE2E2" />
                                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Draft}">
                                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Messages}">
                                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.NeedsAction}">
                                                                        <Setter Property="Background" Value="#FFEDD5" />
                                                                        <Setter Property="BorderBrush" Value="#FDBA74" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusBadgeCaption}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#166534" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Blocked}">
                                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Draft}">
                                                                            <Setter Property="Foreground" Value="#4B5563" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.Messages}">
                                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PrimaryBadgeKind}" Value="{x:Static vm:DashboardAdBadgeKind.NeedsAction}">
                                                                            <Setter Property="Foreground" Value="#C2410C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Padding="4,1"
                                                            CornerRadius="4"
                                                            Background="#F1F5F9"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Visibility="{Binding ShowMessageCountPill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding MessageCountPillText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#6B7280"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1} · id {2}">
                                                            <Binding Path="Ad.City" />
                                                            <Binding Path="Ad.Status" />
                                                            <Binding Path="Ad.Id" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Row="3"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#B91C1C"
                                                           Text="{Binding Ad.DeleteDate}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DashboardAdKind.Blocked}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="4"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap">
                                                    <Hyperlink Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Ad}">
                                                        <Run Text="Avito" />
                                                    </Hyperlink>
                                                    <Run Text="  ·  "
                                                         Foreground="#94A3B8" />
                                                    <Hyperlink Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Run Text="Отклики" />
                                                    </Hyperlink>
                                                    <Run Text="  ·  "
                                                         Foreground="#94A3B8" />
                                                    <Hyperlink Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Run Text="Статистика" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
