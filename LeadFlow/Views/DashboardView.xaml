<UserControl x:Class="LeadFlow.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters">
    <UserControl.Resources>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <TextBlock Text="Статистика" FontSize="22" FontWeight="SemiBold" />
            <UniformGrid Columns="4" Margin="0,16,0,0">
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Новых откликов" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding NewResponses}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Перейти к мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Всего за сегодня" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding TotalToday}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Перейти к мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Отправлено в CRM" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding SentToCrm}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Открыть журнал" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="В обработке" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding InProgress}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Перейти к мониторингу" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Дубликаты" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding Duplicates}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Открыть журнал" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Ошибки" Style="{StaticResource SubtleTextStyle}"/>
                        <TextBlock Text="{Binding Errors}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="Открыть журнал" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource StatCardButtonStyle}"
                        Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel>
                        <TextBlock Text="Аккаунтов подключено" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ConnectedAccounts}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding RequiresAuthorization, StringFormat=Требует авторизации: {0}}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   Visibility="{Binding RequiresAuthorization, Converter={StaticResource ZeroToCollapsedConverter}}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Открыть настройки" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Динамика за сегодня" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Activity}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="4">
                                        <Rectangle Height="{Binding SentCount}" Width="18" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="Краткая сводка" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalToday, StringFormat=Всего откликов: {0}}" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding SentToCrm, StringFormat=Успешно отправлено: {0}}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Duplicates, StringFormat=Дубликаты: {0}}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Errors, StringFormat=Ошибки: {0}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 🟢 Активные объявления Авито (Детальный список) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🟢 Активные объявления" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="#DCFCE7" CornerRadius="8" Padding="6,2" Margin="8,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveAds.Count}" FontWeight="Bold" Foreground="#166534" FontSize="14" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding TotalActiveViews, StringFormat='Просмотры: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" FontSize="13" />
                    <TextBlock Text="{Binding TotalActiveContacts, StringFormat='Контакты: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />

                    <ListBox ItemsSource="{Binding ActiveAds}"
                             MaxHeight="350"
                             Margin="0,12,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="12" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding City}" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👁 " FontSize="12" />
                                            <TextBlock Text="{Binding Views}" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" />
                                            <TextBlock Text="📞 " FontSize="12" />
                                            <TextBlock Text="{Binding Contacts}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние для активных -->
                    <TextBlock Text="Активных объявлений нет" Foreground="#64748B" FontStyle="Italic" Margin="0,8,0,0"
                               Visibility="{Binding ActiveAds.Count, Converter={StaticResource ZeroToCollapsedConverter}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>

            <!-- 🔴 Заблокированные и 🟡 Черновики (Только счётчики) -->
            <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="12" Padding="16" BorderBrush="#FECACA" BorderThickness="1">
            <StackPanel>
            <TextBlock Text="🔴 Заблокировано" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding BlockedAdsCount}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0" />
            </StackPanel>
            </Border>

        <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="12" Padding="16" BorderBrush="#FEF08A" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🟡 Черновики" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding DraftsCount}" FontSize="28" FontWeight="Bold" Foreground="#CA8A04" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
        </StackPanel>
    </Border>
</UserControl>
