<UserControl x:Class="LeadFlow.Views.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LeadFlow.Converters">
    <UserControl.Resources>
        <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,6" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock Text="Отклики и CRM" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Text=" · "
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="2,0,2,0" />
                    <TextBlock Text="Счётчики за сегодня, динамика и сводка"
                               Style="{StaticResource SubtleTextStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <UniformGrid Rows="1" Columns="7" Margin="0,6,0,0">
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Новых откликов"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding NewResponses}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Всего за сегодня"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalToday}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="В CRM"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Отправлено в CRM" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SentToCrm}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="Логи"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource StatCardButtonStyle}"
                            Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="В обработке"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InProgress}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenJournalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDuplicatesAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FFF7ED" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Дубликаты"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Duplicates}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="Логи"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenMonitoringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActionRequiredAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FFF7ED" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Нужны действия"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Отложена отправка в CRM или контакт без сделки" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ActionRequired}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="К мониторингу"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountsNeedAttention}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="#FEF2F2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Аккаунты"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           ToolTip="Аккаунтов подключено" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectedAccounts}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding RequiresAuthorization, StringFormat=Требует авторизации: {0}}"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding RequiresAuthorization, Converter={StaticResource ZeroToCollapsedConverter}}"
                                       Margin="0,1,0,0" />
                            <TextBlock Grid.Row="2"
                                       Text="Настройки"
                                       Style="{StaticResource StatLinkTextStyle}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </Grid>
                    </Button>
                </UniformGrid>

                <Border x:Name="ChartActivityHost"
                        Style="{StaticResource CompactCardBorderStyle}"
                        Margin="2,6,2,0"
                        Padding="8,6"
                        Loaded="ChartActivityHost_OnLoaded"
                        SizeChanged="ChartActivityHost_OnSizeChanged">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="Динамика за сегодня"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="По дням — графики"
                                    Margin="10,0,0,0"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Command="{Binding DataContext.OpenStatisticsHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Подробная статистика по календарным дням" />
                        </StackPanel>
                        <Grid Margin="0,2,0,0" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <!-- Базовая линия общая для всех столбиков — сразу под ними, без зазора -->
                            <Grid Grid.Row="0">
                                <Rectangle Height="2"
                                           VerticalAlignment="Bottom"
                                           Fill="#94A3B8"
                                           HorizontalAlignment="Stretch"
                                           SnapsToDevicePixels="True" />
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="72"
                                                  Margin="2,0"
                                                  ToolTipService.InitialShowDelay="200"
                                                  ToolTipService.ShowDuration="60000">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding ChartTooltip}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="320"
                                                                   FontSize="12" />
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Rectangle Height="{Binding ChartBarHeight}"
                                                           Width="14"
                                                           Fill="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding Activity}"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.ActivityChartColumns, ElementName=DashboardRoot}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" ClipToBounds="False">
                                            <!-- Штрих вверх к столбику, визуально из одной линейки с базой -->
                                            <Border Width="1.5"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,0,0"
                                                    Background="#475569"
                                                    SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       Margin="0,0,0,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CompactCardBorderStyle}"
                        Margin="2,6,2,0"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Динамика за неделю"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <Grid Margin="0,2,0,0" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Rectangle Height="2"
                                           VerticalAlignment="Bottom"
                                           Fill="#94A3B8"
                                           HorizontalAlignment="Stretch"
                                           SnapsToDevicePixels="True" />
                                <ItemsControl ItemsSource="{Binding WeeklyActivity}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="72"
                                                  Margin="2,0"
                                                  ToolTipService.InitialShowDelay="200"
                                                  ToolTipService.ShowDuration="60000">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding ChartTooltip}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="320"
                                                                   FontSize="12" />
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Rectangle Height="{Binding ChartBarHeight}"
                                                           Width="14"
                                                           Fill="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding WeeklyActivity}"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="26" ClipToBounds="False">
                                            <Border Width="1.5"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,0,0"
                                                    Background="#475569"
                                                    SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Margin="0,0,0,1" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DetailSectionBorderStyle}" Margin="2,6,2,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="Краткая сводка" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="Всего: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalToday}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="В CRM: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SentToCrm}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <TextBlock Text="Дубликаты: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Duplicates}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Ошибки: " Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Errors}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CompactCardBorderStyle}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Объявления на Avito" Style="{StaticResource SectionHeaderTextStyle}" />

                <StackPanel Orientation="Horizontal" Margin="{StaticResource CardInnerGap}" VerticalAlignment="Center">
                    <TextBlock Text="Активные" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#DCFCE7" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveAds.Count}" FontWeight="Bold" Foreground="#166534" FontSize="12" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalActiveViews, StringFormat=Просмотры: {0}}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" · "
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalActiveContacts, StringFormat=Контакты: {0}}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="{StaticResource CardInnerGap}">
                    <ListBox ItemsSource="{Binding ActiveAds}"
                             MinHeight="120"
                             MaxHeight="280"
                             Margin="0"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenAdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch">
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="6,5" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding City}"
                                                           Foreground="#64748B"
                                                           FontSize="11"
                                                           Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="6,0,0,0">
                                                <TextBlock Text="Просм. " FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding Views}" FontSize="10" Foreground="#64748B" Margin="0,0,4,0" />
                                                <TextBlock Text="Конт. " FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding Contacts}" FontSize="10" Foreground="#64748B" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Нет активных объявлений. Проверьте аккаунт Avito или обновите данные на главной."
                               Style="{StaticResource CaptionTextStyle}"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="{StaticResource CardInnerGap}"
                               Visibility="{Binding ActiveAds.Count, Converter={StaticResource ZeroToCollapsedConverter}, ConverterParameter=Invert}" />
                </StackPanel>

                <Grid Margin="{StaticResource SectionSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="10" Padding="12,10" Margin="4,0,4,0" BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Заблокировано" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BlockedAdsCount}" Style="{StaticResource StatValueTextStyle}" Foreground="{StaticResource ErrorBrush}" Margin="{StaticResource TightSpacing}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFBEB" CornerRadius="10" Padding="12,10" Margin="4,0,4,0" BorderBrush="#FEF08A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Черновики" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DraftsCount}" Style="{StaticResource StatValueTextStyle}" Foreground="{StaticResource WarningBrush}" Margin="{StaticResource TightSpacing}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
