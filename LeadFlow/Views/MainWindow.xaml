<Window x:Class="LeadFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LeadFlow.Views"
        Title="LeadFlow"
        Width="1400"
        Height="960"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="64" Height="64" Source="{StaticResource LeadFlowIcon}" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="LeadFlow" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatus, Converter={StaticResource StatusToBrushConverter}}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <UniformGrid Rows="1" Columns="6" Margin="0,0,0,10">
                            <StackPanel Margin="6">
                                <Button Content="1" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenMonitoringCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Мониторинг откликов" />
                                <TextBlock Text="Мониторинг" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Button Content="2" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenCandidateDetailsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Карточка отклика" />
                                <TextBlock Text="Карточка" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Button Content="3" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenDuplicateCheckCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Проверка дублей" />
                                <TextBlock Text="Дубли" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Button Content="4" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenBitrixIntegrationCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Интеграция с Bitrix24" />
                                <TextBlock Text="Bitrix24" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Button Content="5" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenJournalCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Журнал и база" />
                                <TextBlock Text="Журнал" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6">
                                <Button Content="6" Style="{StaticResource RoundNavButtonStyle}" Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Настройки" />
                                <TextBlock Text="Настройки" Style="{StaticResource SubtleTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Запустить мониторинг" Command="{Binding StartMonitoringCommand}" />
                            <Button Content="Остановить" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" Command="{Binding StopMonitoringCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <views:DashboardView Grid.Row="1" DataContext="{Binding Dashboard}" />
        </Grid>
    </ScrollViewer>
</Window>
