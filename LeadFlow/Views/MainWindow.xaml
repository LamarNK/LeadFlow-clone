<Window x:Class="LeadFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LeadFlow.Views"
        Title="LeadFlow"
        Icon="/Assets/LeadFlowWindowIcon.png"
        Width="1400"
        Height="960"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="64" Height="64" Source="{StaticResource LeadFlowIcon}" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                MaxWidth="720">
                        <TextBlock Text="LeadFlow" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatus, Converter={StaticResource StatusToBrushConverter}}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SystemStatusDetails}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemStatusDetails}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,10">
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenMonitoringCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть мониторинг откликов">
                                <StackPanel>
                                    <Button Content="1" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Мониторинг"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenJournalCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть журнал и базу">
                                <StackPanel>
                                    <Button Content="2" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Журнал"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть настройки">
                                <StackPanel>
                                    <Button Content="3" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Настройки"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="{Binding MonitoringActionText}" Command="{Binding ToggleMonitoringCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True">
                                                <Setter Property="Background" Value="#E2E8F0" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <views:DashboardView Grid.Row="1" DataContext="{Binding Dashboard}" />
        </Grid>
    </ScrollViewer>
</Window>
