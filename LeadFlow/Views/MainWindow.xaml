<Window x:Class="LeadFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LeadFlow.Views"
        xmlns:models="clr-namespace:LeadFlow.Models"
        Title="LeadFlow"
        Icon="/Assets/LeadFlowWindowIcon.png"
        Width="1080"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource MinimalShellHeaderBorderStyle}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Width="32"
                               Height="32"
                               VerticalAlignment="Center"
                               Source="{StaticResource LeadFlowIcon}"
                               Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="LeadFlow"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <StackPanel Margin="0,7,0,0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ShowDuration="60000">
                                <StackPanel.ToolTip>
                                    <ToolTip MaxWidth="360">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="#334155">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Мониторинг сейчас не выполняет проверку новых откликов" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True">
                                                                <Setter Property="Text" Value="Мониторинг выполняет проверку новых откликов" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SystemStatus}" Value="{x:Static models:MonitoringStatus.Error}">
                                                                <Setter Property="Text" Value="Мониторинг требует внимания" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding SystemStatusDetails}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding NextMonitoringCycleHint}" />
                                        </StackPanel>
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             SnapsToDevicePixels="True">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#D4A27C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True">
                                                        <Setter Property="Fill" Value="#6B9B76" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SystemStatus}" Value="{x:Static models:MonitoringStatus.Error}">
                                                        <Setter Property="Fill" Value="#C56A6A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontWeight="Normal"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="{Binding SystemStatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9A7B68" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SystemStatus}" Value="{x:Static models:MonitoringStatus.Error}">
                                                        <Setter Property="Foreground" Value="#A84848" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- Текущий шаг цикла (как средний блок тултипа), виден сразу под статусом -->
                                <TextBlock Margin="13,2,0,0"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           Text="{Binding SystemStatusDetails}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SystemStatusDetails, Converter={StaticResource IsNullOrEmptyConverter}}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MinimalShellNavButtonStyle}"
                                    Command="{Binding OpenMonitoringCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Мониторинг откликов">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z"
                                              Fill="#64748B"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Text="Мониторинг"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MinimalShellNavButtonStyle}"
                                    Command="{Binding OpenJournalCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Системные логи">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M18 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 4h5v8l-2.5-1.5L6 12V4z"
                                              Fill="#64748B"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Text="Логи"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MinimalShellNavButtonStyle}"
                                    Command="{Binding OpenStatisticsHistoryCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Статистика по дням">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M3 13h2v8H3v-8zm4-6h2v14H7V7zm4-4h2v18h-2V3zm4 8h2v10h-2V11zm4-3h2v13h-2V8z"
                                              Fill="#64748B"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Text="Статистика"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MinimalShellNavButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Настройки">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22l-1.92 3.32c-.12.22-.07.49.12.64l2.03 1.58c-.05.3-.07.63-.07.97 0 .33.02.65.07.97l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.03.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z"
                                              Fill="#64748B"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                    <TextBlock Text="Настройки"
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Rectangle Width="1"
                                   Height="28"
                                   Margin="14,0,14,0"
                                   VerticalAlignment="Center"
                                   Fill="#E2E8F0" />
                        <Button Command="{Binding ToggleMonitoringCommand}"
                                ToolTip="{Binding MonitoringActionText}"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MinimalStartMonitoringButtonStyle}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Path Data="M8 5v14l11-7z"
                                                              Fill="White"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding IsMonitoringRunning, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                                        <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                                              Fill="White"
                                                              Stretch="Uniform"
                                                              Visibility="{Binding IsMonitoringRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Viewbox>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MonitoringButtonText}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="15" />
                                                    <TextBlock Text="{Binding MonitoringActionText}"
                                                               Foreground="#E0F2FE"
                                                               FontSize="11"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                                                  Fill="#B91C1C"
                                                                  Stretch="Uniform" />
                                                        </Viewbox>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MonitoringButtonText}"
                                                                       Foreground="#B91C1C"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="15" />
                                                            <TextBlock Text="{Binding MonitoringActionText}"
                                                                       Foreground="#991B1B"
                                                                       FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <views:DashboardView Grid.Row="1"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Top"
                                 DataContext="{Binding Dashboard}" />
        </Grid>
    </ScrollViewer>
</Window>
