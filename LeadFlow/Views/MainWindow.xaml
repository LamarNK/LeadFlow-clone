<Window x:Class="LeadFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LeadFlow.Views"
        Title="LeadFlow"
        Icon="/Assets/LeadFlowWindowIcon.png"
        Width="1400"
        Height="960"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        StateChanged="MainWindow_StateChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="64" Height="64" Source="{StaticResource LeadFlowIcon}" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                MaxWidth="720">
                        <TextBlock Text="LeadFlow" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatus, Converter={StaticResource StatusToBrushConverter}}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SystemStatusDetails}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemStatusDetails}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenMonitoringCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть мониторинг откликов">
                                <StackPanel>
                                    <Button Content="1" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Мониторинг"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenJournalCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть журнал и базу">
                                <StackPanel>
                                    <Button Content="2" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Журнал"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding OpenSettingsCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Открыть настройки">
                                <StackPanel>
                                    <Button Content="3" Style="{StaticResource RoundNavButtonStyle}" IsHitTestVisible="False" />
                                    <TextBlock Text="Настройки"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <!-- Play/Pause indicator button -->
                            <Button Style="{StaticResource NavItemButtonStyle}"
                                    Command="{Binding ToggleMonitoringCommand}"
                                    ToolTip="{Binding MonitoringActionText}">
                                <StackPanel>
                                    <!-- Round button with icon - same size as 1/2/3 buttons -->
                                    <Button Style="{StaticResource RoundNavButtonStyle}"
                                            Background="{StaticResource PrimaryBrush}"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Padding="0">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Play icon when not running -->
                                                <Path Data="M8 5v14l11-7z" 
                                                      Fill="White"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsMonitoringRunning, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                                                <!-- Pause icon when running -->
                                                <Path Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" 
                                                      Fill="White"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding IsMonitoringRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Viewbox>
                                    </Button>
                                    <TextBlock Text="{Binding MonitoringButtonText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <views:DashboardView Grid.Row="1" DataContext="{Binding Dashboard}" />
        </Grid>
    </ScrollViewer>
</Window>
