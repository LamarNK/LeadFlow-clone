                                                   Text="Часовой пояс"
                                                   Visibility="{Binding ShowManualTimezoneField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBox Margin="0,2,0,0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding ShowManualTimezoneField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Отпечаток" Style="{StaticResource SectionTabItemStyle}">
                        <ScrollViewer Padding="0,8,8,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Сетевые и локальные сигналы" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="WebRTC" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding WebRtcModeOptions}"
                                                          SelectedItem="{Binding WebRtcMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Часовой пояс" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding TimezoneModeOptions}"
                                                          SelectedItem="{Binding TimezoneMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowManualTimezoneField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Геолокация" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding GeolocationModeOptions}"
                                                          SelectedItem="{Binding GeolocationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <Grid Visibility="{Binding ShowCustomGeolocationFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Margin="0,0,6,0"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             Text="{Binding GeolocationLatitude, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="0,0,6,0"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             Text="{Binding GeolocationLongitude, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="2"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             Text="{Binding GeolocationAccuracyMeters, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Язык" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding LanguageModeOptions}"
                                                          SelectedItem="{Binding LanguageMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding Languages, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Язык интерфейса" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding UiLanguageModeOptions}"
                                                          SelectedItem="{Binding UiLanguageMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,0"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding CustomUiLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomUiLanguageField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="navigator.platform (пусто — по ОС из UA)" />
                                        <TextBox Margin="0,2,0,0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding NavigatorPlatform, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0" Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Визуальные сигналы" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Разрешение экрана" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding ScreenModeOptions}"
                                                          SelectedItem="{Binding ScreenMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding ScreenResolution, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowScreenResolutionField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Шрифты" />
