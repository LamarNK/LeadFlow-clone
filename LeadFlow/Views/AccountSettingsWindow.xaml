<Window x:Class="LeadFlow.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeadFlow.ViewModels"
        Title="Настройки аккаунта"
        Width="1080"
        Height="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="AccountWindowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleTextStyle}">
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="AccountSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="AccountSectionTitleFirstStyle" TargetType="TextBlock" BasedOn="{StaticResource AccountSectionTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="AccountHintStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AccountFormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="AccountSettingsGroupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="AccountSettingsGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="ProxyHostPortInnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="UaInlineRegenerateButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAF1FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="OverviewToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="UaPresetToggleStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="248" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Padding="10,8"
                Style="{StaticResource CompactCardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Настройки аккаунта" Style="{StaticResource AccountWindowTitleStyle}" />
                    <TextBlock Style="{StaticResource AccountHintStyle}"
                               Text="Параметры браузера, User-Agent и cookie для выбранного аккаунта Avito. Изменения сохраняются кнопкой «Сохранить»." />
                </StackPanel>
                <TabControl Grid.Row="1"
                            Style="{StaticResource SectionTabControlStyle}"
                            VerticalAlignment="Stretch">
                    <TabItem Header="Общий" Style="{StaticResource SectionTabItemStyle}">
                        <ScrollViewer Padding="0,8,8,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Профиль и браузер" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Имя" Style="{StaticResource AccountFormLabelStyle}" />
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         MaxLength="100"
                                                         Margin="0,0,6,0"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding DisplayNameCounter}" />
                                            </Grid>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Браузер" Style="{StaticResource AccountFormLabelStyle}" />
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="140" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" MinWidth="108" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Padding="10,6"
                                                        Background="{StaticResource CardBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding CurrentBrowserName}" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Padding="10,6"
                                                        Background="{StaticResource CardBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding CurrentBrowserVersion}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Система (для User-Agent)" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <TextBlock Margin="0,-4,0,8"
                                                   Style="{StaticResource AccountHintStyle}"
                                                   Text="Пять колонок в одну строку: ОС и версия." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <CheckBox Content="Windows"
                                                          FontSize="12"
                                                          IsChecked="{Binding UseWindowsOs, Mode=TwoWay}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          FontSize="12"
                                                          IsEnabled="{Binding UseWindowsOs}"
                                                          ItemsSource="{Binding WindowsVersionOptions}"
                                                          SelectedItem="{Binding WindowsVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                                <CheckBox Content="macOS"
                                                          FontSize="12"
                                                          IsChecked="{Binding UseMacOs, Mode=TwoWay}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          FontSize="12"
                                                          IsEnabled="{Binding UseMacOs}"
                                                          ItemsSource="{Binding MacOsVersionOptions}"
                                                          SelectedItem="{Binding MacOsVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                                <CheckBox Content="Linux"
                                                          FontSize="12"
                                                          IsChecked="{Binding UseLinuxOs, Mode=TwoWay}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          FontSize="12"
                                                          IsEnabled="{Binding UseLinuxOs}"
                                                          ItemsSource="{Binding LinuxVersionOptions}"
                                                          SelectedItem="{Binding LinuxVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,4,0">
                                                <CheckBox Content="Android"
                                                          FontSize="12"
                                                          IsChecked="{Binding UseAndroidOs, Mode=TwoWay}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          FontSize="12"
                                                          IsEnabled="{Binding UseAndroidOs}"
                                                          ItemsSource="{Binding AndroidVersionOptions}"
                                                          SelectedItem="{Binding AndroidVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="0,0,0,0">
                                                <CheckBox Content="iOS"
                                                          FontSize="12"
                                                          IsChecked="{Binding UseIosOs, Mode=TwoWay}" />
                                                <ComboBox Margin="0,4,0,0"
                                                          FontSize="12"
                                                          IsEnabled="{Binding UseIosOs}"
                                                          ItemsSource="{Binding IosVersionOptions}"
                                                          SelectedItem="{Binding IosVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="User-Agent" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <TextBlock Margin="0,-4,0,6"
                                                   Style="{StaticResource AccountHintStyle}"
                                                   Text="Пресеты слева, строка справа; иконка — пересобрать UA." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource AccountFormLabelStyle}"
                                                       Text="Строка" />
                                            <Grid Grid.Column="2" MinHeight="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="148" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <ToggleButton x:Name="UaPresetToggle"
                                                                  HorizontalAlignment="Stretch"
                                                                  IsChecked="{Binding IsUaPresetDropdownOpen, Mode=TwoWay}"
                                                                  Style="{StaticResource UaPresetToggleStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       Text="{Binding UaPresetHeaderText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Path Grid.Column="1"
                                                                  Width="10"
                                                                  Height="6"
                                                                  Margin="8,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 5 6 L 10 0"
                                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round" />
                                                        </Grid>
                                                    </ToggleButton>
                                                    <Popup x:Name="UaPresetPopup"
                                                           AllowsTransparency="True"
                                                           Closed="UaPresetPopup_OnClosed"
                                                           IsOpen="{Binding IsUaPresetDropdownOpen, Mode=TwoWay}"
                                                           Placement="Bottom"
                                                           PlacementTarget="{Binding ElementName=UaPresetToggle}"
                                                           StaysOpen="False">
                                                        <Border MinWidth="{Binding ActualWidth, ElementName=UaPresetToggle}"
                                                                Background="#FFFFFF"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                MaxHeight="240">
                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl Margin="0,4" ItemsSource="{Binding UaPresetRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:UaPresetRow}">
                                                                            <CheckBox Margin="10,3,10,3"
                                                                                      Content="{Binding Label}"
                                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="UaAssignedTextBox"
                                                             Grid.Column="0"
                                                             Margin="0,0,6,0"
                                                             Padding="8,5"
                                                             VerticalContentAlignment="Center"
                                                             Style="{StaticResource SearchTextBoxStyle}"
                                                             Text="{Binding AssignedUserAgent, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    <Button Grid.Column="1"
                                                            MinWidth="40"
                                                            VerticalAlignment="Stretch"
                                                            Click="RegenerateUserAgent_OnClick"
                                                            Focusable="False"
                                                            PreviewMouseLeftButtonDown="RegenerateUserAgent_PreviewMouseLeftButtonDown"
                                                            Style="{StaticResource UaInlineRegenerateButtonStyle}"
                                                            ToolTip="Перегенерировать User-Agent">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="15"
                                                                   Foreground="{StaticResource PrimaryBrush}"
                                                                   Text="&#xE8B1;" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cookie" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                            <Button Command="{Binding MergeCookiesWithSavedCommand}"
                                                    Content="Объединить с сохранёнными"
                                                    Style="{StaticResource GhostButtonStyle}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,0,0,5"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding StatusHint}"
                                                   TextWrapping="Wrap" />
                                        <TextBox MinHeight="108"
                                                 Padding="8,6"
                                                 AcceptsReturn="True"
                                                 Background="#FFFFFF"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 BorderThickness="1"
                                                 Text="{Binding CookiesJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Заметки" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <TextBlock Margin="0,-4,0,6"
                                                   Style="{StaticResource AccountHintStyle}"
                                                   Text="Произвольный текст, только для вас." />
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="6,0,0,4"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       Text="{Binding NotesCounter}" />
                                            <TextBox MinHeight="56"
                                                     MaxLength="1500"
                                                     Padding="8,6"
                                                     AcceptsReturn="True"
                                                     Background="#FFFFFF"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"
                                                     Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Прокси" Style="{StaticResource SectionTabItemStyle}">
                        <ScrollViewer Padding="0,8,8,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Border Height="1"
                                            Margin="0,10,0,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Padding="10,0"
                                               VerticalAlignment="Center"
                                               Background="{StaticResource CardBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="Прокси" />
                                </Grid>

                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Подключение" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="112" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="0,0,0,2"
                                                       Style="{StaticResource InfoLabelStyle}"
                                                       Text="Тип" />
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       Grid.ColumnSpan="3"
                                                       Margin="0,0,0,2"
                                                       Style="{StaticResource InfoLabelStyle}"
                                                       Text="Хост:порт" />
                                            <ComboBox Grid.Row="1"
                                                      Grid.Column="0"
                                                      ItemsSource="{Binding ProxyTypeOptions}"
                                                      SelectedItem="{Binding ProxyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource FilterComboBoxStyle}" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="2"
                                                    Background="#FFFFFF"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    MinHeight="34"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Padding="10,6,4,6"
                                                             Style="{StaticResource ProxyHostPortInnerTextBoxStyle}"
                                                             Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text=":" />
                                                    <TextBox Grid.Column="2"
                                                             Padding="4,6,10,6"
                                                             Style="{StaticResource ProxyHostPortInnerTextBoxStyle}"
                                                             Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Button Command="{Binding CheckProxyCommand}"
                                                        Content="Проверить"
                                                        Style="{StaticResource GhostButtonStyle}" />
                                                <Button Command="{Binding RotateProxyIpCommand}"
                                                        Content="Сменить IP"
                                                        Style="{StaticResource GhostButtonStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Margin="0,0,0,2" Style="{StaticResource InfoLabelStyle}" Text="Логин" />
                                                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,2" Style="{StaticResource InfoLabelStyle}" Text="Пароль" />
                                                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding ProxyPassword, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource InfoLabelStyle}" Text="URL смены IP" />
                                        <TextBox Margin="0,2,0,6"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding ProxyRotationUrl, UpdateSourceTrigger=PropertyChanged}" />

                                        <StackPanel Visibility="{Binding ShowProxyCheckFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                       Text="Запрос внешнего IP…"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsProxyChecking, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding ProxyCheckResultText}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsProxyChecking, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource SubtleTextStyle}" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProxyCheckIsError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,10">
                                    <Border Height="1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BorderBrush}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               Padding="10,0"
                                               Background="{StaticResource CardBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="Шаблоны прокси" />
                                </Grid>
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource AccountHintStyle}"
                                           Text="Быстрая подстановка в текущий прокси." />
                                <Button Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddProxyPresetCommand}"
                                        Content="Добавить шаблон"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <ItemsControl ItemsSource="{Binding ProxyPresets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProxyPresetRowViewModel}">
                                            <Border Margin="0,0,0,8"
                                                    Padding="10,8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Orientation="Horizontal">
                                                            <Button Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.ApplyProxyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Применить"
                                                                    Style="{StaticResource GhostButtonStyle}" />
                                                            <Button Command="{Binding DataContext.RemoveProxyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Удалить"
                                                                    Style="{StaticResource GhostButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="108" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
