                                                                  ItemsSource="{Binding DataContext.ProxyTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding ProxyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource FilterComboBoxStyle}" />
                                                        <TextBox Grid.Column="2"
                                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                    <Grid Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Margin="0,0,0,1" Style="{StaticResource InfoLabelStyle}" Text="Логин" />
                                                            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Margin="0,0,0,1" Style="{StaticResource InfoLabelStyle}" Text="Пароль" />
                                                            <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,1" Style="{StaticResource InfoLabelStyle}" Text="URL смены IP" />
                                                    <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                             Text="{Binding RotationUrl, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Платформа" Style="{StaticResource SectionTabItemStyle}">
