                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding CustomFonts, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomFontsField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Canvas" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding NoiseModeOptions}"
                                                          SelectedItem="{Binding CanvasMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="WebGL Image" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding WebGlModeOptions}"
                                                          SelectedItem="{Binding WebGlImageMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="AudioContext" />
                                                <ComboBox Margin="0,2,0,0"
                                                          ItemsSource="{Binding NoiseModeOptions}"
                                                          SelectedItem="{Binding AudioMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Медиа-устройства" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding AutoOrCustomModeOptions}"
                                                          SelectedItem="{Binding MediaDevicesMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding MediaDevicesLabel, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomMediaDevicesField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="ClientRects" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding NoiseModeOptions}"
                                                          SelectedItem="{Binding ClientRectsMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="SpeechVoices" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding AutoOrCustomModeOptions}"
                                                          SelectedItem="{Binding SpeechVoicesMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding SpeechVoicesLabel, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomSpeechVoicesField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="WebGL метаданные" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding RealOrCustomModeOptions}"
                                                          SelectedItem="{Binding WebGlMetadataMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <ComboBox Margin="0,0,0,6"
                                                          MaxDropDownHeight="240"
                                                          ItemsSource="{Binding WebGlPresetOptions}"
                                                          SelectedItem="{Binding SelectedWebGlPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}"
                                                          Visibility="{Binding ShowWebGlConfigFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBox Margin="0,0,0,6"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding WebGlVendor, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowWebGlConfigFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBox Margin="0,0,0,8"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding WebGlRenderer, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowWebGlConfigFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="WebGPU" />
                                                <ComboBox Margin="0,2,0,0"
                                                          ItemsSource="{Binding WebGpuModeOptions}"
                                                          SelectedItem="{Binding WebGpuMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0" Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Оборудование и запуск" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="CPU" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding RealOrCustomModeOptions}"
                                                          SelectedItem="{Binding CpuMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding HardwareConcurrencyValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomCpuField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="RAM" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding RealOrCustomModeOptions}"
                                                          SelectedItem="{Binding RamMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding DeviceMemoryValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomRamField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Имя устройства" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding RealOrCustomModeOptions}"
                                                          SelectedItem="{Binding DeviceNameMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding DeviceNameValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomDeviceNameField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="MAC-адрес" />
                                                <ComboBox Margin="0,2,0,6"
                                                          ItemsSource="{Binding RealOrCustomModeOptions}"
                                                          SelectedItem="{Binding MacAddressMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <TextBox Margin="0,0,0,0"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding MacAddressValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowCustomMacField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Do Not Track" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding DntModeOptions}"
                                                          SelectedItem="{Binding DoNotTrackMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <CheckBox Margin="0,0,0,8"
                                                          Content="Защита от сканирования портов"
                                                          IsChecked="{Binding PortScanProtectionEnabled, Mode=TwoWay}" />
                                                <TextBox Margin="0,0,0,8"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding AllowedPortScanPorts, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ShowAllowedPortScanPortsField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="Аппаратное ускорение" />
                                                <ComboBox Margin="0,2,0,8"
                                                          ItemsSource="{Binding HardwareAccelerationModeOptions}"
                                                          SelectedItem="{Binding HardwareAccelerationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource FilterComboBoxStyle}" />
                                                <CheckBox Margin="0,0,0,8"
                                                          Content="Отключить функции TLS"
                                                          IsChecked="{Binding DisableTlsFeatures, Mode=TwoWay}" />
                                                <TextBlock Style="{StaticResource InfoLabelStyle}" Text="WebRTC — флаги Chromium" />
                                                <TextBox Margin="0,2,0,0"
                                                         Style="{StaticResource SearchTextBoxStyle}"
                                                         Text="{Binding WebRtcLaunchFlags, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Дополнительно" Style="{StaticResource SectionTabItemStyle}">
                        <ScrollViewer Padding="0,8,8,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource AccountSettingsGroupBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Аргументы запуска Chromium" Style="{StaticResource AccountSettingsGroupTitleStyle}" />
                                        <TextBlock Margin="0,-4,0,8"
                                                   Style="{StaticResource AccountHintStyle}"
                                                   Text="Дополнительные флаги через пробел; добавляются к прокси и WebRTC, не подменяют их." />
                                        <TextBox MinHeight="120"
                                                 Padding="8,6"
                                                 AcceptsReturn="True"
                                                 Background="#FFFFFF"
                                                 BorderBrush="{StaticResource BorderBrush}"
