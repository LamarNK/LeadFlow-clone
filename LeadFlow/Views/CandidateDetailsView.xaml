<UserControl x:Class="LeadFlow.Views.CandidateDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CompactCardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="3. Карточка отклика" FontSize="22" FontWeight="SemiBold" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ФИО" Margin="0,6"/>
                    <TextBox Grid.Column="1" Text="{Binding CurrentResponse.FullName}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="1" Text="Возраст" Margin="0,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentResponse.Age}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Text="Телефон" Margin="0,6"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentResponse.PhoneRaw}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="3" Text="Город" Margin="0,6"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentResponse.City}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="4" Text="Вакансия" Margin="0,6"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentResponse.Vacancy}" IsReadOnly="True"/>
                    <TextBlock Grid.Row="5" Text="Дата отклика" Margin="0,6"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentResponse.CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" IsReadOnly="True"/>
                </Grid>
                <Border Style="{StaticResource ToolbarSurfaceBorderStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Автоматическое считывание данных" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="При появлении нового отклика данные извлекаются автоматически" Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Margin="14,0,0,0">
                <StackPanel>
                    <TextBlock Text="Источник (предпросмотр)" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentResponse.FullName}" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding CurrentResponse.PhoneRaw}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentResponse.Vacancy}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentResponse.City}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentResponse.SourceUrl}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource SubtleTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
