<Window x:Class="LeadFlow.Views.StatisticsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LeadFlow.Views"
        Title="Статистика по дням"
        Width="1100"
        Height="820"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DashboardPageChromeBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/MinimalDashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <views:StatisticsHistoryView />
    </ScrollViewer>
</Window>
