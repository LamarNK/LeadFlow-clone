<Window x:Class="LeadFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки LeadFlow"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="AccountListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="AccountListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Аккаунты Avito" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           TextWrapping="Wrap"
                           Text="Здесь осталось только управление аккаунтами Avito." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Список аккаунтов" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Каждый аккаунт работает через отдельный браузерный профиль и хранится независимо." Style="{StaticResource SubtleTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}"
                             Style="{StaticResource AccountListBoxStyle}"
                             ItemContainerStyle="{StaticResource AccountListItemStyle}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Text="{Binding LastAuthCheckAt, StringFormat=Проверка: {0:dd.MM.yyyy HH:mm}, TargetNullValue=Проверка: ещё не выполнялась}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Top" />

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                   Text="{Binding LastMonitoringAt, StringFormat=Последний запуск: {0:dd.MM.yyyy HH:mm}, TargetNullValue=Последний запуск: ещё не было}" />

                                        <!-- Toggle switch for Enable/Disable directly in list item -->
                                        <ToggleButton Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Width="44" Height="24"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Border x:Name="SwitchBorder"
                                                                Width="44" Height="24"
                                                                CornerRadius="12"
                                                                Background="#E2E8F0"
                                                                BorderThickness="0" />
                                                        <Ellipse x:Name="SwitchThumb"
                                                                 Width="20" Height="20"
                                                                 Margin="2,0,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Fill="White"
                                                                 RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform X="0" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform X="20" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Карточка аккаунта" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAccountName}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedAccountStateHint}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedAccountStatusText}"
                                   Foreground="{Binding SelectedAccount.Status, Converter={StaticResource StatusToBrushConverter}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Проверка авторизации" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountAuthCheckText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Последний мониторинг" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountMonitoringText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,10" Padding="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Профиль Avito" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding FixedProfileUrl}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="0">
                            <StackPanel>
                                <TextBlock Text="Состояние" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountErrorText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,24,0,0">
                        <Button Content="Добавить аккаунт" Style="{StaticResource ActionButtonStyle}" Command="{Binding AddAccountCommand}" />
                        <Button Content="Удалить аккаунт" Style="{StaticResource GhostButtonStyle}" Command="{Binding DeleteAccountCommand}" />
                        <Button Content="Открыть окно Avito" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenAvitoProfileCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Авторизовать в Avito" Style="{StaticResource ActionButtonStyle}" Command="{Binding AuthorizeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding ShowAuthorizeButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить аккаунты" Command="{Binding SaveCommand}" />
            <Button Content="Закрыть" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
