<Window x:Class="LeadFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки LeadFlow"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Аккаунты Авито">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="140"/>
                            <DataGridTextColumn Header="URL откликов" Binding="{Binding AvitoResponsesUrl}" Width="200"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Включён" Binding="{Binding IsEnabled}" Width="75"/>
                            <DataGridTextColumn Header="Последняя проверка" Binding="{Binding LastAuthCheckAt}" Width="140"/>
                            <DataGridTextColumn Header="Ошибка" Binding="{Binding LastErrorMessage}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Карточка аккаунта" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedAccount.DisplayName}" />
                        <TextBox Text="{Binding SelectedAccount.AvitoResponsesUrl}" />
                        <TextBox Text="{Binding SelectedAccount.BrowserProfilePath}" IsReadOnly="True" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Добавить аккаунт" Command="{Binding AddAccountCommand}" />
                            <Button Content="Удалить аккаунт" Command="{Binding DeleteAccountCommand}" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" />
                            <Button Content="Вкл/Выкл" Command="{Binding ToggleAccountCommand}" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Авторизовать" Command="{Binding AuthorizeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Проверить авторизацию" Command="{Binding CheckAuthorizationCommand}" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Bitrix24">
                <StackPanel Margin="16">
                    <TextBlock Text="Webhook URL" />
                    <TextBox Text="{Binding WebhookUrl}" />
                    <CheckBox Content="Demo mode" IsChecked="{Binding DemoModeEnabled}" Margin="4,12,4,4"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="База данных">
                <StackPanel Margin="16">
                    <TextBlock Text="Путь к SQLite базе" />
                    <TextBox Text="{Binding DatabasePath}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Мониторинг">
                <StackPanel Margin="16">
                    <TextBlock Text="Интервал проверки (сек)" />
                    <TextBox Text="{Binding CheckIntervalSeconds}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Селекторы Авито">
                <StackPanel Margin="16">
                    <TextBlock Text="Селектор списка откликов" />
                    <TextBox Text="{Binding ResponseListSelector}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Логи">
                <StackPanel Margin="16">
                    <TextBlock Text="Логи сохраняются в SQLite и обновляются автоматически из pipeline." />
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Content="Закрыть" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
