<Window x:Class="LeadFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки LeadFlow"
        PreviewDragOver="SettingsWindow_OnPreviewDragOver"
        DragLeave="SettingsWindow_OnDragLeave"
        PreviewKeyDown="SettingsWindow_OnPreviewKeyDown"
        Width="1060"
        Height="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Две колонки * / * + Stretch: одинаковая ширина; без MinWidth — иначе разъезжаются с WrapPanel. -->
        <Style x:Key="SettingsCardPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsCardGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#EAF1FF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="AccountListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="AccountListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CompactCardBorderStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Аккаунты Avito" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SubtleTextStyle}"
                           TextWrapping="Wrap"
                           Text="Добавляйте аккаунты, при необходимости авторизуйтесь на Avito и включайте мониторинг; список сохраняется кнопкой внизу окна." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AccountsListDropCard"
                    AllowDrop="True"
                    Drop="AccountsListDropCard_OnDrop"
                    PreviewDragOver="AccountsListDropCard_OnPreviewDragOver"
                    Style="{StaticResource CompactCardBorderStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Список аккаунтов" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Каждый аккаунт работает через отдельный браузерный профиль и хранится независимо." Style="{StaticResource SubtleTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             AllowDrop="True"
                             Drop="AccountsListDropCard_OnDrop"
                             PreviewDragOver="AccountsListDropCard_OnPreviewDragOver"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}"
                             Style="{StaticResource AccountListBoxStyle}"
                             ItemContainerStyle="{StaticResource AccountListItemStyle}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="AccountsList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ListRowTitleTextStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource SubtleTextStyle}"
                                                   Text="{Binding LastAuthCheckAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=Проверка: {0:dd.MM.yyyy HH:mm}, TargetNullValue=Проверка: ещё не выполнялась}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Top" />

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource SubtleTextStyle}"
                                                   Text="{Binding LastMonitoringAt, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat=Последний запуск: {0:dd.MM.yyyy HH:mm}, TargetNullValue=Последний запуск: ещё не было}" />

                                        <!-- Toggle switch for Enable/Disable directly in list item -->
                                        <ToggleButton Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Width="44" Height="24"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid>
                                                        <Border x:Name="SwitchBorder"
                                                                Width="44" Height="24"
                                                                CornerRadius="12"
                                                                Background="#E2E8F0"
                                                                BorderThickness="0" />
                                                        <Ellipse x:Name="SwitchThumb"
                                                                 Width="20" Height="20"
                                                                 Margin="2,0,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 Fill="White"
                                                                 RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <TranslateTransform X="0" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <TranslateTransform X="20" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CompactCardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Карточка аккаунта" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAccountName}" Style="{StaticResource PageTitleTextStyle}" />
                            <TextBlock Text="{Binding SelectedAccountStateHint}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedAccountStatusText}"
                                   Foreground="{Binding SelectedAccount.Status, Converter={StaticResource StatusToBrushConverter}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Проверка авторизации" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountAuthCheckText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Последний мониторинг" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountMonitoringText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,8" Padding="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Профиль Avito" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding FixedProfileUrl}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="0">
                            <StackPanel>
                                <TextBlock Text="Состояние" Style="{StaticResource InfoLabelStyle}" />
                                <TextBlock Text="{Binding SelectedAccountErrorText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                Command="{Binding AddAccountCommand}"
                                Content="Добавить аккаунт"
                                Style="{StaticResource SettingsCardPrimaryButtonStyle}" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Command="{Binding DeleteAccountCommand}"
                                Content="Удалить аккаунт"
                                Style="{StaticResource SettingsCardGhostButtonStyle}" />
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,6"
                                Command="{Binding OpenAccountSettingsCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Настройки аккаунта"
                                Style="{StaticResource SettingsCardGhostButtonStyle}" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,6"
                                Command="{Binding OpenAvitoProfileCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Открыть окно Avito"
                                Style="{StaticResource SettingsCardGhostButtonStyle}" />
                        <Button Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Command="{Binding AuthorizeCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Авторизовать в Avito"
                                Style="{StaticResource SettingsCardPrimaryButtonStyle}"
                                Visibility="{Binding ShowAuthorizeButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,14,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Command="{Binding ExportProfileArchiveCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Экспорт"
                                    Style="{StaticResource SettingsCardGhostButtonStyle}" />
                            <Button Grid.Column="2"
                                    Command="{Binding ImportProfileArchiveCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Импорт"
                                    Style="{StaticResource SettingsCardGhostButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить аккаунты" Command="{Binding SaveCommand}" />
            <Button Content="Закрыть" Background="#E2E8F0" Foreground="{StaticResource TextBrush}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
