TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token
# Привязка карт к чатам — через Telegram-бота, не через .env
PLUSOFON_API_TOKEN=
# PLUSOFON_CLIENT_ID=10553
PLUSOFON_SMS_FETCH_LIMIT=20
PLUSOFON_SMS_MAX_AGE_MINUTES=15
# Webhook Plusofon (платная опция) — можно не настраивать
PLUSOFON_SECRET=your-plusofon-secret
PLUSOFON_WEBHOOK_VALIDATION=false