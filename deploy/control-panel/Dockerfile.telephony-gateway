FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Orbita.TelephonyGateway/*.csproj Orbita.TelephonyGateway/
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore Orbita.TelephonyGateway/Orbita.TelephonyGateway.csproj

COPY Orbita.TelephonyGateway/ Orbita.TelephonyGateway/
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish Orbita.TelephonyGateway/Orbita.TelephonyGateway.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Orbita.TelephonyGateway.dll"]
