# Orbita Server .env (production)
# cp .env.example .env
# Fill with strong values. Never commit the populated .env file.

REGISTRATION_SECRET=replace-with-a-new-random-secret
JWT_KEY=replace-with-a-new-random-signing-key-at-least-32-bytes
ADMIN_EMAIL=admin@orbita.local
ADMIN_PASSWORD=replace-with-a-new-strong-password

# Add your server IP or domain for CORS if needed
CORS_ORIGIN_0=https://orbitsu.ru
CORS_ORIGIN_1=https://www.orbitsu.ru
CORS_ORIGIN_2=http://163.5.153.207

# Public HTTPS address used by Bitrix24 outgoing webhooks.
BITRIX_WORKFORCE_PUBLIC_BASE_URL=https://api.orbitsu.ru
BITRIX_WORKFORCE_WORKER_INTERVAL_SECONDS=5
BITRIX_WORKFORCE_BATCH_SIZE=50
BITRIX_WORKFORCE_LEASE_SECONDS=300

# Optional isolated telephony ingress. The service is disabled unless the
# "telephony" Docker Compose profile is explicitly enabled.
TELEPHONY_GATEWAY_PUBLIC_BASE_URL=
# Generate exactly 32 random bytes and encode them as Base64.
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Linux: openssl rand -base64 32
TELEPHONY_GATEWAY_QUEUE_KEY=
TELEPHONY_GATEWAY_MAX_QUEUE_ITEMS=100000
TELEPHONY_GATEWAY_MAX_QUEUE_BYTES=10737418240
TELEPHONY_GATEWAY_MAX_BODY_BYTES=110100480
TELEPHONY_GATEWAY_MAX_DELIVERY_ATTEMPTS=20

# Optional own SIP/media layer. Start only after creating the Asterisk receiver
# in Orbita and filling real credentials outside Git.
ASTERISK_BIND_IP=127.0.0.1
ASTERISK_EXTERNAL_ADDRESS=
ASTERISK_LOCAL_NET=172.16.0.0/12
ASTERISK_SIP_SERVER=
ASTERISK_SIP_PORT=5060
# Plusofon recommends TCP. Check the provider documentation before changing it.
ASTERISK_SIP_TRANSPORT=tcp
ASTERISK_SIP_LOGIN=
# Optional authentication ID when it differs from the public SIP user.
ASTERISK_SIP_AUTH_LOGIN=
ASTERISK_SIP_PASSWORD=
# Keep false when all provider lines are configured in the Orbita interface.
ASTERISK_PRIMARY_TRUNK_ENABLED=false
ASTERISK_DEFAULT_EXTENSION=
# Runtime office/provider routes override this legacy fallback automatically.
ASTERISK_OUTBOUND_PROVIDER=primary
ASTERISK_PUBLIC_ID=
ASTERISK_WEBHOOK_SECRET=
ASTERISK_ENDPOINTS_FILE=/opt/orbita/secrets/pjsip.endpoints.conf

# Optional second SIP trunk: Beeline Cloud PBX. It registers alongside the
# primary trunk and does not disable incoming Plusofon calls.
BEELINE_SIP_ENABLED=false
BEELINE_SIP_SERVER=
BEELINE_SIP_PORT=5060
BEELINE_SIP_TRANSPORT=udp
BEELINE_SIP_LOGIN=
# Optional authentication ID when it differs from the SIP login.
BEELINE_SIP_AUTH_LOGIN=
BEELINE_SIP_PASSWORD=

# One shared Asterisk serves all Orbita offices. Runtime trunks, receivers and
# employee routes are written per office. This UUID is only the fallback office
# for the legacy/default SIP trunk configured below.
ASTERISK_DEFAULT_OFFICE_ID=11111111-1111-1111-1111-111111111111
# Deprecated compatibility alias; leave empty in a new installation.
ASTERISK_OFFICE_ID=

# Optional browser WebRTC. Employee endpoints and passwords are generated by
# Orbita when an administrator binds an internal number to an employee.
TELEPHONY_WEBRTC_ENABLED=false
# Local test: ws://127.0.0.1:8088/ws. Production must use public WSS via TLS proxy.
TELEPHONY_WEBRTC_WS_URL=
TELEPHONY_WEBRTC_SIP_DOMAIN=
ASTERISK_WEBRTC_BIND_IP=127.0.0.1

# NotifyBot (Telegram 3DS relay, same VPS as Orbita)
NOTIFYBOT_DB_PASSWORD=change-me-notifybot-db
TELEGRAM_BOT_TOKEN=
# Chat ID настраиваются через бота, админы: andreypakin, LamarrNK
# Ключ доступа: ЛК → Разработчикам → Доступ к API → Сгенерировать ключ
PLUSOFON_API_TOKEN=
# Client всегда 10553 (менять не нужно)
# PLUSOFON_CLIENT_ID=10553
PLUSOFON_SMS_FETCH_LIMIT=20
PLUSOFON_SMS_MAX_AGE_MINUTES=15
PLUSOFON_SMS_WATCH_DURATION_MINUTES=5
PLUSOFON_SMS_WATCH_POLL_INTERVAL_SECONDS=5
PLUSOFON_SMS_WATCH_IDLE_INTERVAL_SECONDS=15
PLUSOFON_SECRET=
PLUSOFON_WEBHOOK_VALIDATION=false
