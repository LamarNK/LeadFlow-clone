FROM ubuntu:24.04

RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu|http://mirror.yandex.ru/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|http://mirror.yandex.ru/ubuntu|g' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        asterisk ca-certificates curl gettext-base tini \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/control-panel/telephony/asterisk /opt/orbita-asterisk
RUN sed -i 's/\r$//' /opt/orbita-asterisk/*.sh \
    && bash -n /opt/orbita-asterisk/*.sh \
    && chmod 0755 /opt/orbita-asterisk/*.sh \
    && mkdir -p /var/spool/asterisk/recording /etc/asterisk/orbita \
    && chown -R asterisk:asterisk /var/spool/asterisk/recording /etc/asterisk/orbita

ENTRYPOINT ["/usr/bin/tini", "--", "/opt/orbita-asterisk/entrypoint.sh"]
