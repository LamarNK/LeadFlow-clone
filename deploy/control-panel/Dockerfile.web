FROM node:22-alpine AS js-obfuscator
WORKDIR /src

COPY Orbita.Web/wwwroot/js/ /src/js/
RUN npm install --global javascript-obfuscator@4.1.1 \
    && npm install --prefix /vendor chart.js@4.4.1 @microsoft/signalr@8.0.7 drawflow@0.0.60 \
    && javascript-obfuscator /src/js \
        --output /obfuscated-js \
        --compact true \
        --control-flow-flattening false \
        --dead-code-injection false \
        --identifier-names-generator hexadecimal \
        --rename-globals false \
        --self-defending false

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Orbita.Contracts/*.csproj Orbita.Contracts/
COPY Orbita.Logging/*.csproj Orbita.Logging/
COPY Orbita.Web/*.csproj Orbita.Web/
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore Orbita.Web/Orbita.Web.csproj

COPY Orbita.Contracts/ Orbita.Contracts/
COPY Orbita.Logging/ Orbita.Logging/
COPY Orbita.Web/ Orbita.Web/
COPY --from=js-obfuscator /obfuscated-js/ Orbita.Web/wwwroot/js/
COPY --from=js-obfuscator /vendor/node_modules/chart.js/dist/chart.umd.js Orbita.Web/wwwroot/lib/chart.js/dist/chart.umd.js
COPY --from=js-obfuscator /vendor/node_modules/@microsoft/signalr/dist/browser/signalr.min.js Orbita.Web/wwwroot/lib/signalr/dist/browser/signalr.min.js
COPY --from=js-obfuscator /vendor/node_modules/drawflow/dist/drawflow.min.css Orbita.Web/wwwroot/lib/drawflow/dist/drawflow.min.css
COPY --from=js-obfuscator /vendor/node_modules/drawflow/dist/drawflow.min.js Orbita.Web/wwwroot/lib/drawflow/dist/drawflow.min.js
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish Orbita.Web/Orbita.Web.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Orbita.Web.dll"]
