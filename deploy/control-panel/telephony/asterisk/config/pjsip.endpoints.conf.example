; Copy this file outside Git, remove .example, and use unique strong passwords.
; Bind one extension to the matching Orbita user in Telephony settings.
;
; [201]
; type=aor
; max_contacts=1
; remove_existing=yes
;
; [201]
; type=auth
; auth_type=userpass
; username=201
; password=CHANGE_ME
;
; [201]
; type=endpoint
; transport=transport-udp
; context=from-orbita-managers
; disallow=all
; allow=alaw,ulaw
; auth=201
; aors=201
; callerid=201 <201>
; direct_media=no
; rtp_symmetric=yes
; force_rport=yes
; rewrite_contact=yes
