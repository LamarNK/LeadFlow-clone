[general]
static=yes
writeprotect=yes

[globals]
RECORDING_DIR=/var/spool/asterisk/recording

[from-orbita-managers]
; Plusofon expects Russian external numbers in 7XXXXXXXXXX format.
exten => _8XXXXXXXXXX,1,Goto(7${EXTEN:1},1)
exten => _X.,1,NoOp(Orbita outgoing call)
 same => n,Set(__ORBITA_CALL_ID=${FILTER(0-9.,${UNIQUEID})})
 same => n,Set(__ORBITA_DIRECTION=outbound)
 same => n,Set(__ORBITA_INTERNAL=${FILTER(0-9,${CALLERID(num)})})
 same => n,Set(__ORBITA_OFFICE_ID=${DB(orbita_user/office_id/${ORBITA_INTERNAL})})
 same => n,Set(__ORBITA_CALLER=${FILTER(0-9+,${CALLERID(num)})})
 same => n,Set(__ORBITA_CALLED=${FILTER(0-9+,${EXTEN})})
 same => n,Set(__ORBITA_STARTED_AT=${EPOCH})
 same => n,Set(__ORBITA_DIAL_STATUS=CHANUNAVAIL)
 same => n,Set(__ORBITA_RECORDING=${RECORDING_DIR}/${ORBITA_CALL_ID}.wav)
 same => n,MixMonitor(${ORBITA_RECORDING},b)
 same => n,Set(ORBITA_OUTBOUND_ENDPOINT=${DB(orbita_user/outbound_endpoint/${ORBITA_INTERNAL})})
 same => n,ExecIf($["${ORBITA_OUTBOUND_ENDPOINT}"=""]?Set(ORBITA_OUTBOUND_ENDPOINT=${DB(orbita_office/outbound_endpoint/${ORBITA_OFFICE_ID})}))
 same => n,ExecIf($["${ORBITA_OUTBOUND_ENDPOINT}"=""]?Set(ORBITA_OUTBOUND_ENDPOINT=${DB(orbita/outbound_endpoint)}))
 same => n,ExecIf($["${ORBITA_OUTBOUND_ENDPOINT}"=""]?Set(ORBITA_OUTBOUND_ENDPOINT=${ASTERISK_OUTBOUND_ENDPOINT}))
 same => n,Set(__ORBITA_OUTBOUND_CALLER_ID=${DB(orbita_endpoint/outbound_caller_id/${ORBITA_OUTBOUND_ENDPOINT})})
 same => n,Set(__ORBITA_OUTBOUND_DOMAIN=${DB(orbita_endpoint/outbound_domain/${ORBITA_OUTBOUND_ENDPOINT})})
 same => n,Dial(PJSIP/${ORBITA_CALLED}@${ORBITA_OUTBOUND_ENDPOINT},60,b(orbita-provider-headers^s^1))
 same => n,Set(__ORBITA_DIAL_STATUS=${DIALSTATUS})
 same => n,Hangup()
exten => h,1,Gosub(orbita-publish,s,1)

[orbita-provider-headers]
exten => s,1,NoOp(Apply outbound provider caller ID)
 same => n,GotoIf($["${ORBITA_OUTBOUND_CALLER_ID}"=""]?done)
 same => n,Set(CALLERID(num)=${ORBITA_OUTBOUND_CALLER_ID})
 same => n,GotoIf($["${ORBITA_OUTBOUND_DOMAIN}"=""]?done)
 same => n,Set(PJSIP_HEADER(add,P-Charge-Info)=<sip:${ORBITA_OUTBOUND_CALLER_ID}@${ORBITA_OUTBOUND_DOMAIN}>)
 same => n(done),Return()

[from-orbita-provider]
exten => _X.,1,NoOp(Orbita incoming call)
 same => n,Set(__ORBITA_CALL_ID=${FILTER(0-9.,${UNIQUEID})})
 same => n,Set(__ORBITA_DIRECTION=inbound)
 same => n,Set(__ORBITA_INTERNAL=${FILTER(0-9,${ASTERISK_DEFAULT_EXTENSION})})
 same => n,Set(__ORBITA_CALLER=${FILTER(0-9+,${CALLERID(num)})})
 same => n,Set(__ORBITA_CALLED=${FILTER(0-9+,${EXTEN})})
 same => n,Set(__ORBITA_STARTED_AT=${EPOCH})
 same => n,Set(__ORBITA_DIAL_STATUS=CHANUNAVAIL)
 same => n,Set(__ORBITA_RECORDING=${RECORDING_DIR}/${ORBITA_CALL_ID}.wav)
 same => n,MixMonitor(${ORBITA_RECORDING},b)
 same => n,Set(ORBITA_ROUTE=${SHELL(/opt/orbita-asterisk/resolve-inbound-route.sh ${ORBITA_OFFICE_ID} ${ORBITA_CALLER} ${ORBITA_CALLED} ${ORBITA_INBOUND_PROVIDER} ${ORBITA_INBOUND_ACCOUNT})})
 same => n,Set(ORBITA_PREFERRED=${FILTER(0-9,${CUT(ORBITA_ROUTE,^,1)})})
 same => n,Set(ORBITA_FALLBACK=${CUT(ORBITA_ROUTE,^,2)})
 same => n,Set(ORBITA_EXCLUSIVE=$["${ORBITA_FALLBACK}"="PJSIP/orbita-exclusive-route"])
 same => n,ExecIf($["${ORBITA_EXCLUSIVE}"="1"]?Set(ORBITA_FALLBACK=))
 same => n,GotoIf($["${ORBITA_PREFERRED}"=""]?preferred_failed)
 same => n,Set(__ORBITA_INTERNAL=${ORBITA_PREFERRED})
 same => n,Set(ORBITA_PREFERRED_DIAL=${PJSIP_DIAL_CONTACTS(${ORBITA_PREFERRED}-webrtc)})
 same => n,GotoIf($["${ORBITA_PREFERRED_DIAL}"=""]?preferred_failed)
 same => n,Dial(${ORBITA_PREFERRED_DIAL},15)
 same => n,Set(__ORBITA_DIAL_STATUS=${DIALSTATUS})
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 ; A browser can replace a stale WebSocket contact while the first Dial is
 ; still waiting on the old contact. Retry only when the resolved contact
 ; actually changed, so an ordinary unanswered call is never duplicated.
 same => n,Set(ORBITA_PREFERRED_RETRY_DIAL=${PJSIP_DIAL_CONTACTS(${ORBITA_PREFERRED}-webrtc)})
 same => n,GotoIf($["${ORBITA_PREFERRED_RETRY_DIAL}"=""]?preferred_failed)
 same => n,GotoIf($["${ORBITA_PREFERRED_RETRY_DIAL}"="${ORBITA_PREFERRED_DIAL}"]?preferred_failed)
 same => n,Dial(${ORBITA_PREFERRED_RETRY_DIAL},15)
 same => n,Set(__ORBITA_DIAL_STATUS=${DIALSTATUS})
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 same => n(preferred_failed),GotoIf($["${ORBITA_EXCLUSIVE}"="1"]?done:fallback)
 same => n(fallback),GotoIf($["${ORBITA_FALLBACK}"=""]?default)
 same => n,Dial(${ORBITA_FALLBACK},45)
 same => n,Set(__ORBITA_DIAL_STATUS=${DIALSTATUS})
 same => n,Goto(done)
 same => n(default),Set(__ORBITA_INTERNAL=${FILTER(0-9,${ASTERISK_DEFAULT_EXTENSION})})
 same => n,Dial(PJSIP/${ORBITA_INTERNAL}-webrtc,60)
 same => n,Set(__ORBITA_DIAL_STATUS=${DIALSTATUS})
 same => n(done),Hangup()
exten => h,1,Gosub(orbita-publish,s,1)

[orbita-publish]
exten => s,1,NoOp(Publish Orbita call after hangup)
 same => n,StopMixMonitor()
 same => n,Set(ORBITA_DISPOSITION=${FILTER(A-Z,${CDR(disposition)})})
 same => n,Set(ORBITA_DIAL_STATUS_SAFE=${FILTER(A-Z,${DIALSTATUS})})
 same => n,ExecIf($["${ORBITA_DIAL_STATUS_SAFE}"=""]?Set(ORBITA_DIAL_STATUS_SAFE=${FILTER(A-Z,${ORBITA_DIAL_STATUS})}))
 same => n,Set(ORBITA_HANGUP_CAUSE=${FILTER(0-9,${HANGUPCAUSE})})
 same => n,ExecIf($["${ORBITA_DISPOSITION}"=""]?Set(ORBITA_DISPOSITION=UNKNOWN))
 same => n,ExecIf($["${ORBITA_DIAL_STATUS_SAFE}"=""]?Set(ORBITA_DIAL_STATUS_SAFE=UNKNOWN))
 same => n,ExecIf($["${ORBITA_HANGUP_CAUSE}"=""]?Set(ORBITA_HANGUP_CAUSE=0))
 same => n,TrySystem(/opt/orbita-asterisk/publish-call.sh ${ORBITA_CALL_ID} ${ORBITA_CALLER} ${ORBITA_CALLED} ${ORBITA_DIRECTION} ${ORBITA_INTERNAL} ${ORBITA_STARTED_AT} ${CDR(billsec)} ${ORBITA_RECORDING} ${ORBITA_OFFICE_ID} ${ORBITA_DISPOSITION} ${ORBITA_DIAL_STATUS_SAFE} ${ORBITA_HANGUP_CAUSE})
 same => n,Return()
