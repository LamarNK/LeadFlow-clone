; Generated by entrypoint.sh. Browser auth is independent from the provider trunk.
[${ASTERISK_WEBRTC_AUTH_USERNAME}]
type=aor
max_contacts=1
remove_existing=yes
support_path=yes
qualify_frequency=30

[${ASTERISK_WEBRTC_AUTH_USERNAME}-auth]
type=auth
auth_type=userpass
username=${ASTERISK_WEBRTC_AUTH_USERNAME}
password=${ASTERISK_WEBRTC_PASSWORD}

[${ASTERISK_WEBRTC_AUTH_USERNAME}]
type=endpoint
transport=transport-ws
context=from-orbita-managers
disallow=all
allow=ulaw,alaw
auth=${ASTERISK_WEBRTC_AUTH_USERNAME}-auth
aors=${ASTERISK_WEBRTC_AUTH_USERNAME}
callerid=${ASTERISK_WEBRTC_EXTENSION} <${ASTERISK_WEBRTC_EXTENSION}>
webrtc=yes
dtls_auto_generate_cert=yes
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
