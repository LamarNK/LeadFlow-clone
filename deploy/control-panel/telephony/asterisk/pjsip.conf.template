[global]
type=global
user_agent=Orbita-PBX

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${ASTERISK_EXTERNAL_ADDRESS}
external_media_address=${ASTERISK_EXTERNAL_ADDRESS}
local_net=${ASTERISK_LOCAL_NET}

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_signaling_address=${ASTERISK_EXTERNAL_ADDRESS}
external_media_address=${ASTERISK_EXTERNAL_ADDRESS}
local_net=${ASTERISK_LOCAL_NET}

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0
external_signaling_address=${ASTERISK_EXTERNAL_ADDRESS}
external_media_address=${ASTERISK_EXTERNAL_ADDRESS}
local_net=${ASTERISK_LOCAL_NET}

[orbita-provider-auth]
type=auth
auth_type=userpass
username=${ASTERISK_SIP_AUTH_LOGIN}
password=${ASTERISK_SIP_PASSWORD}

[orbita-provider-aor]
type=aor
contact=sip:${ASTERISK_SIP_SERVER}:${ASTERISK_SIP_PORT}
qualify_frequency=30

[orbita-provider]
type=endpoint
transport=transport-${ASTERISK_SIP_TRANSPORT}
context=from-orbita-provider
disallow=all
allow=alaw,ulaw
outbound_auth=orbita-provider-auth
aors=orbita-provider-aor
from_user=${ASTERISK_SIP_LOGIN}
from_domain=${ASTERISK_SIP_SERVER}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
set_var=ORBITA_OFFICE_ID=${ASTERISK_DEFAULT_OFFICE_ID}

[orbita-provider-identify]
type=identify
endpoint=orbita-provider
match=${ASTERISK_SIP_SERVER}

[orbita-provider-registration]
type=registration
transport=transport-${ASTERISK_SIP_TRANSPORT}
outbound_auth=orbita-provider-auth
server_uri=sip:${ASTERISK_SIP_SERVER}:${ASTERISK_SIP_PORT}
client_uri=sip:${ASTERISK_SIP_LOGIN}@${ASTERISK_SIP_SERVER}:${ASTERISK_SIP_PORT}
contact_user=${ASTERISK_SIP_LOGIN}
contact_header_params=expires=300
retry_interval=60
forbidden_retry_interval=300
expiration=300

; Manager extensions are mounted separately so their passwords never enter Git.
#include /etc/asterisk/orbita/pjsip.endpoints.conf
#include /etc/asterisk/orbita/pjsip.webrtc.conf
#include /etc/asterisk/orbita/pjsip.beeline.conf
