@model CrmTelephonyPageViewModel
@{
    var isPlusofon = Model.Provider == CrmTelephonyProviders.Plusofon;
    var isAsterisk = Model.Provider == CrmTelephonyProviders.Asterisk;
    var isBeeline = Model.Provider == CrmTelephonyProviders.Beeline;
    var isSipProvider = isPlusofon || isBeeline;
    var providerLabel = isPlusofon ? "Плюсофон" : isAsterisk ? "SIP-сервер" : isBeeline ? "Билайн SIP" : "SIPOUT";
    var bindingsByUser = Model.Settings.UserBindings.ToDictionary(x => x.UserId, StringComparer.Ordinal);
    var phoneUsersByUser = Model.PhoneUsers.ToDictionary(x => x.UserId, StringComparer.Ordinal);
    var plusofonAccounts = Model.PlusofonAccounts.ToList();
    var beelineAccounts = Model.BeelineAccounts.ToList();
    var officeOutboundLines = new List<(string Value, string Label, bool Selected)>();
    officeOutboundLines.AddRange(plusofonAccounts
        .Where(account => account.Mode == CrmSipAccountModes.Shared)
        .Select(account => (
            CrmTelephonyOutboundProviders.ForPlusofonLine(account.AccountKey),
            $"Плюсофон · {account.Name}",
            account.UseForOutbound)));
    officeOutboundLines.AddRange(beelineAccounts
        .Where(account => account.Mode == CrmSipAccountModes.Shared)
        .Select(account => (
            CrmTelephonyOutboundProviders.ForBeelineLine(account.AccountKey),
            $"Билайн · {account.Name}",
            account.UseForOutbound)));
    var selectedProvider = Model.ProviderSummaries.FirstOrDefault(summary =>
        string.Equals(summary.Provider, Model.Provider, StringComparison.OrdinalIgnoreCase));
    var receiverStatusLabel = Model.Settings.IsEnabled
        ? "Приём событий включён"
        : Model.Settings.IsConfigured
            ? "Приём событий приостановлен"
            : "Приём событий не настроен";
    string OutboundLineLabel(string? provider)
    {
        if (CrmTelephonyOutboundProviders.TryGetBeelineLineKey(provider, out var accountKey))
        {
            return beelineAccounts.FirstOrDefault(account =>
                string.Equals(account.AccountKey, accountKey, StringComparison.OrdinalIgnoreCase))?.Name
                ?? "Линия Билайна";
        }
        if (CrmTelephonyOutboundProviders.TryGetPlusofonLineKey(provider, out accountKey))
        {
            return plusofonAccounts.FirstOrDefault(account =>
                string.Equals(account.AccountKey, accountKey, StringComparison.OrdinalIgnoreCase))?.Name
                ?? "Линия Плюсофона";
        }
        return provider switch
        {
            CrmTelephonyProviders.Beeline => beelineAccounts.FirstOrDefault(account => account.UseForOutbound)?.Name ?? "Билайн",
            CrmTelephonyProviders.Plusofon => plusofonAccounts.FirstOrDefault(account => account.UseForOutbound)?.Name ?? "Плюсофон",
            _ => "Номер по умолчанию"
        };
    }
    ViewData["Title"] = "Телефония";
}
<partial name="_PageHeader" model="@(new PageHeaderViewModel
{
    Title = "Телефония",
    Subtitle = $"Линии, сотрудники и записи звонков · {Model.OfficeName}",
    ShowRefresh = false
})" />

<div class="orbita-main settings-page telephony-settings-page">
    <div class="telephony-settings-nav">
        <a class="settings-link-btn telephony-back-link" href="@Url.Action("Index", "Settings", new { tab = "offices", officeId = Model.OfficeId })">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> К офису
        </a>
        <span class="telephony-access-note">@(Model.CanManage ? "Вы можете изменять телефонию офиса" : "Просмотр без права изменения")</span>
    </div>

    <div class="settings-control-bar" role="tablist" aria-label="Подключения телефонии">
        <div class="settings-tabs">
            @foreach (var summary in Model.ProviderSummaries)
            {
                var selected = string.Equals(summary.Provider, Model.Provider, StringComparison.OrdinalIgnoreCase);
                var statusClass = summary.IsEnabled ? "settings-tab-dot--online" : summary.IsConfigured ? "settings-tab-dot--paused" : null;
                <a class="settings-tab @(selected ? "settings-tab--active" : null)"
                   role="tab"
                   aria-selected="@selected.ToString().ToLowerInvariant()"
                   href="@Url.Action("Telephony", "TelephonySettings", new { officeId = Model.OfficeId, provider = summary.Provider })">
                    <span class="settings-tab-dot @statusClass" aria-hidden="true"></span>
                    @summary.Name
                </a>
            }
        </div>
    </div>

    <div class="telephony-page-meta">
        <p>@(selectedProvider?.Description ?? "Настройте подключение и свяжите линии с сотрудниками офиса.")</p>
        <div class="telephony-page-facts" aria-label="Сводка по выбранному подключению">
            <span><strong>@(selectedProvider?.BoundUsersCount ?? 0)</strong> сотрудников</span>
            <span>@receiverStatusLabel</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="settings-alert settings-alert--success" role="status">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="settings-alert settings-alert--error" role="alert">@Model.ErrorMessage</div>
    }

    @if (isAsterisk || isSipProvider)
    {
        <section class="card telephony-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Линия офиса по умолчанию</h2>
                    <p class="settings-card-subtitle">Используется сотрудниками, у которых не выбрана персональная линия</p>
                </div>
            </div>
            <div class="card-body">
                <form asp-controller="TelephonySettings" asp-action="SetOfficeDefaultOutbound" method="post" class="telephony-binding-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="officeId" value="@Model.OfficeId" />
                    <input type="hidden" name="provider" value="@Model.Provider" />
                    <label class="settings-field">
                        <span class="settings-field-label">Через какую телефонию звонит офис</span>
                        <select name="outboundProvider" required disabled="@(officeOutboundLines.Count == 0)">
                            @if (officeOutboundLines.Count == 0)
                            {
                                <option value="">Сначала подключите общую SIP-линию</option>
                            }
                            @foreach (var line in officeOutboundLines)
                            {
                                <option value="@line.Value" selected="@line.Selected">@line.Label</option>
                            }
                        </select>
                    </label>
                    @if (Model.CanManage)
                    {
                        <button type="submit" class="settings-primary-btn" disabled="@(officeOutboundLines.Count == 0)">Переключить</button>
                    }
                </form>
                <p class="telephony-configured-note">Переключение не удаляет реквизиты и не отключает регистрацию других линий.</p>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ProviderSetupUrl))
    {
        <section class="card telephony-card telephony-secret-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Данные webhook для @providerLabel</h2>
                    <p class="settings-card-subtitle">Показываются один раз. Не отправляйте их в общие чаты.</p>
                </div>
            </div>
            <div class="card-body">
                <div class="telephony-copy-row">
                    <code id="telephonyProviderUrl">@Model.ProviderSetupUrl</code>
                    <button type="button" class="settings-primary-btn settings-primary-btn--compact" data-copy-telephony-value="telephonyProviderUrl">Копировать URL</button>
                </div>
                @if (isPlusofon || isAsterisk)
                {
                    <div class="telephony-copy-row">
                        <code id="telephonyProviderSecret">@Model.WebhookSecretHeader: @Model.WebhookSecret</code>
                        <button type="button" class="settings-primary-btn settings-primary-btn--compact" data-copy-telephony-value="telephonyProviderSecret">Копировать заголовок</button>
                    </div>
                    @if (isAsterisk)
                    {
                        <ol class="telephony-steps">
                            <li>Запишите <strong>Public ID</strong> из адреса и секретный HTTP-заголовок в защищённый <code>.env</code> SIP-контейнера.</li>
                            <li>Asterisk отправляет сюда multipart-поля звонка и файл <strong>recording</strong> после завершения разговора.</li>
                            <li>Внутренние номера сотрудников свяжите с пользователями ниже.</li>
                        </ol>
                    }
                    else
                    {
                        <ol class="telephony-steps">
                            <li>В Плюсофоне создайте webhook события <strong>destroy</strong> для всех звонков.</li>
                            <li>Укажите URL выше и добавьте HTTP-заголовок целиком.</li>
                            <li>Передавайте поля <strong>call_id, direction, from, to, internal, timestamp, duration</strong>.</li>
                        </ol>
                    }
                }
                else
                {
                    <ol class="telephony-steps">
                        <li>В виртуальной АТС SIPOUT откройте сценарий звонка.</li>
                        <li>В системном обработчике завершения <strong>h</strong> добавьте действие <strong>WebRequest</strong>.</li>
                        <li>Вставьте адрес целиком и включите запись разговоров.</li>
                    </ol>
                }
            </div>
        </section>
    }

    @if (isPlusofon)
    {
        <section class="card telephony-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">API для облачных записей звонков</h2>
                    <p class="settings-card-subtitle">Не влияет на прохождение звонков: SIP-линия настраивается отдельным блоком ниже</p>
                </div>
                <span class="settings-status-pill @(Model.Settings.ProviderCredentialsConfigured ? "settings-status-pill--online" : "settings-status-pill--disabled")">
                    @(Model.Settings.ProviderCredentialsConfigured ? "Настроено" : "Не настроено")
                </span>
            </div>
            <div class="card-body">
                <form asp-controller="TelephonySettings" asp-action="SavePlusofonCredentials" method="post" class="telephony-binding-form" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="officeId" value="@Model.OfficeId" />
                    <label class="settings-field">
                        <span class="settings-field-label">Client ID</span>
                        <input type="text" name="clientId" required maxlength="128" autocomplete="off" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">Access token</span>
                        <input type="password" name="accessToken" required maxlength="4096" autocomplete="new-password" />
                    </label>
                    @if (Model.CanManage)
                    {
                        <button type="submit" class="settings-primary-btn">
                            @(Model.Settings.ProviderCredentialsConfigured ? "Заменить реквизиты" : "Сохранить реквизиты")
                        </button>
                    }
                </form>
                <p class="telephony-configured-note">
                    Токен шифруется Data Protection Орбиты. В логах и интерфейсе его значение не выводится.
                </p>
            </div>
        </section>
    }

    @if (isPlusofon)
    {
        var account = plusofonAccounts.FirstOrDefault(line => line.AccountKey == "default");
        var registrationTone = account is null
            ? "settings-status-pill--disabled"
            : account.RegistrationStatus == "registered"
                ? "settings-status-pill--online"
                : account.RegistrationStatus is "rejected" or "reload-failed" or "runtime-unavailable"
                    ? "settings-status-pill--danger"
                    : "settings-status-pill--warning";
        var registrationLabel = account?.RegistrationStatus switch
        {
            "registered" => "Зарегистрирован",
            "rejected" => "Отклонён провайдером",
            "unregistered" => "Не зарегистрирован",
            "reload-failed" => "Ошибка конфигурации",
            "runtime-unavailable" => "SIP-сервер недоступен",
            _ => account is not null ? "Проверяется" : "Не настроен"
        };
        <section class="card telephony-card telephony-sip-account-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">SIP-линия Плюсофона</h2>
                    <p class="settings-card-subtitle">Общий номер офиса, через который Asterisk совершает и принимает звонки</p>
                </div>
                <span class="settings-status-pill @registrationTone"
                      data-sip-registration-status
                      data-registration-status="@account?.RegistrationStatus"
                      data-status-url="@Url.Action("SipAccountStatus", "TelephonySettings", new { officeId = Model.OfficeId, provider = Model.Provider })">@registrationLabel</span>
            </div>
            <div class="card-body">
                <form asp-controller="TelephonySettings" asp-action="SaveSipProviderAccount" method="post" class="telephony-sip-account-grid" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
                    <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Plusofon" />
                    <input type="hidden" name="AccountKey" value="@(account?.AccountKey ?? "default")" />
                    <input type="hidden" name="Name" value="Линия Плюсофона" />
                    <input type="hidden" name="Mode" value="@CrmSipAccountModes.Shared" />
                    <label class="settings-field">
                        <span class="settings-field-label">SIP-сервер</span>
                        <input type="text" name="Server" value="@account?.Server" required maxlength="253" placeholder="12345.voice.plusofon.ru" autocomplete="off" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">Domain / Realm</span>
                        <input type="text" name="Domain" value="@account?.Domain" maxlength="253" placeholder="Обычно совпадает с SIP-сервером" autocomplete="off" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">SIP-логин</span>
                        <input type="text" name="SipLogin" value="@account?.SipLogin" required maxlength="128" autocomplete="off" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">Логин авторизации</span>
                        <input type="text" name="AuthorizationLogin" value="@account?.AuthorizationLogin" maxlength="256" placeholder="Если совпадает с SIP-логином — оставьте пустым" autocomplete="off" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">SIP-пароль</span>
                        <input type="password" name="Password" maxlength="4096" autocomplete="new-password" placeholder="@(account?.PasswordConfigured == true ? "Оставьте пустым, чтобы не менять" : "Обязательно при первой настройке")" />
                    </label>
                    <label class="settings-field">
                        <span class="settings-field-label">Исходящий АОН</span>
                        <input type="tel" name="OutboundCallerId" value="@account?.OutboundCallerId" required maxlength="18" inputmode="numeric" placeholder="7XXXXXXXXXX" autocomplete="off" />
                        <small>Номер должен быть активирован на договоре Plusofon. Для SIP-транка он передаётся в P-Charge-Info.</small>
                    </label>
                    <div class="telephony-sip-account-grid__pair">
                        <label class="settings-field"><span class="settings-field-label">Порт</span><input type="number" name="Port" value="@(account?.Port ?? 5060)" min="1" max="65535" required /></label>
                        <label class="settings-field">
                            <span class="settings-field-label">Транспорт</span>
                            <select name="Transport" required>
                                <option value="udp" selected="@(account?.Transport == "udp")">UDP</option>
                                <option value="tcp" selected="@(account?.Transport != "udp")">TCP</option>
                            </select>
                        </label>
                    </div>
                    <label class="telephony-sip-outbound-option">
                        <input type="checkbox" name="UseForOutbound" value="true" checked="@(account?.UseForOutbound != false)" />
                        <span><strong>Использовать Плюсофон по умолчанию</strong><small>Новые звонки из карточки будут направляться через эту линию.</small></span>
                    </label>
                    <div class="telephony-sip-account-grid__actions">
                        @if (Model.CanManage)
                        {
                            <button type="submit" class="settings-primary-btn">@(account is null ? "Подключить линию" : "Сохранить и переподключить")</button>
                        }
                        <span>Пароль шифруется в БД и никогда не возвращается в браузер.</span>
                    </div>
                </form>
                <div class="telephony-binding-guide telephony-sip-account-help">
                    <span class="telephony-binding-guide__icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
                    <div>
                        <strong>Как назначаются звонки</strong>
                        <p>Менеджерам назначаются разные внутренние номера <strong>201, 202…</strong> в разделе «SIP-сервер». Обратный звонок направляется сотруднику, который последним звонил этому клиенту.</p>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (isPlusofon)
    {
        var additionalPlusofonAccounts = plusofonAccounts
            .Where(line => line.AccountKey != "default")
            .ToList();
        <section class="card telephony-card telephony-sip-lines-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Дополнительные линии Плюсофона</h2>
                    <p class="settings-card-subtitle">Персональные одноканальные номера и дополнительные общие транки</p>
                </div>
                <span class="settings-status-pill @(additionalPlusofonAccounts.Count > 0 ? "settings-status-pill--online" : "settings-status-pill--disabled")">@additionalPlusofonAccounts.Count</span>
            </div>
            <div class="card-body telephony-sip-lines-body">
                <div class="telephony-sip-lines-list">
                    @foreach (var line in additionalPlusofonAccounts)
                    {
                        var outboundValue = CrmTelephonyOutboundProviders.ForPlusofonLine(line.AccountKey);
                        var assignedCount = Model.PhoneUsers.Count(binding => string.Equals(binding.OutboundProvider, outboundValue, StringComparison.OrdinalIgnoreCase));
                        var statusTone = line.RegistrationStatus == "registered"
                            ? "settings-status-pill--online"
                            : line.RegistrationStatus is "rejected" or "reload-failed" or "runtime-unavailable"
                                ? "settings-status-pill--danger"
                                : "settings-status-pill--warning";
                        <article class="telephony-sip-line">
                            <div class="telephony-sip-line__summary">
                                <span class="telephony-sip-line__icon"><i class="fa-solid @(line.Mode == CrmSipAccountModes.Personal ? "fa-user" : "fa-users")" aria-hidden="true"></i></span>
                                <span class="telephony-sip-line__identity"><strong>@line.Name</strong><small>@(line.Mode == CrmSipAccountModes.Personal ? "Персональная · 1 сотрудник" : "Общая многоканальная")</small></span>
                                <span class="telephony-sip-line__technical"><strong>@line.SipLogin</strong><small>@line.Server:@line.Port · @line.Transport.ToUpperInvariant()</small></span>
                                <span class="telephony-sip-line__assignment"><strong>@assignedCount</strong><small>сотрудников</small></span>
                                <span class="telephony-sip-line__statuses">
                                    @if (line.UseForOutbound) { <span class="settings-status-pill settings-status-pill--online">Линия офиса</span> }
                                    <span class="settings-status-pill @statusTone">@(line.RegistrationStatus == "registered" ? "Зарегистрирована" : line.RegistrationStatus == "rejected" ? "Отклонена" : "Проверяется")</span>
                                </span>
                            </div>
                            @if (Model.CanManage)
                            {
                                <details class="telephony-sip-line__editor">
                                    <summary><i class="fa-solid fa-pen" aria-hidden="true"></i> Изменить</summary>
                                    <form asp-controller="TelephonySettings" asp-action="SaveSipProviderAccount" method="post" class="telephony-sip-account-grid" autocomplete="off">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
                                        <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Plusofon" />
                                        <input type="hidden" name="AccountKey" value="@line.AccountKey" />
                                        <label class="settings-field"><span class="settings-field-label">Название линии</span><input type="text" name="Name" value="@line.Name" required maxlength="100" /></label>
                                        <label class="settings-field"><span class="settings-field-label">Тип линии</span><select name="Mode" required><option value="personal" selected="@(line.Mode == CrmSipAccountModes.Personal)">Персональная одноканальная</option><option value="shared" selected="@(line.Mode == CrmSipAccountModes.Shared)">Общая многоканальная</option></select></label>
                                        <label class="settings-field"><span class="settings-field-label">SIP-сервер</span><input type="text" name="Server" value="@line.Server" required maxlength="253" /></label>
                                        <label class="settings-field"><span class="settings-field-label">Domain / Realm</span><input type="text" name="Domain" value="@line.Domain" maxlength="253" /></label>
                                        <label class="settings-field"><span class="settings-field-label">SIP-логин</span><input type="text" name="SipLogin" value="@line.SipLogin" required maxlength="128" /></label>
                                        <label class="settings-field"><span class="settings-field-label">Логин авторизации</span><input type="text" name="AuthorizationLogin" value="@line.AuthorizationLogin" maxlength="256" /></label>
                                        <label class="settings-field"><span class="settings-field-label">SIP-пароль</span><input type="password" name="Password" maxlength="4096" autocomplete="new-password" placeholder="Оставьте пустым, чтобы не менять" /></label>
                                        <label class="settings-field"><span class="settings-field-label">Исходящий АОН</span><input type="tel" name="OutboundCallerId" value="@line.OutboundCallerId" required maxlength="18" inputmode="numeric" /></label>
                                        <div class="telephony-sip-account-grid__pair"><label class="settings-field"><span class="settings-field-label">Порт</span><input type="number" name="Port" value="@line.Port" min="1" max="65535" required /></label><label class="settings-field"><span class="settings-field-label">Транспорт</span><select name="Transport" required><option value="tcp" selected="@(line.Transport == "tcp")">TCP</option><option value="udp" selected="@(line.Transport == "udp")">UDP</option></select></label></div>
                                        <label class="telephony-sip-outbound-option"><input type="checkbox" name="UseForOutbound" value="true" checked="@line.UseForOutbound" disabled="@(line.Mode == CrmSipAccountModes.Personal)" /><span><strong>Линия офиса по умолчанию</strong><small>Доступно только для общей линии.</small></span></label>
                                        <div class="telephony-sip-account-grid__actions"><button type="submit" class="settings-primary-btn">Сохранить и переподключить</button></div>
                                    </form>
                                    <form asp-controller="TelephonySettings" asp-action="DeleteSipProviderAccount" method="post" class="telephony-sip-line__delete" onsubmit="return confirm('Удалить линию Плюсофона?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="officeId" value="@Model.OfficeId" />
                                        <input type="hidden" name="provider" value="@CrmTelephonyProviders.Plusofon" />
                                        <input type="hidden" name="accountKey" value="@line.AccountKey" />
                                        <button type="submit" class="settings-danger-btn"><i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить линию</button>
                                    </form>
                                </details>
                            }
                        </article>
                    }
                </div>
                @if (Model.CanManage)
                {
                    <details class="telephony-sip-line telephony-sip-line--new">
                        <summary><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить линию Плюсофона</summary>
                        <form asp-controller="TelephonySettings" asp-action="SaveSipProviderAccount" method="post" class="telephony-sip-account-grid" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
                            <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Plusofon" />
                            <label class="settings-field"><span class="settings-field-label">Название линии</span><input type="text" name="Name" required maxlength="100" placeholder="Например, Линия менеджера" /></label>
                            <label class="settings-field"><span class="settings-field-label">Тип линии</span><select name="Mode" required><option value="personal">Персональная одноканальная</option><option value="shared">Общая многоканальная</option></select></label>
                            <label class="settings-field"><span class="settings-field-label">SIP-сервер</span><input type="text" name="Server" required maxlength="253" placeholder="12345.voice.plusofon.ru" /></label>
                            <label class="settings-field"><span class="settings-field-label">Domain / Realm</span><input type="text" name="Domain" maxlength="253" placeholder="Обычно совпадает с SIP-сервером" /></label>
                            <label class="settings-field"><span class="settings-field-label">SIP-логин</span><input type="text" name="SipLogin" required maxlength="128" /></label>
                            <label class="settings-field"><span class="settings-field-label">Логин авторизации</span><input type="text" name="AuthorizationLogin" maxlength="256" /></label>
                            <label class="settings-field"><span class="settings-field-label">SIP-пароль</span><input type="password" name="Password" required maxlength="4096" autocomplete="new-password" /></label>
                            <label class="settings-field"><span class="settings-field-label">Исходящий АОН</span><input type="tel" name="OutboundCallerId" required maxlength="18" inputmode="numeric" placeholder="7XXXXXXXXXX" /></label>
                            <div class="telephony-sip-account-grid__pair"><label class="settings-field"><span class="settings-field-label">Порт</span><input type="number" name="Port" value="5060" min="1" max="65535" required /></label><label class="settings-field"><span class="settings-field-label">Транспорт</span><select name="Transport" required><option value="tcp">TCP</option><option value="udp">UDP</option></select></label></div>
                            <label class="telephony-sip-outbound-option"><input type="checkbox" name="UseForOutbound" value="true" /><span><strong>Линия офиса по умолчанию</strong><small>Для персональной линии флаг отключается.</small></span></label>
                            <div class="telephony-sip-account-grid__actions"><button type="submit" class="settings-primary-btn">Подключить линию</button><span>Основная линия Плюсофона останется подключённой.</span></div>
                        </form>
                    </details>
                }
            </div>
        </section>
    }

    @if (isBeeline)
    {
        <section class="card telephony-card telephony-sip-lines-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Линии Билайна</h2>
                    <p class="settings-card-subtitle">Общий многоканальный транк или отдельные одноканальные SIP-аккаунты сотрудников</p>
                </div>
                <span class="settings-status-pill @(beelineAccounts.Count > 0 ? "settings-status-pill--online" : "settings-status-pill--disabled")">
                    @beelineAccounts.Count @(beelineAccounts.Count == 1 ? "линия" : beelineAccounts.Count is >= 2 and <= 4 ? "линии" : "линий")
                </span>
            </div>
            <div class="card-body telephony-sip-lines-body">
                @if (beelineAccounts.Count == 0)
                {
                    <div class="telephony-empty-lines">
                        <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
                        <strong>Линии Билайна ещё не подключены</strong>
                        <span>Добавьте общий транк или персональный SIP-аккаунт.</span>
                    </div>
                }
                <div class="telephony-sip-lines-list">
                @foreach (var account in beelineAccounts)
                {
                    var outboundValue = CrmTelephonyOutboundProviders.ForBeelineLine(account.AccountKey);
                    var assignedCount = Model.PhoneUsers.Count(binding =>
                        string.Equals(binding.OutboundProvider, outboundValue, StringComparison.OrdinalIgnoreCase)
                        || (account.AccountKey == "default"
                            && string.Equals(binding.OutboundProvider, CrmTelephonyProviders.Beeline, StringComparison.OrdinalIgnoreCase)));
                    var registrationTone = account.RegistrationStatus == "registered"
                        ? "settings-status-pill--online"
                        : account.RegistrationStatus == "rejected"
                            ? "settings-status-pill--danger"
                            : "settings-status-pill--warning";
                    var registrationLabel = account.RegistrationStatus switch
                    {
                        "registered" => "Зарегистрирована",
                        "rejected" => "Отклонена провайдером",
                        "unregistered" => "Не зарегистрирована",
                        "runtime-unavailable" => "SIP-сервер недоступен",
                        _ => "Проверяется"
                    };
                    <article class="telephony-sip-line">
                        <div class="telephony-sip-line__summary">
                            <span class="telephony-sip-line__icon"><i class="fa-solid @(account.Mode == CrmSipAccountModes.Personal ? "fa-user" : "fa-users")" aria-hidden="true"></i></span>
                            <span class="telephony-sip-line__identity">
                                <strong>@account.Name</strong>
                                <small>@(account.Mode == CrmSipAccountModes.Personal ? "Персональная · 1 сотрудник" : "Общая многоканальная")</small>
                            </span>
                            <span class="telephony-sip-line__technical">
                                <strong>@account.SipLogin</strong>
                                <small>@account.Server:@account.Port · @account.Transport.ToUpperInvariant()</small>
                            </span>
                            <span class="telephony-sip-line__assignment">
                                <strong>@assignedCount</strong>
                                <small>сотрудников</small>
                            </span>
                            <span class="telephony-sip-line__statuses">
                                @if (account.UseForOutbound)
                                {
                                    <span class="settings-status-pill settings-status-pill--online">Линия офиса</span>
                                }
                                <span class="settings-status-pill @registrationTone">@registrationLabel</span>
                            </span>
                        </div>
                        @if (account.RegistrationStatus == "rejected"
                            && !string.IsNullOrWhiteSpace(account.RegistrationDetail))
                        {
                            <p class="telephony-sip-line__registration-detail">
                                <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                                Ошибка регистрации: @account.RegistrationDetail
                            </p>
                        }
                        @if (Model.CanManage)
                        {
                            <details class="telephony-sip-line__editor">
                                <summary><i class="fa-solid fa-pen" aria-hidden="true"></i> Изменить</summary>
                                <form asp-controller="TelephonySettings" asp-action="SaveSipProviderAccount" method="post" class="telephony-sip-account-grid" autocomplete="off">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
                                    <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Beeline" />
                                    <input type="hidden" name="AccountKey" value="@account.AccountKey" />
                                    <label class="settings-field">
                                        <span class="settings-field-label">Название линии</span>
                                        <input type="text" name="Name" value="@account.Name" required maxlength="100" />
                                    </label>
                                    <label class="settings-field">
                                        <span class="settings-field-label">Тип линии</span>
                                        <select name="Mode" required>
                                            <option value="shared" selected="@(account.Mode == CrmSipAccountModes.Shared)">Общая многоканальная</option>
                                            <option value="personal" selected="@(account.Mode == CrmSipAccountModes.Personal)">Персональная одноканальная</option>
                                        </select>
                                    </label>
                                    <label class="settings-field"><span class="settings-field-label">SIP proxy</span><input type="text" name="Server" value="@account.Server" required maxlength="253" /></label>
                                    <label class="settings-field"><span class="settings-field-label">Domain</span><input type="text" name="Domain" value="@account.Domain" maxlength="253" /></label>
                                    <label class="settings-field"><span class="settings-field-label">SIP User ID</span><input type="text" name="SipLogin" value="@account.SipLogin" required maxlength="128" /></label>
                                    <label class="settings-field"><span class="settings-field-label">Authorization User ID</span><input type="text" name="AuthorizationLogin" value="@account.AuthorizationLogin" required maxlength="256" /></label>
                                    <label class="settings-field"><span class="settings-field-label">SIP-пароль</span><input type="password" name="Password" maxlength="4096" autocomplete="new-password" placeholder="Оставьте пустым, чтобы не менять" /></label>
                                    <div class="telephony-sip-account-grid__pair">
                                        <label class="settings-field"><span class="settings-field-label">Порт</span><input type="number" name="Port" value="@account.Port" min="1" max="65535" required /></label>
                                        <label class="settings-field"><span class="settings-field-label">Транспорт (обычно UDP)</span><select name="Transport" required><option value="udp" selected="@(account.Transport != "tcp")">UDP</option><option value="tcp" selected="@(account.Transport == "tcp")">TCP</option></select></label>
                                    </div>
                                    <label class="telephony-sip-outbound-option">
                                        <input type="checkbox" name="UseForOutbound" value="true" checked="@account.UseForOutbound" disabled="@(account.Mode == CrmSipAccountModes.Personal)" />
                                        <span><strong>Линия офиса по умолчанию</strong><small>Доступно только для общей линии.</small></span>
                                    </label>
                                    <div class="telephony-sip-account-grid__actions">
                                        <button type="submit" class="settings-primary-btn">Сохранить и переподключить</button>
                                        <span>Пароль хранится в зашифрованном виде.</span>
                                    </div>
                                </form>
                                <form asp-controller="TelephonySettings" asp-action="DeleteSipProviderAccount" method="post" class="telephony-sip-line__delete" onsubmit="return confirm('Удалить линию Билайна?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="officeId" value="@Model.OfficeId" />
                                    <input type="hidden" name="provider" value="@CrmTelephonyProviders.Beeline" />
                                    <input type="hidden" name="accountKey" value="@account.AccountKey" />
                                    <button type="submit" class="settings-danger-btn"><i class="fa-solid fa-trash" aria-hidden="true"></i> Удалить линию</button>
                                </form>
                            </details>
                        }
                    </article>
                }
                </div>
                @if (Model.CanManage)
                {
                    <details class="telephony-sip-line telephony-sip-line--new">
                        <summary><i class="fa-solid fa-plus" aria-hidden="true"></i> Добавить линию Билайна</summary>
                        <form asp-controller="TelephonySettings" asp-action="SaveSipProviderAccount" method="post" class="telephony-sip-account-grid" autocomplete="off">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
                            <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Beeline" />
                            <label class="settings-field"><span class="settings-field-label">Название линии</span><input type="text" name="Name" required maxlength="100" placeholder="Например, Общий номер офиса" /></label>
                            <label class="settings-field"><span class="settings-field-label">Тип линии</span><select name="Mode" required><option value="shared">Общая многоканальная</option><option value="personal">Персональная одноканальная</option></select></label>
                            <label class="settings-field"><span class="settings-field-label">SIP proxy</span><input type="text" name="Server" required maxlength="253" placeholder="ekt.ip.beeline.ru" /></label>
                            <label class="settings-field"><span class="settings-field-label">Domain</span><input type="text" name="Domain" maxlength="253" placeholder="ip.beeline.ru" /></label>
                            <label class="settings-field"><span class="settings-field-label">SIP User ID</span><input type="text" name="SipLogin" required maxlength="128" /></label>
                            <label class="settings-field"><span class="settings-field-label">Authorization User ID</span><input type="text" name="AuthorizationLogin" required maxlength="256" /></label>
                            <label class="settings-field"><span class="settings-field-label">SIP-пароль</span><input type="password" name="Password" required maxlength="4096" autocomplete="new-password" /></label>
                            <div class="telephony-sip-account-grid__pair">
                                <label class="settings-field"><span class="settings-field-label">Порт</span><input type="number" name="Port" value="5060" min="1" max="65535" required /></label>
                                <label class="settings-field"><span class="settings-field-label">Транспорт (обычно UDP)</span><select name="Transport" required><option value="udp">UDP</option><option value="tcp">TCP</option></select></label>
                            </div>
                            <label class="telephony-sip-outbound-option"><input type="checkbox" name="UseForOutbound" value="true" /><span><strong>Линия офиса по умолчанию</strong><small>Для персональной линии этот флаг не используется.</small></span></label>
                            <div class="telephony-sip-account-grid__actions"><button type="submit" class="settings-primary-btn">Подключить линию</button><span>После сохранения линия автоматически передаётся Asterisk.</span></div>
                        </form>
                    </details>
                }
            </div>
        </section>
    }

    @if (isAsterisk || isPlusofon || isBeeline)
    {
        <section class="card telephony-card telephony-staff-card telephony-office-users-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Пользователи телефонии</h2>
                    <p class="settings-card-subtitle">Внутренний номер и линия исходящих звонков — как в привычных настройках Bitrix24</p>
                </div>
                @if (Model.CanManage && Model.OfficeUsers.Count > 0)
                {
                    <button type="button"
                            class="settings-primary-btn settings-primary-btn--compact telephony-add-user-btn"
                            data-telephony-open-user>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        Подключить сотрудника
                    </button>
                }
                else if (Model.CanManage)
                {
                    <a class="settings-primary-btn settings-primary-btn--compact telephony-add-user-btn"
                       href="@Url.Action("Index", "Settings", new { tab = "offices", officeId = Model.OfficeId })">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        Подключить сотрудника
                    </a>
                }
            </div>
            <div class="card-body telephony-staff-body">
                @if (Model.OfficeUsers.Count == 0)
                {
                    <div class="telephony-staff-empty">
                        <i class="fa-solid fa-users" aria-hidden="true"></i>
                        <div>
                            <strong>В офисе пока нет сотрудников</strong>
                            <p>Добавьте сотрудников в офис, чтобы назначить внутренние номера и линии исходящих звонков.</p>
                        </div>
                    </div>
                }
                else
                {
                <div class="telephony-staff-table telephony-staff-table--bitrix" role="table" aria-label="Пользователи телефонии">
                    <div class="telephony-staff-table__head" role="row">
                        <span>Пользователь</span>
                        <span>Внутренний номер</span>
                        <span>Номер для исходящего звонка</span>
                        <span>Телефонный аппарат</span>
                        <span></span>
                    </div>
                    @foreach (var user in Model.OfficeUsers)
                    {
                        phoneUsersByUser.TryGetValue(user.Id, out var phoneUser);
                        var displayName = string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;
                        <div class="telephony-staff-table__row" role="row">
                            <span class="telephony-employee">
                                <span class="telephony-employee__avatar">@displayName.Trim()[0]</span>
                                <span>
                                    <strong>@displayName</strong>
                                    <small>@PanelRoles.Label(user.Role)</small>
                                </span>
                            </span>
                            <span class="telephony-mono">@(phoneUser?.ProviderUserKey ?? "—")</span>
                            <span>
                                <span class="telephony-line-name">@OutboundLineLabel(phoneUser?.OutboundProvider)</span>
                            </span>
                            <span>
                                <span class="settings-status-pill @(phoneUser is null ? "settings-status-pill--disabled" : "settings-status-pill--online")">
                                    @(phoneUser is null ? "Не подключён" : "Встроенная телефония")
                                </span>
                            </span>
                            <span class="telephony-staff-table__actions">
                                @if (Model.CanManage)
                                {
                                    <button type="button"
                                            class="settings-secondary-btn telephony-edit-btn"
                                            title="Настроить внутренний номер и линию исходящих звонков"
                                            data-telephony-open-user
                                            data-user-id="@user.Id"
                                            data-user-name="@displayName"
                                            data-provider-key="@phoneUser?.ProviderUserKey"
                                            data-outbound-provider="@(phoneUser?.OutboundProvider ?? CrmTelephonyOutboundProviders.Default)">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        Настроить
                                    </button>
                                }
                                else
                                {
                                    <span class="telephony-muted">Только просмотр</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                }
            </div>
        </section>
    }

    @if (!isBeeline)
    {
    <div class="telephony-settings-grid">
        <section class="card telephony-card telephony-receiver-card" id="telephonyReceiver">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Приём звонков</h2>
                    <p class="settings-card-subtitle">@providerLabel отправляет событие после завершения разговора</p>
                </div>
                <span class="settings-status-pill @(Model.Settings.IsEnabled ? "settings-status-pill--online" : "settings-status-pill--disabled")">
                    @(Model.Settings.IsEnabled ? "Включён" : Model.Settings.IsConfigured ? "Приостановлен" : "Не настроен")
                </span>
            </div>
            <div class="card-body telephony-receiver-body">
                <p>
                    Орбита сопоставляет номер клиента с основной или дополнительной телефонией карточки,
                    сохраняет направление и длительность звонка и показывает запись в ленте.
                </p>
                @if (Model.CanManage)
                {
                <div class="telephony-actions">
                    <form asp-controller="TelephonySettings" asp-action="RotateTelephonyReceiver" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="officeId" value="@Model.OfficeId" />
                        <input type="hidden" name="provider" value="@Model.Provider" />
                        <button type="submit" class="settings-primary-btn">
                            @(Model.Settings.IsConfigured ? "Перевыпустить адрес" : $"Создать адрес {providerLabel}")
                        </button>
                    </form>
                    @if (Model.Settings.IsConfigured)
                    {
                        <form asp-controller="TelephonySettings" asp-action="SetTelephonyEnabled" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="officeId" value="@Model.OfficeId" />
                            <input type="hidden" name="provider" value="@Model.Provider" />
                            <input type="hidden" name="enabled" value="@(Model.Settings.IsEnabled ? "false" : "true")" />
                            <button type="submit" class="settings-secondary-btn">
                                @(Model.Settings.IsEnabled ? "Приостановить" : "Включить")
                            </button>
                        </form>
                    }
                </div>
                }
                @if (Model.Settings.IsConfigured)
                {
                    <p class="telephony-configured-note">
                        Идентификатор приёмника: <code>@Model.Settings.PublicId</code>. Секрет хранится в БД только в виде хеша.
                    </p>
                }
            </div>
        </section>

        @if (!isAsterisk)
        {
        <section class="card telephony-card telephony-staff-card">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Линии сотрудников</h2>
                    <p class="settings-card-subtitle">Кто и с какого внутреннего номера работает через @providerLabel</p>
                </div>
                @if (Model.CanManage)
                {
                    <button type="button"
                            class="settings-primary-btn settings-primary-btn--compact"
                            data-telephony-open-binding>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        Привязать линию
                    </button>
                }
            </div>
            <div class="telephony-note">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                <div>
                    <strong>Как это работает</strong>
                    <p>Сначала линия или внутренний номер создаётся на SIP-сервере либо у провайдера. Здесь Орбита только связывает уже существующий номер с сотрудником, чтобы определить автора звонка и записать разговор в карточку клиента.</p>
                </div>
            </div>
            <div class="card-body telephony-staff-body">
                <div class="telephony-staff-table" role="table" aria-label="Линии сотрудников">
                    <div class="telephony-staff-table__head" role="row">
                        <span>Сотрудник</span>
                        <span>Провайдер</span>
                        <span>Внутренний номер</span>
                        <span>Исходящий номер</span>
                        <span>Статус</span>
                        <span></span>
                    </div>
                    @foreach (var user in Model.OfficeUsers)
                    {
                        bindingsByUser.TryGetValue(user.Id, out var binding);
                        var displayName = string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName;
                        <div class="telephony-staff-table__row" role="row">
                            <span class="telephony-employee">
                                <span class="telephony-employee__avatar">@displayName.Trim()[0]</span>
                                <span>
                                    <strong>@displayName</strong>
                                    <small>@PanelRoles.Label(user.Role)</small>
                                </span>
                            </span>
                            <span><strong>@providerLabel</strong></span>
                            <span class="telephony-mono">@(binding?.ProviderUserKey ?? "—")</span>
                            <span class="telephony-muted">@(binding is null ? "—" : "По маршруту провайдера")</span>
                            <span>
                                <span class="settings-status-pill @(binding is null ? "settings-status-pill--disabled" : "settings-status-pill--online")">
                                    @(binding is null ? "Не подключён" : "Готов к работе")
                                </span>
                            </span>
                            <span class="telephony-staff-table__actions">
                                @if (Model.CanManage)
                                {
                                    <button type="button"
                                            class="settings-secondary-btn telephony-edit-btn"
                                            data-telephony-open-binding
                                            data-user-id="@user.Id"
                                            data-user-name="@displayName"
                                            data-provider-key="@binding?.ProviderUserKey">
                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        @(binding is null ? "Настроить" : "Изменить")
                                    </button>
                                }
                                else
                                {
                                    <span class="telephony-muted">Только просмотр</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        </section>
        }
    </div>
    }
</div>

@if ((isAsterisk || isPlusofon || isBeeline) && Model.CanManage)
{
<div class="telephony-modal" data-telephony-user-modal hidden>
    <button type="button" class="telephony-modal__backdrop" data-telephony-close-user aria-label="Закрыть"></button>
    <section class="telephony-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="telephonyUserTitle">
        <header class="telephony-modal__header">
            <div>
                <span class="telephony-modal__eyebrow">@Model.OfficeName · телефония офиса</span>
                <h2 id="telephonyUserTitle">Настройка сотрудника</h2>
                <p>Внутренний номер определяет менеджера, а исходящая линия — через какого оператора будет выполнен звонок.</p>
            </div>
            <button type="button" class="telephony-modal__close" data-telephony-close-user aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <form asp-controller="TelephonySettings" asp-action="SaveTelephonyBinding" method="post" class="telephony-modal__form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
            <input type="hidden" name="Provider" value="@CrmTelephonyProviders.Asterisk" />
            <label class="settings-field telephony-modal__wide">
                <span class="settings-field-label">Пользователь</span>
                <select name="UserId" required data-telephony-phone-user-select>
                    <option value="">Выберите сотрудника</option>
                    @foreach (var user in Model.OfficeUsers)
                    {
                        <option value="@user.Id">@(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName)</option>
                    }
                </select>
            </label>
            <label class="settings-field">
                <span class="settings-field-label">Внутренний номер</span>
                <input type="text" inputmode="numeric" pattern="[0-9]{1,8}" name="ProviderUserKey" required maxlength="8" placeholder="Например, 201" data-telephony-phone-extension />
            </label>
            <label class="settings-field">
                <span class="settings-field-label">Номер для исходящего звонка</span>
                <select name="OutboundProvider" data-telephony-outbound-provider>
                    <option value="@CrmTelephonyOutboundProviders.Default">Линия офиса по умолчанию</option>
                    @if (Model.PhoneUsers.Any(binding => string.Equals(
                        binding.OutboundProvider,
                        CrmTelephonyProviders.Plusofon,
                        StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@CrmTelephonyProviders.Plusofon" hidden>Плюсофон · старое назначение</option>
                    }
                    @foreach (var account in plusofonAccounts)
                    {
                        var accountOutboundValue = CrmTelephonyOutboundProviders.ForPlusofonLine(account.AccountKey);
                        var assignedPhoneUser = Model.PhoneUsers.FirstOrDefault(binding =>
                            string.Equals(binding.OutboundProvider, accountOutboundValue, StringComparison.OrdinalIgnoreCase)
                            || (account.AccountKey == "default"
                                && string.Equals(binding.OutboundProvider, CrmTelephonyProviders.Plusofon, StringComparison.OrdinalIgnoreCase)));
                        <option value="@accountOutboundValue"
                                data-sip-account
                                data-account-mode="@account.Mode"
                                data-assigned-user-id="@assignedPhoneUser?.UserId"
                                data-office-default="@account.UseForOutbound.ToString().ToLowerInvariant()">
                            Плюсофон · @account.Name · @(account.Mode == CrmSipAccountModes.Personal ? "персональная" : "общая")
                        </option>
                    }
                    @foreach (var account in beelineAccounts)
                    {
                        var accountOutboundValue = CrmTelephonyOutboundProviders.ForBeelineLine(account.AccountKey);
                        var assignedPhoneUser = Model.PhoneUsers.FirstOrDefault(binding =>
                            string.Equals(binding.OutboundProvider, accountOutboundValue, StringComparison.OrdinalIgnoreCase)
                            || (account.AccountKey == "default"
                                && string.Equals(binding.OutboundProvider, CrmTelephonyProviders.Beeline, StringComparison.OrdinalIgnoreCase)));
                        <option value="@accountOutboundValue"
                                data-sip-account
                                data-account-mode="@account.Mode"
                                data-assigned-user-id="@assignedPhoneUser?.UserId"
                                data-office-default="@account.UseForOutbound.ToString().ToLowerInvariant()">
                            Билайн · @account.Name · @(account.Mode == CrmSipAccountModes.Personal ? "персональная" : "общая")
                        </option>
                    }
                </select>
            </label>
            <div class="telephony-provider-note telephony-modal__wide">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                <span>SIP‑логин и пароль оператора остаются общими реквизитами офиса и сотруднику не показываются.</span>
            </div>
            <footer class="telephony-modal__footer telephony-modal__wide">
                <button type="button" class="settings-secondary-btn" data-telephony-close-user>Отмена</button>
                <button type="submit" class="settings-primary-btn">Сохранить</button>
            </footer>
        </form>
    </section>
</div>
}

@if (Model.CanManage)
{
<div class="telephony-modal" data-telephony-binding-modal hidden>
    <button type="button" class="telephony-modal__backdrop" data-telephony-close-binding aria-label="Закрыть"></button>
    <section class="telephony-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="telephonyBindingTitle">
        <header class="telephony-modal__header">
            <div>
                <span class="telephony-modal__eyebrow">@Model.OfficeName · @providerLabel</span>
                <h2 id="telephonyBindingTitle">Привязка линии к сотруднику</h2>
                <p>Выберите сотрудника и укажите уже созданный внутренний номер или SIP-логин. Новая линия в телефонии здесь не создаётся.</p>
            </div>
            <button type="button" class="telephony-modal__close" data-telephony-close-binding aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <form asp-controller="TelephonySettings" asp-action="SaveTelephonyBinding" method="post" class="telephony-modal__form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="OfficeId" value="@Model.OfficeId" />
            <input type="hidden" name="Provider" value="@Model.Provider" />
            <label class="settings-field telephony-modal__wide">
                <span class="settings-field-label">Сотрудник</span>
                <select name="UserId" required data-telephony-user-select>
                    <option value="">Выберите сотрудника</option>
                    @foreach (var user in Model.OfficeUsers)
                    {
                        <option value="@user.Id">@(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName)</option>
                    }
                </select>
            </label>
            <label class="settings-field">
                <span class="settings-field-label">Провайдер</span>
                <input type="text" value="@providerLabel" disabled />
            </label>
            <label class="settings-field">
                <span class="settings-field-label">Внутренний номер / SIP-логин</span>
                <input type="text" name="ProviderUserKey" required maxlength="128" placeholder="Например, 201" data-telephony-provider-key />
                <small class="telephony-field-note">Значение должно совпадать с номером на SIP-сервере или в кабинете провайдера.</small>
            </label>
            <div class="telephony-provider-note telephony-modal__wide">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                <span>Пароль SIP, исходящий номер и маршрутизация настраиваются у провайдера или на SIP-сервере. Орбита не запрашивает и не показывает эти секреты.</span>
            </div>
            <div class="telephony-permissions telephony-modal__wide">
                <span class="settings-field-label">Разрешённые действия</span>
                <span><i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i> Исходящие звонки</span>
                <span><i class="fa-solid fa-phone-volume" aria-hidden="true"></i> Входящие звонки</span>
                <span><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> Запись разговора</span>
            </div>
            <footer class="telephony-modal__footer telephony-modal__wide">
                <button type="button" class="settings-secondary-btn" data-telephony-close-binding>Отмена</button>
                <button type="submit" class="settings-primary-btn">Сохранить привязку</button>
            </footer>
        </form>
    </section>
</div>
}
