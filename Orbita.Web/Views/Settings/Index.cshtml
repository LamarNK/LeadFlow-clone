@model SettingsIndexViewModel
@using Orbita.Contracts
@{
    ViewData["Title"] = "Администрирование";
    var logs = Model.Logs;
    var workers = Model.Workers;

    var logsPagination = logs?.Pagination;
    var rotatedApiKey = ViewBag.RotatedWorkerApiKey as string;
    var rotatedOfficeSecret = ViewBag.RotatedOfficeRegistrationSecret as string;
    var officesTab = Model.Offices;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main settings-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="settings-alert settings-alert--success" role="status">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="settings-alert settings-alert--error" role="alert">@Model.ErrorMessage</div>
    }

    <div class="settings-control-bar">
        <nav class="settings-tabs" aria-label="Разделы настроек">
            @foreach (var tab in Model.Tabs)
            {
                var isActive = tab.Id == Model.ActiveTab;
                <a class="settings-tab @(isActive ? "settings-tab--active" : "")"
                   href="@Url.Action("Index", new { tab = tab.Id })"
                   aria-current="@(isActive ? "page" : null)">@tab.Label</a>
            }
        </nav>
    </div>

    @if (Model.ActiveTab == "offices" && officesTab is not null)
    {
        var selectedOffice = officesTab.Selected;

        @if (!string.IsNullOrWhiteSpace(rotatedOfficeSecret))
        {
            <div class="settings-alert settings-alert--api-key" role="status">
                <span class="settings-api-key-label">Новый секрет регистрации офиса:</span>
                <code class="settings-api-key-value" id="rotatedOfficeSecret">@rotatedOfficeSecret</code>
                <button type="button" class="settings-link-btn" data-settings-copy-api-key data-copy-target="rotatedOfficeSecret">Копировать</button>
            </div>
        }

        <div class="settings-grid settings-grid--offices">
            <aside class="settings-office-directory" aria-labelledby="officeDirectoryTitle">
                <header class="settings-office-directory__head">
                    <div>
                        <h2 class="settings-card-title" id="officeDirectoryTitle">Офисы</h2>
                        <p class="settings-card-subtitle">Каждый офис хранит свои данные, сотрудников и подключения.</p>
                    </div>
                    <span class="settings-office-count" aria-label="Всего офисов: @officesTab.Rows.Count">@officesTab.Rows.Count</span>
                </header>

                @if (officesTab.Rows.Count == 0)
                {
                    <p class="settings-office-directory__empty">Офисов пока нет. Создайте первый, чтобы подключить сотрудников и воркеры.</p>
                }
                else
                {
                    <nav class="settings-office-directory__list" aria-label="Выбор офиса">
                        @foreach (var office in officesTab.Rows)
                        {
                            var isSelected = selectedOffice?.Id == office.Id;
                            <a class="settings-office-directory__item @(isSelected ? "settings-office-directory__item--active" : null)"
                               href="@Url.Action("Index", new { tab = "offices", officeId = office.Id })"
                               aria-current="@(isSelected ? "page" : null)">
                                <span class="settings-office-directory__icon" aria-hidden="true"><i class="fa-solid fa-building"></i></span>
                                <span class="settings-office-directory__copy">
                                    <strong>@office.Name</strong>
                                    <small>@office.UserCount @(office.UserCount == 1 ? "сотрудник" : "сотрудников") · @office.WorkerCount @(office.WorkerCount == 1 ? "воркер" : "воркеров")</small>
                                </span>
                                <span class="settings-office-directory__state @(office.IsEnabled ? "settings-office-directory__state--online" : null)" aria-label="@(office.IsEnabled ? "Активен" : "Отключён")"></span>
                            </a>
                        }
                    </nav>
                }

                <a class="settings-office-directory__create" href="@Url.Action("Index", new { tab = "offices" })">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Новый офис</span>
                </a>
            </aside>

            @if (selectedOffice is not null)
            {
                var selected = selectedOffice;
                var selectedRow = officesTab.Rows.FirstOrDefault(row => row.Id == selected.Id);
                <section class="settings-office-workspace" aria-labelledby="selectedOfficeTitle">
                    <header class="settings-office-workspace__head">
                        <div>
                            <h2 class="settings-office-workspace__title" id="selectedOfficeTitle">@selected.Name</h2>
                            <p class="settings-office-workspace__subtitle">Управляйте базовыми параметрами, подключениями и безопасностью в одном контексте.</p>
                        </div>
                        <span class="settings-status-pill @(selected.IsEnabled ? "settings-status-pill--online" : "settings-status-pill--disabled")">
                            @(selected.IsEnabled ? "Офис активен" : "Офис отключён")
                        </span>
                    </header>

                    <dl class="settings-office-pulse" aria-label="Сводка по офису">
                        <div>
                            <dt>Сотрудники</dt>
                            <dd>@(selectedRow?.UserCount ?? 0)</dd>
                        </div>
                        <div>
                            <dt>Воркеры</dt>
                            <dd>@(selectedRow?.WorkerCount ?? 0)</dd>
                        </div>
                        <div>
                            <dt>Приём откликов</dt>
                            <dd class="settings-office-pulse__state @(selected.CrmEnabled ? "settings-office-pulse__state--good" : null)">@(selected.CrmEnabled ? "Включён" : "Выключен")</dd>
                        </div>
                        <div>
                            <dt>Регистрация воркеров</dt>
                            <dd class="settings-office-pulse__state @(selected.RegistrationConfigured ? "settings-office-pulse__state--good" : "settings-office-pulse__state--warn")">@(selected.RegistrationConfigured ? "Готова" : "Не настроена")</dd>
                        </div>
                    </dl>

                    <div class="settings-office-workspace__body">
                        <section class="settings-office-section settings-office-section--primary">
                            <div class="settings-office-section-head">
                                <div>
                                    <h3 class="settings-office-section-title">Основное</h3>
                                    <p class="settings-office-section-hint">Название и доступность офиса для работы в панели.</p>
                                </div>
                            </div>
                            <form asp-action="UpdateOffice" method="post" class="settings-create-form settings-office-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="OfficeId" value="@selected.Id" />
                                <label class="settings-field">
                                    <span class="settings-field-label">Название</span>
                                    <input type="text" name="Name" value="@selected.Name" required maxlength="200" />
                                </label>
                                <div class="settings-options">
                                    <div class="settings-option">
                                        <div class="settings-option-text">
                                            <span class="settings-option-label">Офис активен</span>
                                            <span class="settings-option-desc">Воркеры и операторы офиса доступны в панели</span>
                                        </div>
                                        <label class="worker-toggle" title="Офис активен">
                                            <input type="checkbox" name="IsEnabled" value="true" @(selected.IsEnabled ? "checked" : null) />
                                            <span class="worker-toggle-slider"></span>
                                        </label>
                                    </div>
                                    <div class="settings-option">
                                        <div class="settings-option-text">
                                            <span class="settings-option-label">Офис принимает отклики</span>
                                            <span class="settings-option-desc">Операторы всех офисов могут отправлять отклики в CRM этого офиса</span>
                                        </div>
                                        <label class="worker-toggle" title="Офис принимает отклики">
                                            <input type="checkbox" name="CrmEnabled" value="true" @(selected.CrmEnabled ? "checked" : null) />
                                            <span class="worker-toggle-slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="settings-office-form-actions">
                                    <button type="submit" class="settings-primary-btn">Сохранить изменения</button>
                                </div>
                            </form>
                        </section>

                        <section class="settings-office-section settings-office-section--connections">
                            <div class="settings-office-section-head">
                                <div>
                                    <h3 class="settings-office-section-title">Подключения</h3>
                                    <p class="settings-office-section-hint">Сервисы, которые работают в контексте этого офиса.</p>
                                </div>
                            </div>
                            <div class="settings-office-connections">
                                <div class="settings-office-connection">
                                    <span class="settings-office-connection__icon settings-office-connection__icon--bitrix" aria-hidden="true"><i class="fa-solid fa-diagram-project"></i></span>
                                    <div class="settings-office-connection__copy">
                                        <strong>Bitrix24</strong>
                                        <span>@selected.BitrixValidationStatusLabel@(string.IsNullOrWhiteSpace(selected.BitrixPortalHost) ? string.Empty : $" · {selected.BitrixPortalHost}")</span>
                                    </div>
                                    <a class="settings-secondary-btn settings-secondary-btn--compact"
                                       href="@Url.Action(nameof(Index), new { tab = "bitrix", officeId = selected.Id })">Открыть</a>
                                </div>
                                <div class="settings-office-connection">
                                    <span class="settings-office-connection__icon settings-office-connection__icon--telephony" aria-hidden="true"><i class="fa-solid fa-phone-volume"></i></span>
                                    <div class="settings-office-connection__copy">
                                        <strong>Телефония</strong>
                                        <span>Линии, внутренние номера, звонки и записи сотрудников.</span>
                                    </div>
                                    <a class="settings-secondary-btn settings-secondary-btn--compact"
                                       href="@Url.Action("Telephony", "TelephonySettings", new { officeId = selected.Id })">Открыть</a>
                                </div>
                            </div>
                        </section>

                        <section class="settings-office-section settings-office-section--security">
                            <div class="settings-office-section-head">
                                <div>
                                    <h3 class="settings-office-section-title">Безопасность и регистрация</h3>
                                    <p class="settings-office-section-hint">Секрет нужен только при установке Orbita.Worker на компьютеры этого офиса.</p>
                                </div>
                                <span class="settings-registration-status @(selected.RegistrationConfigured ? "settings-registration-status--ok" : "settings-registration-status--warn")">
                                    @(selected.RegistrationConfigured ? "Настроен" : "Не настроен")
                                </span>
                            </div>
                            <div class="settings-office-secret-panel">
                                <code class="settings-office-secret-value">@selected.MaskedRegistrationSecret</code>
                                <form asp-action="RotateOfficeRegistrationSecret" method="post" class="settings-office-secret-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="officeId" value="@selected.Id" />
                                    <button type="submit" class="settings-secondary-btn">Перевыпустить секрет</button>
                                </form>
                            </div>
                        </section>

                        <details class="settings-office-danger-zone">
                            <summary>Опасные действия</summary>
                            <p>
                                Удаление сотрёт связанные настройки Bitrix и CRM-карточки, а сотрудников отвяжет от офиса.
                                Оно недоступно, пока есть привязанные воркеры или это последний офис.
                            </p>
                            <form asp-action="DeleteOffice"
                                  method="post"
                                  class="settings-office-delete-form"
                                  data-confirm-message="Удалить офис «@selected.Name»? Это действие нельзя отменить."
                                  onsubmit="return confirm(this.getAttribute('data-confirm-message'));">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="officeId" value="@selected.Id" />
                                <button type="submit" class="settings-danger-btn">Удалить офис</button>
                            </form>
                        </details>
                    </div>
                </section>
            }
            else
            {
                <section class="settings-office-empty-state" aria-labelledby="newOfficeTitle">
                    <div class="settings-office-empty-state__head">
                        <div>
                            <h2 class="settings-office-workspace__title" id="newOfficeTitle">Создайте офис</h2>
                            <p class="settings-office-workspace__subtitle">Офис изолирует сотрудников, воркеры, интеграции и события от остальных команд.</p>
                        </div>
                    </div>
                    <form asp-action="CreateOffice" method="post" class="settings-create-form settings-office-empty-state__form">
                        @Html.AntiForgeryToken()
                        <label class="settings-field">
                            <span class="settings-field-label">Название</span>
                            <input type="text" name="Name" required maxlength="200" placeholder="Например, Екатеринбург" />
                        </label>
                        <button type="submit" class="settings-primary-btn">Создать офис</button>
                    </form>
                </section>
            }
        </div>
    }
    else if (Model.ActiveTab == "users")
    {
        var userGroups = Model.UserGroups;
        <div class="settings-grid settings-grid--users">
            <div class="card card--settings-users">
                <div class="card-header settings-card-header">
                    <div>
                        <h2 class="settings-card-title">Пользователи панели</h2>
                        <p class="settings-card-subtitle">Всего @Model.Users.Count · сгруппированы по офисам</p>
                    </div>
                </div>
                <div class="card-body settings-users-body" data-settings-users>
                    <div class="settings-users-toolbar" role="search">
                        <label class="settings-filter-field settings-filter-field--grow">
                            <span class="settings-filter-label">Поиск</span>
                            <input type="search"
                                   class="settings-input"
                                   data-settings-users-search
                                   placeholder="ФИО или email"
                                   autocomplete="off" />
                        </label>
                        <label class="settings-filter-field">
                            <span class="settings-filter-label">Профиль</span>
                            <select class="settings-select" data-settings-users-role>
                                <option value="">Все профили</option>
                                @foreach (var opt in Model.ProfileOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </label>
                        <label class="settings-filter-field">
                            <span class="settings-filter-label">Офис</span>
                            <select class="settings-select" data-settings-users-office>
                                <option value="">Все офисы</option>
                                <option value="admins">Администраторы</option>
                                @foreach (var opt in Model.OfficeOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                                <option value="unassigned">Без офиса</option>
                            </select>
                        </label>
                    </div>

                    @if (userGroups.Count == 0)
                    {
                        <p class="settings-users-empty">Пользователей пока нет.</p>
                    }
                    else
                    {
                        <div class="settings-users-groups">
                            @foreach (var group in userGroups)
                            {
                                <section class="settings-user-group"
                                         data-settings-user-group
                                         data-group-kind="@group.Kind"
                                         data-group-office-id="@(group.OfficeId ?? string.Empty)">
                                    <header class="settings-user-group__header">
                                        <div class="settings-user-group__title-wrap">
                                            <h3 class="settings-user-group__title">@group.Title</h3>
                                            @if (!string.IsNullOrWhiteSpace(group.Subtitle))
                                            {
                                                <span class="settings-user-group__subtitle">@group.Subtitle</span>
                                            }
                                        </div>
                                        <span class="settings-user-group__count" data-settings-user-group-count>@group.Users.Count</span>
                                    </header>
                                    <div class="settings-table-wrap">
                                        <table class="data-table data-table--settings-users data-table--cards">
                                            <thead>
                                            <tr>
                                                <th>Пользователь</th>
                                                <th>Доступ</th>
                                                <th>Офис</th>
                                                <th>Bitrix24</th>
                                                <th class="data-table-actions-col">Действия</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var user in group.Users)
                                            {
                                                var searchText = $"{user.FullName} {user.Email}".Trim();
                                                var displayName = string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName.Trim();
                                                <tr data-settings-user-row
                                                    data-user-role="@user.Role"
                                                    data-user-office-id="@(user.OfficeId?.ToString("D") ?? string.Empty)"
                                                    data-user-group-kind="@group.Kind"
                                                    data-user-search="@searchText">
                                                    <td class="settings-user-person" data-label="Пользователь">
                                                        <span class="settings-user-person__content">
                                                            <strong class="settings-user-person__name">@displayName</strong>
                                                            <span class="settings-user-email">@user.Email</span>
                                                            @if (user.IsOnline)
                                                            {
                                                                <span class="settings-user-presence settings-user-presence--online">Онлайн</span>
                                                            }
                                                            else if (user.LastSeenAtUtc is not null)
                                                            {
                                                                <span class="settings-user-presence settings-user-presence--offline">
                                                                    Был(а) онлайн <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(user.LastSeenAtUtc, "activity"))" />
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="settings-user-presence settings-user-presence--unknown">Не входил(а)</span>
                                                            }
                                                            <span class="settings-user-person__badges">
                                                                @if (user.IsCurrentUser)
                                                                {
                                                                    <span class="settings-user-badge">Вы</span>
                                                                }
                                                                @if (user.IsLocked)
                                                                {
                                                                    <span class="settings-user-badge settings-user-badge--locked">Заблокирован</span>
                                                                }
                                                            </span>
                                                        </span>
                                                    </td>
                                                    <td class="settings-user-access" data-label="Доступ">
                                                        <span class="settings-role-pill">@user.RoleLabel</span>
                                                        @if (user.HasPermissionOverride)
                                                        {
                                                            <span class="settings-user-access__hint">Индивидуальные права</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="settings-user-access__hint">Как у профиля</span>
                                                        }
                                                    </td>
                                                    <td class="settings-user-office" data-label="Офис">
                                                        @if (user.Role == PanelRoles.Admin)
                                                        {
                                                            <span>Все офисы</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@(user.OfficeName ?? "Не назначен")</span>
                                                        }
                                                    </td>
                                                    <td data-label="Bitrix24">
                                                        @if (user.OfficeId is Guid userOfficeId)
                                                        {
                                                            <a class="settings-bitrix-status settings-bitrix-status--@user.BitrixStatusTone"
                                                               href="@Url.Action("Index", new { tab = "offices", officeId = userOfficeId })">
                                                                @user.BitrixStatusLabel
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="settings-bitrix-status settings-bitrix-status--@user.BitrixStatusTone">@user.BitrixStatusLabel</span>
                                                        }
                                                    </td>
                                                    <td class="data-table-menu" data-label="">
                                                        <div class="row-menu" data-row-menu>
                                                            <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                                                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                                            </button>
                                                            <div class="row-menu-dropdown" hidden>
                                                                <button type="button"
                                                                        class="row-menu-item"
                                                                        data-settings-edit-user
                                                                        data-user-id="@user.Id"
                                                                        data-user-email="@user.Email"
                                                                        data-user-full-name="@user.FullName"
                                                                        data-user-role="@user.Role"
                                                                        data-user-office-id="@(user.OfficeId?.ToString() ?? string.Empty)"
                                                                        data-user-permissions="@string.Join(',', user.EffectivePermissions)"
                                                                        data-user-has-permission-override="@user.HasPermissionOverride.ToString().ToLowerInvariant()"
                                                                        data-user-is-current="@user.IsCurrentUser.ToString().ToLowerInvariant()">
                                                                    Редактировать
                                                                </button>
                                                                @if (!user.IsCurrentUser)
                                                                {
                                                                    @if (user.IsLocked)
                                                                    {
                                                                        <form asp-action="UnlockUser" method="post" class="settings-inline-form">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                                            <button type="submit" class="row-menu-item">Разблокировать</button>
                                                                        </form>
                                                                    }
                                                                    else
                                                                    {
                                                                        <form asp-action="LockUser" method="post" class="settings-inline-form">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="userId" value="@user.Id" />
                                                                            <button type="submit" class="row-menu-item">Заблокировать</button>
                                                                        </form>
                                                                    }
                                                                    <form asp-action="RevokeUserSessions" method="post" class="settings-inline-form">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                                        <button type="submit" class="row-menu-item">Завершить сессии</button>
                                                                    </form>
                                                                    <form asp-action="DeleteUser" method="post" class="settings-inline-form">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                                        <button type="submit" class="row-menu-item row-menu-item--danger">
                                                                            Удалить
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            }
                        </div>
                        <p class="settings-users-empty" data-settings-users-empty hidden>Никого не найдено по выбранным условиям.</p>
                    }
                </div>
            </div>

            <div class="settings-users-aside">
            <div class="card card--settings-create card--settings-create-user">
                <div class="card-header settings-card-header">
                    <div>
                        <h2 class="settings-card-title">Новый пользователь</h2>
                        <p class="settings-card-subtitle">Доступ появится сразу после создания.</p>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="CreateUser" method="post" class="settings-create-form settings-create-user-form">
                        @Html.AntiForgeryToken()
                        <label class="settings-field">
                            <span class="settings-field-label">ФИО</span>
                            <input type="text" name="FullName" required maxlength="256" placeholder="Иванов Иван Иванович" autocomplete="name" />
                        </label>
                        <label class="settings-field">
                            <span class="settings-field-label">Email</span>
                            <input type="email" name="Email" required placeholder="user@example.com" autocomplete="username" />
                        </label>
                        <label class="settings-field">
                            <span class="settings-field-label">Пароль</span>
                            <input type="password" name="Password" required minlength="8" placeholder="Минимум 8 символов" autocomplete="new-password" />
                        </label>
                        <label class="settings-field" data-settings-create-user-office-field>
                            <span class="settings-field-label">Офис</span>
                            <select name="OfficeId"
                                    class="settings-select"
                                    aria-label="Офис нового пользователя"
                                    data-settings-create-user-office
                                    required>
                                @foreach (var opt in Model.OfficeOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </label>
                        <label class="settings-field">
                            <span class="settings-field-label">Профиль</span>
                            <select name="Role"
                                    class="settings-select"
                                    aria-label="Профиль нового пользователя"
                                    data-settings-create-user-role
                                    required>
                                @foreach (var opt in Model.ProfileOptions)
                                {
                                    if (opt.Value == PanelRoles.Operator)
                                    {
                                        <option value="@opt.Value" selected>@opt.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                }
                            </select>
                        </label>
                        <button type="submit" class="settings-primary-btn settings-create-user-form__submit">
                            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                            <span>Добавить</span>
                        </button>
                    </form>
                </div>
            </div>
            @{
                var presence = Model.PresenceStats;
            }
            @if (presence is not null)
            {
                <section class="card card--settings-user-presence" data-settings-user-presence>
                    <div class="card-header settings-card-header">
                        <div>
                            <h2 class="settings-card-title">Присутствие</h2>
                            <p class="settings-card-subtitle">Кто в панели сейчас и в какие часы обычно пик (МСК).</p>
                        </div>
                    </div>
                    <div class="card-body settings-user-presence-body">
                        <div class="settings-presence-kpis" aria-label="Сводка по пользователям">
                            <div class="settings-presence-kpi settings-presence-kpi--online">
                                <strong>@presence.Online</strong>
                                <span>Онлайн</span>
                            </div>
                            <div class="settings-presence-kpi">
                                <strong>@presence.Total</strong>
                                <span>Всего</span>
                            </div>
                            <div class="settings-presence-kpi">
                                <strong>@presence.Offline</strong>
                                <span>Офлайн</span>
                            </div>
                            <div class="settings-presence-kpi">
                                <strong>@presence.NeverSeen</strong>
                                <span>Не входили</span>
                            </div>
                        </div>
                        @if (presence.TypicalPeakLabel is not null)
                        {
                            <p class="settings-presence-peak">
                                Пик обычно @presence.TypicalPeakLabel
                                @if (presence.TodayPeakLabel is not null)
                                {
                                    <span>· сегодня до @presence.TodayPeakValue чел. в @presence.TodayPeakLabel</span>
                                }
                            </p>
                        }
                        else
                        {
                            <p class="settings-presence-peak settings-presence-peak--empty">Пиковые часы появятся после работы в панели.</p>
                        }
                        @if (presence.HasHourlyData)
                        {
                            <div class="settings-presence-chart" role="img" aria-label="Активность по часам, московское время">
                                <div class="settings-presence-chart__bars">
                                    @foreach (var hour in presence.Hours)
                                    {
                                        var barClass = "settings-presence-chart__bar"
                                            + (hour.IsTypicalPeak ? " is-peak" : "")
                                            + (hour.IsCurrentHour ? " is-current" : "")
                                            + (hour.HeightPercent == 0 ? " is-empty" : "");
                                        <span class="@barClass"
                                              style="--h:@(hour.HeightPercent)%"
                                              title="@hour.Title"></span>
                                    }
                                </div>
                                <div class="settings-presence-chart__axis" aria-hidden="true">
                                    @foreach (var hour in presence.Hours)
                                    {
                                        if (hour.Hour % 6 == 0)
                                        {
                                            <span>@hour.Hour.ToString("00")</span>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "workers" && workers is not null)
    {
        @if (!string.IsNullOrWhiteSpace(rotatedApiKey))
        {
            <div class="settings-alert settings-alert--api-key" role="status">
                <span class="settings-api-key-label">Новый API-ключ воркера:</span>
                <code class="settings-api-key-value" id="rotatedWorkerApiKey">@rotatedApiKey</code>
                <button type="button" class="settings-link-btn" data-settings-copy-api-key data-copy-target="rotatedWorkerApiKey">Копировать</button>
            </div>
        }

        @if (workers.Registration is not null)
        {
            <div class="card card--settings-registration">
                <div class="card-body settings-registration-body">
                    <div>
                        <h2 class="settings-card-title">Устаревший глобальный секрет</h2>
                        <p class="settings-card-subtitle">Секрет из config для старых установок. Для новых воркеров используйте секрет офиса (вкладка «Офисы»).</p>
                    </div>
                    <div class="settings-registration-meta">
                        <span class="settings-registration-status @(workers.Registration.IsConfigured ? "settings-registration-status--ok" : "settings-registration-status--warn")">
                            @(workers.Registration.IsConfigured ? "Настроен" : "Не настроен")
                        </span>
                        <span class="settings-registration-secret">@workers.Registration.MaskedSecret</span>
                        <span class="settings-registration-source">Источник: @workers.Registration.Source</span>
                    </div>
                </div>
            </div>
        }

        <div class="card card--settings-workers">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Воркеры</h2>
                    <p class="settings-card-subtitle">Переименование, отключение и перевыпуск API-ключей</p>
                </div>
            </div>
            <div class="card-body card-body-table settings-table-wrap">
                <table class="data-table data-table--settings-workers data-table--cards">
                    <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Офис</th>
                        <th>Машина</th>
                        <th>Версия</th>
                        <th>Статус</th>
                        <th>Последний контакт</th>
                        <th>Ключ</th>
                        <th class="data-table-actions-col">Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (workers.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="settings-empty-cell">Воркеры не найдены.</td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var worker in workers.Rows)
                    {
                        <tr class="@(!worker.IsEnabled ? "settings-worker-row--disabled" : null)">
                            <td class="cell-name" data-label="Имя">
                                <form asp-action="RenameWorker" method="post" class="settings-worker-rename-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="WorkerId" value="@worker.Id" />
                                    <input type="text" name="DisplayName" value="@worker.DisplayName" class="settings-worker-name-input" required />
                                    <button type="submit" class="settings-link-btn">Сохранить</button>
                                </form>
                            </td>
                            <td data-label="Офис">@worker.OfficeName</td>
                            <td data-label="Машина">@worker.MachineName</td>
                            <td data-label="Версия">
                                <span class="@(worker.UpdateAvailable ? "settings-version--outdated" : null)">@worker.AppVersion</span>
                                @if (worker.UpdateAvailable)
                                {
                                    <span class="settings-update-badge" title="Доступна версия @(worker.LatestReleaseVersion)">↑</span>
                                }
                            </td>
                            <td data-label="Статус">
                                @if (!worker.IsEnabled)
                                {
                                    <span class="settings-status-pill settings-status-pill--disabled">Отключён</span>
                                }
                                else if (worker.IsOnline)
                                {
                                    <span class="settings-status-pill settings-status-pill--online">Онлайн</span>
                                }
                                else
                                {
                                    <span class="settings-status-pill settings-status-pill--offline">Офлайн</span>
                                }
                            </td>
                            <td class="settings-log-time" data-label="Последний контакт"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(worker.LastSeenAtUtc, "datetime"))" /></td>
                            <td class="settings-log-time" data-label="Ключ"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(worker.ApiKeyRotatedAtUtc, "datetime"))" /></td>
                            <td class="data-table-menu" data-label="">
                                <div class="row-menu" data-row-menu>
                                    <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                    </button>
                                    <div class="row-menu-dropdown" hidden>
                                        @if (worker.IsEnabled)
                                        {
                                            <form asp-action="DisableWorker" method="post" class="settings-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="workerId" value="@worker.Id" />
                                                <button type="submit" class="row-menu-item">Отключить</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="EnableWorker" method="post" class="settings-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="workerId" value="@worker.Id" />
                                                <button type="submit" class="row-menu-item">Включить</button>
                                            </form>
                                        }
                                        <form asp-action="RotateWorkerKey" method="post" class="settings-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@worker.Id" />
                                            <button type="submit" class="row-menu-item">Перевыпустить API-ключ</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "worker-releases" && Model.WorkerReleases is not null)
    {
        var releases = Model.WorkerReleases;
        <div class="card card--settings-worker-releases">
            <div class="card-header settings-card-header">
                <div>
                    <h2 class="settings-card-title">Обновления воркера</h2>
                    <p class="settings-card-subtitle">Перетащите MSI вида Orbita.Worker.Setup-1.0.0.1.msi — версия определится автоматически</p>
                </div>
            </div>
            <div class="card-body settings-worker-releases-body">
                <form asp-action="UploadWorkerRelease" method="post" enctype="multipart/form-data" class="settings-release-upload-form" data-worker-release-upload>
                    @Html.AntiForgeryToken()
                    <input type="file" name="packageFile" accept=".msi" class="settings-release-file-input" required hidden />
                    <div class="settings-release-dropzone" data-worker-release-dropzone tabindex="0" role="button" aria-label="Перетащите MSI или выберите файл">
                        <div class="settings-release-dropzone-icon" aria-hidden="true">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <p class="settings-release-dropzone-title">Перетащите MSI сюда</p>
                        <p class="settings-release-dropzone-hint">или нажмите, чтобы выбрать файл</p>
                        <p class="settings-release-dropzone-file" data-worker-release-file-name hidden></p>
                        <p class="settings-release-dropzone-error" data-worker-release-file-error hidden></p>
                    </div>
                    <div class="settings-release-upload-grid">
                        <label class="settings-filter-field">
                            <span class="settings-filter-label">Версия</span>
                            <input type="text"
                                   name="version"
                                   class="settings-input settings-input--readonly"
                                   data-worker-release-version
                                   placeholder="Определится из имени файла"
                                   readonly />
                        </label>
                        <label class="settings-filter-field settings-filter-field--wide">
                            <span class="settings-filter-label">Заметки к релизу</span>
                            <input type="text" name="releaseNotes" class="settings-input" placeholder="Исправления и изменения" />
                        </label>
                    </div>
                    <button type="submit" class="settings-primary-btn" data-worker-release-submit disabled>Загрузить релиз</button>
                </form>
            </div>
        </div>

        <div class="card card--settings-worker-releases-list">
            <div class="card-body card-body-table settings-table-wrap">
                <table class="data-table data-table--settings-releases data-table--cards">
                    <thead>
                    <tr>
                        <th>Версия</th>
                        <th>Размер</th>
                        <th>SHA256</th>
                        <th>Загружен</th>
                        <th>Статус</th>
                        <th class="data-table-actions-col">Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (releases.Versions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="settings-empty-cell">Релизы ещё не загружены.</td>
                        </tr>
                    }
                    else
                    {
                    @foreach (var release in releases.Versions)
                    {
                        <tr>
                            <td class="cell-name" data-label="Версия">
                                <strong>@release.Version</strong>
                                @if (!string.IsNullOrWhiteSpace(release.ReleaseNotes))
                                {
                                    <div class="settings-release-notes">@release.ReleaseNotes</div>
                                }
                            </td>
                            <td data-label="Размер">@release.FileSizeLabel</td>
                            <td class="settings-release-sha" data-label="SHA256"><code>@release.Sha256[..Math.Min(12, release.Sha256.Length)]…</code></td>
                            <td class="settings-log-time" data-label="Загружен"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(release.UploadedAtUtc, "datetime"))" /></td>
                            <td data-label="Статус">
                                @if (release.IsLatest)
                                {
                                    <span class="settings-status-pill settings-status-pill--online">Актуальная</span>
                                }
                                else
                                {
                                    <span class="settings-status-pill settings-status-pill--offline">Архив</span>
                                }
                            </td>
                            <td class="data-table-actions-col" data-label="">
                                <div class="settings-release-actions">
                                    @if (!release.IsLatest)
                                    {
                                        <form asp-action="SetWorkerReleaseLatest" method="post" class="settings-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="version" value="@release.Version" />
                                            <button type="submit" class="settings-link-btn">Сделать актуальной</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteWorkerRelease" method="post" class="settings-inline-form" onsubmit="return confirm('Удалить версию @release.Version?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="version" value="@release.Version" />
                                        <button type="submit" class="settings-link-btn settings-link-btn--danger">Удалить</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "profiles")
    {
        <div class="settings-profiles-grid">
            @foreach (var accessProfile in Model.Profiles)
            {
                <article class="card card--settings-profile">
                    <div class="card-body">
                        <div class="settings-profile-head">
                            <div class="settings-profile-icon">
                                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h2 class="settings-profile-name">@accessProfile.Name</h2>
                                <p class="settings-profile-description">@accessProfile.Description</p>
                            </div>
                        </div>
                        <div class="settings-profile-meta">
                            <span class="settings-profile-count">@accessProfile.UsersCount пользователей</span>
                        </div>
                        <form asp-action="UpdateAccessProfile" method="post" class="settings-profile-permissions">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProfileId" value="@accessProfile.Id" />
                            <span class="settings-profile-permissions-label">Права доступа</span>
                            <div class="settings-profile-permission-list">
                                @foreach (var permission in PanelPermissions.All)
                                {
                                    var isGranted = accessProfile.Permissions.Contains(permission.Id, StringComparer.Ordinal);
                                    var isRequiredForAdmin = accessProfile.Id == "admin"
                                        && permission.Id == PanelPermissions.Administration;
                                    if (isRequiredForAdmin)
                                    {
                                        <input type="hidden" name="Permissions" value="@permission.Id" />
                                    }
                                    <label class="settings-profile-permission" title="@permission.Description">
                                        <input type="checkbox"
                                               name="Permissions"
                                               value="@permission.Id"
                                               checked="@(isGranted ? "checked" : null)"
                                               disabled="@(isRequiredForAdmin ? "disabled" : null)" />
                                        <span>@permission.Label</span>
                                    </label>
                                }
                            </div>
                            <p class="settings-profile-permissions-hint">Изменение завершит активные сессии пользователей профиля.</p>
                            <button type="submit" class="settings-secondary-btn">Сохранить права</button>
                        </form>
                        <div class="settings-profile-members">
                            <span class="settings-profile-permissions-label">Пользователи</span>
                            @if (accessProfile.Members.Count == 0)
                            {
                                <p class="settings-profile-empty">Нет назначенных пользователей</p>
                            }
                            else
                            {
                                <ul class="settings-profile-member-list">
                                    @foreach (var member in accessProfile.Members)
                                    {
                                        <li>@member.Email</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else if (Model.ActiveTab == "logs" && logs is not null)
    {
        <div class="card card--settings-logs-filters">
            <form class="settings-logs-filters" method="get" asp-action="Index">
                <input type="hidden" name="tab" value="logs" />
                <div class="settings-logs-filters-row">
                    <label class="settings-filter-field">
                        <span class="settings-filter-label">Источник</span>
                        <select name="workerId" class="settings-select" aria-label="Источник логов">
                            @foreach (var opt in logs.WorkerOptions)
                            {
                                var selectedWorker = logs.WorkerId?.ToString("D") ?? "";
                                if (opt.Value == selectedWorker)
                                {
                                    <option value="@opt.Value" selected>@opt.Label</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            }
                        </select>
                    </label>
                    <label class="settings-filter-field">
                        <span class="settings-filter-label">Уровень</span>
                        <select name="level" class="settings-select" aria-label="Уровень">
                            @foreach (var opt in logs.LevelOptions)
                            {
                                if (opt.Value == (logs.Level ?? ""))
                                {
                                    <option value="@opt.Value" selected>@opt.Label</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            }
                        </select>
                    </label>
                    @if (!logs.IsWorkerLogs)
                    {
                        <label class="settings-filter-field">
                            <span class="settings-filter-label">Сервис</span>
                            <select name="service" class="settings-select" aria-label="Сервис">
                                @foreach (var opt in logs.ServiceOptions)
                                {
                                    if (opt.Value == (logs.Service ?? ""))
                                    {
                                        <option value="@opt.Value" selected>@opt.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                }
                            </select>
                        </label>
                    }
                    <label class="settings-filter-field">
                        <span class="settings-filter-label">Дата</span>
                        <input type="date"
                               name="date"
                               class="settings-date-input"
                               value="@logs.Date?.ToString("yyyy-MM-dd")"
                               aria-label="Дата" />
                    </label>
                    <label class="settings-filter-field settings-filter-field--grow">
                        <span class="settings-filter-label">Поиск</span>
                        <input type="search"
                               name="q"
                               class="settings-search-input"
                               value="@logs.SearchQuery"
                               placeholder="Сообщение, источник, trace id..."
                               aria-label="Поиск по логам" />
                    </label>
                    <button type="submit" class="settings-primary-btn settings-primary-btn--compact">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <span>Найти</span>
                    </button>
                </div>
            </form>
        </div>

        <div class="card card--settings-logs-table">
            <partial name="_LogFeed" model="@(new LogFeedPanelViewModel
            {
                Rows = logs.Rows,
                Pagination = logs.Pagination,
                FeedAriaLabel = logs.IsWorkerLogs ? "Логи воркера" : "Логи сервисов",
                ShowServiceTag = !logs.IsWorkerLogs
            })" />

            @if (logsPagination is not null && logsPagination.TotalItems > 0)
            {
                <div class="settings-pagination">
                    <span class="settings-pagination-info">
                        Показано @logsPagination.RangeStart–@logsPagination.RangeEnd из @logsPagination.TotalItems
                    </span>
                    <div class="settings-pagination-controls">
                        @{
                            var prevPage = logsPagination.Page > 1 ? logsPagination.Page - 1 : (int?)null;
                            var nextPage = logsPagination.Page < logsPagination.TotalPages ? logsPagination.Page + 1 : (int?)null;
                        }
                        @if (prevPage is not null)
                        {
                            <a class="settings-page-btn"
                               href="@Url.Action("Index", new { tab = "logs", workerId = logs.WorkerId, q = logs.SearchQuery, level = logs.Level, service = logs.Service, date = logs.Date?.ToString("yyyy-MM-dd"), page = prevPage })"
                               aria-label="Предыдущая страница">&lt;</a>
                        }
                        else
                        {
                            <span class="settings-page-btn settings-page-btn--disabled" aria-hidden="true">&lt;</span>
                        }
                        <span class="settings-page-btn settings-page-btn--active" aria-current="page">@logsPagination.Page</span>
                        @if (nextPage is not null)
                        {
                            <a class="settings-page-btn"
                               href="@Url.Action("Index", new { tab = "logs", workerId = logs.WorkerId, q = logs.SearchQuery, level = logs.Level, service = logs.Service, date = logs.Date?.ToString("yyyy-MM-dd"), page = nextPage })"
                               aria-label="Следующая страница">&gt;</a>
                        }
                        else
                        {
                            <span class="settings-page-btn settings-page-btn--disabled" aria-hidden="true">&gt;</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    <dialog class="settings-dialog settings-dialog--user" id="editUserDialog">
        <form asp-action="UpdateUser"
              method="post"
              class="settings-dialog-form settings-user-dialog"
              id="editUserForm"
              data-update-user-action="@Url.Action("UpdateUser", "Settings")"
              data-orbita-full-submit>
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" id="editUserId" />
            <input type="hidden" name="OriginalFullName" id="editUserOriginalFullName" />
            <input type="hidden" name="OriginalRole" id="editUserOriginalRole" />
            <input type="hidden" name="OriginalOfficeId" id="editUserOriginalOfficeId" />
            <input type="hidden" name="OriginalUseProfilePermissions" id="editUserOriginalUseProfilePermissions" />
            <input type="hidden" name="OriginalPermissionKeys" id="editUserOriginalPermissionKeys" />
            <header class="settings-user-dialog__header">
                <div class="settings-user-dialog__identity">
                    <span class="settings-user-dialog__avatar" id="editUserInitials" aria-hidden="true">П</span>
                    <div>
                        <span class="settings-user-dialog__eyebrow">Пользователь</span>
                        <h2 class="settings-dialog-title">Редактировать пользователя</h2>
                        <p class="settings-dialog-subtitle" id="editUserEmail"></p>
                    </div>
                </div>
                <button type="button" class="settings-user-dialog__close" data-settings-dialog-close aria-label="Закрыть"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </header>
            <div class="settings-user-dialog__body">
                <section class="settings-user-dialog__section">
                    <header class="settings-user-dialog__section-head"><h3>Профиль</h3><p>Основные данные пользователя.</p></header>
                    <label class="settings-field">
                        <span class="settings-field-label">ФИО</span>
                        <input type="text" name="FullName" id="editUserFullName" required maxlength="256" autocomplete="name" />
                    </label>
                </section>
                <section class="settings-dialog-fields settings-user-dialog__section" id="editUserAccessFields">
                    <header class="settings-user-dialog__section-head"><h3>Доступ</h3><p>Роль, офис и разрешения в панели.</p></header>
                    <div class="settings-user-dialog__field-grid">
                        <label class="settings-field">
                            <span class="settings-field-label">Профиль</span>
                            <select name="Role" class="settings-select" id="editUserRole">
                                @foreach (var opt in Model.ProfileOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </label>
                        <label class="settings-field" id="editUserOfficeField">
                            <span class="settings-field-label">Офис</span>
                            <select name="OfficeId" class="settings-select" id="editUserOffice">
                                @foreach (var opt in Model.OfficeOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="settings-field settings-user-dialog__permissions" id="editUserPermissionsField">
                        <div class="settings-user-dialog__permissions-head">
                            <span class="settings-field-label">Права доступа</span>
                            <label class="settings-profile-permission">
                                <input type="checkbox"
                                       name="UseProfilePermissions"
                                       value="true"
                                       id="editUserUseProfilePermissions"
                                       checked />
                                <span>Как у профиля</span>
                            </label>
                        </div>
                        <div class="settings-profile-permission-list" id="editUserPermissionsList">
                            @foreach (var permission in PanelPermissions.All)
                            {
                                <label class="settings-profile-permission" title="@permission.Description">
                                    <input type="checkbox"
                                           name="Permissions"
                                           value="@permission.Id"
                                           data-user-permission-checkbox />
                                    <span>@permission.Label</span>
                                </label>
                            }
                        </div>
                        <span class="settings-user-dialog__hint">Снимите «Как у профиля», чтобы назначить персональные права.</span>
                    </div>
                </section>
                <section class="settings-field settings-user-dialog__section settings-user-dialog__section--password" id="editUserPasswordField">
                    <header class="settings-user-dialog__section-head"><h3>Пароль</h3><p>Необязательное изменение.</p></header>
                    <input type="password" name="Password" id="editUserPassword" minlength="8" autocomplete="new-password" placeholder="Оставьте пустым, чтобы не менять" />
                    <span class="settings-user-dialog__hint">Минимум 8 символов.</span>
                </section>
            </div>
            <footer class="settings-dialog-actions">
                <p class="settings-user-dialog__submit-error" id="editUserSubmitError" role="alert" hidden></p>
                <button type="button" class="settings-secondary-btn" data-settings-dialog-close>Отмена</button>
                <button type="submit" class="settings-primary-btn">Сохранить</button>
            </footer>
        </form>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/orbita-settings.js" asp-append-version="true"></script>
    @if (Model.ActiveTab == "offices")
    {
        <script src="~/js/orbita-bitrix-settings.js" asp-append-version="true"></script>
    }
    @if (Model.ActiveTab == "worker-releases")
    {
        <script src="~/js/orbita-worker-releases.js" asp-append-version="true"></script>
    }
}
