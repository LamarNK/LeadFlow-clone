@model WorkerDetailsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.DisplayName;
    var chartJson = JsonSerializer.Serialize(Model.ActivityChart, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var createdApiKey = TempData["CreatedWorkerApiKey"] as string;
    var installCommand = TempData["CreatedWorkerInstallCommand"] as string;
    var workersError = TempData["WorkersError"] as string;
    var workersSuccess = TempData["WorkersSuccess"] as string;
}
<div class="orbita-main worker-detail-page">
    <nav class="orbita-breadcrumbs" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="worker-detail-head">
        <div class="worker-detail-title-block">
            <div class="worker-detail-title-row">
                <h1 class="worker-detail-title">@Model.DisplayName</h1>
                <span class="status-dot @(Model.IsOnline ? "" : "offline")">
                    <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                    @(Model.IsOnline ? "Онлайн" : "Оффлайн")
                </span>
            </div>
            <p class="worker-detail-sub">
                Последняя активность:
                <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(Model.LastActivityUtc, "time"))" />
            </p>
        </div>
        <div class="worker-detail-toolbar">
            <a href="@Context.Request.Path"
               class="worker-refresh-btn"
               title="Обновить данные"
               data-orbita-refresh>
                <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                <span>Обновить данные</span>
            </a>
        </div>
    </div>

    <div class="kpi-row worker-detail-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <article class="kpi-card kpi-card--stat" style="--kpi-index: @kpiIdx">
                <header class="kpi-card-head">
                    <div class="kpi-icon-box kpi-icon-box--@kpi.IconTone">
                        <i class="@kpi.IconClass" aria-hidden="true"></i>
                    </div>
                    <span class="kpi-card-label">@kpi.Label</span>
                </header>
                <div class="kpi-card-metric">
                    @if (kpi.Label == "Время работы")
                    {
                        <span class="kpi-value kpi-value--text">@kpi.Value</span>
                    }
                    else
                    {
                        <span class="kpi-value"
                              data-kpi-count="@kpi.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              data-kpi-suffix="@(kpi.ValueSuffix ?? "")">0@(kpi.ValueSuffix)</span>
                    }
                    <span class="kpi-delta-pill kpi-delta-@kpi.DeltaTone">@kpi.Delta</span>
                </div>
            </article>
            kpiIdx++;
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(createdApiKey))
    {
        <div class="settings-alert settings-alert--api-key" role="status">
            <span class="settings-api-key-label">API-ключ воркера (сохраните сейчас):</span>
            <code class="settings-api-key-value" id="createdWorkerApiKey">@createdApiKey</code>
            <button type="button" class="settings-link-btn" data-worker-copy data-copy-target="createdWorkerApiKey">Копировать ключ</button>
            @if (!string.IsNullOrWhiteSpace(installCommand))
            {
                <p class="workers-install-cmd-label">Установка на VDS:</p>
                <p class="settings-api-key-value settings-api-key-value--text" id="createdWorkerInstallCmd">@installCommand</p>
                <button type="button" class="settings-link-btn" data-worker-copy data-copy-target="createdWorkerInstallCmd">Копировать инструкцию</button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(workersSuccess))
    {
        <div class="settings-alert settings-alert--success" role="status">@workersSuccess</div>
    }

    @if (!string.IsNullOrWhiteSpace(workersError))
    {
        <div class="settings-alert settings-alert--warn" role="alert">@workersError</div>
    }

    <div class="worker-detail-settings-row">
        <div class="card card--worker-system">
            <div class="card-header"><h2>Система</h2></div>
            <div class="card-body worker-system-metrics">
                <div class="worker-system-metric">
                    <span class="worker-system-label">CPU</span>
                    <span class="worker-system-value">@(Model.CpuPercent.HasValue ? $"{Model.CpuPercent:F1}%" : "—")</span>
                </div>
                <div class="worker-system-metric">
                    <span class="worker-system-label">RAM</span>
                    <span class="worker-system-value">
                        @if (Model.RamPercent.HasValue && Model.RamUsedMb.HasValue && Model.RamTotalMb.HasValue)
                        {
                            @($"{Model.RamPercent:F1}% ({Model.RamUsedMb} / {Model.RamTotalMb} MB)")
                        }
                        else
                        {
                            @("—")
                        }
                    </span>
                </div>
            </div>
        </div>
        <div class="card card--worker-settings">
            <div class="card-header">
                <h2>Настройки воркера</h2>
                <p class="worker-settings-subtitle">Параллелизм и подключение к AdsPower Local API на VDS</p>
            </div>
            <div class="card-body">
                <form asp-action="UpdateSettings" method="post" class="worker-settings-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workerId" value="@Model.WorkerId" />

                    <div class="worker-settings-section">
                        <span class="worker-settings-section-title">Параллелизм</span>
                        <label class="worker-settings-field" for="maxConcurrentAccounts">
                            <span class="worker-settings-label">Аккаунтов одновременно</span>
                            <div class="worker-parallel-controls">
                                <input type="range" id="maxConcurrentAccounts" name="maxConcurrentAccounts" min="1" max="10" value="@Model.MaxConcurrentAccounts" />
                                <output id="maxConcurrentAccountsOut">@Model.MaxConcurrentAccounts</output>
                            </div>
                        </label>
                    </div>

                    <div class="worker-settings-section">
                        <span class="worker-settings-section-title">AdsPower Local API</span>
                        <label class="worker-settings-field" for="adsPowerApiBaseUrl">
                            <span class="worker-settings-label">URL API</span>
                            <input type="url"
                                   id="adsPowerApiBaseUrl"
                                   name="adsPowerApiBaseUrl"
                                   value="@Model.AdsPowerApiBaseUrl"
                                   placeholder="@WorkerDetailsViewModel.DefaultAdsPowerApiBaseUrl"
                                   autocomplete="off"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">
                                Если поле пустое, воркер использует @WorkerDetailsViewModel.DefaultAdsPowerApiBaseUrl
                            </span>
                        </label>
                        <label class="worker-settings-field" for="adsPowerApiKey">
                            <span class="worker-settings-label">API Key</span>
                            <input type="password"
                                   id="adsPowerApiKey"
                                   name="adsPowerApiKey"
                                   value="@Model.AdsPowerApiKey"
                                   placeholder="@(string.IsNullOrWhiteSpace(Model.AdsPowerApiKey) ? "Не задан — запросы без Authorization" : "Ключ задан")"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">
                                Ключ из настроек AdsPower на VDS. Оставьте пустым, если Local API без авторизации.
                            </span>
                        </label>
                        <div class="worker-settings-effective">
                            <span class="worker-settings-label">Текущий URL для воркера</span>
                            <code class="worker-settings-effective-value">@Model.EffectiveAdsPowerApiBaseUrl</code>
                        </div>
                    </div>

                    <div class="worker-settings-actions">
                        <button type="submit" class="worker-refresh-btn">Сохранить настройки</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="worker-detail-grid-main">
        <div class="card card--worker-info">
            <div class="card-header">
                <h2>Общая информация</h2>
            </div>
            <div class="card-body">
                <dl class="worker-info-list">
                    @foreach (var item in Model.InfoItems)
                    {
                        <div class="worker-info-row">
                            <dt class="worker-info-label">@item.Label</dt>
                            <dd class="worker-info-value">
                                @if (item.TimeValue is not null)
                                {
                                    <partial name="_UtcTime" model="item.TimeValue" />
                                }
                                else
                                {
                                    @item.Value
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
        <div class="card card--worker-activity">
            <div class="card-header">
                <h2>Активность за сегодня</h2>
            </div>
            <div class="card-body">
                @if (Model.ActivityChart.HasData)
                {
                    <div class="chart-canvas-wrap chart-canvas-wrap--hourly">
                        <canvas id="chart-worker-activity" aria-label="Активность за сегодня"></canvas>
                    </div>
                }
                else
                {
                    <p class="chart-empty-state">Нет данных за сегодня. Воркер пока не передаёт почасовую статистику откликов.</p>
                }
            </div>
        </div>
    </div>

    <div class="worker-detail-grid-bottom">
        <div class="card card--worker-events">
            <div class="card-header">
                <h2>Последние события</h2>
            </div>
            <div class="card-body">
                <partial name="_WorkerEventList" model="Model.Events" />
                <a class="card-footer-btn" href="@Url.Action("Index", "Events")">Показать все события</a>
            </div>
        </div>
        <div class="card card--worker-stats">
            <div class="card-header">
                <h2>Статистика за период</h2>
            </div>
            <div class="card-body">
                <dl class="worker-stats-list">
                    @foreach (var stat in Model.PeriodStats)
                    {
                        <div class="worker-stats-row">
                            <dt class="worker-stats-label">@stat.Label</dt>
                            <dd class="worker-stats-value">@stat.Value</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="card card--worker-accounts">
        <div class="card-header">
            <h2>Аккаунты воркера</h2>
        </div>
        <div class="card-body card-body-table worker-accounts-wrap">
            <table class="data-table data-table--accounts">
                <thead>
                    <tr>
                        <th>Вкл</th>
                        <th>Аккаунт</th>
                        <th>Статус</th>
                        <th>Баланс</th>
                        <th>Откликов</th>
                        <th>Последняя активность</th>
                        <th>Ошибок</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var account in Model.Accounts)
                {
                    var accountUrl = Url.Action("Index", "Accounts");
                    <tr class="worker-account-row">
                        <td>
                            <form asp-action="UpdateAccount" method="post" class="worker-account-toggle-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="workerId" value="@Model.WorkerId" />
                                <input type="hidden" name="accountId" value="@account.Id" />
                                <input type="hidden" name="isEnabledInPanel" value="false" />
                                <label class="worker-toggle">
                                    <input type="checkbox"
                                           name="isEnabledInPanel"
                                           value="true"
                                           @(account.IsEnabledInPanel ? "checked" : null)
                                           onchange="this.form.submit()" />
                                    <span class="worker-toggle-slider"></span>
                                </label>
                            </form>
                        </td>
                        <td class="cell-name">
                            <a href="@accountUrl">@account.DisplayName</a>
                            @if (!string.IsNullOrWhiteSpace(account.AdsPowerProfileId))
                            {
                                <span class="worker-account-sub">AdsPower @account.AdsPowerProfileId</span>
                            }
                        </td>
                        <td>
                            <span class="account-status account-status--@account.StatusTone">
                                <i class="fa-solid fa-circle account-status-dot" aria-hidden="true"></i>
                                @account.StatusLabel
                            </span>
                        </td>
                        <td>@account.BalanceText</td>
                        <td>@account.Responses</td>
                        <td><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.LastActivityUtc, "time"))" /></td>
                        <td>@account.Errors</td>
                        <td class="data-table-menu">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown" hidden>
                                    <a class="row-menu-item" href="@accountUrl">Открыть</a>
                                    <button type="button" class="row-menu-item">Перезапустить</button>
                                    <button type="button" class="row-menu-item">Просмотреть логи</button>
                                    <button type="button" class="row-menu-item">Настройки</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <script id="worker-charts-data" type="application/json">@Html.Raw(chartJson)</script>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/orbita-worker.js" asp-append-version="true"></script>
}