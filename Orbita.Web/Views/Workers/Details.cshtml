@model WorkerDetailsViewModel
@using System.Linq
@using System.Text.Json
@using Orbita.Contracts
@{
    ViewData["Title"] = Model.DisplayName;
    var subProfileJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var chartJson = JsonSerializer.Serialize(Model.ActivityChart, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var createdApiKey = TempData["CreatedWorkerApiKey"] as string;
    var installCommand = TempData["CreatedWorkerInstallCommand"] as string;
    var workersError = TempData["WorkersError"] as string;
    var workersSuccess = TempData["WorkersSuccess"] as string;
    var workerAccountsSortRoute = new { id = Model.WorkerId, q = Model.AccountSearchQuery, groupId = Model.AccountGroupId, provider = Model.AccountProvider, sort = Model.Sort.Column, dir = Model.Sort.Dir };
    var snapshotUrl = Url.Action("DetailsSnapshot", "Workers", workerAccountsSortRoute)!;
    var adsPowerAccountsUrl = Url.Action("Details", "Workers", new { id = Model.WorkerId, q = Model.AccountSearchQuery, provider = "adspower", sort = Model.Sort.Column, dir = Model.Sort.Dir })!;
    var multiloginAccountsUrl = Url.Action("Details", "Workers", new { id = Model.WorkerId, q = Model.AccountSearchQuery, provider = "multilogin", sort = Model.Sort.Column, dir = Model.Sort.Dir })!;
    var localAccountsUrl = Url.Action("Details", "Workers", new { id = Model.WorkerId, q = Model.AccountSearchQuery, provider = "local", sort = Model.Sort.Column, dir = Model.Sort.Dir })!;
    var isLocalProvider = string.Equals(Model.AccountProvider, "local", StringComparison.Ordinal);
    var scheduleDayLabels = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["Mon"] = "Понедельник",
        ["Tue"] = "Вторник",
        ["Wed"] = "Среда",
        ["Thu"] = "Четверг",
        ["Fri"] = "Пятница",
        ["Sat"] = "Суббота",
        ["Sun"] = "Воскресенье"
    };
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main worker-detail-page"
     data-orbita-live
     data-orbita-live-page="worker"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-id="@Model.WorkerId"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-settings-logs-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = "__id__" })"
     data-responses-filter-url="@Url.Action("Index", "Responses", new { accountId = "__id__" })"

     data-account-metric-responses-url="@($"/Responses?from=__today__&to=__today__&workerId=__workerId__&accountId=__accountId__")"
     data-account-metric-unique-url="@($"/Responses?from=__today__&to=__today__&status=unique&workerId=__workerId__&accountId=__accountId__")"
     data-account-metric-errors-url="@($"/Events?level=errors&workerId=__workerId__&accountId=__accountId__")">
    <nav class="orbita-breadcrumbs" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="worker-detail-head">
        <div class="worker-detail-title-block">
            <div class="worker-detail-title-row">
                @if (!Model.IsEnabled)
                {
                    <span class="status-dot offline">
                        <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                        Отключён
                    </span>
                }
                else
                {
                    <span class="status-dot @(Model.IsOnline ? "" : "offline")" data-worker-online-badge>
                        <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                        @(Model.IsOnline ? "Онлайн" : "Оффлайн")
                    </span>
                }
                <span class="workers-status-badge workers-status-badge--paused" data-worker-pause-badge hidden="@(!Model.IsMonitoringPaused)">
                    Пауза мониторинга
                </span>
            </div>
            <p class="worker-detail-sub">
                Последняя активность:
                <time data-worker-last-activity
                      data-orbita-utc="@OrbitaTime.ToIsoUtc(Model.LastActivityUtc)"
                      data-orbita-format="activity"></time>
            </p>
            <div class="worker-detail-activity" data-worker-current-activity>
                <span class="worker-detail-activity-label">Сейчас:</span>
                @if (Model.ActiveAccountActivities.Count > 1)
                {
                    <div class="worker-detail-activity-list">
                        @foreach (var item in Model.ActiveAccountActivities)
                        {
                            <partial name="_WorkerActivityPill" model="item" />
                        }
                    </div>
                }
                else
                {
                    <partial name="_WorkerActivityPill" model="Model.CurrentActivity" />
                }
            </div>
        </div>
        <div class="worker-detail-toolbar">
            @if (Model.IsEnabled)
            {
                <button type="button" class="worker-refresh-btn" data-worker-restart data-worker-id="@Model.WorkerId">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                    <span>Перезапустить</span>
                </button>
                @* Временно скрыто: маршрут и страница просмотра браузеров сохранены для последующего включения. *@
            }
            <div class="worker-actions-menu" data-row-menu>
                <button type="button" class="worker-actions-trigger row-menu-btn" aria-label="Действия с воркером" aria-expanded="false" aria-haspopup="true">
                    <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                    <span>Действия</span>
                </button>
                <div class="row-menu-dropdown row-menu-dropdown--workers row-menu-dropdown--worker-toolbar" hidden>
                    <button type="button" class="row-menu-item" data-worker-rename-open>
                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                        Переименовать
                    </button>
                    <form asp-action="Disable" method="post" class="settings-inline-form" data-worker-pause-form hidden="@Model.IsMonitoringPaused">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workerId" value="@Model.WorkerId" />
                        <button type="submit" class="row-menu-item">
                            <i class="fa-solid fa-circle-pause" aria-hidden="true"></i>
                            Пауза мониторинга
                        </button>
                    </form>
                    <form asp-action="Enable" method="post" class="settings-inline-form" data-worker-resume-form hidden="@(!Model.IsMonitoringPaused)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workerId" value="@Model.WorkerId" />
                        <button type="submit" class="row-menu-item">
                            <i class="fa-solid fa-circle-play" aria-hidden="true"></i>
                            Возобновить
                        </button>
                    </form>
                    <form asp-action="RotateKey" method="post" class="settings-inline-form" onsubmit="return confirm('Перевыпустить API-ключ? Старый ключ перестанет работать.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workerId" value="@Model.WorkerId" />
                        <button type="submit" class="row-menu-item">
                            <i class="fa-solid fa-key" aria-hidden="true"></i>
                            Перевыпустить API-ключ
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="settings-inline-form" onsubmit="return confirm('Удалить воркер «@Model.DisplayName»? Это действие необратимо.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workerId" value="@Model.WorkerId" />
                        <button type="submit" class="row-menu-item row-menu-item--danger">
                            <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                            Удалить
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="kpi-row worker-detail-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(createdApiKey))
    {
        <div class="settings-alert settings-alert--api-key" role="status">
            <span class="settings-api-key-label">API-ключ воркера (сохраните сейчас):</span>
            <code class="settings-api-key-value" id="createdWorkerApiKey">@createdApiKey</code>
            <button type="button" class="settings-link-btn" data-worker-copy data-copy-target="createdWorkerApiKey">Копировать ключ</button>
            @if (!string.IsNullOrWhiteSpace(installCommand))
            {
                <p class="workers-install-cmd-label">Установка на VDS:</p>
                <p class="settings-api-key-value settings-api-key-value--text" id="createdWorkerInstallCmd">@installCommand</p>
                <button type="button" class="settings-link-btn" data-worker-copy data-copy-target="createdWorkerInstallCmd">Копировать инструкцию</button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(workersSuccess))
    {
        <div class="settings-alert settings-alert--success" role="status">@workersSuccess</div>
    }

    @if (!string.IsNullOrWhiteSpace(workersError))
    {
        <div class="settings-alert settings-alert--warn" role="alert">@workersError</div>
    }

    <div class="worker-detail-settings-row">
        <div class="card card--worker-system">
            <div class="card-header">
                <h2>Система</h2>
                <p class="worker-settings-subtitle">Ресурсы VDS и параметры машины</p>
            </div>
            <div class="card-body">
                <partial name="_WorkerSystemCard" model="Model.System" />
            </div>
        </div>
        <div class="card card--worker-settings" id="worker-settings">
            <div class="card-header">
                <h2>Настройки воркера</h2>
                <p class="worker-settings-subtitle">Параллелизм и подключение к AdsPower, Multilogin X и обычному Chrome</p>
            </div>
            <div class="card-body">
                <form asp-action="UpdateSettings" method="post" class="worker-settings-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workerId" value="@Model.WorkerId" />
                    <input type="hidden" name="settingsTab" id="workerSettingsActiveTab" value="performance" />

                    <div class="worker-settings-shell">
                    <div class="worker-settings-rail">
                    <div class="worker-settings-templates"
                         data-worker-settings-templates
                         data-worker-id="@Model.WorkerId"
                         data-create-url="@Url.Action("CreateSettingsTemplate")"
                         data-update-url="@Url.Action("UpdateSettingsTemplate")"
                         data-delete-url="@Url.Action("DeleteSettingsTemplate")">
                        <div class="worker-settings-templates-head">
                            <span class="worker-settings-templates-title">Шаблоны настроек</span>
                            <span class="worker-settings-hint">Применение только подставляет значения в форму. Чтобы отправить их воркеру, нажмите «Сохранить настройки».</span>
                        </div>
                        <label class="worker-settings-templates-select" for="workerSettingsTemplateSelect">
                            <span class="visually-hidden">Шаблон</span>
                            <select id="workerSettingsTemplateSelect"
                                    class="worker-settings-input"
                                    data-worker-settings-template-select>
                                <option value="">Выберите шаблон</option>
                                @foreach (var template in Model.SettingsTemplates)
                                {
                                    <option value="@template.Id" data-settings="@JsonSerializer.Serialize(template.Settings, subProfileJsonOptions)">@template.Name</option>
                                }
                            </select>
                        </label>
                        <button type="button" class="worker-provider-btn worker-provider-btn--secondary worker-settings-templates-create" data-worker-settings-template-create>
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            Сохранить как новый
                        </button>
                        <label class="worker-settings-templates-name" for="workerSettingsTemplateName">
                            <span class="visually-hidden">Название шаблона</span>
                            <input type="text"
                                   id="workerSettingsTemplateName"
                                   class="worker-settings-input"
                                   maxlength="200"
                                   placeholder="Название шаблона"
                                   autocomplete="off"
                                   data-worker-settings-template-name />
                        </label>
                        <div class="worker-settings-templates-actions">
                            <button type="button" class="worker-provider-btn" data-worker-settings-template-apply>Применить</button>
                            <button type="button" class="worker-provider-btn" data-worker-settings-template-update>Обновить</button>
                            <button type="button" class="worker-provider-btn worker-settings-templates-delete" data-worker-settings-template-delete>Удалить</button>
                        </div>
                    </div>

                    <nav class="worker-settings-nav" role="tablist" aria-label="Разделы настроек воркера">
                        <button type="button" class="worker-settings-nav-link" id="worker-settings-tab-performance" role="tab" aria-selected="true" aria-controls="worker-settings-performance" data-worker-settings-tab="performance">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            Режим работы
                        </button>
                        <button type="button" class="worker-settings-nav-link" id="worker-settings-tab-schedule" role="tab" aria-selected="false" aria-controls="worker-settings-schedule" data-worker-settings-tab="schedule">
                            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                            Расписание
                        </button>
                        <button type="button" class="worker-settings-nav-link" id="worker-settings-tab-collection" role="tab" aria-selected="false" aria-controls="worker-settings-collection" data-worker-settings-tab="collection">
                            <i class="fa-solid fa-filter" aria-hidden="true"></i>
                            Сбор откликов
                        </button>
                        <button type="button" class="worker-settings-nav-link" id="worker-settings-tab-processing" role="tab" aria-selected="false" aria-controls="worker-settings-processing" data-worker-settings-tab="processing">
                            <i class="fa-solid fa-comments" aria-hidden="true"></i>
                            Обработка откликов
                        </button>
                        <button type="button" class="worker-settings-nav-link" id="worker-settings-tab-connection" role="tab" aria-selected="false" aria-controls="worker-settings-connection" data-worker-settings-tab="connection">
                            <i class="fa-solid fa-plug" aria-hidden="true"></i>
                            Подключение
                        </button>
                    </nav>
                    </div>

                    <div class="worker-settings-layout">
                        <div class="worker-settings-groups">
                    <div class="worker-settings-group" id="worker-settings-performance" role="tabpanel" aria-labelledby="worker-settings-tab-performance" data-worker-settings-panel="performance">
                        <div class="worker-settings-panel-head">
                            <div class="worker-settings-panel-copy">
                                <h3 class="worker-settings-panel-title">Режим работы</h3>
                                <p class="worker-settings-panel-desc">Лимит параллельных аккаунтов рассчитывается автоматически по ОЗУ воркера.</p>
                            </div>
                        </div>
                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-gauge-high"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Параллелизм</span>
                                    <p class="worker-settings-block-desc">Аккаунтов одновременно. Применяется в текущем цикле перед стартом следующего аккаунта. Уже открытые браузеры не закрываются при уменьшении лимита.</p>
                                </div>
                            </div>
                            <label class="worker-settings-field" for="maxConcurrentAccounts">
                                <span class="worker-settings-label">Аккаунтов одновременно</span>
                                <div class="worker-parallel-controls">
                                    <input type="range" id="maxConcurrentAccounts" name="maxConcurrentAccounts" min="1" max="@Model.MaxConcurrentAccountsLimit" value="@Model.MaxConcurrentAccounts" />
                                    <output id="maxConcurrentAccountsOut">@Model.MaxConcurrentAccounts</output>
                                </div>
                            </label>
                        </section>
                    </div>

                    <div class="worker-settings-group" id="worker-settings-collection" role="tabpanel" aria-labelledby="worker-settings-tab-collection" data-worker-settings-panel="collection">
                        <div class="worker-settings-panel-head">
                            <div class="worker-settings-panel-copy">
                                <h3 class="worker-settings-panel-title">Сбор откликов</h3>
                                <p class="worker-settings-panel-desc">Отсекают карточки до раскрытия телефона и не отправляют их в панель. Любая включенная галка или лимит ниже начинает работать сразу. Пустые лимиты возраста — без ограничения.</p>
                            </div>
                        </div>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-venus-mars"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Пол — кого не собирать</span>
                                </div>
                            </div>
                            <div class="worker-settings-rows">
                                <div class="worker-settings-row">
                                    <span class="worker-settings-row-icon" aria-hidden="true"><i class="fa-solid fa-mars"></i></span>
                                    <div class="worker-settings-row-copy">
                                        <span class="worker-settings-row-title">Исключать мужчин</span>
                                        <span class="worker-settings-row-desc">По метке «Мужчина» или мужскому ФИО; ники и неоднозначные имена не отсекаем</span>
                                    </div>
                                    <label class="worker-toggle" title="Исключать мужчин">
                                        <input type="checkbox"
                                               id="responseFilterExcludeMale"
                                               name="responseFilterExcludeMale"
                                               value="true"
                                               @(Model.ResponseFilterExcludeMale ? "checked" : null) />
                                        <span class="worker-toggle-slider"></span>
                                    </label>
                                </div>
                                <div class="worker-settings-row">
                                    <span class="worker-settings-row-icon" aria-hidden="true"><i class="fa-solid fa-venus"></i></span>
                                    <div class="worker-settings-row-copy">
                                        <span class="worker-settings-row-title">Исключать женщин</span>
                                        <span class="worker-settings-row-desc">По метке «Женщина» или женскому ФИО; ники и неоднозначные имена не отсекаем</span>
                                    </div>
                                    <label class="worker-toggle" title="Исключать женщин">
                                        <input type="checkbox"
                                               id="responseFilterExcludeFemale"
                                               name="responseFilterExcludeFemale"
                                               value="true"
                                               @(Model.ResponseFilterExcludeFemale ? "checked" : null) />
                                        <span class="worker-toggle-slider"></span>
                                    </label>
                                </div>
                            </div>
                        </section>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-regular fa-id-card"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Макс. возраст по полу</span>
                                    <p class="worker-settings-block-desc">Включительно: «62» оставляет 62 и отсекает 63+. Разные лимиты для мужчин и женщин. Без возраста в карточке — оставляем.</p>
                                </div>
                            </div>
                            <div class="worker-settings-age-grid">
                                <label class="worker-settings-field" for="responseFilterMaxAgeMale">
                                    <span class="worker-settings-label">Мужчины, до (лет)</span>
                                    <input type="number"
                                           id="responseFilterMaxAgeMale"
                                           name="responseFilterMaxAgeMale"
                                           class="worker-settings-input"
                                           min="1"
                                           max="120"
                                           step="1"
                                           value="@(Model.ResponseFilterMaxAgeMale?.ToString() ?? "")"
                                           placeholder="Без лимита"
                                           inputmode="numeric" />
                                </label>
                                <label class="worker-settings-field" for="responseFilterMaxAgeFemale">
                                    <span class="worker-settings-label">Женщины, до (лет)</span>
                                    <input type="number"
                                           id="responseFilterMaxAgeFemale"
                                           name="responseFilterMaxAgeFemale"
                                           class="worker-settings-input"
                                           min="1"
                                           max="120"
                                           step="1"
                                           value="@(Model.ResponseFilterMaxAgeFemale?.ToString() ?? "")"
                                           placeholder="Без лимита"
                                           inputmode="numeric" />
                                </label>
                            </div>
                        </section>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-regular fa-clock"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Давность отклика</span>
                                    <p class="worker-settings-block-desc">Отклики, созданные на Avito раньше этого срока, не собираются. По дате отклика из чата. Пусто — без ограничения.</p>
                                </div>
                            </div>
                            <label class="worker-settings-field" for="responseFilterMaxAgeDays">
                                <span class="worker-settings-label">Пропускать отклики старше (дней)</span>
                                <input type="number"
                                       id="responseFilterMaxAgeDays"
                                       name="responseFilterMaxAgeDays"
                                       class="worker-settings-input"
                                       min="1"
                                       max="365"
                                       step="1"
                                       value="@(Model.ResponseFilterMaxAgeDays?.ToString() ?? "")"
                                       placeholder="Без ограничения"
                                       inputmode="numeric" />
                            </label>
                        </section>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Временные номера Avito</span>
                                    <p class="worker-settings-block-desc">При первом появлении номера отклик сразу уходит в Орбиту. Дальше N часов следим за сменой номера и дописываем историю в тот же отклик; после окна наблюдение закрывается. Ключ: субпрофиль + ФИО (не ID отклика/аккаунта). 0 — не наблюдать после первой отправки. По умолчанию 120 (5 суток).</p>
                                </div>
                            </div>
                            <label class="worker-settings-field" for="phoneUnchangedHours">
                                <span class="worker-settings-label">Окно наблюдения (часов) после первой отправки</span>
                                <input type="number"
                                       id="phoneUnchangedHours"
                                       name="phoneUnchangedHours"
                                       class="worker-settings-input"
                                       min="0"
                                       max="720"
                                       step="1"
                                       value="@(Model.PhoneUnchangedHours?.ToString() ?? "120")"
                                       placeholder="120"
                                       inputmode="numeric" />
                            </label>
                        </section>
                    </div>

                    <div class="worker-settings-group" id="worker-settings-processing" role="tabpanel" aria-labelledby="worker-settings-tab-processing" data-worker-settings-panel="processing">
                        <div class="worker-settings-panel-head">
                            <div class="worker-settings-panel-copy">
                                <h3 class="worker-settings-panel-title">Обработка откликов</h3>
                                <p class="worker-settings-panel-desc">Подсвечивает отклики этого воркера в общем списке — по возрасту, профилю или субпрофилю Avito.</p>
                            </div>
                            <label class="worker-settings-switch" title="Включить пометку откликов">
                                <span class="worker-settings-switch-label">Включить пометку откликов</span>
                                <span class="worker-toggle">
                                    <input type="checkbox"
                                           id="responseHighlightEnabled"
                                           name="responseHighlightEnabled"
                                           value="true"
                                           @(Model.ResponseHighlightEnabled ? "checked" : null) />
                                    <span class="worker-toggle-slider"></span>
                                </span>
                            </label>
                        </div>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-regular fa-clock"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Подсветка откликов</span>
                                    <p class="worker-settings-block-desc">Выберите возрастные группы, профили или субпрофили ниже</p>
                                </div>
                            </div>
                            <div class="worker-settings-dependent" data-worker-settings-depends-on="responseHighlightEnabled">
                                @{
                                    var selectedHighlightBuckets = (Model.ResponseHighlightAgeBuckets ?? string.Empty)
                                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                    var selectedHighlightTargets = ResponseHighlightRules.ParseTargets(Model.ResponseHighlightTargetsJson)
                                        .Select(x => x.ToFormValue())
                                        .ToHashSet(StringComparer.Ordinal);
                                }
                                <span class="worker-settings-subsection-title">Возраст кандидата</span>
                                <div class="worker-settings-chip-grid">
                                    @foreach (var bucket in Model.ResponseHighlightBucketOptions)
                                    {
                                        var isChecked = selectedHighlightBuckets.Contains(bucket);
                                        <label class="worker-settings-chip-option">
                                            <input type="checkbox"
                                                   name="responseHighlightAgeBuckets"
                                                   value="@bucket"
                                                   @(isChecked ? "checked" : null) />
                                            <span>@bucket</span>
                                        </label>
                                    }
                                </div>
                                <span class="worker-settings-subsection-title">Профили Avito</span>
                                <div class="worker-highlight-profiles" data-worker-highlight-profiles>
                                    @if (Model.HighlightAccounts.Count == 0)
                                    {
                                        <p class="worker-settings-hint">Аккаунтов пока нет. Они появятся после синхронизации AdsPower или Multilogin, либо добавьте аккаунт обычного браузера.</p>
                                    }
                                    @foreach (var account in Model.HighlightAccounts)
                                    {
                                        var profileTarget = new ResponseHighlightTarget(account.Id).ToFormValue();
                                        var isProfileSelected = selectedHighlightTargets.Contains(profileTarget);
                                        var hasSubProfiles = account.SubProfiles.Count > 0;
                                        var selectedSubProfilesCount = account.SubProfiles.Count(subProfile =>
                                            selectedHighlightTargets.Contains(new ResponseHighlightTarget(account.Id, subProfile.Id).ToFormValue()));
                                        var isExpanded = isProfileSelected || selectedSubProfilesCount > 0;
                                        var subProfilesLabel = account.SubProfiles.Count == 1
                                            ? "1 субпрофиль"
                                            : $"{account.SubProfiles.Count} субпрофилей";
                                        <section class="worker-highlight-profile@(isExpanded ? " is-expanded" : string.Empty)" data-worker-highlight-profile>
                                            <div class="worker-highlight-profile__header">
                                                @if (hasSubProfiles)
                                                {
                                                    <button type="button"
                                                            class="worker-highlight-profile__toggle"
                                                            data-worker-highlight-profile-toggle
                                                            aria-expanded="@(isExpanded ? "true" : "false")"
                                                            title="Показать субпрофили">
                                                        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Показать субпрофили</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="worker-highlight-profile__toggle worker-highlight-profile__toggle--empty" aria-hidden="true">
                                                        <i class="fa-solid fa-minus"></i>
                                                    </span>
                                                }
                                                <label class="worker-highlight-profile__account" title="Подсвечивать отклики со всего профиля">
                                                    <input type="checkbox"
                                                           name="responseHighlightTargets"
                                                           value="@profileTarget"
                                                           @(isProfileSelected ? "checked" : null) />
                                                    <span>@account.DisplayName</span>
                                                    <span class="worker-provider-chip worker-provider-chip--@account.ProfileProviderTone" title="@account.ProfileIdTitle">@account.ProfileProviderLabel</span>
                                                </label>
                                                <span class="worker-highlight-profile__meta">
                                                    @if (hasSubProfiles)
                                                    {
                                                        <span>@subProfilesLabel</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Без субпрофилей</span>
                                                    }
                                                    <span class="worker-highlight-profile__selected"
                                                          data-worker-highlight-profile-selected
                                                          @(isProfileSelected || selectedSubProfilesCount > 0 ? null : "hidden")>
                                                        Выбрано: @(selectedSubProfilesCount + (isProfileSelected ? 1 : 0))
                                                    </span>
                                                </span>
                                            </div>
                                            @if (hasSubProfiles)
                                            {
                                                <div class="worker-highlight-profile__subprofiles"
                                                     data-worker-highlight-profile-panel
                                                     aria-hidden="@(isExpanded ? "false" : "true")"
                                                     @(isExpanded ? null : "hidden")>
                                                    @foreach (var subProfile in account.SubProfiles)
                                                    {
                                                        var subProfileTarget = new ResponseHighlightTarget(account.Id, subProfile.Id).ToFormValue();
                                                        <label class="worker-highlight-profile__subprofile">
                                                            <input type="checkbox"
                                                                   name="responseHighlightTargets"
                                                                   value="@subProfileTarget"
                                                                   @(selectedHighlightTargets.Contains(subProfileTarget) ? "checked" : null) />
                                                            <span>@subProfile.Name</span>
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </div>
                        </section>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-regular fa-user"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Автоответ в чатах Avito</span>
                                    <p class="worker-settings-block-desc">Ответ отправляется, если кандидат написал в чат, а менеджер ещё не ответил.</p>
                                </div>
                                <label class="worker-toggle" title="Включить автоответы">
                                    <input type="checkbox"
                                           id="messengerAutoReplyEnabled"
                                           name="messengerAutoReplyEnabled"
                                           value="true"
                                           @(Model.MessengerAutoReplyEnabled ? "checked" : null) />
                                    <span class="worker-toggle-slider"></span>
                                </label>
                            </div>
                            <div class="worker-settings-dependent" data-worker-settings-depends-on="messengerAutoReplyEnabled">
                                <label class="worker-settings-field" for="messengerAutoReplyMessage">
                                    <span class="worker-settings-label">Текст автоответа</span>
                                    <textarea id="messengerAutoReplyMessage"
                                              name="messengerAutoReplyMessage"
                                              class="worker-settings-textarea"
                                              maxlength="2000"
                                              rows="3"
                                              placeholder="Доброго времени суток, наши коллеги с вами свяжутся и поподробнее расскажут о вакансии.">@Model.MessengerAutoReplyMessage</textarea>
                                    <span class="worker-settings-hint">
                                        Максимум 2000 символов. Если поле пустое, автоответ не отправляется даже при включённой опции.
                                    </span>
                                </label>
                            </div>
                        </section>

                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-share"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Авто-отправка откликов</span>
                                    <p class="worker-settings-block-desc">
                                        Офис назначения: <strong>@(string.IsNullOrWhiteSpace(Model.OfficeName) ? "—" : Model.OfficeName)</strong>.
                                        CRM — основной канал; Bitrix24 — временный (legacy).
                                    </p>
                                </div>
                            </div>
                            <div class="worker-settings-rows">
                                <div class="worker-settings-row">
                                    <span class="worker-settings-row-icon" aria-hidden="true"><i class="fa-regular fa-comments"></i></span>
                                    <div class="worker-settings-row-copy">
                                        <span class="worker-settings-row-title">Авто в CRM</span>
                                        <span class="worker-settings-row-desc">Создавать карточку CRM и назначать менеджеру на смене</span>
                                    </div>
                                    <label class="worker-toggle" title="Авто в CRM">
                                        <input type="checkbox"
                                               id="autoDeliverToCrm"
                                               name="autoDeliverToCrm"
                                               value="true"
                                               @(Model.AutoDeliverToCrm ? "checked" : null) />
                                        <span class="worker-toggle-slider"></span>
                                    </label>
                                </div>
                                <div class="worker-settings-row">
                                    <span class="worker-settings-row-icon" aria-hidden="true"><i class="fa-solid fa-diagram-project"></i></span>
                                    <div class="worker-settings-row-copy">
                                        <span class="worker-settings-row-title">Авто в Bitrix24 (legacy)</span>
                                        <span class="worker-settings-row-desc">Отправлять по схеме связей офиса</span>
                                    </div>
                                    <label class="worker-toggle" title="Авто в Bitrix">
                                        <input type="checkbox"
                                               id="autoDeliverToBitrix"
                                               name="autoDeliverToBitrix"
                                               value="true"
                                               @(Model.AutoDeliverToBitrix ? "checked" : null) />
                                        <span class="worker-toggle-slider"></span>
                                    </label>
                                </div>
                            </div>
                        </section>
                    </div>

                    <div class="worker-settings-group" id="worker-settings-schedule" role="tabpanel" aria-labelledby="worker-settings-tab-schedule" data-worker-settings-panel="schedule">
                        <div class="worker-settings-panel-head">
                            <div class="worker-settings-panel-copy">
                                <h3 class="worker-settings-panel-title">Расписание</h3>
                                <p class="worker-settings-panel-desc">Воркер будет автоматически включаться только в выбранные дни и часы, а вне окна сам выключится.</p>
                            </div>
                            <label class="worker-settings-switch" title="Включить расписание">
                                <span class="worker-settings-switch-label">Включить расписание</span>
                                <span class="worker-toggle">
                                    <input type="checkbox"
                                           id="autoScheduleEnabled"
                                           name="autoScheduleEnabled"
                                           value="true"
                                           @(Model.AutoScheduleEnabled ? "checked" : null) />
                                    <span class="worker-toggle-slider"></span>
                                </span>
                            </label>
                        </div>
                        <section class="worker-settings-block">
                            <div class="worker-settings-block-head">
                                <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-regular fa-calendar"></i></span>
                                <div class="worker-settings-block-copy">
                                    <span class="worker-settings-block-title">Автовключение по расписанию</span>
                                    <p class="worker-settings-block-desc">Пример: будни с 07:00 до 19:00</p>
                                </div>
                            </div>
                            <div class="worker-settings-dependent" data-worker-settings-depends-on="autoScheduleEnabled">
                                @{
                                    var selectedScheduleDays = (Model.AutoScheduleDays ?? string.Empty)
                                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                }
                                <span class="worker-settings-subsection-title" id="schedule-days-title">Дни работы</span>
                                <div class="worker-schedule-days" role="group" aria-labelledby="schedule-days-title">
                                    @foreach (var day in Model.AutoScheduleDayOptions)
                                    {
                                        var isChecked = selectedScheduleDays.Contains(day);
                                        var dayLabel = scheduleDayLabels.TryGetValue(day, out var label) ? label : day;
                                        <label class="worker-schedule-day" title="@dayLabel">
                                            <input type="checkbox"
                                                   name="autoScheduleDays"
                                                   value="@day"
                                                   aria-label="@dayLabel"
                                                   @(isChecked ? "checked" : null) />
                                            <span aria-hidden="true">@dayLabel</span>
                                        </label>
                                    }
                                </div>

                                <span class="worker-settings-subsection-title">Рабочее время</span>
                                <div class="worker-settings-age-grid worker-schedule-time-grid">
                                    <label class="worker-settings-field" for="autoScheduleFromLocalTime">
                                        <span class="worker-settings-label">С</span>
                                        <input type="time"
                                               id="autoScheduleFromLocalTime"
                                               name="autoScheduleFromLocalTime"
                                               class="worker-settings-input"
                                               value="@Model.AutoScheduleFromLocalTime" />
                                    </label>
                                    <label class="worker-settings-field" for="autoScheduleToLocalTime">
                                        <span class="worker-settings-label">До</span>
                                        <input type="time"
                                               id="autoScheduleToLocalTime"
                                               name="autoScheduleToLocalTime"
                                               class="worker-settings-input"
                                               value="@Model.AutoScheduleToLocalTime" />
                                    </label>
                                </div>
                                <span class="worker-settings-hint">
                                    Время московское. Если окно пересекает полночь, например 19:00-07:00, оно тоже поддерживается.
                                </span>
                            </div>
                        </section>
                    </div>

                    <div class="worker-settings-group worker-settings-group--advanced" id="worker-settings-connection" role="tabpanel" aria-labelledby="worker-settings-tab-connection" data-worker-settings-panel="connection">
                    <div class="worker-settings-panel-head">
                        <div class="worker-settings-panel-copy">
                            <h3 class="worker-settings-panel-title">Подключение</h3>
                            <p class="worker-settings-panel-desc">Источники браузеров, ключи API и проверка связи с AdsPower, Multilogin X и обычным Chrome.</p>
                        </div>
                    </div>
                    <section class="worker-settings-block">
                        <div class="worker-settings-block-head">
                            <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-window-restore"></i></span>
                            <div class="worker-settings-block-copy">
                                <span class="worker-settings-block-title">Источники браузеров</span>
                            </div>
                        </div>
                        <div class="worker-provider-sources" data-provider-sources>
                        @foreach (var card in new[] { Model.AdsPowerCheck, Model.MultiloginCheck, Model.LocalChromeCheck })
                        {
                            var enabledName = card.Provider switch
                            {
                                "Multilogin" => "multiloginEnabled",
                                "Local" => "localChromeEnabled",
                                _ => "adsPowerEnabled"
                            };
                            var enabled = card.Provider switch
                            {
                                "Multilogin" => Model.MultiloginEnabled,
                                "Local" => Model.LocalChromeEnabled,
                                _ => Model.AdsPowerEnabled
                            };
                            var title = card.Provider switch
                            {
                                "Multilogin" => "Multilogin X",
                                "Local" => "Обычный браузер",
                                _ => "AdsPower"
                            };
                            var toggleTitle = card.Provider switch
                            {
                                "Multilogin" => "Использовать Multilogin",
                                "Local" => "Использовать обычный браузер",
                                _ => "Использовать AdsPower"
                            };
                            var iconClass = card.Provider switch
                            {
                                "Multilogin" => "fa-solid fa-layer-group",
                                "Local" => "fa-brands fa-chrome",
                                _ => "fa-solid fa-window-restore"
                            };
                            var iconTone = card.Provider switch
                            {
                                "Multilogin" => "mlx",
                                "Local" => "local",
                                _ => "ads"
                            };
                            var resultMessage = card.Status == WorkerBrowserProviderStatus.Disabled
                                ? ""
                                : (card.Message ?? "");
                            <div class="worker-provider-row"
                                 data-provider-card="@card.Provider"
                                 data-provider-status="@card.Status">
                                <span class="worker-provider-row__icon worker-provider-row__icon--@iconTone" aria-hidden="true">
                                    <i class="@iconClass"></i>
                                </span>
                                <span class="worker-provider-row__name">@title</span>
                                <span class="worker-provider-status worker-provider-status--@card.Status" data-provider-status-label>@card.StatusLabel</span>
                                <span class="worker-provider-row__result">
                                    <span class="worker-provider-row__message" data-provider-message>@resultMessage</span>
                                    <span class="worker-provider-row__time" data-provider-checked-at @(card.CheckedAtUtc is null ? "hidden" : null)>
                                        @if (card.CheckedAtUtc is not null)
                                        {
                                            <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(card.CheckedAtUtc.Value, "activity"))" />
                                        }
                                    </span>
                                </span>
                                <label class="worker-provider-row__toggle" title="@toggleTitle">
                                    <span class="worker-toggle">
                                        <input type="checkbox"
                                               name="@enabledName"
                                               value="true"
                                               aria-label="@toggleTitle"
                                               data-provider-toggle="@card.Provider"
                                               @(enabled ? "checked" : null) />
                                        <span class="worker-toggle-slider"></span>
                                    </span>
                                </label>
                                <span class="worker-provider-row__actions" data-provider-actions>
                                    <button type="button"
                                            class="worker-provider-btn"
                                            data-provider-check="@card.Provider"
                                            data-worker-id="@Model.WorkerId"
                                            data-can-check="@(card.CanCheck ? "true" : "false")"
                                            title="@(card.CanCheck ? null : card.Status == WorkerBrowserProviderStatus.Checking
                                                ? WorkerBrowserProviderMessages.CheckingMessage
                                                : card.Status == WorkerBrowserProviderStatus.NeedsSetup
                                                    ? WorkerBrowserProviderMessages.NeedsToken
                                                    : card.Status == WorkerBrowserProviderStatus.Disabled
                                                        ? WorkerBrowserProviderMessages.DisabledHint
                                                        : WorkerBrowserProviderMessages.CheckAlreadyQueued)"
                                            @(card.CanCheck ? null : "disabled")>
                                        Проверить
                                    </button>
                                    @if (WorkerBrowserProviderKinds.SupportsCatalogSync(card.Provider))
                                    {
                                        <button type="button"
                                                class="worker-provider-btn worker-provider-btn--secondary"
                                                data-provider-sync="@card.Provider"
                                                data-worker-id="@Model.WorkerId"
                                                data-can-sync="@(card.CanSync ? "true" : "false")"
                                                title="@(card.CanSync ? null : WorkerBrowserProviderMessages.SyncAlreadyQueued)"
                                                @(card.CanSync ? null : "hidden")>
                                            Синхронизировать
                                        </button>
                                    }
                                </span>
                            </div>
                        }
                        </div>
                    </section>

                    <div class="worker-settings-section worker-settings-block" data-provider-section="AdsPower" @(Model.AdsPowerEnabled ? null : "hidden")>
                        <div data-provider-fields="AdsPower">
                        <label class="worker-settings-field" for="adsPowerApiBaseUrl">
                            <span class="worker-settings-label">URL API</span>
                            <input type="url"
                                   id="adsPowerApiBaseUrl"
                                   name="adsPowerApiBaseUrl"
                                   class="worker-settings-input"
                                   value="@Model.AdsPowerApiBaseUrl"
                                   placeholder="@WorkerDetailsViewModel.DefaultAdsPowerApiBaseUrl"
                                   autocomplete="off"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">
                                Если поле пустое, воркер использует @WorkerDetailsViewModel.DefaultAdsPowerApiBaseUrl
                            </span>
                        </label>
                        <label class="worker-settings-field" for="adsPowerApiKey">
                            <span class="worker-settings-label">API Key</span>
                            <input type="password"
                                   id="adsPowerApiKey"
                                   name="adsPowerApiKey"
                                   class="worker-settings-input"
                                   value="@Model.AdsPowerApiKey"
                                   placeholder="@(string.IsNullOrWhiteSpace(Model.AdsPowerApiKey) ? "Не задан — запросы без Authorization" : "Ключ задан")"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">
                                Ключ из настроек AdsPower на VDS. Оставьте пустым, если Local API без авторизации.
                            </span>
                        </label>
                        <label class="worker-settings-field" for="adsPowerGroupId">
                            <span class="worker-settings-label">Группа AdsPower</span>
                            <select id="adsPowerGroupId"
                                    name="adsPowerGroupId"
                                    class="worker-settings-input">
                                <option value="">Все группы</option>
                                @foreach (var group in Model.AdsPowerGroups)
                                {
                                    var isSelected = string.Equals(group.GroupId, Model.AdsPowerGroupId, StringComparison.Ordinal);
                                    var groupLabel = string.IsNullOrWhiteSpace(group.GroupName) ? group.GroupId : group.GroupName;
                                    if (isSelected)
                                    {
                                        <option value="@group.GroupId" selected="selected">@groupLabel</option>
                                    }
                                    else
                                    {
                                        <option value="@group.GroupId">@groupLabel</option>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.AdsPowerGroupId)
                                     && !Model.AdsPowerGroups.Any(g => string.Equals(g.GroupId, Model.AdsPowerGroupId, StringComparison.Ordinal)))
                                {
                                    var pendingLabel = string.IsNullOrWhiteSpace(Model.AdsPowerGroupName) ? Model.AdsPowerGroupId : Model.AdsPowerGroupName;
                                    <option value="@Model.AdsPowerGroupId" selected="selected">@pendingLabel</option>
                                }
                            </select>
                            <span class="worker-settings-hint" data-ads-group-hint @(Model.AdsPowerGroups.Count > 0 ? "hidden" : null)>
                                Сначала проверьте подключение — список групп появится после успешной проверки.
                            </span>
                            <span class="worker-settings-hint" data-ads-group-ready @(Model.AdsPowerGroups.Count > 0 ? null : "hidden")>
                                В AdsPower профили делятся по группам. Выберите группу этого воркера — в список попадут только её профили.
                            </span>
                        </label>
                        </div>
                    </div>

                    <div class="worker-settings-section worker-settings-block" data-provider-section="Multilogin" @(Model.MultiloginEnabled ? null : "hidden")>
                        <div data-provider-fields="Multilogin">
                        <label class="worker-settings-field" for="multiloginAutomationToken">
                            <span class="worker-settings-label">API Token</span>
                            <input type="password"
                                   id="multiloginAutomationToken"
                                   name="multiloginAutomationToken"
                                   class="worker-settings-input"
                                   value=""
                                   placeholder="@(Model.HasMultiloginAutomationToken ? "Токен задан — оставьте пустым, чтобы не менять" : "Скопируйте в Multilogin → Информация → Токен API")"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">
                                Вставьте Token API из Multilogin → Информация. Orbita сама получит и сохранит долгоживущий automation token; ID проекта не нужен.
                            </span>
                        </label>
                        <details class="worker-settings-advanced">
                            <summary>Дополнительно</summary>
                            <label class="worker-settings-field" for="multiloginLauncherUrl">
                                <span class="worker-settings-label">Launcher URL</span>
                                <input type="url"
                                       id="multiloginLauncherUrl"
                                       name="multiloginLauncherUrl"
                                       class="worker-settings-input"
                                       value="@Model.MultiloginLauncherUrl"
                                       placeholder="@WorkerDetailsViewModel.DefaultMultiloginLauncherUrl"
                                       autocomplete="off"
                                       spellcheck="false" />
                                <span class="worker-settings-hint">
                                    Обычно менять не нужно. Если поле пустое, сохраняется @WorkerDetailsViewModel.DefaultMultiloginLauncherUrl
                                </span>
                            </label>
                            <label class="worker-settings-field" for="multiloginCloudApiUrl">
                                <span class="worker-settings-label">Cloud API URL</span>
                                <input type="url"
                                       id="multiloginCloudApiUrl"
                                       name="multiloginCloudApiUrl"
                                       class="worker-settings-input"
                                       value="@Model.MultiloginCloudApiUrl"
                                       placeholder="@WorkerDetailsViewModel.DefaultMultiloginCloudApiUrl"
                                       autocomplete="off"
                                       spellcheck="false" />
                                <span class="worker-settings-hint">
                                    Обычно менять не нужно. Необязательно: пустое поле не заполняется значением по умолчанию.
                                </span>
                            </label>
                        </details>
                        </div>
                    </div>

                    <div class="worker-settings-section worker-settings-block" data-provider-section="Local" @(Model.LocalChromeEnabled ? null : "hidden")>
                        <div data-provider-fields="Local">
                        <p class="worker-settings-hint">Chrome будет найден автоматически. Для каждого аккаунта нужна отдельная папка User Data — стандартный профиль Default обычного Chrome использовать нельзя.</p>
                        <details class="worker-settings-advanced">
                            <summary>Дополнительно</summary>
                            <label class="worker-settings-field" for="localChromeExecutablePath">
                                <span class="worker-settings-label">Путь к Chrome/Chromium</span>
                                <input type="text"
                                       id="localChromeExecutablePath"
                                       name="localChromeExecutablePath"
                                       class="worker-settings-input"
                                       value="@Model.LocalChromeExecutablePath"
                                       placeholder="C:\Program Files\Google\Chrome\Application\chrome.exe"
                                       autocomplete="off"
                                       spellcheck="false" />
                                <span class="worker-settings-hint">
                                    Нужно только если браузер установлен не в Program Files.
                                </span>
                            </label>
                        </details>
                        </div>
                    </div>

                    <section class="worker-settings-block">
                        <div class="worker-settings-block-head">
                            <span class="worker-settings-block-icon" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span>
                            <div class="worker-settings-block-copy">
                                <span class="worker-settings-block-title">RuCaptcha</span>
                                <p class="worker-settings-block-desc">Ключ с rucaptcha.com для автопрохождения GeeTest v4. Пока пусто — воркер останавливает аккаунт на капче.</p>
                            </div>
                        </div>
                        <label class="worker-settings-field" for="ruCaptchaApiKey">
                            <span class="worker-settings-label">RuCaptcha API Key</span>
                            <input type="password"
                                   id="ruCaptchaApiKey"
                                   name="ruCaptchaApiKey"
                                   class="worker-settings-input"
                                   value="@Model.RuCaptchaApiKey"
                                   placeholder="@(string.IsNullOrWhiteSpace(Model.RuCaptchaApiKey) ? "Не задан — капча Avito вручную" : "Ключ задан")"
                                   autocomplete="new-password"
                                   spellcheck="false" />
                        </label>
                    </section>
                    </div>
                        </div>
                    </div>
                    </div>

                    <div class="worker-settings-actions" data-worker-settings-actions>
                        <span class="worker-settings-dirty" data-worker-settings-dirty hidden>Есть несохранённые изменения</span>
                        <button type="submit" class="worker-refresh-btn" data-worker-settings-save>Сохранить настройки</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="worker-detail-grid-main">
        <div class="card card--worker-info">
            <div class="card-header">
                <h2>Общая информация</h2>
            </div>
            <div class="card-body">
                <dl class="worker-info-list" data-worker-info-list>
                    @foreach (var item in Model.InfoItems)
                    {
                        <div class="worker-info-row" data-worker-info-label="@item.Label">
                            <dt class="worker-info-label">@item.Label</dt>
                            <dd class="worker-info-value">
                                @if (item.TimeValue is not null)
                                {
                                    <partial name="_UtcTime" model="item.TimeValue" />
                                }
                                else
                                {
                                    @item.Value
                                }
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
        <div class="card card--worker-activity">
            <div class="card-header">
                <h2>Активность за сегодня</h2>
            </div>
            <div class="card-body">
                @if (Model.ActivityChart.HasData)
                {
                    <div class="chart-canvas-wrap chart-canvas-wrap--hourly">
                        <canvas id="chart-worker-activity" aria-label="Активность за сегодня"></canvas>
                    </div>
                }
                else
                {
                    <p class="chart-empty-state">Нет данных за сегодня. Воркер пока не передаёт почасовую статистику откликов.</p>
                }
            </div>
        </div>
    </div>

    <div class="worker-detail-grid-bottom">
        <div class="card card--worker-events">
            <div class="card-header">
                <h2>Последние события</h2>
            </div>
            <div class="card-body">
                <div data-worker-events>
                    <partial name="_WorkerEventList" model="Model.Events" />
                </div>
                <a class="card-footer-btn" href="@Url.Action("Index", "Events")">Показать все события</a>
            </div>
        </div>
        <div class="card card--worker-stats">
            <div class="card-header">
                <h2>Статистика за сегодня</h2>
            </div>
            <div class="card-body">
                <dl class="worker-stats-list" data-worker-period-stats>
                    @foreach (var stat in Model.PeriodStats)
                    {
                        <div class="worker-stats-row" data-worker-stat-label="@stat.Label">
                            <dt class="worker-stats-label">@stat.Label</dt>
                            <dd class="worker-stats-value">@stat.Value</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="card card--worker-accounts" id="worker-accounts">
        <div class="card-header worker-accounts-header">
            <div class="worker-accounts-heading">
                <h2>Аккаунты воркера</h2>
                <p class="worker-accounts-summary" data-worker-accounts-summary>
                    <span data-worker-accounts-total>@Model.CatalogAccountCount @(Model.CatalogAccountCount == 1 ? "аккаунт" : "аккаунтов")</span>
                </p>
            </div>
            <nav class="worker-accounts-tabs" aria-label="Источник аккаунтов">
                <a class="worker-accounts-tab@(Model.AccountProvider == "adspower" ? " is-active" : "")"
                   href="@adsPowerAccountsUrl"
                   aria-current="@(Model.AccountProvider == "adspower" ? "page" : null)">
                    <span>AdsPower</span>
                    <span class="worker-accounts-tab-count" data-worker-accounts-ads>@Model.AdsPowerAccountCount</span>
                </a>
                <a class="worker-accounts-tab@(Model.AccountProvider == "multilogin" ? " is-active" : "")"
                   href="@multiloginAccountsUrl"
                   aria-current="@(Model.AccountProvider == "multilogin" ? "page" : null)">
                    <span>Multilogin</span>
                    <span class="worker-accounts-tab-count" data-worker-accounts-mlx>@Model.MultiloginAccountCount</span>
                </a>
                <a class="worker-accounts-tab@(isLocalProvider ? " is-active" : "")"
                   href="@localAccountsUrl"
                   aria-current="@(isLocalProvider ? "page" : null)">
                    <span>Обычный браузер</span>
                    <span class="worker-accounts-tab-count" data-worker-accounts-local>@Model.LocalAccountCount</span>
                </a>
            </nav>
        </div>
        <div class="worker-accounts-toolbar">
            <form class="worker-accounts-controls" method="get" action="@Url.Action("Details", "Workers", new { id = Model.WorkerId })">
                <input type="hidden" name="provider" value="@Model.AccountProvider" />
                <input type="hidden" name="sort" value="@Model.Sort.Column" />
                <input type="hidden" name="dir" value="@Model.Sort.Dir" />
                <div class="worker-accounts-search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input type="search" name="q" value="@Model.AccountSearchQuery" placeholder="Поиск по аккаунтам" aria-label="Поиск по аккаунтам" />
                </div>
                <label class="worker-accounts-group-select" @(isLocalProvider ? "hidden" : null)>
                    <span>@(Model.AccountProvider == "multilogin" ? "Папка" : "Группа")</span>
                    <select name="groupId" data-worker-accounts-group-select aria-label="@(Model.AccountProvider == "multilogin" ? "Папка Multilogin" : "Группа AdsPower")">
                        @foreach (var opt in Model.AccountGroupOptions)
                        {
                            var label = string.IsNullOrWhiteSpace(opt.Value)
                                ? Model.AccountProvider == "multilogin" ? "Все папки" : "Все группы"
                                : opt.Label.Replace("AdsPower · ", string.Empty).Replace("Multilogin · ", string.Empty);
                            <option value="@opt.Value" selected="@(opt.Value == (Model.AccountGroupId ?? ""))">@label</option>
                        }
                    </select>
                </label>
                <button class="worker-accounts-search-submit" type="submit">Найти</button>
                <a class="worker-accounts-reset" href="@Url.Action("Details", "Workers", new { id = Model.WorkerId, provider = Model.AccountProvider, sort = Model.Sort.Column, dir = Model.Sort.Dir })">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                    <span>Сбросить</span>
                </a>
                @if (Model.ActiveAccountFilterChips.Count > 0)
                {
                    <partial name="_FilterChips" model="Model.ActiveAccountFilterChips" />
                }
            </form>
        </div>
        @if (isLocalProvider)
        {
            <div class="worker-local-account-panel">
                <p class="worker-local-account-steps">Создайте аккаунт → Откройте браузер → Войдите в Avito → Закройте браузер → Включите мониторинг.</p>
                <form asp-action="CreateLocalAccount" method="post" class="worker-local-account-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workerId" value="@Model.WorkerId" />
                    <span class="worker-local-account-form-title">Создать браузерный аккаунт</span>
                    <label class="worker-settings-field" for="localAccountDisplayName">
                        <span class="worker-settings-label">Название</span>
                        <input type="text"
                               id="localAccountDisplayName"
                               name="displayName"
                               class="worker-settings-input"
                               maxlength="200"
                               required
                               placeholder="Например, Авито — кабинет 1"
                               autocomplete="off" />
                    </label>
                    <button type="submit" class="worker-refresh-btn">Создать браузерный аккаунт</button>
                </form>
                <details class="worker-local-account-advanced">
                    <summary>Подключить существующую папку профиля</summary>
                    <form asp-action="CreateLocalAccount" method="post" class="worker-local-account-form worker-local-account-form--advanced">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workerId" value="@Model.WorkerId" />
                        <label class="worker-settings-field" for="localAttachDisplayName">
                            <span class="worker-settings-label">Название</span>
                            <input type="text"
                                   id="localAttachDisplayName"
                                   name="displayName"
                                   class="worker-settings-input"
                                   maxlength="200"
                                   required
                                   placeholder="Например, Авито — кабинет 1"
                                   autocomplete="off" />
                        </label>
                        <label class="worker-settings-field" for="localAccountUserDataDir">
                            <span class="worker-settings-label">Папка профиля (User Data)</span>
                            <input type="text"
                                   id="localAccountUserDataDir"
                                   name="localUserDataDir"
                                   class="worker-settings-input"
                                   maxlength="1024"
                                   required
                                   placeholder="D:\Orbita\ChromeProfiles\account-1"
                                   autocomplete="off"
                                   spellcheck="false" />
                            <span class="worker-settings-hint">Только отдельная папка на машине воркера. Системный Chrome User Data и Default использовать нельзя. При удалении записи папка на диске не удаляется.</span>
                        </label>
                        <button type="submit" class="worker-refresh-btn">Подключить папку</button>
                    </form>
                </details>
            </div>
        }
        <div class="card-body card-body-table worker-accounts-wrap">
            <div data-worker-accounts-empty @(Model.Accounts.Count == 0 ? null : "hidden")>
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-users",
                    Title = Model.HasActiveAccountFilters ? "Аккаунты не найдены" : "Аккаунтов пока нет",
                    Description = Model.HasActiveAccountFilters
                        ? "Измените поисковый запрос."
                        : isLocalProvider
                            ? "Создайте аккаунт, откройте браузер, войдите в Avito и затем включите мониторинг."
                            : "Дождитесь синхронизации профилей AdsPower или Multilogin с воркером.",
                    CtaLabel = Model.HasActiveAccountFilters ? "Сбросить фильтры" : null,
                    CtaUrl = Model.HasActiveAccountFilters
                        ? Url.Action("Details", "Workers", new { id = Model.WorkerId, provider = Model.AccountProvider, sort = Model.Sort.Column, dir = Model.Sort.Dir })
                        : null
                })" />
            </div>
            <table class="data-table data-table--accounts data-table--cards" @(Model.Accounts.Count == 0 ? "hidden" : null)>
                <thead>
                    <tr>
                        <th>Вкл</th>
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Аккаунт", Column = "account", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Статус", Column = "status", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Баланс", Column = "balance", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute, Numeric = true })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Откликов", Column = "responses", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute, Numeric = true })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Последняя активность", Column = "activity", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Ошибок", Column = "errors", Sort = Model.Sort, Controller = "Workers", Action = "Details", RouteValues = workerAccountsSortRoute, Numeric = true })" />
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody data-orbita-live-body="worker-accounts">
                @foreach (var account in Model.Accounts)
                {
                    var accountSearchUrl = Url.Action("Index", "Accounts", new { q = account.DisplayName });
                    var responsesUrl = Url.Action("Index", "Responses", new { accountId = account.Id });
                    var rowClass = "worker-account-row"
                        + (account.IsProcessingNow ? " worker-account-row--processing" : "")
                        + (account.IsLowBalance ? " worker-account-row--low-balance" : "");
                    var rowTitle = account.IsLowBalance ? "Низкий баланс — требуется пополнение" : "";
                    <tr class="@rowClass"
                        data-account-id="@account.Id"
                        data-subprofiles-layout="worker"
                        data-processing-subprofile-id="@(account.IsProcessingNow ? account.ProcessingSubProfileId : null)"
                        data-subprofiles-json="@JsonSerializer.Serialize(account.SubProfiles, subProfileJsonOptions)"
                        @(string.IsNullOrEmpty(rowTitle) ? null : $"title=\"{rowTitle}\"")>
                        <td class="cell-toggle" data-label="Вкл">
                            <label class="worker-toggle@(account.IsProviderEnabled ? "" : " is-disabled")" title="@(account.IsProviderEnabled ? (account.IsEnabledInPanel ? "Отключить аккаунт в панели" : "Включить аккаунт в панели") : WorkerBrowserProviderMessages.DisabledHint)">
                                <input type="checkbox"
                                       data-account-enable-toggle
                                       data-worker-id="@Model.WorkerId"
                                       data-account-id="@account.Id"
                                       @(account.IsEnabledInPanel ? "checked" : null)
                                       @(account.IsProviderEnabled ? null : "disabled") />
                                <span class="worker-toggle-slider"></span>
                            </label>
                        </td>
                        <td class="cell-name" data-label="Аккаунт">
                            <div class="worker-account-identity">
                                <a class="worker-account-name" href="@accountSearchUrl">@account.DisplayName</a>
                                <div class="worker-account-meta">
                                    @if (!string.IsNullOrWhiteSpace(account.LocationLabel))
                                    {
                                        <span class="worker-account-location" title="@account.LocationTitle">@account.LocationLabel</span>
                                    }
                                    @if (account.HasAvitoCredentials)
                                    {
                                        <span class="worker-account-cred" title="@(account.AvitoLogin ?? "логин задан")">
                                            <i class="fa-solid fa-key" aria-hidden="true"></i>
                                            Avito
                                        </span>
                                    }
                                </div>
                            </div>
                            <partial name="_SubProfilesSection" model="@(new SubProfilesSectionViewModel
                            {
                                WorkerId = Model.WorkerId,
                                AccountId = account.Id,
                                PanelIdPrefix = "subprofiles",
                                CanRefreshSubProfiles = account.CanRefreshSubProfiles,
                                IsSubProfilesRefreshPending = account.IsSubProfilesRefreshPending,
                                HasSubProfiles = account.HasSubProfiles,
                                ProcessingSubProfileId = account.IsProcessingNow ? account.ProcessingSubProfileId : null,
                                Items = account.SubProfiles
                            })" />
                        </td>
                        <td data-label="Статус">
                            <span class="account-status account-status--@account.StatusTone">
                                <i class="fa-solid fa-circle account-status-dot" aria-hidden="true"></i>
                                @account.StatusLabel
                            </span>
                            @if (!string.IsNullOrWhiteSpace(account.LastErrorMessage))
                            {
                                <span class="account-error-hint" title="@account.LastErrorMessage">@account.LastErrorMessage</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(account.ErrorHint))
                            {
                                <span class="account-error-hint" title="@account.ErrorHint">@account.ErrorHint</span>
                            }
                            @if (account.IsLocal)
                            {
                                <form asp-action="OpenLocalBrowser" method="post" class="worker-local-open-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="workerId" value="@Model.WorkerId" />
                                    <input type="hidden" name="accountId" value="@account.Id" />
                                    <button type="submit"
                                            class="worker-local-open-btn"
                                            data-local-open-browser
                                            data-worker-id="@Model.WorkerId"
                                            data-account-id="@account.Id"
                                            data-post-url="@Url.Action("OpenLocalBrowser", "Workers")"
                                            @(account.CanOpenBrowser ? null : "disabled")
                                            title="@(account.CanOpenBrowser ? account.OpenBrowserLabel : account.BrowserSessionStatus)">@account.OpenBrowserLabel</button>
                                </form>
                                <span class="worker-local-browser-status">@account.BrowserSessionStatus</span>
                            }
                        </td>
                        <td class="cell-num cell-balance" data-label="Баланс">
                            <span class="account-balance-multiline">@account.BalanceText</span>
                        </td>
                        <td class="cell-num" data-label="Откликов">
                            <partial name="_MetricLink" model="@AccountMetricLinks.Responses(Model.WorkerId, account.Id, account.Responses)" />
                        </td>
                        <td data-label="Последняя активность"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.LastActivityUtc, "activity"))" /></td>
                        <td class="cell-num" data-label="Ошибок">
                            <partial name="_MetricLink" model="@AccountMetricLinks.Errors(Model.WorkerId, account.Id, account.Errors)" />
                        </td>
                        <td class="data-table-menu" data-label="">
                            @if (account.IsLocal)
                            {
                                <button type="button"
                                        class="row-menu-btn worker-local-settings-btn"
                                        aria-label="Настройки профиля"
                                        title="Настройки профиля"
                                        data-local-profile-settings
                                        data-worker-id="@Model.WorkerId"
                                        data-account-id="@account.Id"
                                        data-account-name="@account.DisplayName"
                                        data-login="@(account.AvitoLogin ?? "")"
                                        data-has-password="@(account.HasAvitoCredentials ? "true" : "false")"
                                        data-proxy-enabled="@(account.LocalProxyEnabled ? "true" : "false")"
                                        data-proxy-address="@(account.LocalProxyAddress ?? "")"
                                        data-proxy-username="@(account.LocalProxyUsername ?? "")"
                                        data-has-proxy-password="@(account.HasProxyPassword ? "true" : "false")"
                                        data-proxy-status="@account.ProxyStatus"
                                        data-traffic-mode="@account.LocalTrafficMode"
                                        data-block-media="@(account.LocalBlockMedia ? "true" : "false")"
                                        data-block-analytics="@(account.LocalBlockAnalytics ? "true" : "false")"
                                        data-block-images="@(account.LocalBlockImages ? "true" : "false")"
                                        data-block-fonts="@(account.LocalBlockFonts ? "true" : "false")"
                                        data-block-prefetch="@(account.LocalBlockPrefetch ? "true" : "false")"
                                        data-nav-timeout="@account.LocalNavigationTimeoutSeconds"
                                        data-traffic-last-summary="@(account.LocalTrafficLastSummary ?? "")"
                                        data-browser-status="@account.BrowserSessionStatus"
                                        data-can-open-browser="@(account.CanOpenBrowser ? "true" : "false")"
                                        data-open-label="@account.OpenBrowserLabel"
                                        data-save-url="@Url.Action("UpdateLocalAccountProfile", "Workers")"
                                        data-open-url="@Url.Action("OpenLocalBrowser", "Workers")"
                                        data-clear-url="@Url.Action("UpdateAccountCredentials", "Workers")">
                                    <i class="fa-solid fa-gear" aria-hidden="true"></i>
                                </button>
                            }
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown" hidden>
                                    <a class="row-menu-item" href="@accountSearchUrl">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Просмотр
                                    </a>
                                    <a class="row-menu-item" href="#worker-accounts">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                        Настройки на воркере
                                    </a>
                                    @if (account.IsLocal)
                                    {
                                        <button type="button"
                                                class="row-menu-item"
                                                data-local-profile-settings
                                                data-worker-id="@Model.WorkerId"
                                                data-account-id="@account.Id"
                                                data-account-name="@account.DisplayName"
                                                data-login="@(account.AvitoLogin ?? "")"
                                                data-has-password="@(account.HasAvitoCredentials ? "true" : "false")"
                                                data-proxy-enabled="@(account.LocalProxyEnabled ? "true" : "false")"
                                                data-proxy-address="@(account.LocalProxyAddress ?? "")"
                                                data-proxy-username="@(account.LocalProxyUsername ?? "")"
                                                data-has-proxy-password="@(account.HasProxyPassword ? "true" : "false")"
                                                data-proxy-status="@account.ProxyStatus"
                                                data-traffic-mode="@account.LocalTrafficMode"
                                                data-block-media="@(account.LocalBlockMedia ? "true" : "false")"
                                                data-block-analytics="@(account.LocalBlockAnalytics ? "true" : "false")"
                                                data-block-images="@(account.LocalBlockImages ? "true" : "false")"
                                                data-block-fonts="@(account.LocalBlockFonts ? "true" : "false")"
                                                data-block-prefetch="@(account.LocalBlockPrefetch ? "true" : "false")"
                                                data-nav-timeout="@account.LocalNavigationTimeoutSeconds"
                                                data-traffic-last-summary="@(account.LocalTrafficLastSummary ?? "")"
                                                data-browser-status="@account.BrowserSessionStatus"
                                                data-can-open-browser="@(account.CanOpenBrowser ? "true" : "false")"
                                                data-open-label="@account.OpenBrowserLabel"
                                                data-save-url="@Url.Action("UpdateLocalAccountProfile", "Workers")"
                                                data-open-url="@Url.Action("OpenLocalBrowser", "Workers")"
                                                data-clear-url="@Url.Action("UpdateAccountCredentials", "Workers")">
                                            <i class="fa-solid fa-gear" aria-hidden="true"></i>
                                            Настройки профиля
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="row-menu-item"
                                                data-avito-credentials
                                                data-worker-id="@Model.WorkerId"
                                                data-account-id="@account.Id"
                                                data-account-name="@account.DisplayName"
                                                data-login="@(account.AvitoLogin ?? "")"
                                                data-has-password="@(account.HasAvitoCredentials ? "true" : "false")"
                                                data-post-url="@Url.Action("UpdateAccountCredentials", "Workers")">
                                            <i class="fa-solid fa-key" aria-hidden="true"></i>
                                            Логин / пароль Avito
                                        </button>
                                    }
                                    <a class="row-menu-item" href="@responsesUrl">
                                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                        История откликов
                                    </a>
                                    @if (account.IsLocal)
                                    {
                                        <form asp-action="OpenLocalBrowser" method="post" class="row-menu-item-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@Model.WorkerId" />
                                            <input type="hidden" name="accountId" value="@account.Id" />
                                            <button type="submit"
                                                    class="row-menu-item"
                                                    data-local-open-browser
                                                    data-worker-id="@Model.WorkerId"
                                                    data-account-id="@account.Id"
                                                    data-post-url="@Url.Action("OpenLocalBrowser", "Workers")"
                                                    @(account.CanOpenBrowser ? null : "disabled")>
                                                <i class="fa-regular fa-window-maximize" aria-hidden="true"></i>
                                                @account.OpenBrowserLabel
                                            </button>
                                        </form>
                                        <button type="button"
                                                class="row-menu-item"
                                                data-local-account-edit
                                                data-local-account-rename
                                                data-worker-id="@Model.WorkerId"
                                                data-account-id="@account.Id"
                                                data-account-name="@account.DisplayName"
                                                data-user-data-dir="@(account.IsManagedLocalProfile ? "" : account.LocalUserDataDir ?? "")"
                                                data-managed="@(account.IsManagedLocalProfile ? "true" : "false")"
                                                data-post-url="@Url.Action("UpdateLocalAccount", "Workers")">
                                            <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                            Переименовать аккаунт
                                        </button>
                                        <button type="button"
                                                class="row-menu-item"
                                                data-local-account-edit
                                                data-worker-id="@Model.WorkerId"
                                                data-account-id="@account.Id"
                                                data-account-name="@account.DisplayName"
                                                data-user-data-dir="@(account.IsManagedLocalProfile ? "" : account.LocalUserDataDir ?? "")"
                                                data-managed="@(account.IsManagedLocalProfile ? "true" : "false")"
                                                data-post-url="@Url.Action("UpdateLocalAccount", "Workers")">
                                            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                                            Папка профиля
                                        </button>
                                        <form asp-action="DeleteLocalAccount" method="post" class="row-menu-item-form" onsubmit="return confirm('Удалить аккаунт из панели? Папка профиля на диске не удалится.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@Model.WorkerId" />
                                            <input type="hidden" name="accountId" value="@account.Id" />
                                            <button type="submit" class="row-menu-item row-menu-item--danger">
                                                <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                                Удалить аккаунт
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                    @if (account.HasSubProfiles)
                    {
                        <partial name="_SubProfileTableRows" model="@(new SubProfileTableRowsViewModel
                        {
                            WorkerId = Model.WorkerId,
                            AccountId = account.Id,
                            PanelId = $"subprofiles-{account.Id}",
                            ProcessingSubProfileId = account.IsProcessingNow ? account.ProcessingSubProfileId : null,
                            Layout = SubProfileTableLayout.WorkerDetails,
                            Items = account.SubProfiles
                        })" />
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (User.IsInRole(PanelRoles.Admin))
    {
        <div class="card card--worker-logs" id="worker-logs">
            <div class="card-header worker-logs-header">
                <h2>Логи воркера</h2>
                <a class="card-footer-btn card-footer-btn--inline" href="@Url.Action("Index", "Settings", new { tab = "logs", service = "Orbita.Worker", q = $"worker:{Model.WorkerId:D}" })">Открыть журнал</a>
            </div>
        </div>
    }

    <script id="worker-charts-data" type="application/json">@Html.Raw(chartJson)</script>
</div>

<div class="workers-modal" id="workerRenameModal" hidden>
    <div class="workers-modal-backdrop" data-worker-rename-close></div>
    <div class="workers-modal-dialog" role="dialog" aria-labelledby="workerRenameTitle" aria-modal="true">
        <header class="workers-modal-head">
            <h2 id="workerRenameTitle">Переименовать воркер</h2>
            <button type="button" class="workers-modal-close" data-worker-rename-close aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <form asp-action="Rename" method="post" class="workers-modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="workerId" value="@Model.WorkerId" />
            <input type="hidden" name="q" value="@Model.AccountSearchQuery" />
            <input type="hidden" name="sort" value="@Model.Sort.Column" />
            <input type="hidden" name="dir" value="@Model.Sort.Dir" />
            <input type="hidden" name="provider" value="@Model.AccountProvider" />
            <input type="hidden" name="groupId" value="@Model.AccountGroupId" />
            <p class="workers-modal-hint">Текущее имя: <strong>@Model.DisplayName</strong></p>
            <label class="workers-modal-label" for="workerRenameDisplayName">Новое имя</label>
            <input type="text"
                   id="workerRenameDisplayName"
                   name="displayName"
                   class="workers-modal-input"
                   value="@Model.DisplayName"
                   required
                   maxlength="200"
                   autocomplete="off"
                   data-worker-rename-input />
            <footer class="workers-modal-footer">
                <button type="button" class="workers-modal-btn workers-modal-btn--ghost" data-worker-rename-close>Отмена</button>
                <button type="submit" class="workers-modal-btn workers-modal-btn--primary">Сохранить</button>
            </footer>
        </form>
    </div>
</div>

<div class="workers-modal" id="topUpModal" hidden>
    <div class="workers-modal-backdrop" data-topup-close></div>
    <div class="workers-modal-dialog topup-modal-dialog" role="dialog" aria-labelledby="topUpTitle" aria-modal="true">
        <header class="workers-modal-head">
            <h2 id="topUpTitle">Пополнение баланса</h2>
            <button type="button" class="workers-modal-close" data-topup-close aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <div class="workers-modal-body topup-modal-body">
            <div class="topup-loading" data-topup-loading>
                <div class="topup-spinner"></div>
                <p>Создание сессии пополнения...</p>
            </div>
            <div class="topup-error" data-topup-error hidden>
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                <p data-topup-error-message></p>
                <button type="button" class="workers-modal-btn workers-modal-btn--ghost" data-topup-close>Закрыть</button>
            </div>
            <div class="topup-content" data-topup-content hidden>
                <div class="topup-info">
                    <div class="topup-info-row">
                        <span class="topup-info-label">Аккаунт:</span>
                        <span class="topup-info-value" data-topup-account-name></span>
                    </div>
                    <div class="topup-info-row">
                        <span class="topup-info-label">Текущий баланс:</span>
                        <span class="topup-info-value"><span data-topup-current-balance></span> ₽</span>
                    </div>
                    <div class="topup-info-row">
                        <span class="topup-info-label">Целевой баланс:</span>
                        <span class="topup-info-value"><span data-topup-target-balance></span> ₽</span>
                    </div>
                    <div class="topup-info-row">
                        <span class="topup-info-label">Сумма пополнения:</span>
                        <span class="topup-info-value topup-amount"><span data-topup-requested-amount></span> ₽</span>
                    </div>
                    <div class="topup-info-row">
                        <span class="topup-info-label">Откликов сегодня:</span>
                        <span class="topup-info-value" data-topup-daily-responses></span>
                    </div>
                    <div class="topup-tier-hint" data-topup-tier-label></div>
                </div>

                <div class="topup-status" data-topup-status></div>

                <div class="topup-stale-warning" data-topup-stale-warning hidden>
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                    <span>Не удаётся обновить статус сессии. Данные могут быть устаревшими.</span>
                </div>

                <div class="topup-qr-section" data-topup-qr-section hidden>
                    <div class="topup-qr-container">
                        <img data-topup-qr-image alt="QR-код для оплаты" class="topup-qr-image" />
                    </div>
                    <div class="topup-payment-notice">
                        <i class="fa-solid fa-info-circle" aria-hidden="true"></i>
                        <p>Отсканируйте QR-код в приложении банка для оплаты через СБП. Оплата производится вручную и не подтверждается автоматически в Орбите. После пополнения обновите страницу для актуального баланса.</p>
                    </div>
                </div>

                <div class="topup-terminal-message" data-topup-terminal-message hidden></div>

                <div class="topup-live-region" data-topup-live-region role="status" aria-live="polite" aria-atomic="true"></div>

                <footer class="workers-modal-footer topup-modal-footer">
                    <button type="button" class="workers-modal-btn workers-modal-btn--ghost" data-topup-close>Закрыть</button>
                    <button type="button" class="workers-modal-btn workers-modal-btn--danger" data-topup-cancel hidden>Отменить сессию</button>
                </footer>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/orbita-worker.js" asp-append-version="true"></script>
}
