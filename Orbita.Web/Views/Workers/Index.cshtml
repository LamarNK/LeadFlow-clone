@model WorkersIndexViewModel
@using Orbita.Contracts
@{
    ViewData["Title"] = "Все воркеры";
    var pagination = Model.Pagination;
    var workersError = TempData["WorkersError"] as string;
    var snapshotUrl = Url.Action("Snapshot", "Workers", new { q = Model.SearchQuery, status = Model.StatusFilter, page = pagination.Page })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main workers-page"
     data-orbita-live
     data-orbita-live-page="workers"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-settings-logs-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = "__id__" })"
     data-show-admin-logs="@(User.IsInRole(PanelRoles.Admin) ? "true" : "false")">
    <nav class="orbita-breadcrumbs" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="workers-page-head">
        <div class="workers-toolbar">
            <form class="workers-search" method="get" asp-action="Index" role="search">
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                }
                <i class="fa-solid fa-magnifying-glass workers-search-icon" aria-hidden="true"></i>
                <input type="search"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Поиск по воркерам..."
                       aria-label="Поиск по воркерам" />
            </form>
            <button type="button" class="workers-filter-btn@(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "" : " is-active")" data-orbita-filter-toggle="workersFilterPanel" aria-label="Фильтры" aria-expanded="false">
                <i class="fa-solid fa-filter" aria-hidden="true"></i>
            </button>
            <div class="orbita-filter-panel" id="workersFilterPanel" hidden>
                <form method="get" asp-action="Index" class="orbita-filter-panel__form">
                    <input type="hidden" name="q" value="@Model.SearchQuery" />
                    <label class="orbita-filter-panel__field">
                        <span class="orbita-filter-panel__label">Статус</span>
                        <select name="status" class="orbita-filter-panel__select">
                            @if (string.IsNullOrWhiteSpace(Model.StatusFilter))
                            {
                                <option value="" selected>Все</option>
                            }
                            else
                            {
                                <option value="">Все</option>
                            }
                            @if (Model.StatusFilter == "online")
                            {
                                <option value="online" selected>Онлайн</option>
                            }
                            else
                            {
                                <option value="online">Онлайн</option>
                            }
                            @if (Model.StatusFilter == "offline")
                            {
                                <option value="offline" selected>Оффлайн</option>
                            }
                            else
                            {
                                <option value="offline">Оффлайн</option>
                            }
                        </select>
                    </label>
                    <div class="orbita-filter-panel__actions">
                        <a class="orbita-filter-panel__reset" href="@Url.Action("Index", new { q = Model.SearchQuery })">Сбросить</a>
                        <button type="submit" class="orbita-filter-panel__apply">Применить</button>
                    </div>
                </form>
            </div>
            @if (Model.HasWorkerRelease && !string.IsNullOrWhiteSpace(Model.LatestWorkerDownloadUrl))
            {
                <a class="workers-download-btn" href="@Model.LatestWorkerDownloadUrl">
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    <span>Скачать воркер v@(Model.LatestWorkerReleaseVersion)</span>
                </a>
            }
            @if (Model.CanCreateWorker)
            {
                <button type="button" class="workers-add-btn" data-workers-add-open>
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Добавить воркер</span>
                </button>
            }
        </div>
    </div>

    <div class="kpi-row workers-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.Stat, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <div class="card card--workers-table">
        <div class="card-body card-body-table workers-table-wrap">
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-server",
                    Title = string.IsNullOrWhiteSpace(Model.SearchQuery) ? "Воркеры не найдены" : "Ничего не найдено",
                    Description = string.IsNullOrWhiteSpace(Model.SearchQuery)
                        ? "Добавьте первый воркер через кнопку «Добавить воркер» в панели инструментов."
                        : "Попробуйте изменить поисковый запрос.",
                    CtaLabel = string.IsNullOrWhiteSpace(Model.SearchQuery) ? null : "Сбросить поиск",
                    CtaUrl = string.IsNullOrWhiteSpace(Model.SearchQuery) ? null : Url.Action("Index")
                })" />
            }
            else
            {
            <table class="data-table data-table--workers data-table--cards">
                <thead>
                    <tr>
                        <th>Воркер</th>
                        <th>Статус</th>
                        <th>Аккаунтов</th>
                        <th>Откликов</th>
                        <th>Дублей</th>
                        <th>Ошибок</th>
                        <th>Последняя активность</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody data-orbita-live-body="workers">
                @foreach (var w in Model.Workers)
                {
                    var detailsUrl = Url.Action("Details", new { id = w.Id });
                    <tr class="workers-row@(!w.IsEnabled ? " workers-row--disabled" : "")" data-href="@detailsUrl">
                        <td class="cell-name" data-label="Воркер">
                            <partial name="_WorkerNameCell" model="@(new WorkerNameCellViewModel { DisplayName = w.DisplayName, MachineName = w.MachineName, Url = detailsUrl })" />
                            @if (!w.IsEnabled)
                            {
                                <span class="workers-status-badge workers-status-badge--disabled">Приостановлен</span>
                            }
                            @if (w.UpdateAvailable)
                            {
                                <span class="workers-update-badge" title="Доступна версия @(w.LatestReleaseVersion)">Обновление</span>
                            }
                        </td>
                        <td data-label="Статус">
                            @if (!w.IsEnabled)
                            {
                                <span class="status-dot offline">
                                    <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                                    Приостановлен
                                </span>
                            }
                            else
                            {
                                <span class="status-dot @(w.IsOnline ? "" : "offline")">
                                    <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                                    @(w.IsOnline ? "Онлайн" : "Оффлайн")
                                </span>
                            }
                        </td>
                        <td data-label="Аккаунтов">@w.ActiveAccounts / @w.TotalAccounts</td>
                        <td data-label="Откликов">@w.Responses</td>
                        <td data-label="Дублей">@w.Duplicates</td>
                        <td data-label="Ошибок">@w.Errors</td>
                        <td data-label="Последняя активность"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(w.LastActivityUtc, "time"))" /></td>
                        <td class="data-table-menu" data-label="">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown row-menu-dropdown--workers" hidden>
                                    <a class="row-menu-item" href="@detailsUrl">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Открыть
                                    </a>
                                    @if (w.IsEnabled)
                                    {
                                        <button type="button" class="row-menu-item" data-worker-restart data-worker-id="@w.Id">
                                            <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                                            Перезапустить
                                        </button>
                                        <form asp-action="Disable" method="post" class="settings-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@w.Id" />
                                            <input type="hidden" name="returnTo" value="index" />
                                            <button type="submit" class="row-menu-item">
                                                <i class="fa-solid fa-circle-pause" aria-hidden="true"></i>
                                                Приостановить
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Enable" method="post" class="settings-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workerId" value="@w.Id" />
                                            <input type="hidden" name="returnTo" value="index" />
                                            <button type="submit" class="row-menu-item">
                                                <i class="fa-solid fa-circle-play" aria-hidden="true"></i>
                                                Включить
                                            </button>
                                        </form>
                                    }
                                    <a class="row-menu-item" href="@(detailsUrl + "#worker-settings")">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                        Настройки
                                    </a>
                                    @if (User.IsInRole(PanelRoles.Admin))
                                    {
                                        <a class="row-menu-item" href="@Url.Action("Index", "Settings", new { tab = "logs", workerId = w.Id })">
                                            <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                                            Просмотреть логи
                                        </a>
                                    }
                                    <form asp-action="Delete" method="post" class="settings-inline-form" onsubmit="return confirm('Удалить воркер «@w.DisplayName»? Это действие необратимо.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workerId" value="@w.Id" />
                                        <button type="submit" class="row-menu-item row-menu-item--danger">
                                            <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                            Удалить
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = pagination,
                Controller = "Workers",
                Action = "Index",
                RouteValues = new { q = Model.SearchQuery, status = Model.StatusFilter }
            })" />
        </div>
    </div>
</div>

@{
    var workersSuccess = TempData["WorkersSuccess"] as string;
}
@if (!string.IsNullOrWhiteSpace(workersSuccess))
{
    <div class="settings-alert settings-alert--success" role="status">@workersSuccess</div>
}
@if (!string.IsNullOrWhiteSpace(workersError))
{
    <div class="settings-alert settings-alert--warn" role="alert">@workersError</div>
}

@if (Model.CanCreateWorker)
{
    <div class="workers-modal" id="workersAddModal" hidden>
        <div class="workers-modal-backdrop" data-workers-add-close></div>
        <div class="workers-modal-dialog" role="dialog" aria-labelledby="workersAddTitle" aria-modal="true">
            <header class="workers-modal-head">
                <h2 id="workersAddTitle">Добавить воркер</h2>
                <button type="button" class="workers-modal-close" data-workers-add-close aria-label="Закрыть">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <form asp-action="Create" method="post" class="workers-modal-body">
                @Html.AntiForgeryToken()
                <p class="workers-modal-hint">Укажите имя VDS. API-ключ и команду установки будут показаны один раз после создания.</p>
                <label class="workers-modal-label" for="workerDisplayName">Имя воркера</label>
                <input type="text" id="workerDisplayName" name="displayName" class="workers-modal-input" placeholder="VDS #1" required maxlength="200" />
                @if (Model.CanSelectOffice && Model.OfficeOptions.Count > 0)
                {
                    <label class="workers-modal-label" for="workerOfficeId">Офис</label>
                    <select id="workerOfficeId" name="officeId" class="workers-modal-input" required>
                        @foreach (var opt in Model.OfficeOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                }
                <footer class="workers-modal-footer">
                    <button type="button" class="workers-modal-btn workers-modal-btn--ghost" data-workers-add-close>Отмена</button>
                    <button type="submit" class="workers-modal-btn workers-modal-btn--primary">Создать</button>
                </footer>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/orbita-workers.js" asp-append-version="true"></script>
}