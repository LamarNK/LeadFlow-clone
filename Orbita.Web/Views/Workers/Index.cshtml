@model WorkersIndexViewModel
@using Orbita.Contracts
@{
    ViewData["Title"] = "Все воркеры";
    var pagination = Model.Pagination;
    var workersError = TempData["WorkersError"] as string;
}
<div class="orbita-main workers-page">
    <nav class="orbita-breadcrumbs" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="workers-page-head">
        <h1 class="workers-page-title">Все воркеры</h1>
        <div class="workers-toolbar">
            <form class="workers-search" method="get" asp-action="Index" role="search">
                <i class="fa-solid fa-magnifying-glass workers-search-icon" aria-hidden="true"></i>
                <input type="search"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Поиск по воркерам..."
                       aria-label="Поиск по воркерам" />
            </form>
            <button type="button" class="workers-filter-btn" aria-label="Фильтры">
                <i class="fa-solid fa-filter" aria-hidden="true"></i>
            </button>
            @if (Model.HasWorkerRelease && !string.IsNullOrWhiteSpace(Model.LatestWorkerDownloadUrl))
            {
                <a class="workers-download-btn" href="@Model.LatestWorkerDownloadUrl">
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    <span>Скачать воркер v@(Model.LatestWorkerReleaseVersion)</span>
                </a>
            }
            @if (User.IsInRole(PanelRoles.Admin))
            {
                <button type="button" class="workers-add-btn" data-workers-add-open>
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    <span>Добавить воркер</span>
                </button>
            }
        </div>
    </div>

    <div class="kpi-row workers-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <article class="kpi-card kpi-card--stat" style="--kpi-index: @kpiIdx">
                <header class="kpi-card-head">
                    <div class="kpi-icon-box kpi-icon-box--@kpi.IconTone">
                        <i class="@kpi.IconClass" aria-hidden="true"></i>
                    </div>
                    <span class="kpi-card-label">@kpi.Label</span>
                </header>
                <div class="kpi-card-metric kpi-card-metric--solo">
                    <span class="kpi-value"
                          data-kpi-count="@kpi.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)">0</span>
                </div>
            </article>
            kpiIdx++;
        }
    </div>

    <div class="card card--workers-table">
        <div class="card-body card-body-table workers-table-wrap">
            <table class="data-table data-table--workers">
                <thead>
                    <tr>
                        <th>Воркер</th>
                        <th>Статус</th>
                        <th>Аккаунтов</th>
                        <th>Откликов</th>
                        <th>Дублей</th>
                        <th>Ошибок</th>
                        <th>Последняя активность</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var w in Model.Workers)
                {
                    var detailsUrl = Url.Action("Details", new { id = w.Id });
                    <tr class="workers-row" data-href="@detailsUrl">
                        <td class="cell-name">
                            <a href="@detailsUrl">@w.DisplayName</a>
                            @if (w.UpdateAvailable)
                            {
                                <span class="workers-update-badge" title="Доступна версия @(w.LatestReleaseVersion)">Обновление</span>
                            }
                        </td>
                        <td>
                            <span class="status-dot @(w.IsOnline ? "" : "offline")">
                                <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                                @(w.IsOnline ? "Онлайн" : "Оффлайн")
                            </span>
                        </td>
                        <td>@w.ActiveAccounts / @w.TotalAccounts</td>
                        <td>@w.Responses</td>
                        <td>@w.Duplicates</td>
                        <td>@w.Errors</td>
                        <td><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(w.LastActivityUtc, "time"))" /></td>
                        <td class="data-table-menu">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown" hidden>
                                    <a class="row-menu-item" href="@detailsUrl">Открыть</a>
                                    <button type="button" class="row-menu-item">Перезапустить</button>
                                    <button type="button" class="row-menu-item">Просмотреть логи</button>
                                    <button type="button" class="row-menu-item">Настройки</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <div class="workers-pagination">
                <span class="workers-pagination-info">
                    @if (pagination.TotalItems == 0)
                    {
                        @:Показано 0 из 0
                    }
                    else
                    {
                        @:Показано @pagination.RangeStart–@pagination.RangeEnd из @pagination.TotalItems
                    }
                </span>
                <div class="workers-pagination-controls">
                    @{
                        var prevPage = pagination.Page > 1 ? pagination.Page - 1 : (int?)null;
                        var nextPage = pagination.Page < pagination.TotalPages ? pagination.Page + 1 : (int?)null;
                    }
                    @if (prevPage is not null)
                    {
                        <a class="workers-page-btn"
                           href="@Url.Action("Index", new { q = Model.SearchQuery, page = prevPage })"
                           aria-label="Предыдущая страница">&lt;</a>
                    }
                    else
                    {
                        <span class="workers-page-btn workers-page-btn--disabled" aria-hidden="true">&lt;</span>
                    }
                    <span class="workers-page-btn workers-page-btn--active" aria-current="page">@pagination.Page</span>
                    @if (nextPage is not null)
                    {
                        <a class="workers-page-btn"
                           href="@Url.Action("Index", new { q = Model.SearchQuery, page = nextPage })"
                           aria-label="Следующая страница">&gt;</a>
                    }
                    else
                    {
                        <span class="workers-page-btn workers-page-btn--disabled" aria-hidden="true">&gt;</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(workersError))
{
    <div class="settings-alert settings-alert--warn" role="alert">@workersError</div>
}

@if (User.IsInRole(PanelRoles.Admin))
{
    <div class="workers-modal" id="workersAddModal" hidden>
        <div class="workers-modal-backdrop" data-workers-add-close></div>
        <div class="workers-modal-dialog" role="dialog" aria-labelledby="workersAddTitle" aria-modal="true">
            <header class="workers-modal-head">
                <h2 id="workersAddTitle">Добавить воркер</h2>
                <button type="button" class="workers-modal-close" data-workers-add-close aria-label="Закрыть">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>
            <form asp-action="Create" method="post" class="workers-modal-body">
                @Html.AntiForgeryToken()
                <p class="workers-modal-hint">Укажите имя VDS. API-ключ и команду установки будут показаны один раз после создания.</p>
                <label class="workers-modal-label" for="workerDisplayName">Имя воркера</label>
                <input type="text" id="workerDisplayName" name="displayName" class="workers-modal-input" placeholder="VDS #1" required maxlength="200" />
                @if (Model.CanSelectOffice && Model.OfficeOptions.Count > 0)
                {
                    <label class="workers-modal-label" for="workerOfficeId">Офис</label>
                    <select id="workerOfficeId" name="officeId" class="workers-modal-input" required>
                        @foreach (var opt in Model.OfficeOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                }
                <footer class="workers-modal-footer">
                    <button type="button" class="workers-modal-btn workers-modal-btn--ghost" data-workers-add-close>Отмена</button>
                    <button type="submit" class="workers-modal-btn workers-modal-btn--primary">Создать</button>
                </footer>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/orbita-workers.js" asp-append-version="true"></script>
}