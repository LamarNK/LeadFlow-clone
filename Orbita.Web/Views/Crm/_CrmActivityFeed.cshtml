@model Orbita.Contracts.CrmCandidateDetailDto
@using Orbita.Contracts
@{
    var card = Model.Card;
    var boardReturnStage = Context.Request.Query["stage"].ToString();
    if (string.IsNullOrWhiteSpace(boardReturnStage))
    {
        boardReturnStage = card.Stage;
    }
    var successDocuments = Model.SuccessDocuments ?? [];
    var canEditSuccessReport = ViewData["CanEditSuccessReport"] as bool? == true;
    var canDownloadSuccessReportArchive = ViewData["CanDownloadSuccessReportArchive"] as bool? == true;
    var successReportAnchorRendered = false;
    var successReportSteps = new[]
    {
        (Title: "Переписка", Categories: new[] { CrmSuccessDocumentCategories.Correspondence }, Optional: false),
        (Title: "Билеты", Categories: new[] { CrmSuccessDocumentCategories.Ticket }, Optional: false),
        (Title: "Чеки на билеты", Categories: new[] { CrmSuccessDocumentCategories.TicketReceipt }, Optional: false),
        (Title: "Контракт", Categories: new[] { CrmSuccessDocumentCategories.Contract }, Optional: false),
        (Title: "Отношение", Categories: new[] { CrmSuccessDocumentCategories.Relationship }, Optional: true),
        (Title: "Документы и прочие файлы", Categories: new[] { CrmSuccessDocumentCategories.CandidateDocument, CrmSuccessDocumentCategories.Other }, Optional: false)
    };

    string FormatFileSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.#} МБ",
        >= 1024 => $"{bytes / 1024d:0.#} КБ",
        _ => $"{bytes} Б"
    };

    string FormatFilesCount(int count)
    {
        var suffix = count % 100 is >= 11 and <= 14
            ? "файлов"
            : (count % 10) switch
            {
                1 => "файл",
                >= 2 and <= 4 => "файла",
                _ => "файлов"
            };
        return $"{count} {suffix}";
    }

    string DisplayCrmAction(string action) => action switch
    {
        "Created" => "Карточка создана",
        "Assigned" => "Назначен ответственный",
        "StageChanged" => "Смена этапа",
        "ReturnedToLoad" => "Вернули в нагрузку",
        "RemovedFromLoad" => "Сняли с нагрузки",
        "Closed" => "Карточка закрыта",
        "Reopened" => "Карточка открыта снова",
        "Note" => "Комментарий",
        "CardUpdated" => "Карточка изменена",
        "TaskCreated" => "Задача создана",
        "TaskCompleted" => "Задача выполнена",
        "TaskUpdated" => "Задача изменена",
        "TaskCancelled" => "Задача отменена",
        "TaskReopened" => "Задача возвращена в работу",
        "TaskDeleted" => "Задача удалена",
        "NoteUpdated" => "Комментарий изменён",
        "NoteDeleted" => "Комментарий удалён",
        "NotePinned" => "Комментарий закреплён",
        "NoteUnpinned" => "Комментарий откреплён",
        "SuccessReportUploaded" => "Загружен отчёт по успешному закрытию",
        "SuccessReportUpdated" => "Отчёт по успешному закрытию изменён",
        _ => action
    };
}
<div class="crm-feed">
    @foreach (var item in Model.Activity)
    {
        var feedTask = item.TaskId is Guid taskId
            ? Model.Tasks.FirstOrDefault(task => task.Id == taskId)
            : null;
        var isOpenTask = item.Kind == "task" && feedTask?.Status == CrmTaskStatuses.Open;
        var feedTone = item.Kind switch
        {
            "note" => "note",
            "call" => "call",
            "task-done" => "completed",
            "task" when isOpenTask && feedTask?.IsOverdue == true => "task-overdue",
            "task" when isOpenTask => "task-active",
            "task" => "completed",
            _ => "system"
        };
        var showFeedIcon = feedTone is "note" or "call" or "task-active" or "task-overdue";
        var feedIcon = item.IsPinned
            ? "fa-thumbtack"
            : feedTone switch
            {
                "note" => "fa-comment-dots",
                "call" => item.CallDirection == CrmCallDirections.Incoming ? "fa-phone-volume" : "fa-phone",
                "task-overdue" => "fa-calendar-xmark",
                _ => "fa-calendar-check"
            };
        var displayTitle = DisplayCrmAction(item.Title);
        var isSuccessReport = string.Equals(displayTitle, "Карточка закрыта", StringComparison.Ordinal)
            && string.Equals(item.Body, CrmCloseReasons.Success, StringComparison.Ordinal)
            && successDocuments.Count > 0;
        var successReportAnchor = isSuccessReport && !successReportAnchorRendered ? "crm-success-report" : null;
        if (isSuccessReport)
        {
            successReportAnchorRendered = true;
        }
        var systemTone = displayTitle switch
        {
            "Смена этапа" => "stage",
            "Назначен ответственный" => "assignment",
            "Карточка создана" or "Карточка изменена" or "Карточка закрыта" or "Карточка открыта снова" or "Загружен отчёт по успешному закрытию" => "card",
            _ when displayTitle.StartsWith("Задача", StringComparison.Ordinal) => "task",
            _ => "event"
        };
        <article class="crm-feed-item crm-feed-item--@feedTone @(feedTone == "system" ? $"crm-feed-item--system-{systemTone}" : "") @(item.IsPinned ? "is-pinned" : "")">
            @if (showFeedIcon)
            {
                <div class="crm-feed-item__icon"><i class="fa-solid @feedIcon" aria-hidden="true"></i></div>
            }
            <div class="crm-feed-item__content">
                <header>
                    <div class="crm-feed-item__heading">
                        <strong>@displayTitle</strong>
                    </div>
                    @if (feedTask is not null)
                    {
                        <span class="crm-feed-item__meta">@item.ActorName</span>
                    }
                    else
                    {
                        <span class="crm-feed-item__meta">
                            @item.ActorName · <time data-orbita-utc="@OrbitaTime.ToIsoUtc(item.AtUtc)" data-orbita-format="datetime-short-ru"></time>
                            @if (item.Kind == "note")
                            {
                                <span class="crm-feed-item__edited @(item.UpdatedAtUtc is null ? "is-hidden" : "")" data-crm-note-edited>
                                    · изменено <time data-orbita-utc="@OrbitaTime.ToIsoUtc(item.UpdatedAtUtc ?? item.AtUtc)" data-orbita-format="datetime-short-ru"></time>
                                </span>
                            }
                        </span>
                    }
                </header>
                @if (feedTask is not null)
                {
                    <div class="crm-feed-item__task-times" aria-label="Время работы с задачей">
                        <span><small>Создано</small><time data-orbita-utc="@OrbitaTime.ToIsoUtc(feedTask.CreatedAtUtc)" data-orbita-format="datetime-short-ru"></time></span>
                        @if (feedTask.DueAtUtc is DateTime dueAt)
                        {
                            <span class="crm-feed-item__task-deadline @(feedTask.IsOverdue && isOpenTask ? "is-overdue" : "")">
                                <small>Выполнить до</small><time data-orbita-utc="@OrbitaTime.ToIsoUtc(dueAt)" data-orbita-format="datetime-short-ru"></time>
                            </span>
                        }
                        @if (feedTask.UpdatedAtUtc is DateTime updatedAt)
                        {
                            <span><small>Изменено</small><time data-orbita-utc="@OrbitaTime.ToIsoUtc(updatedAt)" data-orbita-format="datetime-short-ru"></time></span>
                        }
                        @if (feedTask.CompletedAtUtc is DateTime completedAt)
                        {
                            <span><small>Закрыто</small><time data-orbita-utc="@OrbitaTime.ToIsoUtc(completedAt)" data-orbita-format="datetime-short-ru"></time></span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Body))
                    {
                        <p class="crm-feed-item__task-comment"><strong>Комментарий:</strong> @item.Body</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.CompletionReason))
                    {
                        <p class="crm-feed-item__task-result"><strong>Причина закрытия:</strong> @item.CompletionReason</p>
                    }
                }
                else if (item.Kind == "call")
                {
                    var storedRecordingUrl = item.CallRecordingStored && item.CallId is Guid callId
                        ? Url.Action("CallRecording", "Crm", new { callId })
                        : null;
                    var downloadRecordingUrl = item.CallRecordingStored && item.CallId is Guid downloadCallId
                        ? Url.Action("CallRecording", "Crm", new { callId = downloadCallId, download = true })
                        : null;
                    var recordingUrl = !string.IsNullOrWhiteSpace(storedRecordingUrl)
                        ? storedRecordingUrl
                        : item.CallRecordingUrl;
                    <div class="crm-feed-item__call-details">
                        @if (!string.IsNullOrWhiteSpace(item.CallClientPhone))
                        {
                            <span><small>Клиент</small>+@item.CallClientPhone</span>
                        }
                        <span><small>Длительность</small>@(TimeSpan.FromSeconds(item.CallDurationSeconds ?? 0).ToString(@"mm\:ss"))</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(recordingUrl))
                    {
                        <audio class="crm-feed-item__call-player" controls preload="none">
                            <source src="@recordingUrl" />
                            Ваш браузер не поддерживает прослушивание записи.
                        </audio>
                        <div class="crm-feed-item__call-actions">
                            <a class="crm-feed-item__call-link" href="@recordingUrl" target="_blank" rel="noopener noreferrer">
                                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>Открыть запись
                            </a>
                            @if (!string.IsNullOrWhiteSpace(downloadRecordingUrl))
                            {
                                <a class="crm-feed-item__call-link" href="@downloadRecordingUrl" download="download">
                                    <i class="fa-solid fa-download" aria-hidden="true"></i>Скачать
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="crm-feed-item__call-pending">
                            @(CrmCallStatuses.IsUnanswered(item.CallStatus)
                                ? "Разговор не состоялся."
                                : "Запись ещё не получена от оператора телефонии.")
                        </p>
                    }
                    @if (item.CallId is Guid aiCallId && !string.IsNullOrWhiteSpace(item.CallAiStatus))
                    {
                        <div class="crm-call-ai" data-call-ai data-call-ai-url="@Url.Action("CallAiInsight", "Crm", new { callId = aiCallId })">
                            @if (item.CallAiStatus is CrmCallAiStatuses.Completed or CrmCallAiStatuses.Partial)
                            {
                                <button type="button" class="crm-call-ai__load" data-call-ai-load>
                                    <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                                    Расшифровка и анализ звонка
                                </button>
                            }
                            else if (item.CallAiStatus is CrmCallAiStatuses.Pending or CrmCallAiStatuses.Transcribing or CrmCallAiStatuses.Analyzing)
                            {
                                <p class="crm-call-ai__state"><i class="fa-solid fa-spinner" aria-hidden="true"></i>Расшифровка и анализ готовятся…</p>
                            }
                            else if (item.CallAiStatus == CrmCallAiStatuses.Failed)
                            {
                                <p class="crm-call-ai__state crm-call-ai__state--failed"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>Не удалось подготовить расшифровку.</p>
                            }
                            else if (item.CallAiStatus == CrmCallAiStatuses.Skipped)
                            {
                                <p class="crm-call-ai__state"><i class="fa-solid fa-forward" aria-hidden="true"></i>Нулевая запись — расшифровка не требуется.</p>
                            }
                        </div>
                    }
                }
                else if (isSuccessReport)
                {
                    <div id="@successReportAnchor" class="crm-feed-success-report-wrap">
                        @if (!string.IsNullOrWhiteSpace(item.ActionComment))
                        {
                            <div class="crm-feed-item__action-details">
                                <p><small>Причина</small><span>@item.Body</span></p>
                                <p><small>Комментарий</small><span>@item.ActionComment</span></p>
                            </div>
                        }
                        <div class="crm-feed-success-report__summary">
                            <span class="crm-feed-success-report__summary-icon"><i class="fa-solid fa-folder-closed" aria-hidden="true"></i></span>
                            <span>
                                <strong>Отчёт по подписавшемуся кандидату</strong>
                                <small>@FormatFilesCount(successDocuments.Count) · @FormatFileSize(successDocuments.Sum(document => document.SizeBytes))</small>
                            </span>
                            <span class="crm-feed-success-report__summary-actions">
                                <em><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Комплект сохранён</em>
                                @if (canDownloadSuccessReportArchive)
                                {
                                    <a asp-action="DownloadSuccessReportArchive" asp-route-id="@card.Id"><i class="fa-solid fa-file-zipper" aria-hidden="true"></i>Скачать ZIP</a>
                                }
                                @if (canEditSuccessReport)
                                {
                                    <button type="button" data-crm-success-edit-open><i class="fa-solid fa-pen" aria-hidden="true"></i>Изменить</button>
                                }
                            </span>
                        </div>
                        <ol class="crm-feed-success-report">
                            @for (var stepIndex = 0; stepIndex < successReportSteps.Length; stepIndex++)
                            {
                                var step = successReportSteps[stepIndex];
                                var stepDocuments = successDocuments
                                    .Where(document => step.Categories.Contains(document.Category, StringComparer.Ordinal))
                                    .ToList();
                                var isMissingContract = stepIndex == 3
                                    && stepDocuments.Count == 0
                                    && !string.IsNullOrWhiteSpace(Model.SuccessContractMissingReason);
                                var stepStatus = stepDocuments.Count > 0
                                    ? FormatFilesCount(stepDocuments.Count)
                                    : isMissingContract
                                        ? "Нет фото"
                                        : step.Optional
                                            ? "Пропущено"
                                            : "Не приложено";
                                <li>
                                    <header class="crm-feed-success-report__step-header">
                                        <span class="crm-feed-success-report__number">@(stepIndex + 1)</span>
                                        <strong>@step.Title</strong>
                                        <small class="@(stepDocuments.Count > 0 ? "is-ready" : isMissingContract ? "is-warning" : "is-muted")">
                                            @if (stepDocuments.Count > 0)
                                            {
                                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                            }
                                            @stepStatus
                                        </small>
                                    </header>
                                    @if (stepDocuments.Count > 0 || isMissingContract)
                                    {
                                        <div class="crm-feed-success-report__step-body">
                                            @if (stepDocuments.Count > 0)
                                            {
                                            <div class="crm-feed-success-report__files">
                                                @foreach (var document in stepDocuments)
                                                {
                                                    <a asp-action="DownloadSuccessDocument" asp-route-id="@card.Id" asp-route-documentId="@document.Id">
                                                        <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
                                                        <span><strong>@document.FileName</strong><small>@(stepIndex == 5 ? CrmSuccessDocumentCategories.GetLabel(document.Category) + " · " : "")@FormatFileSize(document.SizeBytes)</small></span>
                                                    </a>
                                                }
                                            </div>
                                            }
                                            @if (isMissingContract)
                                            {
                                                <div class="crm-feed-success-report__reason">
                                                    <strong>Причина</strong>
                                                    <span>@Model.SuccessContractMissingReason</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ol>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(item.ActionComment))
                {
                    <div class="crm-feed-item__action-details">
                        @if (!string.IsNullOrWhiteSpace(item.Body))
                        {
                            <p><small>@(systemTone == "stage" ? "Переход" : systemTone == "card" ? "Причина" : "Детали")</small><span>@item.Body</span></p>
                        }
                        <p><small>Комментарий</small><span>@item.ActionComment</span></p>
                    </div>
                }
                else if (item.Kind == "note" && !string.IsNullOrWhiteSpace(item.Body))
                {
                    <p data-crm-note-body>@item.Body</p>
                }
                else if (!string.IsNullOrWhiteSpace(item.Body))
                {
                    <p>@item.Body</p>
                }
                @if (item.Kind == "note" && item.NoteId is Guid noteId)
                {
                    <div class="crm-inline-actions">
                        @if (item.CanPin)
                        {
                            <form asp-action="PinNote" method="post">
                                <input type="hidden" name="id" value="@card.Id" />
                                <input type="hidden" name="noteId" value="@noteId" />
                                <input type="hidden" name="isPinned" value="@((!item.IsPinned).ToString().ToLowerInvariant())" />
                                <button type="submit"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i>@(item.IsPinned ? "Открепить" : "Закрепить")</button>
                            </form>
                        }
                        @if (item.CanEdit)
                        {
                            <button type="button" data-crm-note-edit-open><i class="fa-solid fa-pen" aria-hidden="true"></i>Изменить</button>
                        }
                        @if (item.CanDelete)
                        {
                            <form asp-action="DeleteNote" method="post" onsubmit="return confirm('Удалить комментарий?');">
                                <input type="hidden" name="id" value="@card.Id" />
                                <input type="hidden" name="noteId" value="@noteId" />
                                <button type="submit" class="is-danger"><i class="fa-solid fa-trash" aria-hidden="true"></i>Удалить</button>
                            </form>
                        }
                    </div>
                    @if (item.CanEdit)
                    {
                        <form asp-action="UpdateNote" method="post" class="crm-note-inline-editor" data-crm-note-edit-form hidden>
                            <input type="hidden" name="id" value="@card.Id" />
                            <input type="hidden" name="noteId" value="@noteId" />
                            <input type="hidden" name="stage" value="@boardReturnStage" />
                            <textarea id="note-text-@noteId" name="text" maxlength="4000" aria-label="Текст комментария" required>@item.Body</textarea>
                            <div class="crm-note-inline-editor__actions">
                                <button class="settings-primary-btn" type="submit">Сохранить</button>
                                <button class="settings-secondary-btn" type="button" data-crm-note-edit-cancel>Отмена</button>
                            </div>
                            <span class="crm-note-inline-editor__error" data-crm-note-edit-error role="alert" hidden></span>
                        </form>
                    }
                }
            </div>
        </article>
    }
    @if (Model.Activity.Count == 0) { <p class="crm-empty">Пока нет активности — оставьте первый комментарий.</p> }
</div>
