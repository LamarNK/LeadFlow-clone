@model Orbita.Contracts.CrmBoardDto
@using Orbita.Web.Models.ViewModels
@inject Orbita.Web.Services.IOfficeContext OfficeContext
@{
    ViewData["Title"] = "CRM — Команда";
    var header = new PageHeaderViewModel
    {
        Title = "Команда CRM",
        Subtitle = "Нагрузка, очередь и настройки офиса",
        ShowRefresh = true,
        UpdatedAtUtc = DateTime.UtcNow
    };
    var officeId = OfficeContext.EffectiveOfficeId;
    var stageTotal = Math.Max(1, Model.TeamStats.TotalActiveCards);
}
<partial name="_PageHeader" model="header" />

<main class="orbita-main crm-shell crm-team-dashboard">
    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }
    @if (TempData["CrmOk"] is string ok)
    {
        <div class="crm-notice crm-notice--ok"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>@ok</div>
    }

    <section class="crm-team-overview" aria-label="Сводка по команде">
        <div class="crm-team-metrics">
            <article class="kpi-card crm-team-metric crm-team-metric--cards" style="--kpi-index: 0;">
                <header class="kpi-card-head"><span class="kpi-icon-box kpi-icon-box--blue"><i class="fa-regular fa-folder-open" aria-hidden="true"></i></span><span class="kpi-card-label">Активные карточки</span></header>
                <div class="kpi-card-metric crm-team-metric__metric"><b class="kpi-value">@Model.TeamStats.TotalActiveCards</b></div>
                <p class="crm-team-metric__caption">В работе у команды</p>
            </article>
            <article class="kpi-card crm-team-metric crm-team-metric--queue" style="--kpi-index: 1;">
                <header class="kpi-card-head"><span class="kpi-icon-box kpi-icon-box--orange"><i class="fa-solid fa-inbox" aria-hidden="true"></i></span><span class="kpi-card-label">Очередь</span></header>
                <div class="kpi-card-metric crm-team-metric__metric"><b class="kpi-value">@Model.UnassignedCount</b></div>
                <p class="crm-team-metric__caption">Ждут распределения</p>
            </article>
            <article class="kpi-card crm-team-metric crm-team-metric--shift" style="--kpi-index: 2;">
                <header class="kpi-card-head"><span class="kpi-icon-box kpi-icon-box--green"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span><span class="kpi-card-label">На смене</span></header>
                <div class="kpi-card-metric crm-team-metric__metric"><b class="kpi-value">@Model.TeamStats.OnShiftManagers</b></div>
                <p class="crm-team-metric__caption">Менеджеров доступны</p>
            </article>
            <article class="kpi-card crm-team-metric crm-team-metric--assigned" style="--kpi-index: 3;">
                <header class="kpi-card-head"><span class="kpi-icon-box kpi-icon-box--purple"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i></span><span class="kpi-card-label">Выдано сегодня</span></header>
                <div class="kpi-card-metric crm-team-metric__metric"><b class="kpi-value">@Model.TeamStats.AssignedToday</b></div>
                <p class="crm-team-metric__caption">Карточек назначено</p>
            </article>
            <article class="kpi-card crm-team-metric crm-team-metric--closed" style="--kpi-index: 4;">
                <header class="kpi-card-head"><span class="kpi-icon-box kpi-icon-box--green"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span><span class="kpi-card-label">Закрыто сегодня</span></header>
                <div class="kpi-card-metric crm-team-metric__metric"><b class="kpi-value">@Model.TeamStats.ClosedToday</b></div>
                <p class="crm-team-metric__caption">Завершено за смену</p>
            </article>
        </div>
    </section>

    <div class="crm-team-grid">
        <section class="card crm-team-panel crm-team-panel--managers">
            <header class="crm-team-panel__header"><div><h2>Менеджеры</h2><p>Ёмкость и текущая нагрузка по активным карточкам.</p></div><b>@Model.Managers.Count</b></header>
            <div class="crm-manager-table">
                <div class="crm-manager-table__head" aria-hidden="true"><span>Менеджер</span><span>Нагрузка</span><span>Лимит</span></div>
                @foreach (var m in Model.Managers)
                {
                    var pct = m.Capacity <= 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * m.ActiveLoad / m.Capacity));
                    <article class="crm-manager-row @(pct >= 100 ? "is-at-limit" : null)">
                        <div class="crm-manager-row__name">
                            <span class="crm-manager-row__identity"><i class="fa-solid fa-circle @(m.IsShiftActive ? "is-online" : "")" aria-hidden="true"></i><strong>@m.DisplayName</strong></span>
                            <span>@(m.IsShiftActive ? "на смене" : "не на смене")</span>
                        </div>
                        <div class="crm-manager-row__load">
                            <strong>@m.ActiveLoad / @m.Capacity</strong>
                            <span class="crm-progress"><i style="width:@pct%"></i></span>
                        </div>
                        <form asp-action="SaveCapacity" method="post" class="crm-capacity-form">
                            <input type="hidden" name="managerUserId" value="@m.UserId" />
                            <label><span>Лимит</span><input type="number" name="capacity" min="1" max="100" value="@m.Capacity" aria-label="Лимит нагрузки для @m.DisplayName" /></label>
                            <button class="settings-secondary-btn" type="submit">Сохранить</button>
                        </form>
                    </article>
                }
                @if (Model.Managers.Count == 0)
                {
                    <p class="crm-empty">В офисе нет менеджеров с ролью Manager.</p>
                }
            </div>
        </section>

        <section class="card crm-team-panel crm-team-panel--stages">
            <header class="crm-team-panel__header"><div><h2>По этапам</h2><p>Активные карточки текущего офиса.</p></div></header>
            <div class="crm-stage-counts">
                @foreach (var stage in Model.TeamStats.StageCounts.OrderByDescending(x => x.Count))
                {
                    var pct = Math.Min(100, (int)Math.Round(100.0 * stage.Count / stageTotal));
                    <div class="crm-stage-count"><div><span>@stage.Stage</span><strong>@stage.Count</strong></div><i><b style="width:@pct%"></b></i></div>
                }
                @if (Model.TeamStats.StageCounts.Count == 0)
                {
                    <p class="crm-empty">Нет данных</p>
                }
            </div>
        </section>

        <section class="card crm-team-panel crm-team-panel--settings">
            <header class="crm-team-panel__header"><div><h2>Настройки офиса</h2><p>Приём откликов и правила работы менеджеров.</p></div></header>
            @if (officeId is Guid oid)
            {
                <form asp-action="SaveOfficeSettings" method="post" class="crm-standard-form crm-office-settings-form">
                    <input type="hidden" name="officeId" value="@oid" />
                    <div class="crm-office-settings-form__options">
                        <label class="crm-setting-toggle">
                            <input type="checkbox" name="isEnabled" value="true" @(Model.IsEnabled ? "checked" : null) />
                            <span><strong>Принимать отклики в CRM</strong><small>Создавать карточки из откликов операторов.</small></span>
                        </label>
                        <label class="crm-setting-toggle">
                            <input type="checkbox" name="requireStageComment" value="true" @(Model.RequireStageComment ? "checked" : null) />
                            <span><strong>Комментарий при смене этапа</strong><small>Просить менеджера пояснить изменение статуса.</small></span>
                        </label>
                        <label class="crm-setting-toggle">
                            <input type="checkbox" name="deadlineNotificationsEnabled" value="true" @(Model.DeadlineNotificationsEnabled ? "checked" : null) />
                            <span><strong>Напоминания по срокам задач</strong><small>Персонально уведомлять ответственного за 24 часа, за час и при просрочке.</small></span>
                        </label>
                    </div>
                    <div class="crm-form-footer">
                        <p class="crm-hint">Та же настройка, что в «Администрирование → Офисы». Выключение не останавливает Bitrix.</p>
                        <button class="settings-primary-btn" type="submit">Сохранить настройки</button>
                    </div>
                </form>
            }
            else
            {
                <p class="crm-empty">Выберите офис в шапке.</p>
            }
        </section>

        <section class="card crm-team-panel crm-team-panel--funnel">
            <header class="crm-team-panel__header"><div><h2>Воронка офиса</h2><p>Этапы CRM для текущего офиса.</p></div></header>
            @if (officeId is Guid funnelOfficeId)
            {
                <form asp-action="SaveOfficeFunnel" method="post" class="crm-standard-form crm-funnel-form">
                    <input type="hidden" name="officeId" value="@funnelOfficeId" />
                    <label for="stagesText">Этапы (один на строку, сверху вниз)</label>
                    <textarea id="stagesText" name="stagesText" rows="@(Math.Max(6, Model.FunnelStages.Count + 2))" spellcheck="false">@string.Join(Environment.NewLine, Model.FunnelStages)</textarea>
                    <p class="crm-hint">От @CrmStages.MinCount до @CrmStages.MaxCount уникальных этапов, до @CrmStages.MaxNameLength символов. Карточки с удалённых этапов переносятся на первый этап.</p>
                    <div class="crm-funnel-form__actions">
                        <button class="settings-primary-btn" type="submit">Сохранить воронку</button>
                        <button class="settings-secondary-btn" type="submit" name="resetDefault" value="true">Сбросить по умолчанию</button>
                    </div>
                </form>
            }
            else
            {
                <p class="crm-empty">Выберите офис в шапке.</p>
            }
        </section>
    </div>
</main>
