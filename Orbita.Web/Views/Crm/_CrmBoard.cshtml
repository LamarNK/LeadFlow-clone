@model Orbita.Contracts.CrmBoardDto
@using Orbita.Contracts
@{
    var boardReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentUserId = ViewData["CurrentCrmUserId"] as string;
    var canUseBulkActions = Model.IsAdmin;
    var bulkReasonRequired = User.IsInRole(PanelRoles.SeniorManager)
                             && !User.IsInRole(PanelRoles.OfficeLead)
                             && !User.IsInRole(PanelRoles.Admin);
    var canSelectWholeStage = canUseBulkActions
                              && string.Equals(Model.Scope, CrmBoardScopes.Team, StringComparison.Ordinal)
                              && string.IsNullOrWhiteSpace(Model.ManagerUserId)
                              && string.IsNullOrWhiteSpace(Model.Search)
                              && string.IsNullOrWhiteSpace(Model.City)
                              && string.IsNullOrWhiteSpace(Model.Vacancy)
                              && string.IsNullOrWhiteSpace(Model.CloseReason)
                              && string.IsNullOrWhiteSpace(Model.Stage)
                              && string.IsNullOrWhiteSpace(Model.CreatedFrom)
                              && string.IsNullOrWhiteSpace(Model.CreatedTo)
                              && !Model.OverdueOnly
                              && !Model.ActiveLoadOnly
                              && !Model.IncludeClosed;
}
<section class="crm-board-card card" aria-label="Воронка кандидатов" data-crm-board-carousel data-crm-require-stage-comment="true" data-crm-bulk-board="@(canUseBulkActions ? "true" : "false")" data-crm-bulk-reason-required="@(bulkReasonRequired ? "true" : "false")">
    <div class="crm-board-toolbar">
        <div class="crm-board-toolbar__meta">
            <strong>Этапы воронки</strong>
            <span data-crm-board-range>@Model.Stages.Count этап(ов)</span>
        </div>
        <div class="crm-board-jumps" role="tablist" aria-label="Перейти к этапу" data-crm-board-jumps>
            @for (var jumpIndex = 0; jumpIndex < Model.Stages.Count; jumpIndex++)
            {
                var jumpStage = Model.Stages[jumpIndex];
                <button type="button"
                        class="crm-board-jump"
                        role="tab"
                        data-crm-board-jump
                        data-stage-index="@jumpIndex"
                        title="@jumpStage.Name · @jumpStage.TotalCount"
                        aria-label="Перейти к этапу @jumpStage.Name">
                    <span class="crm-board-jump__name">@jumpStage.Name</span>
                    <span class="crm-board-jump__count">@jumpStage.TotalCount</span>
                </button>
            }
        </div>
        <div class="crm-board-nav" role="group" aria-label="Листать этапы">
            <button type="button" data-crm-board-prev aria-label="Предыдущий этап" title="Предыдущий этап (←)">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <button type="button" data-crm-board-next aria-label="Следующий этап" title="Следующий этап (→)">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    @if (canUseBulkActions)
    {
        <div class="crm-bulk-actions" data-crm-bulk-actions hidden>
            <div class="crm-bulk-actions__selection">
                <span class="crm-bulk-actions__icon"><i class="fa-solid fa-check-double" aria-hidden="true"></i></span>
                <span><strong data-crm-bulk-count>0</strong> выбрано</span>
                <span class="crm-bulk-actions__scope" data-crm-bulk-stage-label hidden></span>
                <button type="button" class="crm-bulk-actions__clear" data-crm-bulk-clear>Снять выбор</button>
            </div>
            <div class="crm-bulk-actions__controls">
                <form asp-action="BulkAssign" method="post" class="crm-bulk-actions__assign" data-crm-bulk-form>
                    <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                    <span data-crm-bulk-card-fields></span>
                    <label>
                        <span>Новый ответственный</span>
                        <select name="managerUserId" required data-crm-bulk-assignee>
                            <option value="" selected disabled>Выберите сотрудника</option>
                            @foreach (var manager in Model.Managers.OrderBy(x => x.DisplayName, StringComparer.CurrentCultureIgnoreCase))
                            {
                                <option value="@manager.UserId">@manager.DisplayName</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="settings-primary-btn"><i class="fa-solid fa-user-check" aria-hidden="true"></i>Назначить</button>
                </form>
                <label class="crm-bulk-actions__stage">
                    <span>Новая стадия</span>
                    <select data-crm-bulk-stage-trigger aria-label="Выберите новую стадию для отмеченных карточек">
                        <option value="" selected>Выберите стадию</option>
                        @foreach (var stage in Model.Stages)
                        {
                            <option value="@stage.Name">@stage.Name</option>
                        }
                    </select>
                </label>
            </div>
            <div class="crm-bulk-actions__transitions">
                <button type="button" class="crm-bulk-actions__close" data-crm-bulk-transition-open="close"><i class="fa-solid fa-box-archive" aria-hidden="true"></i>Закрыть карточки</button>
            </div>
        </div>

        <div class="crm-bulk-modal" data-crm-bulk-modal hidden>
            <button type="button" class="crm-bulk-modal__backdrop" data-crm-bulk-modal-close tabindex="-1" aria-label="Закрыть окно"></button>
            <section class="crm-bulk-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="crm-bulk-modal-title" tabindex="-1">
                <header class="crm-bulk-modal__header">
                    <div>
                        <h2 id="crm-bulk-modal-title" data-crm-bulk-modal-title>Массовое изменение</h2>
                        <p><strong data-crm-bulk-modal-count>0</strong> карточек будет изменено одновременно.</p>
                    </div>
                    <button type="button" class="crm-bulk-modal__x" data-crm-bulk-modal-close aria-label="Закрыть"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                </header>
                <form asp-action="BulkTransition" method="post" class="crm-bulk-modal__form" data-crm-bulk-form data-crm-bulk-transition-form>
                    <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                    <input type="hidden" name="operation" value="move" data-crm-bulk-operation />
                    <span data-crm-bulk-card-fields></span>
                    <label data-crm-bulk-stage-field>
                        <span>Новый этап</span>
                        <select name="stage" data-crm-bulk-stage-select>
                            <option value="" selected disabled>Выберите этап</option>
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.Name">@stage.Name</option>
                            }
                        </select>
                    </label>
                    <label data-crm-bulk-close-field hidden>
                        <span>Тип закрытия</span>
                        <select name="closeReason" data-crm-bulk-close-select>
                            <option value="" selected disabled>Выберите тип закрытия</option>
                            @foreach (var reason in CrmCloseReasons.All)
                            {
                                <option value="@reason">@reason</option>
                            }
                        </select>
                    </label>
                    <label class="crm-bulk-modal__comment">
                        <span data-crm-bulk-comment-label>Причина смены этапа@(bulkReasonRequired ? " *" : "")</span>
                        <textarea name="comment"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="@(bulkReasonRequired ? "Обязательно укажите причину" : "Можно оставить пустым")"
                                  @(bulkReasonRequired ? "required" : null)
                                  data-crm-bulk-comment></textarea>
                    </label>
                    <p class="crm-bulk-modal__hint">
                        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                        @(bulkReasonRequired
                            ? "Для старшего менеджера причина обязательна и сохранится в истории каждой карточки."
                            : "Комментарий необязателен. Действие всё равно сохранится в истории каждой карточки.")
                    </p>
                    <footer class="crm-bulk-modal__footer">
                        <button type="button" class="settings-secondary-btn" data-crm-bulk-modal-close>Отмена</button>
                        <button type="submit" class="settings-primary-btn" data-crm-bulk-submit><i class="fa-solid fa-check" aria-hidden="true"></i>Применить</button>
                    </footer>
                </form>
            </section>
        </div>
    }
    <div class="crm-board-viewport" data-crm-board-viewport>
        <div class="crm-board-wrap" data-crm-board-scroll tabindex="0" aria-label="Горизонтальная прокрутка воронки. Колёсико с Shift или перетаскивание мышью. Карточку можно перетащить на другой этап.">
            <div class="crm-board" data-crm-board style="--crm-stage-count: @Model.Stages.Count">
            @for (var stageIndex = 0; stageIndex < Model.Stages.Count; stageIndex++)
            {
                var stage = Model.Stages[stageIndex];
                var hasRisk = stage.Cards.Any(card => card.HasOverdueTask || card.HoursInStage >= 24);
                var hasUnassigned = stage.Cards.Any(card => !card.IsClosed && string.IsNullOrWhiteSpace(card.ManagerUserId));
                var stagePageUrl = Url.Action("StagePage", new
                {
                    scope = Model.Scope,
                    managerUserId = Model.ManagerUserId,
                    search = Model.Search,
                    city = Model.City,
                    vacancy = Model.Vacancy,
                    closeReason = Model.CloseReason,
                    overdueOnly = Model.OverdueOnly,
                    activeLoadOnly = Model.ActiveLoadOnly,
                    includeClosed = Model.IncludeClosed,
                    createdFrom = Model.CreatedFrom,
                    createdTo = Model.CreatedTo,
                    sort = Model.Sort,
                    dir = Model.SortDir,
                    stage = stage.Name
                });
                <section class="crm-stage @(hasRisk ? "is-risk" : "") @(hasUnassigned ? "has-unassigned" : "")" data-stage="@stage.Name" data-stage-index="@stageIndex" id="crm-stage-@stageIndex">
                    <header class="crm-stage__head">
                        <h3>@stage.Name</h3>
                        <div class="crm-stage__head-actions">
                            @if (canSelectWholeStage && stage.TotalCount > 0 && !string.Equals(stage.Name, "Закрыто", StringComparison.Ordinal))
                            {
                                <button type="button"
                                        class="crm-stage__select-all"
                                        data-crm-select-stage
                                        data-stage-name="@stage.Name"
                                        data-total-count="@stage.TotalCount"
                                        title="Выбрать все @stage.TotalCount карточек этапа «@stage.Name»"
                                        aria-label="Выбрать все карточки этапа @stage.Name"
                                        aria-pressed="false">
                                    <i class="fa-solid fa-check-double" aria-hidden="true"></i>
                                </button>
                            }
                            @if (canUseBulkActions && stage.TotalCount > 0 && !string.Equals(stage.Name, "Закрыто", StringComparison.Ordinal))
                            {
                                <a class="crm-stage__export"
                                   href="@Url.Action("ExportStage", new { stage = stage.Name })"
                                   download
                                   data-no-fast-nav
                                   title="Скачать весь этап «@stage.Name» в ZIP"
                                   aria-label="Скачать весь этап @stage.Name в ZIP">
                                    <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
                                </a>
                            }
                            <span title="Карточек в этапе">@stage.TotalCount</span>
                        </div>
                    </header>
                    <div class="crm-stage__cards"
                         data-crm-stage-cards
                         data-crm-stage-page-url="@stagePageUrl"
                         data-crm-stage-next-page="2"
                         data-crm-stage-loaded="@stage.Cards.Count"
                         data-crm-stage-total="@stage.TotalCount">
                    @foreach (var card in stage.Cards)
                    {
                        <partial name="_CrmTile" model="new Orbita.Web.Models.ViewModels.CrmTileViewModel(
                            card,
                            Model.Managers,
                            stage.Name,
                            currentUserId,
                            boardReturnUrl,
                            Model.CanEdit,
                            Model.IsAdmin,
                            canUseBulkActions)" />
                    }
                    @if (stage.Cards.Count == 0)
                    {
                        <div class="crm-stage__empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><strong>Пока пусто</strong><span>Карточки появятся после перехода на этап</span></div>
                    }
                    @if (stage.Cards.Count < stage.TotalCount)
                    {
                        <div class="crm-stage__loader" data-crm-stage-loader aria-live="polite">
                            <i class="fa-solid fa-spinner" aria-hidden="true"></i><span>Загрузим дальше при прокрутке</span>
                        </div>
                    }
                    </div>
                </section>
            }
            </div>
        </div>
    </div>
</section>
