@model Orbita.Contracts.CrmBoardDto
@using Orbita.Contracts
@{
    var boardReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var currentUserId = ViewData["CurrentCrmUserId"] as string;
}
<section class="crm-board-card card" aria-label="Воронка кандидатов" data-crm-board-carousel data-crm-require-stage-comment="true">
    <div class="crm-board-toolbar">
        <div class="crm-board-toolbar__meta">
            <strong>Этапы воронки</strong>
            <span data-crm-board-range>@Model.Stages.Count этап(ов)</span>
        </div>
        <div class="crm-board-jumps" role="tablist" aria-label="Перейти к этапу" data-crm-board-jumps>
            @for (var jumpIndex = 0; jumpIndex < Model.Stages.Count; jumpIndex++)
            {
                var jumpStage = Model.Stages[jumpIndex];
                <button type="button"
                        class="crm-board-jump"
                        role="tab"
                        data-crm-board-jump
                        data-stage-index="@jumpIndex"
                        title="@jumpStage.Name · @jumpStage.TotalCount"
                        aria-label="Перейти к этапу @jumpStage.Name">
                    <span class="crm-board-jump__name">@jumpStage.Name</span>
                    <span class="crm-board-jump__count">@jumpStage.TotalCount</span>
                </button>
            }
        </div>
        <div class="crm-board-nav" role="group" aria-label="Листать этапы">
            <button type="button" data-crm-board-prev aria-label="Предыдущий этап" title="Предыдущий этап (←)">
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <button type="button" data-crm-board-next aria-label="Следующий этап" title="Следующий этап (→)">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="crm-board-viewport" data-crm-board-viewport>
        <div class="crm-board-wrap" data-crm-board-scroll tabindex="0" aria-label="Горизонтальная прокрутка воронки. Колёсико с Shift или перетаскивание мышью. Карточку можно перетащить на другой этап.">
            <div class="crm-board" data-crm-board style="--crm-stage-count: @Model.Stages.Count">
            @for (var stageIndex = 0; stageIndex < Model.Stages.Count; stageIndex++)
            {
                var stage = Model.Stages[stageIndex];
                var hasRisk = stage.Cards.Any(card => card.HasOverdueTask || card.HoursInStage >= 24);
                var hasUnassigned = stage.Cards.Any(card => !card.IsClosed && string.IsNullOrWhiteSpace(card.ManagerUserId));
                <section class="crm-stage @(hasRisk ? "is-risk" : "") @(hasUnassigned ? "has-unassigned" : "")" data-stage="@stage.Name" data-stage-index="@stageIndex" id="crm-stage-@stageIndex">
                    <header class="crm-stage__head">
                        <h3>@stage.Name</h3>
                        <span title="Карточек в этапе">@stage.TotalCount</span>
                    </header>
                    <div class="crm-stage__cards">
                    @foreach (var card in stage.Cards)
                    {
                        var defaultAssigneeUserId = card.ManagerUserId
                            ?? Model.Managers.FirstOrDefault(x => x.UserId == currentUserId)?.UserId
                            ?? Model.Managers.FirstOrDefault()?.UserId;
                        var adUrl = !string.IsNullOrWhiteSpace(card.VacancyUrl) ? card.VacancyUrl : card.SourceUrl;
                        var hasOverdueTask = !card.IsClosed && card.HasOverdueTask;
                        var hasActiveTask = !card.IsClosed && card.OpenTaskCount > 0 && !hasOverdueTask;
                        <article class="crm-tile @(card.IsClosed ? "is-closed" : "") @(hasOverdueTask ? "is-overdue" : "") @(hasActiveTask ? "has-active-task" : "")"
                                 @if (Model.CanEdit && !card.IsClosed) { <text>draggable="true" data-card-id="@card.Id" data-card-stage="@card.Stage"</text> }>
                            <a asp-action="Card" asp-route-id="@card.Id" asp-route-stage="@stage.Name" class="crm-tile__body" data-crm-open-card data-crm-stage="@stage.Name">
                            <div class="crm-tile__top">
                                <strong>@card.FullName</strong>
                                @if (!card.IsInActiveLoad && !card.IsClosed) { <span class="crm-tag">Вне нагрузки</span> }
                                @if (card.IsClosed) { <span class="crm-tag crm-tag--muted">@card.CloseReason</span> }
                            </div>
                            <div class="crm-tile__meta">@(card.Age?.ToString() ?? "—") лет · @card.City</div>
                            <div class="crm-tile__vacancy">@card.Vacancy</div>
                            <footer class="crm-tile__foot">
                                <span class="crm-tile__assignee">
                                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                                    <small>Ответственный</small>
                                    <strong>@(card.ManagerName ?? "Не назначен")</strong>
                                </span>
                                <span class="@(card.HoursInStage >= 24 ? "crm-hot" : "")" title="В этапе">@card.HoursInStage.ToString("0.#")ч</span>
                                @if (card.OpenTaskCount > 0)
                                {
                                    <span class="crm-tile__tasks @(hasOverdueTask ? "is-overdue" : "is-active")"><i class="fa-solid fa-list-check" aria-hidden="true"></i>@card.OpenTaskCount</span>
                                }
                            </footer>
                            </a>
                            @if (!card.IsClosed)
                            {
                                <div class="crm-tile__actions" aria-label="Быстрые действия для @card.FullName">
                                    <a href="tel:@card.PhoneRaw" title="Позвонить"><i class="fa-solid fa-phone" aria-hidden="true"></i><span>Позвонить</span></a>
                                    @if (!string.IsNullOrWhiteSpace(adUrl))
                                    {
                                        <a href="@adUrl" target="_blank" rel="noopener" title="Открыть объявление"><i class="fa-solid fa-tag" aria-hidden="true"></i><span>Объявление</span></a>
                                    }
                                    @if (Model.CanEdit)
                                    {
                                        @if (!card.IsInActiveLoad)
                                        {
                                            <form asp-action="SetLoad" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="active" value="true" /><input type="hidden" name="returnUrl" value="@boardReturnUrl" /><button type="submit" title="Вернуть в активную нагрузку"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span>В нагрузку</span></button></form>
                                        }
                                        @if (Model.IsAdmin || defaultAssigneeUserId is not null)
                                        {
                                            <details class="crm-tile__quick-menu">
                                                <summary title="Ещё действия"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i><span>Ещё действия</span></summary>
                                                <div>
                                                    @if (Model.IsAdmin && Model.Managers.Count > 0)
                                                    {
                                                        <form asp-action="Assign" method="post">
                                                            <input type="hidden" name="id" value="@card.Id" />
                                                            <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                                                            <select name="managerUserId" aria-label="Назначить менеджера для @card.FullName">
                                                                @foreach (var manager in Model.Managers)
                                                                {
                                                                    if (manager.UserId == card.ManagerUserId)
                                                                    {
                                                                        <option value="@manager.UserId" selected>@manager.DisplayName</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@manager.UserId">@manager.DisplayName</option>
                                                                    }
                                                                }
                                                            </select>
                                                            <button type="submit"><i class="fa-regular fa-user" aria-hidden="true"></i>Назначить</button>
                                                        </form>
                                                    }
                                                    @if (defaultAssigneeUserId is not null)
                                                    {
                                                        <form asp-action="CreateTask" method="post">
                                                            <input type="hidden" name="cardId" value="@card.Id" />
                                                            <input type="hidden" name="assigneeUserId" value="@defaultAssigneeUserId" />
                                                            <input type="hidden" name="importance" value="@CrmTaskImportances.Medium" />
                                                            <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                                                            <select name="taskType" required aria-label="Тип задачи">
                                                                <option value="" selected disabled>Тип задачи</option>
                                                                @foreach (var taskType in CrmTaskTypes.All)
                                                                {
                                                                    <option value="@taskType">@CrmTaskTypes.GetLabel(taskType)</option>
                                                                }
                                                            </select>
                                                            <button type="submit"><i class="fa-solid fa-list-check" aria-hidden="true"></i>Поставить</button>
                                                        </form>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    }
                                </div>
                            }
                        </article>
                    }
                    @if (stage.Cards.Count == 0)
                    {
                        <div class="crm-stage__empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><strong>Пока пусто</strong><span>Карточки появятся после перехода на этап</span></div>
                    }
                    </div>
                </section>
            }
            </div>
        </div>
    </div>
</section>
