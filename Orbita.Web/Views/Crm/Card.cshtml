@model Orbita.Contracts.CrmCandidateDetailDto
@using Orbita.Contracts
@using Orbita.Web.Models.ViewModels
@{
    ViewData["Title"] = Model.Card.FullName;
    var header = new PageHeaderViewModel { Title = Model.Card.FullName, Subtitle = "Карточка кандидата", ShowRefresh = true, UpdatedAtUtc = DateTime.UtcNow };
    var activeTab = ViewData["CrmTab"] as string ?? "activity";
    var card = Model.Card;
    var canEdit = Model.CanEdit;
    var canAccessCrmTasks = ViewData["CanAccessCrmTasks"] as bool? == true;
    var currentUserId = ViewData["CurrentCrmUserId"] as string;
    var isCrmAdmin = ViewData["IsCrmAdmin"] as bool? == true;
    var boardReturnStage = Context.Request.Query["stage"].ToString();
    if (string.IsNullOrWhiteSpace(boardReturnStage))
    {
        boardReturnStage = card.Stage;
    }
    var vacancyUrl = !string.IsNullOrWhiteSpace(card.VacancyUrl) ? card.VacancyUrl : card.SourceUrl;
    var phoneDigits = string.Concat(card.PhoneRaw.Where(char.IsDigit));
    var messengerPhone = phoneDigits.Length == 11 && phoneDigits.StartsWith("8", StringComparison.Ordinal) ? "7" + phoneDigits[1..] : phoneDigits;
    var phoneE164 = $"+{messengerPhone}";
    var encodedPhone = Uri.EscapeDataString(phoneE164);
    var hasCandidateMessages = Model.Chat.Any(message => message.Tone == "incoming");
    string DisplayCrmAction(string action) => action switch
    {
        "Created" => "Карточка создана",
        "Assigned" => "Назначен ответственный",
        "StageChanged" => "Смена этапа",
        "ReturnedToLoad" => "Вернули в нагрузку",
        "RemovedFromLoad" => "Сняли с нагрузки",
        "Closed" => "Карточка закрыта",
        "Reopened" => "Карточка открыта снова",
        "Note" => "Комментарий",
        "CardUpdated" => "Карточка изменена",
        "TaskCreated" => "Задача создана",
        "TaskCompleted" => "Задача выполнена",
        _ => action
    };
}
<partial name="_PageHeader" model="header" />

<div class="orbita-main crm-shell crm-card-page">
    <a asp-action="Index" asp-route-stage="@boardReturnStage" class="crm-back" data-crm-back-to-board data-crm-stage="@boardReturnStage"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>К воронке</a>
    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }

    <section class="crm-card-hero card">
        <form asp-action="UpdateCard" method="post" class="crm-card-inline-edit-form" data-crm-card-inline-edit>
            <input type="hidden" name="id" value="@card.Id" />
            <input type="hidden" name="stage" value="@boardReturnStage" />
            <input type="hidden" name="tab" value="@activeTab" />
        <div class="crm-card-hero__main">
            <div class="crm-avatar">
                @(string.IsNullOrEmpty(card.FullName) ? "?" : card.FullName.Trim()[0])
                <img src="@Url.Action("Avatar", "Crm", new { id = card.Id })" alt="" onerror="this.remove()" />
            </div>
            <div>
                <h1>
                    <span class="crm-card-inline-edit__name-value">@card.FullName</span>
                    <input class="crm-card-inline-edit__name-input" name="fullName" value="@card.FullName" required maxlength="256" aria-label="ФИО кандидата" />
                </h1>
                <p>
                    @(card.Age?.ToString() ?? "—") лет · @card.City ·
                    @if (!string.IsNullOrWhiteSpace(vacancyUrl))
                    {
                        <a class="crm-vacancy-link" href="@vacancyUrl" target="_blank" rel="noopener" title="Открыть объявление">@card.Vacancy <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        @card.Vacancy
                    }
                    @if (card.IsClosed) { <span class="crm-tag crm-tag--muted">Закрыто: @card.CloseReason</span> }
                    else if (!card.IsInActiveLoad) { <span class="crm-tag">Вне нагрузки</span> }
                </p>
                <div class="crm-card-hero__contacts">
                    <details class="crm-phone-actions crm-card-inline-edit__phone-display">
                        <summary class="settings-secondary-btn" aria-label="Действия с номером @card.PhoneRaw"><i class="fa-solid fa-phone" aria-hidden="true"></i>@card.PhoneRaw<i class="fa-solid fa-chevron-down crm-phone-actions__caret" aria-hidden="true"></i></summary>
                        <div class="crm-phone-actions__menu">
                            <span class="crm-phone-actions__title">Связаться с кандидатом</span>
                            <a href="tel:@card.PhoneRaw"><i class="fa-solid fa-phone" aria-hidden="true"></i>Позвонить</a>
                            @if (!string.IsNullOrWhiteSpace(messengerPhone))
                            {
                                <a href="https://wa.me/@messengerPhone" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>WhatsApp</a>
                                <a href="tg://resolve?phone=@encodedPhone"><i class="fa-brands fa-telegram" aria-hidden="true"></i>Telegram</a>
                                <a href="viber://chat?number=@encodedPhone"><i class="fa-brands fa-viber" aria-hidden="true"></i>Viber</a>
                            }
                            <button type="button" data-copy="@card.PhoneRaw" onclick="window.Orbita.copyText(this.dataset.copy, 'Телефон скопирован.');"><i class="fa-regular fa-copy" aria-hidden="true"></i>Копировать номер</button>
                        </div>
                    </details>
                    <input class="crm-card-inline-edit__phone-input" name="phoneRaw" value="@card.PhoneRaw" required maxlength="64" aria-label="Основной телефон" />
                    @if (!string.IsNullOrWhiteSpace(vacancyUrl))
                    {
                        <a href="@vacancyUrl" target="_blank" rel="noopener" class="settings-secondary-btn"><i class="fa-solid fa-tag" aria-hidden="true"></i>Объявление</a>
                    }
                    @if (canEdit)
                    {
                        <button type="button" class="settings-secondary-btn crm-card-inline-edit__toggle" data-crm-card-inline-edit-toggle aria-expanded="false"><i class="fa-solid fa-pen" aria-hidden="true"></i>Редактировать</button>
                        <div class="crm-card-inline-edit__actions">
                            <button class="settings-primary-btn" type="submit">Сохранить</button>
                            <button class="settings-secondary-btn" type="button" data-crm-card-inline-edit-cancel>Отмена</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        </form>
        <div class="crm-card-hero__side">
            <div><small>Ответственный</small><strong>@(card.ManagerName ?? "Не назначен")</strong></div>
            <div><small>В этапе</small><strong class="@(card.HoursInStage >= 24 ? "crm-hot" : "")">@card.HoursInStage.ToString("0.#") ч</strong></div>
            <div><small>Задачи</small><strong class="@(card.HasOverdueTask ? "crm-overdue" : "")">@card.OpenTaskCount</strong></div>
            @if (card.NextActionAtUtc is DateTime nextAction)
            {
                <div><small>Следующее действие</small><strong class="@(nextAction < DateTime.UtcNow ? "crm-overdue" : "")">@nextAction.ToLocalTime().ToString("dd.MM, HH:mm")</strong></div>
            }
        </div>
    </section>

    @if (canEdit)
    {
        <section class="crm-stage-rail card">
            <div class="crm-stage-rail__comment">
                <label for="stageComment">Комментарий к смене этапа (если требуется в офисе)</label>
                <input id="stageComment" type="text" form="crm-stage-forms" name="comment" placeholder="Необязательно, если офис не требует" />
            </div>
            <div class="crm-stage-rail__stages" style="--crm-stage-count: @Model.Stages.Count">
            @foreach (var stage in Model.Stages)
            {
                <form asp-action="Move" method="post" class="@(stage == card.Stage ? "is-current" : "") @(card.IsClosed ? "is-disabled" : "")">
                    <input type="hidden" name="id" value="@card.Id" />
                    <input type="hidden" name="stage" value="@stage" />
                    <input type="hidden" name="comment" value="" data-stage-comment />
                    <button type="submit" @(card.IsClosed ? "disabled" : null)>@stage</button>
                </form>
            }
            </div>
        </section>
    }

    <div class="crm-card-layout">
        <aside class="crm-card-side">
            <section class="card crm-side-panel">
                <header>Контакты и поля</header>
                <dl>
                    <div><dt>Телефон</dt><dd>@card.PhoneRaw</dd></div>
                    @{
                        var contactPhones = Model.ContactPhones ?? Array.Empty<CrmContactPhoneDto>();
                    }
                    @if (contactPhones.Count > 0)
                    {
                        <div>
                            <dt>Контакты</dt>
                            <dd class="crm-phone-history">
                                @foreach (var ph in contactPhones)
                                {
                                    <span>
                                        <i class="fa-solid fa-phone" aria-hidden="true"></i>@ph.PhoneRaw
                                        @if (ph.IsPrimary) { <em>основной</em> }
                                        else if (!string.IsNullOrWhiteSpace(ph.Label)) { <em>@ph.Label</em> }
                                        @if (canEdit && ph.Id != Guid.Empty)
                                        {
                                            if (!ph.IsPrimary)
                                            {
                                                <form asp-action="SetPrimaryPhone" method="post" class="crm-inline-form">
                                                    <input type="hidden" name="id" value="@card.Id" />
                                                    <input type="hidden" name="phoneId" value="@ph.Id" />
                                                    <input type="hidden" name="stage" value="@boardReturnStage" />
                                                    <button type="submit" class="crm-link-btn">Основной</button>
                                                </form>
                                                <form asp-action="RemovePhone" method="post" class="crm-inline-form">
                                                    <input type="hidden" name="id" value="@card.Id" />
                                                    <input type="hidden" name="phoneId" value="@ph.Id" />
                                                    <input type="hidden" name="stage" value="@boardReturnStage" />
                                                    <button type="submit" class="crm-link-btn is-danger">Удалить</button>
                                                </form>
                                            }
                                        }
                                    </span>
                                }
                            </dd>
                        </div>
                    }
                    @if (Model.PhoneHistory.Count > 1)
                    {
                        <div>
                            <dt>История номеров</dt>
                            <dd class="crm-phone-history">
                                @foreach (var ph in Model.PhoneHistory)
                                {
                                    <span><i class="fa-solid fa-phone" aria-hidden="true"></i>@ph.PhoneRaw<em>@ph.RecordedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</em></span>
                                }
                            </dd>
                        </div>
                    }
                    <div><dt>Город</dt><dd>@card.City</dd></div>
                    <div>
                        <dt>Вакансия</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(vacancyUrl))
                            {
                                <a class="crm-field-link" href="@vacancyUrl" target="_blank" rel="noopener" title="Открыть объявление">@card.Vacancy <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                            }
                            else
                            {
                                @card.Vacancy
                            }
                        </dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(card.AccountName))
                    {
                        <div><dt>Источник</dt><dd>@card.AccountName</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.SourceResponseId))
                    {
                        <div><dt>ID отклика</dt><dd>@card.SourceResponseId</dd></div>
                    }
                    <div><dt>Этап</dt><dd>@card.Stage</dd></div>
                    <div><dt>Ответственный</dt><dd>@(card.ManagerName ?? "Не назначен")</dd></div>
                    <div><dt>Нагрузка</dt><dd>@(card.IsInActiveLoad ? "В активной работе" : "Вне нагрузки")</dd></div>
                    <div><dt>Создана</dt><dd>@card.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd></div>
                    @if (card.LastContactAtUtc is DateTime last)
                    {
                        <div><dt>Контакт</dt><dd>@last.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd></div>
                    }
                    @if (card.NextActionAtUtc is DateTime next)
                    {
                        <div><dt>След. действие</dt><dd class="@(next < DateTime.UtcNow ? "crm-overdue" : "")">@next.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd></div>
                    }
                </dl>
                @if (canEdit)
                {
                    <details class="crm-card-edit">
                        <summary><i class="fa-solid fa-plus" aria-hidden="true"></i>Добавить телефон</summary>
                        <form asp-action="AddPhone" method="post" class="crm-side-form crm-card-edit__form">
                            <input type="hidden" name="id" value="@card.Id" />
                            <input type="hidden" name="stage" value="@boardReturnStage" />
                            <label>Номер<input name="phoneRaw" required maxlength="64" placeholder="+7 …" /></label>
                            <label>Подпись<input name="label" maxlength="64" placeholder="Рабочий / доп." /></label>
                            <label class="crm-checkbox-label"><input type="checkbox" name="setAsPrimary" value="true" /> Сделать основным</label>
                            <button class="settings-secondary-btn" type="submit">Добавить</button>
                        </form>
                    </details>
                }
            </section>

            @if (canEdit)
            {
                <section class="card crm-side-panel">
                    <header>Быстрые действия</header>
                    <div class="crm-quick-actions">
                        @if (canAccessCrmTasks)
                        {
                            <form asp-action="FollowUp" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="stage" value="@boardReturnStage" /><input type="hidden" name="minutes" value="60" /><button type="submit">+1 ч</button></form>
                            <form asp-action="FollowUp" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="stage" value="@boardReturnStage" /><input type="hidden" name="minutes" value="180" /><button type="submit">+3 ч</button></form>
                            <form asp-action="FollowUp" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="stage" value="@boardReturnStage" /><input type="hidden" name="minutes" value="1440" /><button type="submit">Завтра</button></form>
                            <form asp-action="FollowUp" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="stage" value="@boardReturnStage" /><input type="hidden" name="minutes" value="4320" /><button type="submit">+3 дн</button></form>
                        }
                    </div>
                    <form asp-action="SetLoad" method="post" class="crm-side-form">
                        <input type="hidden" name="id" value="@card.Id" />
                        <input type="hidden" name="stage" value="@boardReturnStage" />
                        <input type="hidden" name="active" value="@(!card.IsInActiveLoad)" />
                        <button class="settings-secondary-btn" type="submit">@(card.IsInActiveLoad ? "Снять с нагрузки" : "Вернуть в нагрузку")</button>
                    </form>
                    @if (ViewData["IsCrmAdmin"] as bool? == true && Model.Managers.Count > 0)
                    {
                        <form asp-action="Assign" method="post" class="crm-side-form">
                            <input type="hidden" name="id" value="@card.Id" />
                            <input type="hidden" name="stage" value="@boardReturnStage" />
                            <label>Переназначить
                                <select name="managerUserId">
                                    @foreach (var m in Model.Managers)
                                    {
                                        if (m.UserId == card.ManagerUserId)
                                        {
                                            <option value="@m.UserId" selected>@m.DisplayName (@m.ActiveLoad/@m.Capacity)</option>
                                        }
                                        else
                                        {
                                            <option value="@m.UserId">@m.DisplayName (@m.ActiveLoad/@m.Capacity)</option>
                                        }
                                    }
                                </select>
                            </label>
                            <button class="settings-secondary-btn" type="submit">Назначить</button>
                        </form>
                    }
                    @if (!card.IsClosed)
                    {
                        <form asp-action="Close" method="post" class="crm-side-form">
                            <input type="hidden" name="id" value="@card.Id" />
                            <input type="hidden" name="stage" value="@boardReturnStage" />
                            <label>Закрыть
                                <select name="reason" required>
                                    @foreach (var reason in CrmCloseReasons.All)
                                    {
                                        <option value="@reason">@reason</option>
                                    }
                                </select>
                            </label>
                            <textarea name="comment" required minlength="1" placeholder="Комментарий обязателен: причина и детали"></textarea>
                            <button class="settings-secondary-btn crm-btn-danger" type="submit">Закрыть карточку</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reopen" method="post" class="crm-side-form">
                            <input type="hidden" name="id" value="@card.Id" />
                            <input type="hidden" name="stage" value="@boardReturnStage" />
                            <button class="settings-primary-btn" type="submit">Вернуть в работу</button>
                        </form>
                    }
                </section>
            }
        </aside>

        <section class="crm-card-main card">
            <nav class="crm-tabs">
                <a class="@(activeTab == "activity" ? "is-active" : "")" asp-action="Card" asp-route-id="@card.Id" asp-route-stage="@boardReturnStage">Лента</a>
                <a class="@(activeTab == "chat" ? "is-active" : "") @(hasCandidateMessages ? "has-candidate-messages" : "")" asp-action="Card" asp-route-id="@card.Id" asp-route-tab="chat" asp-route-stage="@boardReturnStage">Чат @if (Model.Chat.Count > 0) { <span>@Model.Chat.Count</span> }</a>
                @if (canAccessCrmTasks)
                {
                    <a class="@(activeTab == "tasks" ? "is-active" : "")" asp-action="Card" asp-route-id="@card.Id" asp-route-tab="tasks" asp-route-stage="@boardReturnStage">Задачи <span>@Model.Tasks.Count(t => t.Status == CrmTaskStatuses.Open)</span></a>
                }
                <a class="@(activeTab == "history" ? "is-active" : "")" asp-action="Card" asp-route-id="@card.Id" asp-route-tab="history" asp-route-stage="@boardReturnStage">История</a>
            </nav>

            @if (activeTab == "activity")
            {
                @if (canEdit)
                {
                    <form asp-action="AddNote" method="post" class="crm-composer">
                        <input type="hidden" name="id" value="@card.Id" />
                        <input type="hidden" name="stage" value="@boardReturnStage" />
                        <textarea name="text" required placeholder="Комментарий по кандидату…"></textarea>
                        <button class="settings-primary-btn" type="submit">Добавить</button>
                    </form>
                }
                <div class="crm-feed">
                    @foreach (var item in Model.Activity)
                    {
                        <article class="crm-feed-item crm-feed-item--@item.Kind">
                            <div class="crm-feed-item__icon"><i class="fa-solid @(item.Kind switch { "note" => "fa-comment", "task" => "fa-list-check", "task-done" => "fa-check", _ => "fa-clock" })" aria-hidden="true"></i></div>
                            <div>
                                <header><strong>@DisplayCrmAction(item.Title)</strong><span>@item.ActorName · @item.AtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</span></header>
                                @if (!string.IsNullOrWhiteSpace(item.Body)) { <p>@item.Body</p> }
                            </div>
                        </article>
                    }
                    @if (Model.Activity.Count == 0) { <p class="crm-empty">Пока нет активности — оставьте первый комментарий.</p> }
                </div>
            }
            else if (activeTab == "chat")
            {
                @if (Model.Chat.Count > 0)
                {
                    <div class="crm-chat" data-crm-chat-thread data-card-id="@card.Id" data-mark-read="@(ViewData["MarkChatReadOnLoad"] as bool? == true ? "1" : "0")">
                        @foreach (var msg in Model.Chat)
                        {
                            var sender = msg.Tone == "outgoing" ? "Вы" : msg.Tone == "system" ? "Avito" : "Кандидат";
                            var avatar = msg.Tone == "outgoing" ? "В" : msg.Tone == "system" ? "A" : (string.IsNullOrWhiteSpace(card.FullName) ? "К" : card.FullName.Trim()[0].ToString());
                            <article class="crm-chat__msg crm-chat__msg--@msg.Tone">
                                <span class="crm-chat__avatar" aria-hidden="true">@avatar</span>
                                <div class="crm-chat__bubble">
                                    <header><strong>@sender</strong><time>@msg.TimeLabel</time></header>
                                    <p>@msg.Text</p>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="crm-empty">Переписка не сохранена для этого отклика.</p>
                }
            }
            else if (activeTab == "tasks")
            {
                @if (canEdit)
                {
                    <form asp-action="CreateTask" method="post" class="crm-task-create">
                        <input type="hidden" name="cardId" value="@card.Id" />
                        <input type="hidden" name="stage" value="@boardReturnStage" />
                        <input name="title" required placeholder="Что сделать" />
                          <select name="assigneeUserId" required>
                              @foreach (var m in Model.Managers)
                              {
                                  <option value="@m.UserId">@m.DisplayName</option>
                              }
                          </select>
                          <select name="importance" required aria-label="Важность задачи">
                              <option value="@CrmTaskImportances.Low">Низкая</option>
                              <option value="@CrmTaskImportances.Medium" selected>Средняя</option>
                              <option value="@CrmTaskImportances.High">Высокая</option>
                          </select>
                          <input type="datetime-local" data-crm-deadline-local />
                          <input type="hidden" name="dueAtUtc" data-crm-deadline-utc />
                        <textarea name="description" placeholder="Комментарий"></textarea>
                        <button class="settings-primary-btn" type="submit">Поставить задачу</button>
                    </form>
                }
                <div class="crm-task-list">
                    @foreach (var task in Model.Tasks)
                    {
                        <article class="crm-task-row @(task.Status == CrmTaskStatuses.Completed ? "is-complete" : "") @(task.Status == CrmTaskStatuses.Cancelled ? "is-cancelled" : "") @(task.IsOverdue ? "is-overdue" : "")">
                            <div>
                                <strong>@task.Title</strong>
                                <span>@task.AssigneeName @if (task.DueAtUtc is DateTime due) { <text>· до <time data-orbita-utc="@OrbitaTime.ToIsoUtc(due)" data-orbita-format="datetime"></time></text> } @if (task.IsOverdue) { <em class="crm-overdue">просрочено</em> }</span>
                                <span class="crm-task-row__times">
                                    <small>Поставлена</small>
                                    <time data-orbita-utc="@OrbitaTime.ToIsoUtc(task.CreatedAtUtc)" data-orbita-format="datetime"></time>
                                    @if (task.CompletedAtUtc is DateTime completedAt)
                                    {
                                        <small>@(task.Status == CrmTaskStatuses.Cancelled ? "Закрыта" : "Выполнена")</small>
                                        <time data-orbita-utc="@OrbitaTime.ToIsoUtc(completedAt)" data-orbita-format="datetime"></time>
                                    }
                                </span>
                                @if (!string.IsNullOrWhiteSpace(task.Description)) { <p>@task.Description</p> }
                            </div>
                            @if (task.Status == CrmTaskStatuses.Open && (isCrmAdmin || task.AssigneeUserId == currentUserId))
                            {
                                <form asp-action="CompleteTask" method="post" class="crm-task-complete-form">
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <input type="hidden" name="cardId" value="@card.Id" />
                                    <input type="hidden" name="stage" value="@boardReturnStage" />
                                    <textarea name="comment" required minlength="1" placeholder="Что сделано?" rows="2"></textarea>
                                    <button class="settings-secondary-btn" type="submit">Выполнить</button>
                                </form>
                            }
                        </article>
                    }
                    @if (Model.Tasks.Count == 0) { <p class="crm-empty">Задач пока нет.</p> }
                </div>
            }
            else
            {
                <div class="crm-history-list">
                    @foreach (var item in Model.History)
                    {
                        <article>
                            <time>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</time>
                            <div>
                                <strong>@DisplayCrmAction(item.Action)</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Details)) { <span>@item.Details</span> }
                                <em>@item.ActorName</em>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var input = document.getElementById('stageComment');
    if (input) {
        document.querySelectorAll('[data-stage-comment]').forEach(function (hidden) {
            var form = hidden.closest('form');
            if (!form) return;
            form.addEventListener('submit', function () {
                hidden.value = input.value || '';
            });
        });
    }

    var cardEditForm = document.querySelector('[data-crm-card-inline-edit]');
    var cardEditToggle = document.querySelector('[data-crm-card-inline-edit-toggle]');
    var cardEditCancel = document.querySelector('[data-crm-card-inline-edit-cancel]');
    if (cardEditForm && cardEditToggle) {
        function setCardEditing(editing) {
            cardEditForm.classList.toggle('is-editing', editing);
            cardEditToggle.setAttribute('aria-expanded', editing ? 'true' : 'false');
            if (editing) {
                var nameInput = cardEditForm.querySelector('[name="fullName"]');
                if (nameInput) {
                    nameInput.focus();
                    nameInput.select();
                }
            } else {
                cardEditForm.reset();
            }
        }

        cardEditToggle.addEventListener('click', function () { setCardEditing(true); });
        if (cardEditCancel) {
            cardEditCancel.addEventListener('click', function () { setCardEditing(false); });
        }
    }

    // Remember funnel stage so "К воронке" and board restore land on the same stage.
    try {
        var stage = '@boardReturnStage'.trim();
        if (stage) sessionStorage.setItem('orbita.crm.board.focusStage', stage);
    } catch (e) { /* ignore */ }

    // Mark chat read via POST only (never on GET) after the user actually opened the tab.
    var thread = document.querySelector('[data-crm-chat-thread][data-mark-read="1"]');
    if (thread) {
        var cardId = thread.getAttribute('data-card-id');
        if (cardId && window.Orbita && typeof window.Orbita.postForm === 'function') {
            window.Orbita.postForm('/Crm/MarkChatRead', { id: cardId }).catch(function () { });
        }
    }
})();
</script>
}
