@model Orbita.Contracts.CrmBoardDto
@using Orbita.Contracts
@using Orbita.Web.Models.ViewModels
@{
    ViewData["Title"] = "CRM — Воронка";
    var header = new PageHeaderViewModel
    {
        Title = "Воронка кандидатов",
        Subtitle = Model.IsEnabled ? "Рабочее место менеджера" : "CRM выключена для офиса",
        ShowRefresh = true,
        UpdatedAtUtc = DateTime.UtcNow
    };
    var snapshotUrl = Url.Action("Snapshot", new
    {
        scope = Model.Scope,
        search = Model.Search,
        city = Model.City,
        vacancy = Model.Vacancy,
        overdueOnly = Model.OverdueOnly,
        activeLoadOnly = Model.ActiveLoadOnly,
        includeClosed = Model.IncludeClosed
    })!;
}
<partial name="_PageHeader" model="header" />

<div class="orbita-main crm-shell crm-shell--@Model.Scope" data-orbita-live data-orbita-live-page="crm" data-orbita-snapshot="@snapshotUrl">
    <div data-crm-live-workspace>
        <partial name="_CrmWorkspace" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/orbita-crm-board.js" asp-append-version="true"></script>
}
