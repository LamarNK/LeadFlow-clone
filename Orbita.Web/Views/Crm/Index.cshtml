@model Orbita.Contracts.CrmBoardDto
@using Orbita.Contracts
@using Orbita.Web.Models.ViewModels
@{
    ViewData["Title"] = "CRM — Воронка";
    var header = new PageHeaderViewModel
    {
        Title = "Воронка кандидатов",
        Subtitle = Model.IsEnabled ? "Рабочее место менеджера" : "CRM выключена для офиса",
        ShowRefresh = true,
        UpdatedAtUtc = DateTime.UtcNow
    };
    var activeAdvancedFilters = new[]
    {
        !string.IsNullOrWhiteSpace(Model.City),
        !string.IsNullOrWhiteSpace(Model.Vacancy),
        Model.OverdueOnly,
        Model.ActiveLoadOnly,
        Model.IncludeClosed
    }.Count(x => x);
    var advancedFilterBadge = activeAdvancedFilters > 0 ? activeAdvancedFilters.ToString() : string.Empty;
    var boardReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    string ScopeUrl(string scope) => Url.Action("Index", new
    {
        scope,
        search = Model.Search,
        city = Model.City,
        vacancy = Model.Vacancy,
        overdueOnly = Model.OverdueOnly,
        activeLoadOnly = Model.ActiveLoadOnly,
        includeClosed = Model.IncludeClosed
    })!;
}
<partial name="_PageHeader" model="header" />

<div class="orbita-main crm-shell crm-shell--@Model.Scope">
    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }
    @if (!Model.IsEnabled)
    {
        <div class="crm-notice"><i class="fa-solid fa-flask" aria-hidden="true"></i>Офис не принимает отклики в CRM — операторы не могут отправлять сюда карточки.@if (Model.IsAdmin) { <text> Включите в </text><a asp-action="Team">Команда CRM</a><text> или в настройках офиса.</text> }</div>
    }

    <section class="crm-toolbar card">
        <div class="crm-toolbar__shift">
            <div>
                <span class="crm-pill @(Model.IsShiftActive ? "is-on" : "")">@(Model.IsShiftActive ? "На смене" : "Не на смене")</span>
                <strong class="crm-toolbar__load">@Model.ActiveLoad <span>/ @Model.Capacity</span></strong>
                <p>Нагрузка · открытых задач @Model.OpenTaskCount@if (Model.OverdueTaskCount > 0) { <text> · </text><em class="crm-overdue">просрочено @Model.OverdueTaskCount</em> }</p>
                @if (Model.OverdueTaskCount > 0)
                {
                    <a class="crm-toolbar__urgent" asp-action="Tasks"><i class="fa-solid fa-clock" aria-hidden="true"></i>Открыть просроченные задачи</a>
                }
            </div>
            @if (Model.IsShiftActive)
            {
                <form asp-action="StopShift" method="post"><button class="settings-secondary-btn" type="submit">Стоп смены</button></form>
            }
            else
            {
                <form asp-action="StartShift" method="post"><button class="settings-primary-btn" type="submit">Старт смены</button></form>
            }
        </div>
        <div class="crm-toolbar__stats">
            <div><small>В работе</small><strong>@Model.TeamStats.TotalActiveCards</strong></div>
            <div><small>Очередь</small><strong>@Model.UnassignedCount</strong></div>
            <div><small>На смене</small><strong>@Model.TeamStats.OnShiftManagers / @Model.TeamStats.TotalManagers</strong></div>
            <div><small>Закрыто сегодня</small><strong>@Model.TeamStats.ClosedToday</strong></div>
        </div>
    </section>

    <section class="crm-filters card">
        <form method="get" class="crm-filters__form" asp-action="Index">
            <div class="crm-filters__primary">
                <div class="crm-scope-tabs" role="tablist">
                    <a class="@(Model.Scope == CrmBoardScopes.Mine ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Mine)">Мои</a>
                    <a class="@(Model.Scope == CrmBoardScopes.Team ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Team)">Команда</a>
                    <a class="@(Model.Scope == CrmBoardScopes.Unassigned ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Unassigned)">Очередь <span>@Model.UnassignedCount</span></a>
                    <a class="@(Model.Scope == CrmBoardScopes.Closed ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Closed)">Закрытые</a>
                </div>
                <input type="hidden" name="scope" value="@Model.Scope" />
                <input type="search" name="search" value="@Model.Search" placeholder="ФИО, телефон, город…" aria-label="Поиск кандидата" />
                <button class="settings-primary-btn" type="submit">Найти</button>
                <a class="settings-secondary-btn" asp-action="Index">Сброс</a>
            </div>
            <details class="crm-filter-details" @(activeAdvancedFilters > 0 ? "open" : null)>
                <summary><i class="fa-solid fa-sliders" aria-hidden="true"></i>Дополнительные фильтры<span class="crm-filter-details__count @(activeAdvancedFilters == 0 ? "is-empty" : "")">@advancedFilterBadge</span></summary>
                <div class="crm-filter-details__body">
                    <input type="text" name="city" value="@Model.City" placeholder="Город" />
                    <input type="text" name="vacancy" value="@Model.Vacancy" placeholder="Вакансия" />
                    <label class="crm-check"><input type="checkbox" name="overdueOnly" value="true" @(Model.OverdueOnly ? "checked" : null) /> Просрочка</label>
                    <label class="crm-check"><input type="checkbox" name="activeLoadOnly" value="true" @(Model.ActiveLoadOnly ? "checked" : null) /> В нагрузке</label>
                    <label class="crm-check"><input type="checkbox" name="includeClosed" value="true" @(Model.IncludeClosed ? "checked" : null) /> + закрытые</label>
                </div>
            </details>
            <p class="crm-scope-description">
                @if (Model.Scope == CrmBoardScopes.Team)
                {
                    <text><i class="fa-solid fa-users" aria-hidden="true"></i>Режим команды: видно распределение кандидатов и риски по этапам.</text>
                }
                else if (Model.Scope == CrmBoardScopes.Unassigned)
                {
                    <text><i class="fa-solid fa-inbox" aria-hidden="true"></i>Очередь: кандидаты без ответственного.</text>
                }
                else if (Model.Scope == CrmBoardScopes.Closed)
                {
                    <text><i class="fa-solid fa-box-archive" aria-hidden="true"></i>Архив закрытых карточек.</text>
                }
                else
                {
                    <text><i class="fa-solid fa-user-check" aria-hidden="true"></i>Ваша рабочая воронка и приоритетные действия на сегодня.</text>
                }
                @if (!Model.CanEdit)
                {
                    <text><em class="crm-readonly-hint">Просмотр — изменения недоступны.</em></text>
                }
            </p>
        </form>
    </section>

    <section class="crm-board-card card" aria-label="Воронка кандидатов" data-crm-board-carousel>
        <div class="crm-board-toolbar">
            <div class="crm-board-toolbar__meta">
                <strong>Этапы воронки</strong>
                <span data-crm-board-range>@Model.Stages.Count этап(ов)</span>
            </div>
            <div class="crm-board-jumps" role="tablist" aria-label="Перейти к этапу" data-crm-board-jumps>
                @for (var jumpIndex = 0; jumpIndex < Model.Stages.Count; jumpIndex++)
                {
                    var jumpStage = Model.Stages[jumpIndex];
                    <button type="button"
                            class="crm-board-jump"
                            role="tab"
                            data-crm-board-jump
                            data-stage-index="@jumpIndex"
                            title="@jumpStage.Name · @jumpStage.TotalCount"
                            aria-label="Перейти к этапу @jumpStage.Name">
                        <span class="crm-board-jump__name">@jumpStage.Name</span>
                        <span class="crm-board-jump__count">@jumpStage.TotalCount</span>
                    </button>
                }
            </div>
            <div class="crm-board-nav" role="group" aria-label="Листать этапы">
                <button type="button" data-crm-board-prev aria-label="Предыдущий этап" title="Предыдущий этап (←)">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
                <button type="button" data-crm-board-next aria-label="Следующий этап" title="Следующий этап (→)">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="crm-board-viewport" data-crm-board-viewport>
            <button type="button" class="crm-board-edge crm-board-edge--prev" data-crm-board-prev aria-label="Предыдущий этап" hidden>
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="crm-board-edge crm-board-edge--next" data-crm-board-next aria-label="Следующий этап" hidden>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>
            <div class="crm-board-wrap" data-crm-board-scroll tabindex="0" aria-label="Горизонтальная прокрутка воронки. Колёсико с Shift или перетаскивание мышью.">
                <div class="crm-board" data-crm-board style="--crm-stage-count: @Model.Stages.Count">
                @for (var stageIndex = 0; stageIndex < Model.Stages.Count; stageIndex++)
                {
                    var stage = Model.Stages[stageIndex];
                    var hasRisk = stage.Cards.Any(card => card.HasOverdueTask || card.HoursInStage >= 24);
                    var hasUnassigned = stage.Cards.Any(card => !card.IsClosed && string.IsNullOrWhiteSpace(card.ManagerUserId));
                    var nextStage = stageIndex < Model.Stages.Count - 1 ? Model.Stages[stageIndex + 1].Name : null;
                    <section class="crm-stage @(hasRisk ? "is-risk" : "") @(hasUnassigned ? "has-unassigned" : "")" data-stage="@stage.Name" data-stage-index="@stageIndex" id="crm-stage-@stageIndex">
                        <header class="crm-stage__head">
                            <h3>@stage.Name</h3>
                            <span title="Карточек в этапе">@stage.TotalCount</span>
                        </header>
                        <div class="crm-stage__cards">
                        @foreach (var card in stage.Cards)
                        {
                            var defaultAssigneeUserId = card.ManagerUserId ?? Model.Managers.FirstOrDefault()?.UserId;
                            <article class="crm-tile @(card.IsClosed ? "is-closed" : "") @(card.HasOverdueTask ? "is-overdue" : "") @(card.HoursInStage >= 24 ? "is-stalled" : "")">
                                <a asp-action="Card" asp-route-id="@card.Id" class="crm-tile__body">
                                <div class="crm-tile__top">
                                    <strong>@card.FullName</strong>
                                    @if (!card.IsInActiveLoad && !card.IsClosed) { <span class="crm-tag">Вне нагрузки</span> }
                                    @if (card.IsClosed) { <span class="crm-tag crm-tag--muted">@card.CloseReason</span> }
                                </div>
                                <div class="crm-tile__meta">@(card.Age?.ToString() ?? "—") лет · @card.City</div>
                                <div class="crm-tile__vacancy">@card.Vacancy</div>
                                <footer class="crm-tile__foot">
                                    <span><i class="fa-regular fa-user" aria-hidden="true"></i>@(card.ManagerName ?? "—")</span>
                                    <span class="@(card.HoursInStage >= 24 ? "crm-hot" : "")" title="В этапе">@card.HoursInStage.ToString("0.#")ч</span>
                                    @if (card.OpenTaskCount > 0)
                                    {
                                        <span class="@(card.HasOverdueTask ? "crm-overdue" : "")"><i class="fa-solid fa-list-check" aria-hidden="true"></i>@card.OpenTaskCount</span>
                                    }
                                </footer>
                                </a>
                                @if (!card.IsClosed)
                                {
                                    <div class="crm-tile__actions" aria-label="Быстрые действия для @card.FullName">
                                        <a href="tel:@card.PhoneRaw" title="Позвонить"><i class="fa-solid fa-phone" aria-hidden="true"></i><span>Позвонить</span></a>
                                        @if (!string.IsNullOrWhiteSpace(card.MessengerUrl))
                                        {
                                            <a href="@card.MessengerUrl" target="_blank" rel="noopener" title="Открыть чат"><i class="fa-regular fa-message" aria-hidden="true"></i><span>Чат</span></a>
                                        }
                                        @if (Model.CanEdit)
                                        {
                                            @if (!card.IsInActiveLoad)
                                            {
                                                <form asp-action="SetLoad" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="active" value="true" /><input type="hidden" name="returnUrl" value="@boardReturnUrl" /><button type="submit" title="Вернуть в активную нагрузку"><i class="fa-solid fa-bolt" aria-hidden="true"></i><span>В нагрузку</span></button></form>
                                            }
                                            @if (nextStage is not null && !Model.RequireStageComment)
                                            {
                                                <form asp-action="Move" method="post"><input type="hidden" name="id" value="@card.Id" /><input type="hidden" name="stage" value="@nextStage" /><input type="hidden" name="returnUrl" value="@boardReturnUrl" /><button type="submit" title="Перевести на этап «@nextStage»"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i><span>Дальше</span></button></form>
                                            }
                                            @if (Model.IsAdmin || defaultAssigneeUserId is not null)
                                            {
                                                <details class="crm-tile__quick-menu">
                                                    <summary title="Ещё действия"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i><span>Ещё действия</span></summary>
                                                    <div>
                                                        @if (Model.IsAdmin && Model.Managers.Count > 0)
                                                        {
                                                            <form asp-action="Assign" method="post">
                                                                <input type="hidden" name="id" value="@card.Id" />
                                                                <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                                                                <select name="managerUserId" aria-label="Назначить менеджера для @card.FullName">
                                                                    @foreach (var manager in Model.Managers)
                                                                    {
                                                                        if (manager.UserId == card.ManagerUserId)
                                                                        {
                                                                            <option value="@manager.UserId" selected>@manager.DisplayName</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@manager.UserId">@manager.DisplayName</option>
                                                                        }
                                                                    }
                                                                </select>
                                                                <button type="submit"><i class="fa-regular fa-user" aria-hidden="true"></i>Назначить</button>
                                                            </form>
                                                        }
                                                        @if (defaultAssigneeUserId is not null)
                                                        {
                                                            <form asp-action="CreateTask" method="post">
                                                                <input type="hidden" name="cardId" value="@card.Id" />
                                                                <input type="hidden" name="assigneeUserId" value="@defaultAssigneeUserId" />
                                                                <input type="hidden" name="returnUrl" value="@boardReturnUrl" />
                                                                <input type="text" name="title" required placeholder="Новая задача" aria-label="Новая задача для @card.FullName" />
                                                                <button type="submit"><i class="fa-solid fa-list-check" aria-hidden="true"></i>Поставить</button>
                                                            </form>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        }
                                    </div>
                                }
                            </article>
                        }
                        @if (stage.Cards.Count == 0)
                        {
                            <div class="crm-stage__empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><strong>Пока пусто</strong><span>Карточки появятся после перехода на этап</span></div>
                        }
                        </div>
                    </section>
                }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/orbita-crm-board.js" asp-append-version="true"></script>
}
