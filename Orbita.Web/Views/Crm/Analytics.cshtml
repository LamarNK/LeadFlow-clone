@model CrmAnalyticsViewModel
@using Orbita.Contracts
@using Orbita.Web.Helpers
@{
    ViewData["Title"] = "CRM — Аналитика";
    var tz = BrowserTimeZone.Resolve(Context);
    var from = Model.Header.DateFrom.ToString("yyyy-MM-dd");
    var to = Model.Header.DateTo.ToString("yyyy-MM-dd");
    var period = Model.Header.DateFrom == Model.Header.DateTo ? Model.Header.DateFrom.ToString("dd.MM.yyyy")
        : $"{Model.Header.DateFrom:dd.MM.yyyy} — {Model.Header.DateTo:dd.MM.yyyy}";
    string Evidence(string metric, string? manager = null, Guid? office = null) => Url.Action("AnalyticsEvidence", "Crm", new {
        from, to, metric, managerUserId = manager ?? Model.SelectedManagerUserId,
        evidenceOfficeId = office, tz, cohortBasis = CrmAnalyticsCohortBases.Received, inline = true
    })!;
    string Percentage(double? percent) => percent is null ? "—" : $"{percent:0.#}%";
}
<partial name="_PageHeader" model="Model.Header" />
<main class="orbita-main crm-analytics-sales">
@if (Model.Analytics is not { Sales: { } sales } analytics)
{
    <section class="card sales-error" role="alert">
        <h2>Не удалось загрузить аналитику</h2>
        <p>@(Model.ErrorMessage ?? "Обновите страницу. Если ошибка повторяется, проверьте совместимость версий API и панели.")</p>
        <p>Ошибка загрузки не означает, что у команды нет результатов.</p>
        <a class="settings-primary-btn" href="@Url.Action("Analytics", "Crm", new { from, to, tz, managerUserId = Model.SelectedManagerUserId })">Повторить</a>
    </section>
}
else
{
    <form class="card sales-filters" method="get" asp-controller="Crm" asp-action="Analytics">
        <input type="hidden" name="from" value="@from" data-period-form-from />
        <input type="hidden" name="to" value="@to" data-period-form-to />
        <input type="hidden" name="tz" value="@tz" />
        <div class="sales-office"><span class="sales-eyebrow">Офис</span><strong><i class="fa-regular fa-building" aria-hidden="true"></i> @Model.OfficeContextLabel</strong><small>Меняется переключателем в шапке</small></div>
        @if (Model.IsAdmin)
        {
            <div class="sales-manager-filter"><label for="sales-manager">Менеджер</label>
                <select id="sales-manager" name="managerUserId" aria-label="Фильтр по менеджеру">
                    <option value="">Все сотрудники</option>
                    @foreach (var option in analytics.ManagerOptions.DistinctBy(x => x.UserId))
                    {
                        <option value="@option.UserId" selected="@(option.UserId == Model.SelectedManagerUserId)">@option.DisplayName</option>
                    }
                </select>
            </div>
            <button class="settings-primary-btn" type="submit">Применить</button>
            <a class="sales-reset" href="@Url.Action("Analytics", "Crm", new { from, to, tz })">Сбросить</a>
        }
        else { <div class="sales-self"><span class="sales-eyebrow">Сотрудник</span><strong>@(analytics.ManagerOptions.FirstOrDefault()?.DisplayName ?? "Мои результаты")</strong></div> }
    </form>

    <section class="card sales-block sales-block--work" data-report-block="work" aria-labelledby="sales-work-title">
        <header class="sales-block-heading">
            <div class="sales-heading-main"><span class="sales-section-number">01</span><div><h2 id="sales-work-title">Результаты за период</h2><p>Вся работа за @period — с новыми и ранее полученными карточками.</p></div></div>
            <span class="sales-scope-tag">По дате действия</span>
        </header>
        <div class="sales-kpis">
            @foreach (var metric in sales.Results)
            {
                var tone = metric.Key == CrmSalesMetrics.Contacts ? "contact" : metric.Key == CrmSalesMetrics.Successes ? "success" : "default";
                <button type="button" class="sales-kpi sales-kpi--@tone" data-evidence-url="@Evidence(metric.Key)" data-evidence-title="@metric.Label" aria-expanded="false">
                    <span class="sales-kpi-label">@metric.Label <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></span>
                    <strong data-metric="@metric.Key">@metric.Count.ToString("N0")</strong><span class="sales-kpi-unit">@metric.Unit</span>
                    <small>@metric.Description</small>
                </button>
            }
        </div>
        <div class="sales-context-line"><i class="fa-regular fa-circle-question" aria-hidden="true"></i><span>Карточка пришла 1-го, закрылась в успех 20-го — успех учитывается за 20-е. Числа выше не являются последовательной воронкой.</span></div>
        <div class="sales-breakdown-grid">
            <details class="sales-details" open>
                <summary>Откуда дозвоны <span>@sales.ContactSources.Sum(x => x.Count)</span></summary>
                <div class="sales-breakdown">
                    @foreach (var source in sales.ContactSources) { <button type="button" data-evidence-url="@Evidence(source.Key)" data-evidence-title="Дозвоны из @source.Label"><span>@source.Label</span><strong>@source.Count</strong></button> }
                    @if (sales.ContactSources.Count == 0) { <p class="sales-empty">За период нет первых контактов по согласованным правилам.</p> }
                </div>
            </details>
            <details class="sales-details">
                <summary>Причины закрытия <span>@sales.CloseReasons.Sum(x => x.Count)</span></summary>
                <div class="sales-breakdown">
                    @foreach (var reason in sales.CloseReasons) { <button type="button" data-evidence-url="@Evidence(reason.Key)" data-evidence-title="Закрытия: @reason.Label"><span>@reason.Label</span><strong>@reason.Count</strong></button> }
                    @if (sales.CloseReasons.Count == 0) { <p class="sales-empty">За период закрытий нет.</p> }
                </div>
            </details>
        </div>
        @if (sales.UnclassifiedClosures > 0)
        {
            <p class="sales-alert" role="status">У @sales.UnclassifiedClosures закрытий не сохранён исходный этап или причина. Они учтены в закрытиях, но дозвон достоверно определить нельзя. <button type="button" data-evidence-url="@Evidence(CrmSalesMetrics.UnknownClosures)" data-evidence-title="Закрытия с неполной историей">Показать карточки</button></p>
        }
        @if (sales.InferredEvents > 0 || analytics.InferredReceiptCards > 0)
        {
            <p class="sales-data-note">Старая история: у @sales.InferredEvents событий контекст восстановлен; у @analytics.InferredReceiptCards карточек дата или атрибуция поступления определена по резервным полям. Эти записи не скрыты из отчёта.</p>
        }
        @if (sales.UnattributedActions > 0)
        {
            <p class="sales-alert">У @sales.UnattributedActions событий не записан исполнитель. Они входят в общие результаты, но не приписаны сотруднику. <button type="button" data-evidence-url="@Evidence(CrmSalesMetrics.UnattributedActions)" data-evidence-title="События без исполнителя">Проверить</button></p>
        }
        <details class="sales-rules"><summary>Как считаются дозвоны и результаты</summary>
            <p>Первый переход из лида, НДЗ, НДЗ 2 или недоступных подменных в переговоры, переговоры долгосрок, анкету либо закрытие по любой причине, кроме НДЗ. Каждый первый контакт учитывается один раз за историю карточки. Названия этапов сопоставляются с воронкой офиса.</p>
            <p>Анкеты, билеты и закрытия — события за выбранные даты. Повторные переходы видны в детализации. Результат принадлежит исполнителю действия и не исчезает при смене ответственного. Запись смены не является условием учёта.</p>
        </details>
        <div class="sales-evidence" data-evidence-host hidden role="region" aria-label="Детализация результатов"></div>
    </section>

    <section class="card sales-block sales-block--stages" data-report-block="stages" aria-labelledby="sales-stages-title">
        <header class="sales-block-heading">
            <div class="sales-heading-main"><span class="sales-section-number">02</span><div><h2 id="sales-stages-title">Переходы по этапам</h2><p>Куда переводили карточки за @period. Все этапы — из воронки вашего офиса.</p></div></div>
            <span class="sales-scope-tag">Новые и старые карточки</span>
        </header>
        @foreach (var office in sales.Offices)
        {
            <div class="sales-office-transitions">
                <h3>@office.OfficeName <small>@office.Transitions.Sum(x => x.Count) переходов</small></h3>
                <div class="sales-stage-grid">
                    @foreach (var stage in office.Stages)
                    {
                        <button type="button" class="sales-stage @(stage.Archived ? "sales-stage--archive" : "")" data-evidence-url="@Evidence(stage.Key, office: office.OfficeId)" data-evidence-title="Переводы в этап: @stage.Stage">
                            <span>@stage.Stage @if (stage.Archived) { <small>Исторический этап</small> }</span><strong>@stage.Count</strong><small>переходов в этап</small>
                        </button>
                    }
                </div>
                <details class="sales-details"><summary>Откуда → куда <span>@office.Transitions.Sum(x => x.Count)</span></summary>
                    <div class="sales-transition-list">
                    @foreach (var transition in office.Transitions)
                    {
                        <button type="button" data-evidence-url="@Evidence(transition.Key, office: office.OfficeId)" data-evidence-title="@transition.From → @transition.To">
                            <span>@transition.From</span><span aria-hidden="true">→</span><span>@transition.To</span><strong>@transition.Count</strong>
                        </button>
                    }
                    @if (office.Transitions.Count == 0) { <p class="sales-empty">За выбранные даты переходов нет. Поступление карточки сразу в этап не считается переходом.</p> }
                    </div>
                </details>
            </div>
        }
        <h3 class="sales-subheading">Результаты сотрудников</h3>
        <p class="sales-data-note">Показатели действий — по исполнителю, новые лиды — по первому ответственному. «Выдано впервые» включает старые карточки, впервые назначенные за период.</p>
        <div class="sales-table-scroll" tabindex="0" aria-label="Результаты сотрудников">
            <table class="sales-table sales-manager-table">
                <thead><tr><th>Сотрудник</th><th>Новые лиды</th><th>Дозвоны</th><th>Анкеты</th><th>Билеты</th><th>Успехи</th><th>Без успеха</th><th>Выдано впервые</th><th>От коллег / коллегам</th></tr></thead>
                <tbody>
                @foreach (var manager in sales.Managers)
                {
                    var cells = new[] { (CrmSalesMetrics.Received, "Новые лиды", manager.NewLeads), (CrmSalesMetrics.Contacts, "Дозвоны", manager.Contacts),
                        (CrmSalesMetrics.Questionnaires, "Анкеты", manager.Questionnaires), (CrmSalesMetrics.Tickets, "Билеты", manager.Tickets),
                        (CrmSalesMetrics.Successes, "Успехи", manager.Successes), (CrmSalesMetrics.Refusals, "Без успеха", manager.Refusals),
                        ("manager.primary", "Выдано впервые", manager.FirstAssignments) };
                    <tr><th scope="row">@manager.DisplayName<small>@manager.OfficeName</small></th>
                        @foreach (var cell in cells) { <td><button type="button" class="sales-number" data-evidence-url="@Evidence(cell.Item1, manager.UserId, manager.OfficeId)" data-evidence-title="@manager.DisplayName · @cell.Item2">@cell.Item3</button></td> }
                        <td><button type="button" class="sales-number" data-evidence-url="@Evidence("activity.received", manager.UserId, manager.OfficeId)" data-evidence-title="@manager.DisplayName · Получено от коллег">@manager.TransfersReceived</button> / <button type="button" class="sales-number" data-evidence-url="@Evidence("activity.sent", manager.UserId, manager.OfficeId)" data-evidence-title="@manager.DisplayName · Передано коллегам">@manager.TransfersSent</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (analytics.PeriodActivity is { } activity)
        {
            <div class="sales-context-line"><span>Возвраты в работу: <button type="button" class="sales-number" data-evidence-url="@Evidence("activity.reopened")" data-evidence-title="Возвраты в работу">@activity.ReopenedCards</button>. Получено от коллег: @activity.TransfersReceived. Передано коллегам: @activity.TransfersSent.</span></div>
            @if (activity.RepeatedClosuresWithoutReopen > 0) { <p class="sales-alert">В истории @activity.RepeatedClosuresWithoutReopen повторных закрытий без записанного открытия. <button type="button" data-evidence-url="@Evidence("activity.repeated-closures")" data-evidence-title="Повторные закрытия">Проверить события</button></p> }
            @if (activity.UnattributedAssignments > 0) { <p class="sales-alert">У @activity.UnattributedAssignments старых назначений не записан получатель. Они не приписаны текущему ответственному автоматически.</p> }
        }
        <details class="sales-details sales-supplement">
            <summary>Текущая нагрузка и задачи <span>На сейчас · все даты</span></summary>
            <div class="sales-supplement-content">
                <p class="sales-data-note">Это текущее состояние, а не результаты выбранного периода. Лимит нагрузки зависит от правил офиса.</p>
                <div class="sales-table-scroll" tabindex="0" aria-label="Текущая нагрузка">
                    <table class="sales-table"><thead><tr><th>Сотрудник</th><th>Назначено открытых</th><th>В нагрузке / лимит</th><th>Загрузка</th><th>Задач всего</th><th>Открыто задач</th><th>Просрочено</th></tr></thead><tbody>
                    @foreach (var manager in analytics.Managers)
                    {
                        <tr><th scope="row">@manager.DisplayName<small>@manager.OfficeName</small></th><td>@manager.CurrentAssignedCards</td><td>@manager.ActiveLoad / @manager.Capacity</td><td>@Percentage(manager.CapacityUtilizationPercent)</td><td>@manager.TasksTotal</td><td>@manager.OpenTasks</td><td>@manager.OverdueTasks</td></tr>
                    }
                    </tbody></table>
                </div>
            </div>
        </details>
        @if (analytics.CallQuality is { } quality)
        {
            <details class="sales-details sales-supplement">
                <summary>Качество разговоров <span>За выбранные даты</span></summary>
                <div class="sales-supplement-content">
                    <p class="sales-data-note">Звонков с записью: @quality.RecordedCalls · Расшифровано: @quality.TranscribedCalls · Проанализировано: @quality.AnalyzedCalls · Покрытие: @Percentage(quality.CoveragePercent) · Средняя оценка: @(quality.AverageScore?.ToString("0.#") ?? "—"). Телефонные записи не заменяют показатель «Дозвоны» по переходам CRM.</p>
                    <div class="sales-table-scroll" tabindex="0" aria-label="Качество разговоров сотрудников">
                        <table class="sales-table"><thead><tr><th>Сотрудник</th><th>С записью</th><th>Расшифровано</th><th>Проанализировано</th><th>Покрытие</th><th>Оценка</th></tr></thead><tbody>
                        @foreach (var manager in quality.Managers)
                        {
                            <tr><th scope="row">@manager.DisplayName</th><td>@manager.RecordedCalls</td><td>@manager.TranscribedCalls</td><td>@manager.AnalyzedCalls</td><td>@Percentage(manager.CoveragePercent)</td><td>@(manager.AverageScore?.ToString("0.#") ?? "—")</td></tr>
                        }
                        </tbody></table>
                    </div>
                    <div class="sales-quality-findings">
                        <div><h4>Сильные стороны</h4>@foreach (var finding in quality.CommonStrengths) { <p>@finding.Label · @finding.Count (@Percentage(finding.PercentOfAnalyzed))</p> }</div>
                        <div><h4>Что улучшить</h4>@foreach (var finding in quality.CommonWeaknesses) { <p>@finding.Label · @finding.Count (@Percentage(finding.PercentOfAnalyzed))</p> }</div>
                    </div>
                </div>
            </details>
        }
        <div class="sales-evidence" data-evidence-host hidden role="region" aria-label="Детализация переходов и сотрудников"></div>
    </section>

    <section class="card sales-block sales-block--cohort" data-report-block="cohort" aria-labelledby="sales-cohort-title">
        <header class="sales-block-heading">
            <div class="sales-heading-main"><span class="sales-section-number">03</span><div><h2 id="sales-cohort-title">Конверсия новых лидов</h2><p>Только карточки, поступившие за @period, и их результаты за эти же даты.</p></div></div>
            <span class="sales-scope-tag">Одна группа карточек</span>
        </header>
        <div class="sales-cohort-base"><div><span class="sales-eyebrow">Начало воронки</span><button type="button" data-evidence-url="@Evidence(CrmSalesMetrics.Received)" data-evidence-title="Новые лиды"><strong>@sales.Cohort.Received</strong> новых лидов</button></div><p>Первый процент считается от новых лидов, каждый следующий — от предыдущего этапа. Старые НДЗ входят в общие дозвоны выше, но не увеличивают эту воронку.</p></div>
        @if (sales.Cohort.Received == 0)
        {
            <p class="sales-empty sales-cohort-empty">За выбранные даты новых лидов нет — процент не рассчитывается. Работа со старыми карточками показана в первых двух блоках.</p>
        }
        else
        {
            <div class="sales-conversions">
                @for (var metricIndex = 0; metricIndex < sales.Cohort.Results.Count; metricIndex++)
                {
                    var metric = sales.Cohort.Results[metricIndex];
                    var baseCount = metricIndex == 0 ? sales.Cohort.Received : sales.Cohort.Results[metricIndex - 1].Count;
                    var baseLabel = metricIndex switch { 0 => "новых лидов", 1 => "дозвонов", 2 => "анкет", _ => "билетов" };
                    <button type="button" class="sales-conversion" data-evidence-url="@Evidence(metric.Key)" data-evidence-title="Новые лиды · @metric.Label">
                        <span>@metric.Label</span><strong>@Percentage(metric.Percent)</strong><small>@metric.Count из @baseCount @baseLabel</small>
                        <span class="sales-bar" aria-hidden="true"><span style="width:@((metric.Percent ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                    </button>
                }
            </div>
        }
        <p class="sales-data-note">Одна карточка учитывается один раз на каждом этапе. Каждый процент сравнивает этап с предыдущим. Переходы последующих ответственных не теряются. События после выбранной конечной даты сюда не входят.</p>
        @if (sales.Cohort.Unassigned > 0) { <p class="sales-alert">Сейчас без ответственного: <button type="button" data-evidence-url="@Evidence(CrmSalesMetrics.Unassigned)" data-evidence-title="Новые лиды без ответственного">@sales.Cohort.Unassigned</button>. Они входят в общую базу новых лидов.</p> }
        <div class="sales-evidence" data-evidence-host hidden role="region" aria-label="Детализация конверсии"></div>
    </section>
    <noscript><p class="sales-alert">Для раскрытия карточек внутри страницы нужен JavaScript. Итоговые показатели выше уже загружены с сервера.</p></noscript>
}
</main>
@section Scripts { <script src="~/js/crm-analytics.js" asp-append-version="true" defer></script> }
