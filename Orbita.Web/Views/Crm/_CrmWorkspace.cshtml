@model Orbita.Contracts.CrmBoardDto
@using Orbita.Contracts
@{
    var currentUserId = ViewData["CurrentCrmUserId"] as string;
    var canCreateManualResponse = Model.IsAdmin || PanelRoles.IsCrmDeskRole(User);
    var selectedResponsibleUserId = Model.Scope == CrmBoardScopes.Mine
        ? currentUserId
        : Model.ManagerUserId;
    var selectedResponsibleName = Model.Managers
        .FirstOrDefault(x => string.Equals(x.UserId, Model.ManagerUserId, StringComparison.Ordinal))
        ?.DisplayName;
    var canFilterResponsible = Model.Scope is CrmBoardScopes.Team or CrmBoardScopes.Closed
                               || Model.Managers.Any(x => string.Equals(
                                   x.UserId,
                                   currentUserId,
                                   StringComparison.Ordinal));
    var isResponsibleFilterScope = Model.Scope is CrmBoardScopes.Mine or CrmBoardScopes.Team or CrmBoardScopes.Closed;
    var activeAdvancedFilters = new[]
    {
        !string.IsNullOrWhiteSpace(Model.City),
        !string.IsNullOrWhiteSpace(Model.Vacancy),
        Model.Scope == CrmBoardScopes.Closed && !string.IsNullOrWhiteSpace(Model.CloseReason),
        Model.OverdueOnly,
        Model.ActiveLoadOnly,
        Model.IncludeClosed
    }.Count(x => x);
    var advancedFilterBadge = activeAdvancedFilters > 0 ? activeAdvancedFilters.ToString() : string.Empty;
    string ScopeUrl(string scope) => Url.Action("Index", new
    {
        scope,
        search = Model.Search,
        city = Model.City,
        vacancy = Model.Vacancy,
        closeReason = scope == CrmBoardScopes.Closed ? Model.CloseReason : null,
        overdueOnly = Model.OverdueOnly,
        activeLoadOnly = Model.ActiveLoadOnly,
        includeClosed = Model.IncludeClosed,
        sort = Context.Request.Query["sort"].ToString(),
        dir = Context.Request.Query["dir"].ToString()
    })!;
}
@if (TempData["CrmError"] is string error)
{
    <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
}
@if (!Model.IsEnabled)
{
    <div class="crm-notice"><i class="fa-solid fa-flask" aria-hidden="true"></i>Офис не принимает отклики в CRM — операторы не могут отправлять сюда карточки.@if (Model.IsAdmin) { <text> Включите в </text><a asp-action="Team">Команда CRM</a><text> или в настройках офиса.</text> }</div>
}

<section class="crm-toolbar card">
    <div class="crm-toolbar__shift">
        <div>
            <span class="crm-pill @(Model.IsShiftActive ? "is-on" : "")">@(Model.IsShiftActive ? "На смене" : "Не на смене")</span>
            <strong class="crm-toolbar__load">@Model.ActiveLoad <span>/ @Model.Capacity</span></strong>
            <p>Нагрузка · открытых задач @Model.OpenTaskCount@if (Model.OverdueTaskCount > 0) { <text> · </text><a class="crm-toolbar__overdue" asp-action="Tasks">просрочено @Model.OverdueTaskCount</a> }</p>
            @if (canCreateManualResponse && Model.IsEnabled)
            {
                <button type="button" class="crm-manual-create-trigger" data-crm-manual-create-open aria-haspopup="dialog" aria-controls="crm-manual-create-modal">
                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>Создать отклик
                </button>
            }
        </div>
        @if (Model.IsShiftActive)
        {
            <form asp-action="StopShift" method="post"><button class="crm-shift-action crm-shift-action--stop" type="submit"><i class="fa-solid fa-stop" aria-hidden="true"></i>Стоп смены</button></form>
        }
        else
        {
            <form asp-action="StartShift" method="post"><button class="crm-shift-action crm-shift-action--start" type="submit"><i class="fa-solid fa-play" aria-hidden="true"></i>Старт смены</button></form>
        }
    </div>
    @if (canCreateManualResponse && Model.IsEnabled)
    {
        <div class="crm-manual-create-modal" id="crm-manual-create-modal" data-crm-manual-create-modal hidden>
            <div class="crm-manual-create-modal__backdrop" data-crm-manual-create-close></div>
            <section class="crm-manual-create-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="crm-manual-create-title" tabindex="-1">
                <header class="crm-manual-create-modal__header">
                    <div>
                        <h2 id="crm-manual-create-title">Создать отклик</h2>
                        <p>Добавьте кандидата в воронку вручную.</p>
                    </div>
                    <button type="button" class="crm-manual-create-modal__close" data-crm-manual-create-close aria-label="Закрыть"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                </header>
                    <form asp-action="CreateManual" method="post" class="crm-manual-create__form">
                        <label>ФИО<input name="fullName" required maxlength="256" /></label>
                        <label>Телефон<input name="phoneRaw" required maxlength="64" /></label>
                        <label>Город<input name="city" maxlength="256" /></label>
                        <label>Вакансия<input name="vacancy" maxlength="512" /></label>
                        <label>Возраст<input name="age" type="number" min="14" max="99" /></label>
                        <label>Гражданство<input name="citizenship" maxlength="128" placeholder="Например, Россия" /></label>
                        <label>Источник<input name="source" maxlength="256" placeholder="Битрикс / вручную" /></label>
                        <label>ID отклика<input name="sourceResponseId" maxlength="128" /></label>
                        <label>Этап
                            <select name="stage">
                                @foreach (var st in Model.Stages)
                                {
                                    <option value="@st.Name">@st.Name</option>
                                }
                            </select>
                        </label>
                        @if (Model.IsAdmin)
                        {
                            <label class="crm-checkbox-label"><input type="checkbox" name="assignToMe" value="true" checked /> Назначить на меня</label>
                        }
                        else
                        {
                            <input type="hidden" name="assignToMe" value="true" />
                            <p class="crm-hint"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Новый отклик будет назначен на вас.</p>
                        }
                        <footer class="crm-manual-create__actions">
                            <button class="settings-secondary-btn" type="button" data-crm-manual-create-close>Отмена</button>
                            <button class="settings-primary-btn" type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i>Создать отклик</button>
                        </footer>
                    </form>
            </section>
        </div>
    }
    <div class="crm-toolbar__stats">
        <div><small>В работе</small><strong>@Model.TeamStats.TotalActiveCards</strong></div>
        <div><small>Очередь</small><strong>@Model.UnassignedCount</strong></div>
        <div><small>На смене</small><strong>@Model.TeamStats.OnShiftManagers / @Model.TeamStats.TotalManagers</strong></div>
        <div><small>Закрыто сегодня</small><strong>@Model.TeamStats.ClosedToday</strong></div>
    </div>
</section>

<section class="crm-filters card">
    <form method="get" class="crm-filters__form" asp-action="Index">
        <div class="crm-filters__primary">
            <div class="crm-scope-tabs" role="tablist">
                <a class="@(Model.Scope == CrmBoardScopes.Mine ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Mine)">Мои</a>
                @if (Model.IsAdmin)
                {
                    <a class="@(Model.Scope == CrmBoardScopes.Team ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Team)">Команда</a>
                    <a class="@(Model.Scope == CrmBoardScopes.Unassigned ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Unassigned)">Очередь <span>@Model.UnassignedCount</span></a>
                    <a class="@(Model.Scope == CrmBoardScopes.Closed ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Closed)">Закрытые</a>
                }
                else
                {
                    @* Manager: own closed cards via Mine + includeClosed filter *@
                    <a class="@(Model.Scope == CrmBoardScopes.Closed ? "is-active" : "")" href="@ScopeUrl(CrmBoardScopes.Closed)">Мои закрытые</a>
                }
            </div>
            <input type="hidden" name="scope" value="@Model.Scope" />
            @if (Model.IsAdmin
                 && canFilterResponsible
                 && isResponsibleFilterScope)
            {
                <label class="crm-responsible-filter">
                    <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                    <span>Ответственный</span>
                    <select name="managerUserId"
                            aria-label="Фильтр по ответственному"
                            data-crm-responsible-auto-filter>
                        @if (string.IsNullOrWhiteSpace(selectedResponsibleUserId))
                        {
                            <option value="" selected>Все сотрудники</option>
                        }
                        else
                        {
                            <option value="">Все сотрудники</option>
                        }
                        @foreach (var manager in Model.Managers.OrderBy(x => x.DisplayName, StringComparer.CurrentCultureIgnoreCase))
                        {
                            if (string.Equals(manager.UserId, selectedResponsibleUserId, StringComparison.Ordinal))
                            {
                                <option value="@manager.UserId" selected>@manager.DisplayName</option>
                            }
                            else
                            {
                                <option value="@manager.UserId">@manager.DisplayName</option>
                            }
                        }
                    </select>
                </label>
            }
            <input type="search" name="search" value="@Model.Search" placeholder="ФИО, телефон, город…" aria-label="Поиск кандидата" />
            <button class="settings-primary-btn" type="submit">Найти</button>
            <a class="settings-secondary-btn" asp-action="Index" asp-route-scope="@Model.Scope">Сброс</a>
        </div>
        <details class="crm-filter-details" @(activeAdvancedFilters > 0 ? "open" : null)>
            <summary><i class="fa-solid fa-sliders" aria-hidden="true"></i>Дополнительные фильтры<span class="crm-filter-details__count @(activeAdvancedFilters == 0 ? "is-empty" : "")">@advancedFilterBadge</span></summary>
            <div class="crm-filter-details__body">
                <input type="text" name="city" value="@Model.City" placeholder="Город" />
                <input type="text" name="vacancy" value="@Model.Vacancy" placeholder="Вакансия" />
                @if (Model.Scope == CrmBoardScopes.Closed)
                {
                    <select name="closeReason" aria-label="Фильтр по типу закрытия">
                        <option value="">Все типы закрытия</option>
                        @foreach (var reason in CrmCloseReasons.All)
                        {
                            if (string.Equals(reason, Model.CloseReason, StringComparison.Ordinal))
                            {
                                <option value="@reason" selected>@reason</option>
                            }
                            else
                            {
                                <option value="@reason">@reason</option>
                            }
                        }
                    </select>
                }
                <label class="crm-check"><input type="checkbox" name="overdueOnly" value="true" @(Model.OverdueOnly ? "checked" : null) /> Просрочка</label>
                <label class="crm-check"><input type="checkbox" name="activeLoadOnly" value="true" @(Model.ActiveLoadOnly ? "checked" : null) /> В нагрузке</label>
                <label class="crm-check"><input type="checkbox" name="includeClosed" value="true" @(Model.IncludeClosed ? "checked" : null) /> + закрытые</label>
            </div>
        </details>
        <p class="crm-scope-description">
            @if (Model.Scope == CrmBoardScopes.Team)
            {
                if (!string.IsNullOrWhiteSpace(selectedResponsibleName))
                {
                    <text><i class="fa-solid fa-user-check" aria-hidden="true"></i>Карточки сотрудника: @selectedResponsibleName.</text>
                }
                else
                {
                    <text><i class="fa-solid fa-users" aria-hidden="true"></i>Все сотрудники: видно распределение кандидатов и риски по этапам.</text>
                }
            }
            else if (Model.Scope == CrmBoardScopes.Unassigned)
            {
                <text><i class="fa-solid fa-inbox" aria-hidden="true"></i>Очередь: кандидаты без ответственного.</text>
            }
            else if (Model.Scope == CrmBoardScopes.Closed)
            {
                <i class="fa-solid fa-box-archive" aria-hidden="true"></i><text>Архив закрытых карточек</text>
                @if (!string.IsNullOrWhiteSpace(selectedResponsibleName))
                {
                    <text> сотрудника @selectedResponsibleName</text>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CloseReason))
                {
                    <text> с результатом «@Model.CloseReason»</text>
                }
                <text>.</text>
            }
            else
            {
                <text><i class="fa-solid fa-user-check" aria-hidden="true"></i>Ваша рабочая воронка и приоритетные действия на сегодня.</text>
            }
            @if (!Model.CanEdit)
            {
                <text><em class="crm-readonly-hint">Просмотр — изменения недоступны.</em></text>
            }
        </p>
    </form>
</section>

@if (Model.Scope == CrmBoardScopes.Closed)
{
    <partial name="_CrmClosedTable" model="Model" />
}
else if (Model.Scope == CrmBoardScopes.Unassigned)
{
    <partial name="_CrmQueueTable" model="Model" />
}
else
{
    <partial name="_CrmBoard" model="Model" />
}
