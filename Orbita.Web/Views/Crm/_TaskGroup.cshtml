@model (string Title, IReadOnlyList<Orbita.Contracts.CrmTaskDto> Items, bool ShowComplete)
@using Orbita.Contracts
<section class="card crm-tasks-page">
    <div class="card-header"><div><h2>@Model.Title</h2></div><strong>@Model.Items.Count</strong></div>
    <div class="crm-tasks-list">
    @if (Model.Items.Count == 0)
    {
        <p class="crm-empty">Пусто</p>
    }
    else
    {
        @foreach (var task in Model.Items)
        {
            <article class="crm-task-item @(task.IsOverdue ? "is-overdue" : "") @(task.Status == CrmTaskStatuses.Completed ? "is-complete" : "")">
                <div class="crm-task-item__body">
                    <strong>@task.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        <p>@task.Description</p>
                    }
                    <span>
                        @if (task.CardId is Guid cardId)
                        {
                            <a asp-action="Card" asp-route-id="@cardId" asp-route-tab="tasks">@(task.CandidateName ?? "Карточка")</a>
                        }
                        else
                        {
                            <text>Личная</text>
                        }
                        · @task.AssigneeName
                        @if (task.DueAtUtc is DateTime due)
                        {
                            <text> · до @due.ToLocalTime().ToString("dd MMM, HH:mm")</text>
                        }
                        @if (task.IsOverdue)
                        {
                            <em class="crm-overdue"> · просрочено</em>
                        }
                    </span>
                </div>
                @if (Model.ShowComplete && task.Status == CrmTaskStatuses.Open)
                {
                    <form asp-action="CompleteTask" method="post">
                        <input type="hidden" name="taskId" value="@task.Id" />
                        <button class="settings-secondary-btn" type="submit">Выполнить</button>
                    </form>
                }
            </article>
        }
    }
    </div>
</section>
