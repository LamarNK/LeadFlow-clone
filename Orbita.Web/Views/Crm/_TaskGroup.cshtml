@model (string Title, IReadOnlyList<Orbita.Contracts.CrmTaskDto> Items, bool ShowComplete)
@using Orbita.Contracts
@{
    var currentUserId = ViewData["CurrentCrmUserId"] as string;
    var isAdmin = ViewData["IsCrmAdmin"] as bool? == true;
    var fromTeam = ViewData["TaskDetailsFromTeam"] as bool? == true;
    var teamTaskScope = ViewData["TeamTaskScope"] as string;
    var groupClass = Model.Title switch
    {
        "Просрочено" => "crm-task-group--overdue",
        "Сегодня" => "crm-task-group--today",
        "Позже" => "crm-task-group--later",
        "Отменённые" => "crm-task-group--cancelled",
        _ => "crm-task-group--completed"
    };
    var groupIcon = Model.Title switch
    {
        "Просрочено" => "fa-triangle-exclamation",
        "Сегодня" => "fa-sun",
        "Позже" => "fa-clock",
        "Отменённые" => "fa-ban",
        _ => "fa-check"
    };
    var emptyText = Model.Title switch
    {
        "Просрочено" => "Просроченных задач нет.",
        "Сегодня" => "На сегодня задач нет.",
        "Позже" => "Запланированных задач пока нет.",
        "Отменённые" => "Отменённых задач пока нет.",
        _ => "Завершённых задач пока нет."
    };
    var collapseCompletedByDefault = Model.Title == "Завершённые"
        && ViewData["CollapseCompletedTasks"] as bool? == true
        && teamTaskScope != "completed";
}
<details class="crm-task-group @groupClass @(collapseCompletedByDefault ? "crm-task-group--collapsible" : null)" open="@(!collapseCompletedByDefault)">
    <summary class="crm-task-group__header">
        <span><i class="fa-solid @groupIcon" aria-hidden="true"></i> @Model.Title</span>
        <b>@Model.Items.Count</b>
        @if (collapseCompletedByDefault)
        {
            <i class="fa-solid fa-chevron-down crm-task-group__chevron" aria-hidden="true"></i>
        }
    </summary>
    @if (Model.Items.Count == 0)
    {
        <p class="crm-task-group__empty">@emptyText</p>
    }
    else
    {
        <div class="crm-task-group__list">
            @foreach (var task in Model.Items)
            {
                var isOverdue = task.Status == CrmTaskStatuses.Open && (task.IsOverdue || (task.DueAtUtc is DateTime dueAt && dueAt < DateTime.UtcNow));
                var canComplete = isAdmin || task.AssigneeUserId == currentUserId;
                <article class="crm-task-row @(isOverdue ? "is-overdue" : "") @(task.Status == CrmTaskStatuses.Completed ? "is-complete" : "") @(task.Status == CrmTaskStatuses.Cancelled ? "is-cancelled" : "")">
                    <a class="crm-task-row__main" asp-action="TaskDetails" asp-route-id="@task.Id" asp-route-fromTeam="@fromTeam" asp-route-teamTaskScope="@teamTaskScope">
                        <div class="crm-task-row__title"><strong>@task.Title</strong><span class="crm-task-importance crm-task-importance--@task.Importance.ToLowerInvariant()">@CrmTaskImportances.GetLabel(task.Importance)</span></div>
                        @if (!string.IsNullOrWhiteSpace(task.Description)) { <p>@task.Description</p> }
                        <div class="crm-task-row__people">
                            <span><small>Кандидат</small>@if (task.CardId is Guid) { <span>@(task.CandidateName ?? "Карточка")</span> } else { <em>Личная задача</em> }</span>
                            <span><small>Ответственный</small><b>@task.AssigneeName</b></span>
                            <span><small>Автор</small><b>@task.CreatorName</b></span>
                        </div>
                    </a>
                    <div class="crm-task-row__due @(isOverdue ? "is-overdue" : "")">
                        <small>Срок</small>
                        @if (task.DueAtUtc is DateTime due) { <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> до <time data-orbita-utc="@OrbitaTime.ToIsoUtc(due)" data-orbita-format="datetime"></time></span> } else { <span class="is-empty">Не задан</span> }
                        @if (isOverdue) { <em>Просрочено</em> }
                        @if (task.Status == CrmTaskStatuses.Cancelled) { <em>Отменена</em> }
                        <span class="crm-task-row__times">
                            <small>Поставлена</small>
                            <time data-orbita-utc="@OrbitaTime.ToIsoUtc(task.CreatedAtUtc)" data-orbita-format="datetime"></time>
                            @if (task.CompletedAtUtc is DateTime completedAt)
                            {
                                <small>@(task.Status == CrmTaskStatuses.Cancelled ? "Закрыта" : "Выполнена")</small>
                                <time data-orbita-utc="@OrbitaTime.ToIsoUtc(completedAt)" data-orbita-format="datetime"></time>
                            }
                        </span>
                    </div>
                    @if (Model.ShowComplete && task.Status == CrmTaskStatuses.Open && canComplete)
                    {
                        <form asp-action="CompleteTask" method="post" class="crm-task-complete-form">
                            <input type="hidden" name="taskId" value="@task.Id" />
                            <textarea name="comment" required minlength="1" placeholder="Что сделано?" rows="2"></textarea>
                            <button class="crm-task-row__complete" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Выполнить</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</details>
