@model Orbita.Contracts.CrmTaskDetailDto
@using Orbita.Contracts
@{
    var task = Model.Task;
    var isCompleted = task.Status == CrmTaskStatuses.Completed;
    var progress = isCompleted ? 100 : 50;
    var statusName = isCompleted ? "Выполнена" : "В работе";
    var dueLabel = task.DueAtUtc is DateTime due ? due.ToLocalTime().ToString("dd MMMM yyyy, HH:mm") : "Не задан";
    var createdLabel = task.CreatedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm");
    string Initials(string name)
    {
        var letters = name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]))
            .Take(2);
        return string.Concat(letters).PadRight(1, '?');
    }

    ViewData["Title"] = task.Title;
}

<main class="orbita-main crm-shell crm-task-detail-page">
    <header class="crm-task-detail-header">
        <a asp-action="Tasks" class="crm-task-detail-back" aria-label="Вернуться к задачам" title="К задачам">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <div class="crm-task-detail-title">
            <div class="crm-task-detail-title__eyebrow"><a asp-action="Tasks">Задачи</a><span>/</span> Детали задачи</div>
            <div class="crm-task-detail-title__line">
                <h1>@task.Title</h1>
                @if (task.DueAtUtc is DateTime dueAt)
                {
                    <span class="crm-task-detail-due @(task.IsOverdue ? "is-overdue" : "")"><i class="fa-regular fa-calendar" aria-hidden="true"></i>@(dueAt.Date == DateTime.UtcNow.Date ? "Сегодня" : dueAt.ToLocalTime().ToString("dd MMM"))</span>
                }
            </div>
        </div>
        <div class="crm-task-detail-actions">
            @if (Model.CanComplete && !isCompleted)
            {
                <form asp-action="CompleteTask" method="post">
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <button class="crm-task-detail-complete" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>Выполнить задачу</button>
                </form>
            }
        </div>
    </header>

    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }

    <div class="crm-task-detail-layout">
        <div class="crm-task-detail-primary">
            <section class="crm-task-detail-card crm-task-detail-card--info">
                <dl class="crm-task-detail-fields">
                    <div><dt><i class="fa-regular fa-calendar" aria-hidden="true"></i>Срок исполнения</dt><dd class="@(task.IsOverdue ? "is-overdue" : "")">@dueLabel</dd></div>
                    <div><dt><i class="fa-regular fa-user" aria-hidden="true"></i>Автор задачи</dt><dd>@task.CreatorName</dd></div>
                    <div><dt><i class="fa-regular fa-user" aria-hidden="true"></i>Ответственный</dt><dd>@task.AssigneeName</dd></div>
                    <div><dt><i class="fa-regular fa-clock" aria-hidden="true"></i>Создана</dt><dd>@createdLabel</dd></div>
                    @if (task.CardId is Guid cardId)
                    {
                        <div><dt><i class="fa-regular fa-address-card" aria-hidden="true"></i>Кандидат</dt><dd><a asp-action="Card" asp-route-id="@cardId" asp-route-tab="tasks">@(task.CandidateName ?? "Открыть карточку") <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></dd></div>
                    }
                </dl>

                <div class="crm-task-detail-description">
                    <h2>Описание задачи</h2>
                    <p>@(string.IsNullOrWhiteSpace(task.Description) ? "Описание не добавлено." : task.Description)</p>
                </div>
            </section>

            <section class="crm-task-detail-card crm-task-detail-card--comments">
                <header class="crm-task-detail-section-heading"><h2>Комментарии</h2><b>@Model.Comments.Count</b></header>
                <div class="crm-task-detail-comments">
                    @foreach (var comment in Model.Comments)
                    {
                        var isAssignee = comment.AuthorUserId == task.AssigneeUserId;
                        <article class="crm-task-comment" id="comment-@comment.Id">
                            <span class="crm-task-comment__avatar">@Initials(comment.AuthorName)</span>
                            <div class="crm-task-comment__body">
                                <header><strong>@comment.AuthorName</strong>@if (isAssignee) { <em>Ответственный</em> }</header>
                                <p>@comment.Text</p>
                                <time>@comment.CreatedAtUtc.ToLocalTime().ToString("dd MMMM, HH:mm")</time>
                            </div>
                        </article>
                    }
                    @if (Model.Comments.Count == 0)
                    {
                        <p class="crm-task-detail-empty">Комментариев пока нет — оставьте первый.</p>
                    }
                </div>
                <form asp-action="AddTaskComment" method="post" class="crm-task-comment-composer">
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <span class="crm-task-comment-composer__avatar">@Initials(task.AssigneeName)</span>
                    <textarea name="text" required placeholder="Напишите комментарий…" aria-label="Комментарий к задаче"></textarea>
                    <button type="submit" aria-label="Добавить комментарий" title="Добавить комментарий"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
                </form>
            </section>
        </div>

        <aside class="crm-task-detail-aside">
            <section class="crm-task-detail-card crm-task-detail-status">
                <header><h2>Статус</h2><span class="@(isCompleted ? "is-complete" : "")"><i class="fa-solid fa-circle" aria-hidden="true"></i>@statusName</span></header>
                <p>@(isCompleted ? "Задача выполнена" : "Задача в работе")</p>
                <div class="crm-task-detail-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"><i style="width: @progress%"></i><b>@progress%</b></div>
            </section>

            <section class="crm-task-detail-card crm-task-detail-history">
                <header><h2>История изменений</h2></header>
                <ol>
                    @if (task.CompletedAtUtc is DateTime completedAt)
                    {
                        <li class="is-current"><time>@completedAt.ToLocalTime().ToString("dd MMMM, HH:mm")</time><strong>@task.AssigneeName</strong><p>Выполнил(а) задачу</p></li>
                    }
                    <li><time>@createdLabel</time><strong>@task.CreatorName</strong><p>Создал(а) задачу</p></li>
                </ol>
            </section>

            <section class="crm-task-detail-card crm-task-detail-files">
                <header><h2><i class="fa-solid fa-paperclip" aria-hidden="true"></i>Файлы и вложения</h2></header>
                <div><i class="fa-solid fa-paperclip" aria-hidden="true"></i><p>Файлов пока нет</p><small>Вложения будут отображаться здесь.</small></div>
            </section>
        </aside>
    </div>
</main>
