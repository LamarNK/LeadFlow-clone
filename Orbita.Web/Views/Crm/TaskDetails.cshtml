@model Orbita.Contracts.CrmTaskDetailDto
@using System.Globalization
@using Orbita.Contracts
@using Orbita.Web.Models.ViewModels
@{
    var task = Model.Task;
    var russianCulture = CultureInfo.GetCultureInfo("ru-RU");
    var isCompleted = task.Status == CrmTaskStatuses.Completed;
    var isCancelled = task.Status == CrmTaskStatuses.Cancelled;
    var isOpen = task.Status == CrmTaskStatuses.Open;
    var progress = isCompleted ? 100 : isCancelled ? 0 : 50;
    var statusName = isCompleted ? "Выполнена" : isCancelled ? "Отменена" : "В работе";
    var taskListUrl = ViewData["TaskListUrl"] as string ?? Url.Action("Tasks");
    var taskListTitle = ViewData["TaskListTitle"] as string ?? "Задачи";
    var dueLabel = task.DueAtUtc is DateTime due ? due.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", russianCulture) : "Не задан";
    var dueInputValue = task.DueAtUtc?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
    var createdLabel = task.CreatedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", russianCulture);
    string FormatFileSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.#} МБ",
        >= 1024 => $"{bytes / 1024d:0.#} КБ",
        _ => $"{bytes} Б"
    };
    string Initials(string name)
    {
        var letters = name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]))
            .Take(2);
        return string.Concat(letters).PadRight(1, '?');
    }

    ViewData["Title"] = task.Title;
    var header = new PageHeaderViewModel
    {
        Title = "Задачи",
        Subtitle = "Детали задачи",
        ShowRefresh = true,
        UpdatedAtUtc = DateTime.UtcNow
    };
}

<partial name="_PageHeader" model="header" />

<main class="orbita-main crm-shell crm-task-detail-page">
    <header class="crm-task-detail-header">
        <a href="@taskListUrl" class="crm-task-detail-back" aria-label="Вернуться к списку задач" title="К списку задач">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        </a>
        <div class="crm-task-detail-title">
            <div class="crm-task-detail-title__eyebrow"><a href="@taskListUrl">@taskListTitle</a><span>/</span> Детали задачи</div>
            <div class="crm-task-detail-title__line">
                <h1>@task.Title</h1>
                @if (task.DueAtUtc is DateTime dueAt)
                {
                    <span class="crm-task-detail-due @(task.IsOverdue ? "is-overdue" : "")"><i class="fa-regular fa-calendar" aria-hidden="true"></i>@(dueAt.Date == DateTime.UtcNow.Date ? "Сегодня" : dueAt.ToLocalTime().ToString("dd MMM", russianCulture))</span>
                }
            </div>
        </div>
        <div class="crm-task-detail-actions">
            @if (Model.CanComplete && isOpen)
            {
                <form asp-action="CompleteTask" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <button class="crm-task-detail-complete" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>Выполнить задачу</button>
                </form>
            }
            @if (Model.CanManage)
            {
                <details class="crm-task-detail-menu">
                    <summary aria-label="Действия с задачей"><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></summary>
                    <div class="crm-task-detail-menu__items">
                        @if (isOpen)
                        {
                            <button type="button" data-crm-task-edit-open data-target="task-edit-@task.Id"><i class="fa-solid fa-pen" aria-hidden="true"></i>Редактировать</button>
                            <form asp-action="CancelTask" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@task.Id" />
                                <button type="submit" class="is-danger"><i class="fa-solid fa-ban" aria-hidden="true"></i>Отменить задачу</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="ReopenTask" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskId" value="@task.Id" />
                                <button type="submit"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i>Вернуть в работу</button>
                            </form>
                        }
                    </div>
                </details>
            }
        </div>
    </header>

    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }

    <div class="crm-task-detail-layout">
        <div class="crm-task-detail-primary">
            <section class="crm-task-detail-card crm-task-detail-card--info">
                <dl class="crm-task-detail-fields">
                    <div><dt><i class="fa-regular fa-star" aria-hidden="true"></i>Важность</dt><dd><span class="crm-task-importance crm-task-importance--@task.Importance.ToLowerInvariant()">@CrmTaskImportances.GetLabel(task.Importance)</span></dd></div>
                    <div><dt><i class="fa-regular fa-calendar" aria-hidden="true"></i>Срок исполнения</dt><dd class="@(task.IsOverdue ? "is-overdue" : "")">@dueLabel</dd></div>
                    <div><dt><i class="fa-regular fa-user" aria-hidden="true"></i>Автор задачи</dt><dd>@task.CreatorName</dd></div>
                    <div><dt><i class="fa-regular fa-user" aria-hidden="true"></i>Ответственный</dt><dd>@task.AssigneeName</dd></div>
                    <div><dt><i class="fa-regular fa-clock" aria-hidden="true"></i>Создана</dt><dd>@createdLabel</dd></div>
                    @if (task.CardId is Guid cardId)
                    {
                        <div><dt><i class="fa-regular fa-address-card" aria-hidden="true"></i>Кандидат</dt><dd><a asp-action="Card" asp-route-id="@cardId" asp-route-tab="tasks">@(task.CandidateName ?? "Открыть карточку") <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></dd></div>
                    }
                </dl>

                <div class="crm-task-detail-description">
                    <h2>Описание задачи</h2>
                    <p>@(string.IsNullOrWhiteSpace(task.Description) ? "Описание не добавлено." : task.Description)</p>
                </div>
            </section>

            @if (Model.CanManage && isOpen)
            {
                <details id="task-edit-@task.Id" class="crm-task-detail-card crm-task-edit">
                    <summary><span><i class="fa-solid fa-pen" aria-hidden="true"></i>Редактировать задачу</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
                    <form asp-action="UpdateTask" method="post" class="crm-standard-form crm-task-edit__form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskId" value="@task.Id" />
                        <label><span>Название</span><input name="title" value="@task.Title" maxlength="500" required /></label>
                        <label><span>Ответственный</span><select name="assigneeUserId" required>
                            @foreach (var manager in Model.Managers)
                            {
                                if (manager.UserId == task.AssigneeUserId)
                                {
                                    <option value="@manager.UserId" selected>@manager.DisplayName</option>
                                }
                                else
                                {
                                    <option value="@manager.UserId">@manager.DisplayName</option>
                                }
                            }
                        </select></label>
                        <label><span>Важность</span><select name="importance" required>
                            @foreach (var importance in CrmTaskImportances.All)
                            {
                                if (importance == task.Importance)
                                {
                                    <option value="@importance" selected>@CrmTaskImportances.GetLabel(importance)</option>
                                }
                                else
                                {
                                    <option value="@importance">@CrmTaskImportances.GetLabel(importance)</option>
                                }
                            }
                        </select></label>
                        <label><span>Срок</span><input type="datetime-local" name="dueAtUtc" value="@dueInputValue" /></label>
                        <label class="crm-task-edit__description"><span>Описание</span><textarea name="description" maxlength="4000">@task.Description</textarea></label>
                        <footer><button class="settings-primary-btn" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i>Сохранить изменения</button></footer>
                    </form>
                </details>
            }

            <section class="crm-task-detail-card crm-task-detail-card--comments">
                <header class="crm-task-detail-section-heading"><h2>Комментарии</h2><b>@Model.Comments.Count</b></header>
                <div class="crm-task-detail-comments">
                    @foreach (var comment in Model.Comments)
                    {
                        var isAssignee = comment.AuthorUserId == task.AssigneeUserId;
                        <article class="crm-task-comment" id="comment-@comment.Id">
                            <span class="crm-task-comment__avatar">@Initials(comment.AuthorName)</span>
                            <div class="crm-task-comment__body">
                                <header><strong>@comment.AuthorName</strong>@if (isAssignee) { <em>Ответственный</em> }</header>
                                <p>@comment.Text</p>
                                <time>@comment.CreatedAtUtc.ToLocalTime().ToString("dd MMMM, HH:mm", russianCulture)</time>
                            </div>
                        </article>
                    }
                    @if (Model.Comments.Count == 0)
                    {
                        <p class="crm-task-detail-empty">Комментариев пока нет — оставьте первый.</p>
                    }
                </div>
                <form asp-action="AddTaskComment" method="post" class="crm-task-comment-composer">
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <span class="crm-task-comment-composer__avatar">@Initials(task.AssigneeName)</span>
                    <textarea name="text" required placeholder="Напишите комментарий…" aria-label="Комментарий к задаче"></textarea>
                    <button type="submit" aria-label="Добавить комментарий" title="Добавить комментарий"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
                </form>
            </section>
        </div>

        <aside class="crm-task-detail-aside">
            <section class="crm-task-detail-card crm-task-detail-status">
                <header><h2>Статус</h2><span class="@(isCompleted ? "is-complete" : isCancelled ? "is-cancelled" : "")"><i class="fa-solid fa-circle" aria-hidden="true"></i>@statusName</span></header>
                <p>@(isCompleted ? "Задача выполнена" : isCancelled ? "Задача отменена" : "Задача в работе")</p>
                <div class="crm-task-detail-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"><i style="width: @progress%"></i><b>@progress%</b></div>
            </section>

            <section class="crm-task-detail-card crm-task-detail-history">
                <header><h2>История изменений</h2></header>
                <ol>
                    @if (task.CompletedAtUtc is DateTime completedAt)
                    {
                        <li class="is-current"><time>@completedAt.ToLocalTime().ToString("dd MMMM, HH:mm", russianCulture)</time><strong>@(isCancelled ? task.CreatorName : task.AssigneeName)</strong><p>@(isCancelled ? "Отменил(а) задачу" : "Выполнил(а) задачу")</p></li>
                    }
                    <li><time>@createdLabel</time><strong>@task.CreatorName</strong><p>Создал(а) задачу</p></li>
                </ol>
            </section>

            <section class="crm-task-detail-card crm-task-detail-files">
                <header><h2><i class="fa-solid fa-paperclip" aria-hidden="true"></i>Файлы и вложения <b>@Model.Attachments.Count</b></h2></header>
                <form asp-action="UploadTaskAttachment" method="post" enctype="multipart/form-data" class="crm-task-file-upload" data-crm-task-upload data-max-bytes="@CrmTaskAttachmentLimits.MaxFileSizeBytes">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <input id="crm-task-file-@task.Id" name="file" type="file" hidden data-crm-task-file-input />
                    <label for="crm-task-file-@task.Id" class="crm-task-file-dropzone" data-crm-task-dropzone tabindex="0">
                        <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
                        <span>Перетащите файл сюда или <b>выберите файл</b></span>
                        <small>До 20 МБ</small>
                    </label>
                    <div class="crm-task-file-upload__actions">
                        <span data-crm-task-file-status aria-live="polite">Файл не выбран</span>
                        <button type="submit" class="settings-secondary-btn">Загрузить</button>
                    </div>
                </form>
                @if (Model.Attachments.Count == 0)
                {
                    <p class="crm-task-files-empty">Файлов пока нет.</p>
                }
                else
                {
                    <ul class="crm-task-file-list">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <li>
                                <a asp-action="DownloadTaskAttachment" asp-route-taskId="@task.Id" asp-route-attachmentId="@attachment.Id">
                                    <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                                    <span><strong>@attachment.FileName</strong><small>@FormatFileSize(attachment.SizeBytes) · @attachment.UploadedByName · @attachment.CreatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm", russianCulture)</small></span>
                                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </aside>
    </div>
</main>
