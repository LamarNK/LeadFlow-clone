@model Orbita.Contracts.CrmBoardDto
@{
    var requestedSort = Context.Request.Query["sort"].ToString().Trim().ToLowerInvariant();
    var requestedDir = Context.Request.Query["dir"].ToString();
    var validSorts = new[] { "candidate", "phone", "vacancy", "manager", "result", "changed" };
    var sortColumn = validSorts.Contains(requestedSort) ? requestedSort : "changed";
    var sort = TableSortState.Create(sortColumn, string.Equals(requestedDir, "asc", StringComparison.OrdinalIgnoreCase) ? false : true);
    var cardsQuery = Model.Stages
        .SelectMany(stage => stage.Cards)
        .Where(card => card.IsClosed);
    var cards = sortColumn switch
    {
        "candidate" => sort.Descending ? cardsQuery.OrderByDescending(card => card.FullName) : cardsQuery.OrderBy(card => card.FullName),
        "phone" => sort.Descending ? cardsQuery.OrderByDescending(card => card.PhoneRaw) : cardsQuery.OrderBy(card => card.PhoneRaw),
        "vacancy" => sort.Descending ? cardsQuery.OrderByDescending(card => card.Vacancy) : cardsQuery.OrderBy(card => card.Vacancy),
        "manager" => sort.Descending ? cardsQuery.OrderByDescending(card => card.ManagerName) : cardsQuery.OrderBy(card => card.ManagerName),
        "result" => sort.Descending ? cardsQuery.OrderByDescending(card => card.CloseReason) : cardsQuery.OrderBy(card => card.CloseReason),
        _ => sort.Descending ? cardsQuery.OrderByDescending(card => card.StageChangedAtUtc) : cardsQuery.OrderBy(card => card.StageChangedAtUtc)
    };
    var sortRoute = new
    {
        scope = Model.Scope,
        search = Model.Search,
        city = Model.City,
        vacancy = Model.Vacancy,
        overdueOnly = Model.OverdueOnly,
        activeLoadOnly = Model.ActiveLoadOnly,
        includeClosed = Model.IncludeClosed
    };
}
<section class="crm-closed crm-table-list card" aria-label="Закрытые кандидаты">
    <header class="crm-closed__header">
        <div>
            <h2>Закрытые кандидаты</h2>
            <p>Архив с результатом работы и последним изменением.</p>
        </div>
        <span class="crm-closed__count" title="Карточек в архиве">@cards.Count()</span>
    </header>

    @if (!cards.Any())
    {
        <div class="crm-closed__empty">
            <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
            <strong>Закрытых карточек нет</strong>
            <span>Завершённые кандидаты появятся здесь.</span>
        </div>
    }
    else
    {
        <div class="crm-closed__table-wrap">
            <table class="data-table data-table--cards crm-closed__table crm-table-list__table">
                <colgroup>
                    <col class="crm-table-list__candidate-col" />
                    <col class="crm-table-list__contact-col" />
                    <col class="crm-table-list__vacancy-col" />
                    <col class="crm-table-list__manager-col" />
                    <col class="crm-table-list__result-col" />
                    <col class="crm-table-list__date-col" />
                </colgroup>
                <thead>
                    <tr>
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Кандидат", Column = "candidate", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Контакты", Column = "phone", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Вакансия", Column = "vacancy", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Ответственный", Column = "manager", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Результат", Column = "result", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Закрыто", Column = "changed", Sort = sort, Controller = "Crm", Action = "Index", RouteValues = sortRoute })" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in cards)
                    {
                        var initials = string.Concat(card.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
                        var avatarUrl = Url.Action("Avatar", "Crm", new { id = card.Id });
                        <tr>
                            <td class="crm-table-candidate" data-label="Кандидат">
                                <a asp-action="Card" asp-route-id="@card.Id" class="crm-table-candidate__identity">
                                    <span class="crm-table-candidate__avatar">@(string.IsNullOrWhiteSpace(initials) ? "?" : initials)<img src="@avatarUrl" alt="" loading="lazy" onerror="this.remove()" /></span>
                                    <span class="crm-table-candidate__copy"><strong title="@card.FullName">@card.FullName</strong><small>@(card.Age?.ToString() ?? "—") лет</small></span>
                                </a>
                            </td>
                            <td class="crm-table-contact" data-label="Контакты"><a href="tel:@card.PhoneRaw">@card.PhoneRaw</a><span>@card.City</span></td>
                            <td class="crm-table-vacancy" data-label="Вакансия"><strong title="@card.Vacancy">@card.Vacancy</strong>@if (!string.IsNullOrWhiteSpace(card.AccountName)) { <span>@card.AccountName</span> }</td>
                            <td class="crm-table-manager" data-label="Ответственный">@(card.ManagerName ?? "Не назначен")</td>
                            <td data-label="Результат"><span class="crm-table-result" title="@(card.CloseReason ?? "Причина не указана")">@(card.CloseReason ?? "Не указана")</span></td>
                            <td class="crm-table-time" data-label="Закрыто"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(card.StageChangedAtUtc, "datetime"))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
