@model Orbita.Web.Models.ViewModels.CrmTasksViewModel
@using Orbita.Contracts
@using Orbita.Web.Models.ViewModels
@{
    ViewData["Title"] = "CRM — Задачи";
    var now = DateTime.UtcNow;
    var browserUtcOffsetMinutes = Math.Clamp(Model.BrowserUtcOffsetMinutes, -14 * 60, 14 * 60);
    var browserLocalNow = now.AddMinutes(browserUtcOffsetMinutes);
    var open = Model.Tasks.Where(x => x.Status == CrmTaskStatuses.Open).ToList();
    var overdue = open.Where(x => x.IsOverdue || (x.DueAtUtc is DateTime due && due < now)).OrderBy(x => x.DueAtUtc).ToList();
    var overdueIds = overdue.Select(x => x.Id).ToHashSet();
    var todayEnd = DateTime.SpecifyKind(
        browserLocalNow.Date.AddDays(1).AddMinutes(-browserUtcOffsetMinutes),
        DateTimeKind.Utc);
    var today = open.Where(x => !overdueIds.Contains(x.Id) && x.DueAtUtc is DateTime due && due < todayEnd).OrderBy(x => x.DueAtUtc).ToList();
    var todayIds = today.Select(x => x.Id).ToHashSet();
    var later = open.Where(x => !overdueIds.Contains(x.Id) && !todayIds.Contains(x.Id)).OrderBy(x => x.DueAtUtc ?? DateTime.MaxValue).ToList();
    var completed = Model.Tasks.Where(x => x.Status == CrmTaskStatuses.Completed).OrderByDescending(x => x.CompletedAtUtc).Take(30).ToList();
    var cancelled = Model.Tasks.Where(x => x.Status == CrmTaskStatuses.Cancelled).OrderByDescending(x => x.CompletedAtUtc).Take(30).ToList();
    var selectedScope = Model.SelectedScope;
    ViewData["CurrentCrmUserId"] = Model.CurrentUserId;
    ViewData["IsCrmAdmin"] = Model.IsAdmin;
    ViewData["TaskListScope"] = selectedScope;
    var defaultAssigneeUserId = Model.Managers.FirstOrDefault(x => x.UserId == Model.CurrentUserId)?.UserId
        ?? Model.Managers.FirstOrDefault()?.UserId;
    var shownCount = selectedScope switch
    {
        "overdue" => overdue.Count,
        "today" => today.Count,
        "later" => later.Count,
        "completed" => completed.Count,
        "cancelled" => cancelled.Count,
        _ => open.Count
    };
    var header = new PageHeaderViewModel { Title = "Задачи", Subtitle = "Планируйте, отслеживайте и выполняйте задачи", ShowRefresh = true, UpdatedAtUtc = DateTime.UtcNow };
}
<partial name="_PageHeader" model="header" />

<main class="orbita-main crm-shell crm-task-dashboard" data-crm-tasks-utc-offset="@browserUtcOffsetMinutes">
    @if (TempData["CrmError"] is string error)
    {
        <div class="crm-notice crm-notice--error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@error</div>
    }

    <section class="crm-task-overview" aria-label="Сводка по задачам">
        <div class="crm-task-metrics">
            <article class="kpi-card crm-task-metric crm-task-metric--queue" style="--kpi-index: 0;">
                <header class="kpi-card-head">
                    <span class="kpi-icon-box kpi-icon-box--blue"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
                    <span class="kpi-card-label">Моя очередь</span>
                </header>
                <div class="kpi-card-metric crm-task-metric__metric"><b class="kpi-value">@open.Count</b></div>
                <p class="crm-task-metric__caption">Открытые задачи по срокам</p>
            </article>
            <article class="kpi-card crm-task-metric crm-task-metric--overdue" style="--kpi-index: 1;">
                <header class="kpi-card-head">
                    <span class="kpi-icon-box kpi-icon-box--orange"><i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i></span>
                    <span class="kpi-card-label">Просрочено</span>
                </header>
                <div class="kpi-card-metric crm-task-metric__metric"><b class="kpi-value">@overdue.Count</b></div>
                <p class="crm-task-metric__caption">Требуют внимания сейчас</p>
            </article>
            <article class="kpi-card crm-task-metric crm-task-metric--today" style="--kpi-index: 2;">
                <header class="kpi-card-head">
                    <span class="kpi-icon-box kpi-icon-box--green"><i class="fa-solid fa-calendar-day" aria-hidden="true"></i></span>
                    <span class="kpi-card-label">На сегодня</span>
                </header>
                <div class="kpi-card-metric crm-task-metric__metric"><b class="kpi-value">@today.Count</b></div>
                <p class="crm-task-metric__caption">Запланировано до конца дня</p>
            </article>
            <article class="kpi-card crm-task-metric crm-task-metric--later" style="--kpi-index: 3;">
                <header class="kpi-card-head">
                    <span class="kpi-icon-box kpi-icon-box--purple"><i class="fa-solid fa-clock" aria-hidden="true"></i></span>
                    <span class="kpi-card-label">Позже</span>
                </header>
                <div class="kpi-card-metric crm-task-metric__metric"><b class="kpi-value">@later.Count</b></div>
                <p class="crm-task-metric__caption">Срок ещё впереди</p>
            </article>
        </div>

        <button type="button" class="crm-task-create-trigger" data-crm-task-create-open aria-label="Новая задача" title="Новая задача"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
    </section>

    <section class="card crm-task-workspace" aria-label="Список задач">
        <header class="crm-task-workspace__toolbar">
            <nav class="crm-task-tabs" aria-label="Отбор задач">
                <a class="@(selectedScope == "all" ? "is-active" : "")" asp-action="Tasks">Все задачи</a>
                <a class="@(selectedScope == "overdue" ? "is-active" : "")" asp-action="Tasks" asp-route-scope="overdue">Просроченные @if (overdue.Count > 0) { <span>@overdue.Count</span> }</a>
                <a class="@(selectedScope == "today" ? "is-active" : "")" asp-action="Tasks" asp-route-scope="today">Сегодня @if (today.Count > 0) { <span>@today.Count</span> }</a>
                <a class="@(selectedScope == "later" ? "is-active" : "")" asp-action="Tasks" asp-route-scope="later">Позже @if (later.Count > 0) { <span>@later.Count</span> }</a>
                <a class="@(selectedScope == "completed" ? "is-active" : "")" asp-action="Tasks" asp-route-scope="completed">Завершённые</a>
                <a class="@(selectedScope == "cancelled" ? "is-active" : "")" asp-action="Tasks" asp-route-scope="cancelled">Отменённые</a>
            </nav>
            <div class="crm-task-workspace__tools">
                <button type="button" class="crm-task-tool"><span>Сортировка: Срок (по возрастанию)</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
                <button type="button" class="crm-task-tool crm-task-tool--filter"><i class="fa-solid fa-filter" aria-hidden="true"></i> Фильтры</button>
            </div>
        </header>

        <div id="crm-task-all" class="crm-task-groups">
            @if (selectedScope == "overdue" || (selectedScope == "all" && overdue.Count > 0)) { <partial name="_TaskGroup" model="@("Просрочено", (IReadOnlyList<CrmTaskDto>)overdue, true)" /> }
            @if (selectedScope == "today" || (selectedScope == "all" && today.Count > 0)) { <partial name="_TaskGroup" model="@("Сегодня", (IReadOnlyList<CrmTaskDto>)today, true)" /> }
            @if (selectedScope == "later" || (selectedScope == "all" && later.Count > 0)) { <partial name="_TaskGroup" model="@("Позже", (IReadOnlyList<CrmTaskDto>)later, true)" /> }
            @if (selectedScope == "completed" || (selectedScope == "all" && completed.Count > 0)) { <partial name="_TaskGroup" model="@("Завершённые", (IReadOnlyList<CrmTaskDto>)completed, false)" /> }
            @if (selectedScope == "cancelled" || (selectedScope == "all" && cancelled.Count > 0)) { <partial name="_TaskGroup" model="@("Отменённые", (IReadOnlyList<CrmTaskDto>)cancelled, false)" /> }
            @if (selectedScope == "all" && Model.Tasks.Count == 0)
            {
                <p class="crm-task-groups__empty">Открытых и завершённых задач пока нет.</p>
            }
        </div>

        <footer class="crm-task-workspace__footer">Показано @shownCount задач</footer>
    </section>

    <div class="crm-task-modal" data-crm-task-create-modal hidden>
        <div class="crm-task-modal__backdrop" data-crm-task-create-close></div>
        <section class="crm-task-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="crm-task-create-title" tabindex="-1">
            <header class="crm-task-modal__header">
                <div>
                    <h2 id="crm-task-create-title">Новая задача</h2>
                    <p>Добавьте действие и срок, чтобы не потерять договорённость.</p>
                </div>
                <button type="button" class="crm-task-modal__close" data-crm-task-create-close aria-label="Закрыть"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </header>
            <form asp-action="CreateTask" method="post" class="crm-standard-form crm-task-create-form crm-task-create-form--modal">
                <label><span>Тип задачи</span><select name="taskType" required>
                    <option value="" selected disabled>Выберите тип</option>
                    @foreach (var taskType in CrmTaskTypes.All)
                    {
                        <option value="@taskType">@CrmTaskTypes.GetLabel(taskType)</option>
                    }
                </select></label>
                <label><span>Ответственный</span><select name="assigneeUserId" required>@foreach (var manager in Model.Managers) { if (manager.UserId == defaultAssigneeUserId) { <option value="@manager.UserId" selected>@manager.DisplayName</option> } else { <option value="@manager.UserId">@manager.DisplayName</option> } }</select></label>
                <label><span>Важность</span><select name="importance" required><option value="@CrmTaskImportances.Low">Низкая</option><option value="@CrmTaskImportances.Medium" selected>Средняя</option><option value="@CrmTaskImportances.High">Высокая</option></select></label>
                <label><span>Срок</span><input type="datetime-local" data-crm-deadline-local /><input type="hidden" name="dueAtUtc" data-crm-deadline-utc /></label>
                <label class="crm-task-create-form__description"><span>Комментарий <small>необязательно</small></span><textarea name="description" placeholder="Контекст или следующий шаг"></textarea></label>
                <footer class="crm-task-create-form__actions">
                    <button class="settings-secondary-btn" type="button" data-crm-task-create-close>Отмена</button>
                    <button class="settings-primary-btn" type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i> Создать задачу</button>
                </footer>
            </form>
        </section>
    </div>
</main>
