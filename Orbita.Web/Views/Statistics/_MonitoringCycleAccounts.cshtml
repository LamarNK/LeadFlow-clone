@model MonitoringCycleReportViewModel
@{
    var report = Model;
}
@if (report.AccountReports.Count > 0)
{
    <div class="statistics-workers-table-wrap statistics-monitoring-accounts-wrap">
        <table class="data-table data-table--cards data-table--statistics-workers data-table--monitoring-accounts">
            <thead>
                <tr>
                    <th>Аккаунт</th>
                    <th>Дата</th>
                    <th class="cell-num">Суб-проф.</th>
                    <th class="cell-num">Циклы</th>
                    <th class="cell-num">Отклики</th>
                    <th class="cell-num">Капча</th>
                </tr>
            </thead>
            <tbody data-monitoring-accounts>
                @foreach (var account in report.AccountReports)
                {
                    <tr class="monitoring-account-row"
                        data-monitoring-account="@account.AccountName"
                        data-monitoring-account-toggle
                        aria-expanded="false">
                        <td class="cell-name" data-label="Аккаунт">
                            <span class="monitoring-account-row-label">
                                <i class="fa-solid fa-chevron-right monitoring-account-row-caret" aria-hidden="true"></i>
                                @account.AccountName
                            </span>
                        </td>
                        <td data-label="Дата">
                            <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.DateUtc, "date"))" />
                        </td>
                        <td class="cell-num" data-label="Суб-проф.">@account.SubProfileCount</td>
                        <td class="cell-num" data-label="Циклы">@account.CycleCount</td>
                        <td class="cell-num" data-label="Отклики">@account.TotalLeads</td>
                        <td class="cell-num" data-label="Капча">
                            @if (account.TotalCaptcha > 0)
                            {
                                <span class="monitoring-pass-flag @(account.TotalCaptchaSolved < account.TotalCaptcha ? "monitoring-pass-flag--bad" : null)">@account.CaptchaText</span>
                            }
                            else
                            {
                                <span class="monitoring-pass-empty">—</span>
                            }
                        </td>
                    </tr>
                    <tr class="monitoring-account-detail-row" data-monitoring-account-detail="@account.AccountName" hidden>
                        <td colspan="6">
                            <div class="monitoring-report-table-wrap">
                                <table class="data-table monitoring-report-table">
                                    <thead>
                                        <tr>
                                            <th class="monitoring-col-pos">Позиция</th>
                                            <th class="monitoring-col-name">Субпрофиль</th>
                                            <th class="monitoring-col-passes">Проходы</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in account.Rows)
                                        {
                                            <tr class="@(row.HasNotStarted ? "monitoring-report-row--muted" : null)">
                                                <td class="monitoring-col-pos" data-label="Позиция">@row.PositionText</td>
                                                <td class="monitoring-col-name" data-label="Субпрофиль">@row.Name</td>
                                                <td class="monitoring-col-passes" data-label="Проходы">
                                                    @if (row.Passes.Count == 0)
                                                    {
                                                        @if (row.HasNotStarted)
                                                        {
                                                            <span class="monitoring-pass monitoring-pass--skipped">
                                                                @if (row.NotStartedAtUtc is DateTime notStartedAt)
                                                                {
                                                                    <span class="monitoring-pass-time">
                                                                        <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(notStartedAt, "time"))" />
                                                                    </span>
                                                                }
                                                                <span class="monitoring-pass-flag monitoring-pass-flag--skip">не запускался</span>
                                                                @if (!string.IsNullOrWhiteSpace(row.NotStartedReason))
                                                                {
                                                                    <span class="monitoring-pass-skip-reason">@row.NotStartedReason</span>
                                                                }
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="monitoring-pass-empty">—</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="monitoring-passes">
                                                            @foreach (var pass in row.Passes)
                                                            {
                                                                <partial name="~/Views/Statistics/_MonitoringCyclePassChip.cshtml" model="pass" />
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
