@model MonitoringCycleReportViewModel
@{
    var report = Model;
}
@if (report.AccountReports.Count > 0)
{
    <div class="statistics-workers-table-wrap statistics-monitoring-accounts-wrap">
        <table class="data-table data-table--cards data-table--statistics-workers data-table--monitoring-accounts">
            <thead>
                <tr>
                    <th>Аккаунт</th>
                    <th>Дата</th>
                    <th class="cell-num">Суб-проф.</th>
                    <th class="cell-num">Циклы</th>
                    <th class="cell-num">Отклики</th>
                    <th class="cell-num">Капча</th>
                </tr>
            </thead>
            <tbody data-monitoring-accounts>
                @foreach (var account in report.AccountReports)
                {
                    <tr class="monitoring-account-row"
                        data-monitoring-account="@account.AccountName"
                        data-monitoring-account-toggle
                        aria-expanded="false">
                        <td class="cell-name" data-label="Аккаунт">
                            <span class="monitoring-account-row-label">
                                <i class="fa-solid fa-chevron-right monitoring-account-row-caret" aria-hidden="true"></i>
                                @account.AccountName
                            </span>
                        </td>
                        <td data-label="Дата">
                            <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.DateUtc, "date"))" />
                        </td>
                        <td class="cell-num" data-label="Суб-проф.">@account.SubProfileCount</td>
                        <td class="cell-num" data-label="Циклы">@account.CycleCount</td>
                        <td class="cell-num" data-label="Отклики">@account.TotalLeads</td>
                        <td class="cell-num" data-label="Капча">@account.CaptchaText</td>
                    </tr>
                    <tr class="monitoring-account-detail-row" data-monitoring-account-detail="@account.AccountName" hidden>
                        <td colspan="6">
                            <div class="monitoring-report-table-wrap">
                                <table class="data-table monitoring-report-table">
                                    <thead>
                                        <tr>
                                            <th class="monitoring-col-pos">Позиция</th>
                                            <th class="monitoring-col-name">Название</th>
                                            <th class="monitoring-col-times">Успешное завершение</th>
                                            <th class="monitoring-col-leads">Откликов</th>
                                            <th class="monitoring-col-captcha">Капча</th>
                                            <th class="monitoring-col-errors">Ошибки</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in account.Rows)
                                        {
                                            <tr class="@(row.HasNotStarted ? "monitoring-report-row--muted" : null)">
                                                <td class="monitoring-col-pos">@row.PositionText</td>
                                                <td class="monitoring-col-name">@row.Name</td>
                                                <td class="monitoring-col-times">
                                                    @if (row.CompletionTimesUtc.Count == 0)
                                                    {
                                                        @:—
                                                    }
                                                    else
                                                    {
                                                        <span class="monitoring-times-list">
                                                            @for (var i = 0; i < row.CompletionTimesUtc.Count; i++)
                                                            {
                                                                if (i > 0)
                                                                {
                                                                    <text>, </text>
                                                                }
                                                                <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.CompletionTimesUtc[i], "time"))" />
                                                            }
                                                        </span>
                                                    }
                                                </td>
                                                <td class="monitoring-col-leads">@row.LeadsText</td>
                                                <td class="monitoring-col-captcha">@row.CaptchaText</td>
                                                <td class="monitoring-col-errors @(row.HasErrors ? "cell-bad" : "cell-muted")">
                                                    @if (row.Errors.Count == 0)
                                                    {
                                                        @:—
                                                    }
                                                    else
                                                    {
                                                        @for (var i = 0; i < row.Errors.Count; i++)
                                                        {
                                                            if (i > 0)
                                                            {
                                                                <text>; </text>
                                                            }
                                                            var error = row.Errors[i];
                                                            <span class="monitoring-error-entry">
                                                                <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(error.TimestampUtc, "time"))" />
                                                                <span> — @error.Detail</span>
                                                            </span>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
