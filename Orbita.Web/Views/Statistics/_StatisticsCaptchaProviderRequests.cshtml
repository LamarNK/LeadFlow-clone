@model StatisticsViewModel
@using Orbita.Contracts
@{
    var stats = Model.CaptchaProviderRequests;
}
<section class="card statistics-captcha-requests" data-statistics-captcha-requests>
    <div class="card-header">
        <div>
            <h2>Запросы капчи</h2>
            <p class="card-header-subtitle">Фактические обращения воркеров к RuCaptcha за выбранный период</p>
        </div>
        <span class="card-header-meta" data-captcha-stat="submitted">@(stats?.SubmittedCount ?? 0) отправлено</span>
    </div>
    <div class="card-body">
        @if (stats is null || stats.Workers.Count == 0)
        {
            <div class="table-empty-state"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Запросов капчи нет</span></div>
        }
        else
        {
            <div class="statistics-captcha-kpis">
                <span><strong>@stats.SubmittedCount</strong> отправлено</span>
                <span><strong>@stats.ProviderAcceptedCount</strong> RuCaptcha выдала решение</span>
                <span><strong>@stats.NoSlotCount</strong> нет слота</span>
                <span><strong>@stats.ProviderErrorCount</strong> ошибка провайдера</span>
                <span><strong>@stats.TargetAcceptedCount</strong> Avito подтвердил</span>
                <span><strong>@stats.TargetRejectedCount</strong> отклонил Avito</span>
                <span><strong>@stats.ContextDetectedCount</strong> контекст определён</span>
                <span><strong>@stats.ChallengePresentCount</strong> с challenge</span>
                <span><strong>@stats.RiskTypePresentCount</strong> с risk_type</span>
            </div>
            <div class="statistics-captcha-workers">
                @foreach (var worker in stats.Workers)
                {
                    <details class="statistics-captcha-worker" data-captcha-group-key="@($"{worker.WorkerId:D}:{worker.AccountId:D}")">
                        <summary><span>@worker.WorkerName · @worker.AccountName</span><span class="statistics-captcha-worker-count">@worker.SubmittedCount / @worker.TargetAcceptedCount Avito</span></summary>
                        <div class="statistics-captcha-details">
                            @foreach (var request in worker.Requests)
                            {
                                <div class="statistics-captcha-request-row">
                                    <time datetime="@request.SubmittedAtUtc.ToString("O")"
                                          data-orbita-utc="@request.SubmittedAtUtc.ToString("O")"
                                          data-orbita-format="datetime-short-seconds"></time>
                                    <span>@request.CaptchaType · @request.Stage</span>
                                    <span>попытка @request.Attempt/@request.MaxAttempts</span>
                                    <span class="statistics-captcha-status">@request.ProviderStatus / @request.TargetStatus</span>
                                    @if (!string.IsNullOrWhiteSpace(request.TargetReason))
                                    {
                                        <span class="muted">@request.TargetReason@(request.TargetHttpStatus is int status ? $" · HTTP {status}" : string.Empty)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(request.ContextFingerprint))
                                    {
                                        <span class="muted">ctx @request.ContextFingerprint[..Math.Min(10, request.ContextFingerprint.Length)] · challenge @(request.ChallengePresent == true ? "да" : "нет") · risk @(request.RiskTypePresent == true ? "да" : "нет")</span>
                                    }
                                    @if (request.DiagnosticAttachmentId is Guid attachmentId)
                                    {
                                        <a href="/Diagnostics/Image/@attachmentId" target="_blank" rel="noopener">Скриншот</a>
                                    }
                                    else
                                    {
                                        <span class="muted">Скриншот удалён по сроку хранения</span>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </div>
</section>
