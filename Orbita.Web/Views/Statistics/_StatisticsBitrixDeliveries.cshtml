@model StatisticsViewModel
<div class="card card--statistics-bitrix">
    <div class="card-header">
        <h2>Отправки в Битрикс24</h2>
        <span class="card-header-meta">@Model.Summary.PeriodSent всего за период</span>
    </div>
    <div class="card-body card-body-table" data-statistics-bitrix-deliveries>
        @if (Model.BitrixDeliveries.Count == 0)
        {
            <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
            {
                IconClass = "fa-solid fa-paper-plane",
                Title = "Нет отправок за период",
                Description = "Отклики ещё не отправлялись в Битрикс24 за выбранный период."
            })" />
        }
        else
        {
            <table class="data-table data-table--compact statistics-bitrix-table">
                <thead>
                    <tr>
                        <th>Битрикс</th>
                        <th class="cell-num">Отправлено</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.BitrixDeliveries)
                    {
                        <tr>
                            <td>
                                <a href="@row.ResponsesUrl" class="statistics-bitrix-link">@row.Label</a>
                            </td>
                            <td class="cell-num">@row.SentCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>