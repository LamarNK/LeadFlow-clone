@model ListingsIndexViewModel
@using Microsoft.AspNetCore.Routing
@{
    ViewData["Title"] = "Объявления";
    var pagination = Model.Pagination;
    var listingsSortRoute = new RouteValueDictionary
    {
        ["q"] = Model.SearchQuery,
        ["tab"] = Model.ActiveTab,
        ["pageSize"] = pagination.PageSize,
        ["sort"] = Model.Sort.Column,
        ["dir"] = Model.Sort.Dir
    };
    if (Model.WorkerIds.Count == 1)
    {
        listingsSortRoute["workerId"] = Model.WorkerIds[0];
    }
    else if (Model.WorkerIds.Count > 1)
    {
        listingsSortRoute["workerIds"] = Model.WorkerIds;
    }

    if (Model.AccountIds.Count == 1)
    {
        listingsSortRoute["accountId"] = Model.AccountIds[0];
    }
    else if (Model.AccountIds.Count > 1)
    {
        listingsSortRoute["accountIds"] = Model.AccountIds;
    }

    if (Model.SubProfileIds.Count == 1)
    {
        listingsSortRoute["subProfileId"] = Model.SubProfileIds[0];
    }
    else if (Model.SubProfileIds.Count > 1)
    {
        listingsSortRoute["subProfileIds"] = Model.SubProfileIds;
    }

    var snapshotRoute = new RouteValueDictionary(listingsSortRoute) { ["page"] = pagination.Page };
    var snapshotUrl = Url.Action("Snapshot", "Listings", snapshotRoute)!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main accounts-page listings-page"
     data-orbita-live
     data-orbita-live-page="listings"
     data-orbita-snapshot="@snapshotUrl">
    <div class="kpi-row accounts-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <nav class="accounts-tabs" aria-label="Фильтр объявлений">
        @foreach (var tab in Model.Tabs)
        {
            var isActive = tab.Id == Model.ActiveTab;
            <a class="accounts-tab @(isActive ? "accounts-tab--active" : "")"
               href="@Url.Action("Index", new RouteValueDictionary(listingsSortRoute) { ["tab"] = tab.Id, ["page"] = 1 })"
               aria-current="@(isActive ? "page" : null)">@tab.Label <span class="listings-tab-count">@tab.Count</span></a>
        }
    </nav>

    @{
        var listingsFormAction = Url.Action("Index", "Listings");
        var listingsFilterBar = new ListFiltersBarViewModel
        {
            FormAction = listingsFormAction!,
            FormClass = "orbita-filters-form accounts-filters",
            SearchName = "q",
            SearchPlaceholder = "Поиск по названию, ID, аккаунту или воркеру",
            SearchValue = Model.SearchQuery,
            FilterPanelId = "listingsFilterPanel",
            FilterToggleClass = "orbita-filters-toggle accounts-filter-btn",
            HasActiveFilters = Model.HasActiveFilters,
            ActiveFilterCount = Model.ActiveFilterCount,
            ActiveFilterChips = Model.ActiveFilterChips,
            ResetUrl = listingsFormAction!,
            FilterFieldsPartialName = "_ListingsFilterFields",
            FilterFieldsModel = Model,
            ExtraFormContent = $"<input type=\"hidden\" name=\"sort\" value=\"{Model.Sort.Column}\" /><input type=\"hidden\" name=\"dir\" value=\"{Model.Sort.Dir}\" />"
        };
    }
    <partial name="_ListFiltersBar" model="listingsFilterBar" />

    <div class="listings-workspace">
        <aside class="listings-scope" aria-label="Аккаунты и субпрофили">
            <div class="listings-scope__heading">Объявления</div>
            <a class="listings-scope__all @(Model.AccountIds.Count == 0 ? "is-active" : "")"
               href="@Url.Action("Index", new { q = Model.SearchQuery, tab = Model.ActiveTab, sort = Model.Sort.Column, dir = Model.Sort.Dir })">
                <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Все</span>
                <strong>@(Model.Summary.ActiveCount + Model.Summary.ErrorCount + Model.Summary.UnpublishedCount)</strong>
            </a>
            <div class="listings-scope__accounts">
                @foreach (var account in Model.AccountScopes)
                {
                    var accountActive = Model.AccountIds.Count == 1 && Model.AccountIds[0] == account.AccountId && Model.SubProfileIds.Count == 0;
                    <section class="listings-scope__account">
                        <a class="listings-scope__account-link @(accountActive ? "is-active" : "")"
                           href="@Url.Action("Index", new { q = Model.SearchQuery, tab = Model.ActiveTab, workerId = account.WorkerId, accountId = account.AccountId, sort = Model.Sort.Column, dir = Model.Sort.Dir })">
                            <i class="fa-regular fa-user" aria-hidden="true"></i>
                            <span>@account.AccountName</span>
                        </a>
                        @if (account.SubProfiles.Count > 0)
                        {
                            <div class="listings-scope__subprofiles">
                                @foreach (var sub in account.SubProfiles)
                                {
                                    var subActive = Model.AccountIds.Contains(account.AccountId) && Model.SubProfileIds.Contains(sub.Id);
                                    <a class="listings-scope__subprofile @(subActive ? "is-active" : "")"
                                       href="@Url.Action("Index", new { q = Model.SearchQuery, tab = Model.ActiveTab, workerId = account.WorkerId, accountId = account.AccountId, subProfileId = sub.Id, sort = Model.Sort.Column, dir = Model.Sort.Dir })">
                                        <span class="listings-scope__branch" aria-hidden="true"></span>
                                        <span>@sub.Name</span>
                                    </a>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        </aside>

        <section class="listings-results" aria-label="Список объявлений">
            <div class="listings-results__bar">
                <div>
                    <strong>@pagination.TotalItems</strong>
                    <span>объявлений</span>
                </div>
                <form method="get" class="listings-sort">
                    <input type="hidden" name="q" value="@Model.SearchQuery" />
                    <input type="hidden" name="tab" value="@Model.ActiveTab" />
                    @if (Model.AccountIds.Count == 1) { <input type="hidden" name="accountId" value="@Model.AccountIds[0]" /> }
                    @if (Model.SubProfileIds.Count == 1) { <input type="hidden" name="subProfileId" value="@Model.SubProfileIds[0]" /> }
                    <label for="listingsSort">Сортировка</label>
                    <select id="listingsSort" name="sort" onchange="this.form.submit()">
                        <option value="expires" selected="@(Model.Sort.Column == "expires")">По сроку</option>
                        <option value="seen" selected="@(Model.Sort.Column == "seen")">По проверке</option>
                        <option value="title" selected="@(Model.Sort.Column == "title")">По названию</option>
                    </select>
                </form>
            </div>
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-bullhorn",
                    Title = "Объявления не найдены",
                    Description = "Измените фильтр или дождитесь проверки списка воркером.",
                    CtaLabel = "Показать активные",
                    CtaUrl = Url.Action("Index", new { tab = "active" })
                })" />
            }
            else
            {
                <div class="listings-feed" data-orbita-live-body="listings">
                    @foreach (var row in Model.Rows)
                    {
                        <article class="listing-card listing-card--@row.StateTone" data-listing-id="@row.Id">
                            <div class="listing-card__media">
                                @if (!string.IsNullOrWhiteSpace(row.ImageUrl))
                                {
                                    <img src="@row.ImageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <i class="fa-regular fa-image" aria-hidden="true"></i>
                                }
                            </div>
                            <div class="listing-card__main">
                                <div class="listing-card__heading">
                                    @if (!string.IsNullOrWhiteSpace(row.Url))
                                    {
                                        <a href="@row.Url" target="_blank" rel="noopener noreferrer">@row.Title</a>
                                    }
                                    else { <strong>@row.Title</strong> }
                                    <span class="listing-state listing-state--@row.StateTone">@row.StateLabel</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(row.Salary)) { <div class="listing-card__salary">@row.Salary</div> }
                                <div class="listing-card__geo">
                                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                    <span>@(string.Join(", ", new[] { row.City, row.AddressText, row.DistrictText }.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct()))</span>
                                </div>
                                <div class="listing-card__source">@row.AccountName <span>/</span> @row.SubProfileName <span>·</span> ID @row.AvitoItemId</div>
                                @if (!string.IsNullOrWhiteSpace(row.ErrorReason))
                                {
                                    <div class="listing-card__error"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><div><strong>Причина</strong><span>@row.ErrorReason</span></div></div>
                                }
                                @if (row.CanPublish)
                                {
                                    <div class="listing-card__renewal"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Можно продлить через воркер</div>
                                }
                            </div>
                            <div class="listing-card__aside">
                                <div class="listing-metrics">
                                    <span title="Просмотры"><i class="fa-regular fa-eye"></i><strong>@row.Views</strong></span>
                                    <span title="Контакты"><i class="fa-regular fa-user"></i><strong>@row.Contacts</strong></span>
                                    <span title="В избранном"><i class="fa-regular fa-heart"></i><strong>@row.Favorites</strong></span>
                                </div>
                                @if (row.ConversionPercent is double conversion) { <div class="listing-card__conversion">Конверсия <strong>@conversion%</strong></div> }
                                <div class="listing-card__deadline">
                                    <span>Срок размещения</span>
                                    <strong><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.ExpiresAtUtc, "datetime"))" /></strong>
                                    @if (row.RemainingDays is int remaining) { <small>Осталось @remaining дн.</small> }
                                </div>
                                <div class="listing-card__age">@(row.AgeDays is int age ? $"{age} дн. на Авито" : row.StatusText)</div>
                                <div class="listing-card__checked">Проверено <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.LastSeenAtUtc, "short"))" /></div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    <partial name="_Pagination" model="@(new PaginationPartialViewModel { Pagination = pagination, Controller = "Listings", RouteValues = listingsSortRoute })" />
</div>
@section Scripts {
    <script src="~/js/orbita-listings.js" asp-append-version="true"></script>
}
