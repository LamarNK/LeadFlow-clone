@model ResponsesIndexViewModel
@using System.Text.Json
@using Orbita.Web.Formatting
@using Orbita.Web.Services
@{
    ViewData["Title"] = "Отклики";
    var formAction = Url.Action("Index", "Responses");
    var pagination = Model.Pagination;
    var responsesSortRoute = new
    {
        from = Model.Filters.DateFrom.ToString("yyyy-MM-dd"),
        to = Model.Filters.DateTo.ToString("yyyy-MM-dd"),
        status = Model.Filters.Status,
        workerId = Model.Filters.WorkerId,
        accountId = Model.Filters.AccountId,
        bitrixDestination = Model.Filters.BitrixDestination,
        gender = Model.Filters.Gender,
        ageFrom = Model.Filters.AgeFrom,
        ageTo = Model.Filters.AgeTo,
        vacancy = Model.Filters.VacancyQuery,
        search = Model.Filters.SearchQuery,
        pageSize = pagination.PageSize,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    };
    var snapshotUrl = Url.Action("Snapshot", "Responses", new
    {
        responsesSortRoute.from,
        responsesSortRoute.to,
        responsesSortRoute.status,
        responsesSortRoute.workerId,
        responsesSortRoute.accountId,
        responsesSortRoute.bitrixDestination,
        responsesSortRoute.gender,
        responsesSortRoute.ageFrom,
        responsesSortRoute.ageTo,
        responsesSortRoute.vacancy,
        responsesSortRoute.search,
        page = pagination.Page,
        responsesSortRoute.pageSize,
        responsesSortRoute.sort,
        responsesSortRoute.dir
    })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main responses-page"
     data-orbita-live
     data-orbita-live-page="responses"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-response-detail-json-url="@Url.Action("DetailJson", "Responses", new { id = "__id__" })"
     data-responses-filter-url="@Url.Action("Index", "Responses", new { accountId = "__id__" })"
     data-send-bitrix-url="@Url.Action("Send", "Responses")"
     data-bulk-send-bitrix-url="@Url.Action("BulkSend", "Responses")"
     data-deliver-url="@Url.Action("Deliver", "Responses")"
     data-bulk-deliver-url="@Url.Action("BulkDeliver", "Responses")"
     data-deliver-options-url="@Url.Action("DeliverOptions", "Responses")"
     data-bitrix-instances-json="@JsonSerializer.Serialize(Model.SendBitrixInstances)"
     data-office-options-json="@JsonSerializer.Serialize(Model.DeliveryOffices)">
    @if (TempData["ResponsesError"] is string errorMessage)
    {
        <div class="orbita-preview-banner" role="alert">@errorMessage</div>
    }

    <div class="kpi-row responses-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatStacked, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    @{
        var responsesFilterBar = new ListFiltersBarViewModel
        {
            FormAction = formAction,
            FormClass = "orbita-filters-form responses-filters",
            SearchName = "search",
            SearchPlaceholder = "Поиск по имени, телефону, городу или объявлению...",
            SearchValue = Model.Filters.SearchQuery,
            FilterPanelId = "responsesFilterPanel",
            FilterToggleClass = "orbita-filters-toggle responses-filter-btn",
            HasActiveFilters = Model.HasActiveFilters,
            ActiveFilterCount = Model.ActiveFilterCount,
            ActiveFilterChips = Model.ActiveFilterChips,
            ResetUrl = formAction,
            FilterFieldsPartialName = "_ResponsesFilterFields",
            FilterFieldsModel = Model,
            ExtraFormContent = $"<input type=\"hidden\" name=\"from\" value=\"{Model.Filters.DateFrom:yyyy-MM-dd}\" data-period-form-from /><input type=\"hidden\" name=\"to\" value=\"{Model.Filters.DateTo:yyyy-MM-dd}\" data-period-form-to /><input type=\"hidden\" name=\"sort\" value=\"{Model.Sort.Column}\" /><input type=\"hidden\" name=\"dir\" value=\"{Model.Sort.Dir}\" />"
        };
    }
    <partial name="_ListFiltersBar" model="responsesFilterBar" />

    <div class="card card--responses-table">
        <div class="responses-bulk-bar" data-responses-bulk-bar hidden>
            <div class="responses-bulk-bar-text">
                <span class="responses-bulk-bar-label">Выбрано:</span>
                <strong data-responses-bulk-count>0</strong>
            </div>
            <div class="responses-bulk-bar-actions">
                <button type="button" class="settings-secondary-btn" data-responses-bulk-send>
                    <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    <span>Отправить</span>
                </button>
                <button type="button" class="settings-secondary-btn" data-responses-bulk-copy-cards>
                    <i class="fa-regular fa-copy" aria-hidden="true"></i>
                    <span>Копировать карточки</span>
                </button>
                <button type="button" class="settings-link-btn" data-responses-bulk-clear>Снять выделение</button>
            </div>
        </div>
        <div class="card-body card-body-table responses-table-wrap">
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-inbox",
                    Title = "Отклики не найдены",
                    Description = "Измените период или фильтры, чтобы увидеть отклики.",
                    CtaLabel = "Сбросить фильтры",
                    CtaUrl = formAction
                })" />
            }
            else
            {
            <table class="data-table data-table--responses data-table--cards">
                <colgroup>
                    <col class="responses-col--select" />
                    <col class="responses-col--collected" />
                    <col class="responses-col--collection-duration" />
                    <col class="responses-col--responded" />
                    <col class="responses-col--author" />
                    <col class="responses-col--phone" />
                    <col class="responses-col--city" />
                    <col class="responses-col--age" />
                    <col class="responses-col--gender" />
                    <col class="responses-col--vacancy" />
                    <col class="responses-col--account" />
                    <col class="responses-col--status" />
                    <col class="responses-col--bitrix" />
                    <col class="responses-col--actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="responses-select-col" scope="col">
                            <input type="checkbox"
                                   class="responses-select-checkbox"
                                   data-responses-select-all
                                   aria-label="Выбрать все на странице"
                                   title="Выбрать все на странице" />
                        </th>
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Сбор", Column = "time", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <th class="responses-collection-duration-heading" scope="col"><span class="sr-only">Время сбора</span></th>
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Отклик", Column = "responded", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Автор", Column = "author", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Телефон", Column = "phone", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Город", Column = "city", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Возраст", Column = "age", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Пол", Column = "gender", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Объявление", Column = "vacancy", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Аккаунт", Column = "account", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Статус", Column = "status", Sort = Model.Sort, Controller = "Responses", Action = "Index", RouteValues = responsesSortRoute })" />
                        <th>Битрикс</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody data-orbita-live-body="responses">
                @foreach (var row in Model.Responses)
                {
                    var workerUrl = Url.Action("Details", "Workers", new { id = row.WorkerId });
                    var accountUrl = Url.Action("Index", "Accounts", new { q = row.AccountName });
                    var phoneDisplay = ResponseDisplay.FormatPhone(row.PhoneRaw, row.PhoneNormalized);
                    var adId = ResponseDisplay.DisplayAdId(row.SourceResponseId, row.VacancyUrl);
                    var author = ResponseDisplay.DisplayAuthor(row.FullName);
                    var city = ResponseDisplay.FormatCity(row.City);
                    var collectionDuration = ResponseDisplay.FormatResponseCollectionDuration(row.CreatedAtUtc, row.CollectedAtUtc);
                    var collectionDurationTitle = collectionDuration == "—"
                        ? "Время сбора неизвестно"
                        : $"Собран через {collectionDuration} после отклика";
                    <tr class="responses-row @(row.IsHighlighted ? "responses-row--highlighted" : null)"
                        data-response-id="@row.Id"
                        data-phone="@phoneDisplay"
                        data-can-send="@(row.CanSend ? "true" : "false")"
                        data-phone-hidden="@(row.IsPhoneHidden ? "true" : "false")"
                        data-highlighted="@(row.IsHighlighted ? "true" : "false")"
                        data-highlight-label="@row.HighlightLabel"
                        data-response-card="@ResponseDisplay.HtmlAttributeValue(row.CardCopy)"
                        data-detail-json-url="@Url.Action("DetailJson", "Responses", new { id = row.Id })">
                        <td class="responses-select-col" data-label="">
                            <input type="checkbox"
                                   class="responses-select-checkbox"
                                   data-response-select
                                   value="@row.Id"
                                   aria-label="Выбрать отклик" />
                        </td>
                        <td class="responses-time" data-label="Сбор"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.CollectedAtUtc, "datetime"))" /></td>
                        <td class="responses-collection-duration" data-label="Время сбора">
                            <div class="responses-collection-timeline" title="@collectionDurationTitle">
                                <span class="responses-collection-duration-label">@collectionDuration</span>
                                <span class="responses-collection-duration-track" aria-hidden="true">
                                    <span class="responses-collection-duration-dot"></span>
                                    <span class="responses-collection-duration-line"></span>
                                    <span class="responses-collection-duration-dot"></span>
                                </span>
                            </div>
                        </td>
                        <td class="responses-time responses-time--responded" data-label="Отклик"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.CreatedAtUtc, "datetime"))" /></td>
                        <td class="responses-author" data-label="Автор"><span class="responses-cell-clamp" title="@author">@author</span></td>
                        <td class="responses-phone" data-label="Телефон">
                            @if (row.IsPhoneHidden)
                            {
                                <span class="responses-phone-hidden">Скрыт</span>
                            }
                            else
                            {
                                <span>@phoneDisplay</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.PhoneMetricLabel))
                            {
                                var phoneMetricTone = row.PhoneMetricKind == ResponsePhoneMetricKinds.PhoneChanged
                                    ? "responses-phone-metric--changed"
                                    : "responses-phone-metric--unchanged";
                                var phoneMetricText = row.PhoneMetricKind == ResponsePhoneMetricKinds.PhoneChanged &&
                                    !string.IsNullOrWhiteSpace(row.PreviousPhoneNormalized)
                                    ? $"Был: {ResponseDisplay.FormatPhone(row.PreviousPhoneRaw, row.PreviousPhoneNormalized)}"
                                    : row.PhoneMetricLabel;
                                <span class="responses-phone-metric @phoneMetricTone" title="@row.PhoneMetricLabel">@phoneMetricText</span>
                            }
                        </td>
                        <td class="responses-city" data-label="Город"><span class="responses-cell-clamp" title="@city">@city</span></td>
                        <td class="responses-age" data-label="Возраст">
                            @ResponseDisplay.FormatAge(row.Age)
                            @if (row.IsHighlighted && !string.IsNullOrWhiteSpace(row.HighlightLabel))
                            {
                                <span class="responses-age-highlight-badge">@row.HighlightLabel</span>
                            }
                        </td>
                        <td class="responses-gender" data-label="Пол">@CandidateGenders.FormatLabel(row.Gender)</td>
                        <td class="responses-ad" data-label="Объявление">
                            @if (!string.IsNullOrWhiteSpace(row.VacancyUrl))
                            {
                                <a class="responses-ad-link" href="@row.VacancyUrl" target="_blank" rel="noopener" title="@row.Vacancy">@row.Vacancy</a>
                            }
                            else
                            {
                                <span class="responses-ad-link" title="@row.Vacancy">@row.Vacancy</span>
                            }
                            <span class="responses-ad-id">ID: @adId</span>
                        </td>
                        <td class="cell-link responses-account" data-label="Аккаунт">
                            <a href="@accountUrl" title="@row.AccountName">@row.AccountName</a>
                            @if (!string.IsNullOrWhiteSpace(row.AvitoSubProfileName))
                            {
                                <span class="responses-account-sub" title="Субпрофиль Avito">@row.AvitoSubProfileName</span>
                            }
                        </td>
                        <td data-label="Статус">
                            <span class="response-status-badge response-status-badge--@row.StatusTone">@row.StatusLabel</span>
                        </td>
                        <td class="responses-bitrix" data-label="Битрикс">
                            @if (row.BitrixDeliveries.Count > 0)
                            {
                                <partial name="_ResponseBitrixDeliveries" model="row.BitrixDeliveries" />
                            }
                            else if (!string.IsNullOrWhiteSpace(row.BitrixLabel))
                            {
                                <span class="responses-bitrix-label">@row.BitrixLabel</span>
                            }
                            else
                            {
                                <span class="responses-bitrix-empty">—</span>
                            }
                        </td>
                        <td class="data-table-menu" data-label="">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn responses-row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown row-menu-dropdown--responses" hidden>
                                    <button type="button" class="row-menu-item" data-orbita-response-open data-response-id="@row.Id">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Просмотреть отклик
                                    </button>
                                    @if (!string.IsNullOrWhiteSpace(row.VacancyUrl))
                                    {
                                        <a class="row-menu-item" href="@row.VacancyUrl" target="_blank" rel="noopener">
                                            <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                                            Открыть объявление
                                        </a>
                                    }
                                    <a class="row-menu-item" href="@accountUrl">
                                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                                        Перейти к аккаунту
                                    </a>
                                    <a class="row-menu-item" href="@workerUrl">
                                        <i class="fa-solid fa-server" aria-hidden="true"></i>
                                        Перейти к воркеру
                                    </a>
                                    <button type="button" class="row-menu-item" data-copy-response-card>
                                        <i class="fa-regular fa-copy" aria-hidden="true"></i>
                                        Копировать карточку
                                    </button>
                                    @if (row.CanSend)
                                    {
                                        <button type="button" class="row-menu-item" data-send-bitrix data-response-id="@row.Id">
                                            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                                            Отправить
                                        </button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.BitrixEntityUrl))
                                    {
                                        <a class="row-menu-item" href="@row.BitrixEntityUrl" target="_blank" rel="noopener">
                                            <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                                            Открыть карточку Bitrix24
                                        </a>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = pagination,
                Controller = "Responses",
                Action = "Index",
                RouteValues = responsesSortRoute
            })" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/orbita-responses.js" asp-append-version="true"></script>
}
