@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Панель управления";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var chartsJson = JsonSerializer.Serialize(Model.Charts, jsonOptions);
    var pagination = Model.Pagination;
    var fromIso = Model.Header.DateFrom.ToString("yyyy-MM-dd");
    var toIso = Model.Header.DateTo.ToString("yyyy-MM-dd");
    var dashboardRoute = new
    {
        from = fromIso,
        to = toIso,
        tz = Model.TimeZoneOffsetMinutes,
        pageSize = pagination.PageSize,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    };
    var liveBootstrapJson = JsonSerializer.Serialize(new DashboardLiveSnapshotViewModel
    {
        UpdatedAtUtc = Model.Header.UpdatedAtUtc,
        KpiCards = Model.KpiCards,
        Workers = Model.Workers,
        Events = Model.Events,
        AccountStats = Model.AccountStats,
        Charts = Model.Charts,
        EnabledWorkersCount = Model.EnabledWorkersCount,
        DisabledWorkersCount = Model.DisabledWorkersCount,
        ShowWorkersMonitoringControls = Model.ShowWorkersMonitoringControls,
        Pagination = pagination,
        Sort = Model.Sort
    }, jsonOptions);
    var snapshotUrl = Url.Action("Snapshot", "Dashboard", new
    {
        from = fromIso,
        to = toIso,
        tz = Model.TimeZoneOffsetMinutes,
        page = pagination.Page,
        pageSize = pagination.PageSize,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main"
     data-orbita-live
     data-orbita-live-page="dashboard"
     data-dashboard-live
     data-orbita-snapshot="@snapshotUrl"
     data-dashboard-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-show-office-column="@(Model.ShowOfficeColumn ? "true" : "false")"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-settings-logs-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = "__id__" })"
     data-dashboard-enable-all-url="@Url.Action("EnableAllWorkers", "Dashboard")"
     data-dashboard-disable-all-url="@Url.Action("DisableAllWorkers", "Dashboard")"
     data-dashboard-enable-worker-url="@Url.Action("EnableWorker", "Dashboard")"
     data-dashboard-disable-worker-url="@Url.Action("DisableWorker", "Dashboard")">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="error-text">@Model.ErrorMessage</p>
    }
    else
    {
        <div class="kpi-row">
            @{ var sparkIdx = 0; }
            @foreach (var kpi in Model.KpiCards)
            {
                <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = sparkIdx, Layout = KpiCardLayout.Dashboard })" />
                sparkIdx++;
            }
        </div>

        <div class="dashboard-stack">
            <div class="card card--chart-hourly">
                <div class="card-header">
                    <h2>Отклики по времени</h2>
                    <span class="chart-period-label" title="Период задаётся в шапке страницы">@Model.Header.DateRangeLabel</span>
                </div>
                <div class="card-body">
                    <div class="chart-canvas-wrap chart-canvas-wrap--hourly">
                        <canvas id="chart-hourly-responses" aria-label="Отклики по времени"></canvas>
                    </div>
                </div>
            </div>
            <div class="card card--dashboard-workers">
                <div class="card-header">
                    <h2>Воркеры</h2>
                    @if (Model.ShowWorkersMonitoringControls)
                    {
                        // Все включены → только «Остановить»; иначе обе кнопки.
                        var allWorkersEnabled = Model.DisabledWorkersCount == 0 && Model.EnabledWorkersCount > 0;
                        <div class="dashboard-workers-actions" data-dashboard-monitoring-controls>
                            <button type="button"
                                    class="dashboard-monitoring-btn dashboard-monitoring-btn--start"
                                    data-dashboard-enable-all
                                    title="Возобновить мониторинг на всех воркерах"
                                    @(allWorkersEnabled ? "hidden" : null)
                                    @(Model.DisabledWorkersCount == 0 ? "disabled" : null)>
                                <i class="fa-solid fa-circle-play" aria-hidden="true"></i>
                                <span>Возобновить</span>
                            </button>
                            <button type="button"
                                    class="dashboard-monitoring-btn dashboard-monitoring-btn--stop"
                                    data-dashboard-disable-all
                                    title="Пауза мониторинга на всех воркерах"
                                    @(Model.EnabledWorkersCount == 0 ? "disabled" : null)>
                                <i class="fa-solid fa-circle-pause" aria-hidden="true"></i>
                                <span>Пауза</span>
                            </button>
                        </div>
                    }
                </div>
                <div class="card-body dashboard-workers-table-wrap">
                    <div class="dashboard-workers-empty" data-dashboard-workers-empty @(pagination.TotalItems == 0 ? null : "hidden")>
                        <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                        {
                            IconClass = "fa-solid fa-server",
                            Title = "Воркеры не найдены",
                            Description = "Добавьте первый воркер или дождитесь подключения агента.",
                            CtaLabel = "Все воркеры",
                            CtaUrl = Url.Action("Index", "Workers")
                        })" />
                    </div>
                    <div class="dashboard-workers-table-panel" data-dashboard-workers-table @(pagination.TotalItems == 0 ? "hidden" : null)>
                    <div class="dashboard-workers-table-scroll">
                    <table class="data-table data-table--cards data-table--dashboard-workers">
                        <thead>
                            <tr>
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Воркер", Column = "name", Sort = Model.Sort, Controller = "Dashboard", Action = "Index", RouteValues = dashboardRoute })" />
                                @if (Model.ShowOfficeColumn)
                                {
                                    <th>Офис</th>
                                }
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Статус", Column = "status", Sort = Model.Sort, Controller = "Dashboard", Action = "Index", RouteValues = dashboardRoute })" />
                                <th>Сейчас</th>
                                <th class="cell-num" title="Аккаунтов">Акк.</th>
                                <th class="cell-num" title="Откликов">Откл.</th>
                                <th class="cell-num" title="Дублей">Дубл.</th>
                                <th class="cell-num" title="Ошибок">Ошиб.</th>
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Активность", Column = "activity", Sort = Model.Sort, Controller = "Dashboard", Action = "Index", RouteValues = dashboardRoute })" />
                                <th class="dashboard-worker-toggle-th" aria-label="Управление"></th>
                                <th aria-hidden="true"></th>
                            </tr>
                        </thead>
                        <tbody data-dashboard-workers-body>
                        @foreach (var w in Model.Workers)
                        {
                            var workerDetailsUrl = Url.Action("Details", "Workers", new { id = w.Id });
                            <tr data-href="@workerDetailsUrl">
                                <td class="cell-name" data-label="Воркер">
                                    <partial name="_WorkerNameCell" model="@(new WorkerNameCellViewModel { DisplayName = w.DisplayName, MachineName = w.MachineName, Url = workerDetailsUrl })" />
                                    @if (w.IsMonitoringPaused)
                                    {
                                        <span class="workers-status-badge workers-status-badge--paused">Пауза мониторинга</span>
                                    }
                                </td>
                                @if (Model.ShowOfficeColumn)
                                {
                                    <td data-label="Офис">@w.OfficeName</td>
                                }
                                <td data-label="Статус">
                                    @{
                                        var statusClass = !w.IsEnabled ? " offline" : (w.IsOnline ? "" : " offline");
                                        var statusText = !w.IsEnabled ? "Отключён" : (w.IsOnline ? "Онлайн" : "Оффлайн");
                                    }
                                    <span class="status-dot@statusClass">
                                        <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                                        @statusText
                                    </span>
                                </td>
                                <td data-label="Сейчас">
                                    <partial name="_WorkerActivityPillFromRow" model="@(w.CurrentActivityLabel, w.CurrentActivityTone, w.IsActivityLive)" />
                                </td>
                                <td class="cell-num" data-label="Аккаунтов">@w.ActiveAccounts / @w.TotalAccounts</td>
                                <td class="cell-num" data-label="Откликов">@w.Responses</td>
                                <td class="cell-num" data-label="Дублей">@w.Duplicates</td>
                                <td class="cell-num" data-label="Ошибок">@w.Errors</td>
                                <td data-label="Последняя активность"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(w.LastActivityUtc, "activity"))" /></td>
                                <td class="dashboard-worker-toggle" data-label="">
                                    @if (!w.IsMonitoringPaused)
                                    {
                                        <button type="button"
                                                class="dashboard-worker-toggle-btn dashboard-worker-toggle-btn--pause"
                                                data-dashboard-disable-worker
                                                data-worker-id="@w.Id"
                                                title="Пауза мониторинга"
                                                aria-label="Пауза мониторинга @w.DisplayName">
                                            <i class="fa-solid fa-circle-pause" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="dashboard-worker-toggle-btn dashboard-worker-toggle-btn--play"
                                                data-dashboard-enable-worker
                                                data-worker-id="@w.Id"
                                                title="Возобновить мониторинг"
                                                aria-label="Возобновить мониторинг @w.DisplayName">
                                            <i class="fa-solid fa-circle-play" aria-hidden="true"></i>
                                        </button>
                                    }
                                </td>
                                <td class="data-table-menu" data-label="">
                                    <div class="row-menu" data-row-menu>
                                        <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                        </button>
                                        <div class="row-menu-dropdown" hidden>
                                            <a class="row-menu-item" href="@workerDetailsUrl">Открыть</a>
                                            <button type="button" class="row-menu-item" data-worker-restart data-worker-id="@w.Id">Перезапустить</button>
                                            <a class="row-menu-item" href="@Url.Action("Index", "Settings", new { tab = "logs", workerId = w.Id })">Просмотреть логи</a>
                                            <a class="row-menu-item" href="@(workerDetailsUrl)#worker-settings">Настройки</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    </div>
                    <div class="dashboard-workers-footer">
                        <form method="get"
                              action="@Url.Action("Index", "Dashboard")"
                              class="dashboard-workers-page-size"
                              data-orbita-page-size-form>
                            <input type="hidden" name="from" value="@fromIso" />
                            <input type="hidden" name="to" value="@toIso" />
                            <input type="hidden" name="tz" value="@Model.TimeZoneOffsetMinutes" />
                            <input type="hidden" name="sort" value="@Model.Sort.Column" />
                            <input type="hidden" name="dir" value="@Model.Sort.Dir" />
                            <partial name="_PageSizeFilterField" model="pagination.PageSize" />
                        </form>
                        <partial name="_Pagination" model="@(new PaginationPartialViewModel
                        {
                            Pagination = pagination,
                            Controller = "Dashboard",
                            Action = "Index",
                            RouteValues = dashboardRoute,
                            ExtraClass = "dashboard-workers-pagination"
                        })" />
                    </div>
                    <a class="card-footer-btn" href="@Url.Action("Index", "Workers")">Показать все воркеры</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-grid-bottom">
            <div class="card card--dashboard-events">
                <div class="card-header">
                    <h2>Последние события</h2>
                </div>
                <div class="card-body">
                    <div data-dashboard-events>
                        @if (Model.Events.Count == 0)
                        {
                            <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                            {
                                IconClass = "fa-regular fa-clipboard",
                                Title = "Событий пока нет",
                                Description = "Здесь появятся последние события с воркеров.",
                                CtaLabel = "Все события",
                                CtaUrl = Url.Action("Index", "Events")
                            })" />
                        }
                        else
                        {
                            <partial name="_DashboardEventList" model="Model.Events" />
                        }
                    </div>
                    <a class="card-footer-btn" href="@Url.Action("Index", "Events")">Показать все события</a>
                </div>
            </div>
            <div class="card card--account-stats">
                <div class="card-header">
                    <h2>Состояние аккаунтов</h2>
                </div>
                @{
                    var stats = Model.AccountStats;
                    var total = Math.Max(1, stats.Total);
                }
                <div class="account-stats-widget" data-dashboard-account-stats>
                    <div class="account-stats-chart">
                        <div class="account-stats-donut">
                            <div class="chart-canvas-wrap chart-canvas-wrap--account-donut">
                                <canvas id="chart-account-status" aria-label="Состояние аккаунтов"></canvas>
                            </div>
                            <div class="account-stats-center">
                                <span class="account-stats-total-num" data-account-stat="total">@stats.Total</span>
                                <span class="account-stats-total-lbl">Всего</span>
                            </div>
                        </div>
                    </div>
                    <div class="account-stats-legend">
                        <div class="account-stats-list">
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#22c55e"></span>
                                    Активны
                                </span>
                                <span class="account-stats-value" data-account-stat="active">@stats.Active (@FmtPct(stats.Active, total))</span>
                            </div>
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#94a3b8"></span>
                                    Неактивны
                                </span>
                                <span class="account-stats-value" data-account-stat="inactive">@stats.Inactive (@FmtPct(stats.Inactive, total))</span>
                            </div>
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#f59e0b"></span>
                                    <a class="account-stats-link" href="@Url.Action("Index", "Accounts", new { tab = "errors" })">Ошибки</a>
                                </span>
                                <span class="account-stats-value" data-account-stat="errors">
                                    <a class="account-stats-link" href="@Url.Action("Index", "Accounts", new { tab = "errors" })">@stats.Errors (@FmtPct(stats.Errors, total))</a>
                                </span>
                            </div>
                        </div>
                        <div class="account-stats-footer">
                            <div class="account-stats-row account-stats-row--summary">
                                <span class="account-stats-summary-label">Всего</span>
                                <span class="account-stats-summary-value" data-account-stat="total-summary">@stats.Total</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script id="dashboard-charts-data" type="application/json">@Html.Raw(chartsJson)</script>
        <script id="dashboard-live-bootstrap" type="application/json">@Html.Raw(liveBootstrapJson)</script>
    }
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/orbita-dashboard.js" asp-append-version="true"></script>
}

@functions {
    private static string FmtPct(int value, int total) => $"{value * 100 / total}%";
}
