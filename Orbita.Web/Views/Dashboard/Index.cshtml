@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Панель управления";
    var chartsJson = JsonSerializer.Serialize(Model.Charts, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <p class="error-text">@Model.ErrorMessage</p>
    }
    else
    {
        <div class="kpi-row">
            @{ var sparkIdx = 0; }
            @foreach (var kpi in Model.KpiCards)
            {
                <article class="kpi-card" style="--kpi-index: @sparkIdx">
                    <header class="kpi-card-head">
                        <div class="kpi-icon-box kpi-icon-box--@kpi.IconTone">
                            <i class="@kpi.IconClass" aria-hidden="true"></i>
                        </div>
                        <span class="kpi-card-label">@kpi.Label</span>
                    </header>
                    <div class="kpi-card-metric">
                        <span class="kpi-value"
                              data-kpi-count="@kpi.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              data-kpi-suffix="@(kpi.ValueSuffix ?? "")">0@(kpi.ValueSuffix)</span>
                        <span class="kpi-delta-pill kpi-delta-@kpi.DeltaTone">@kpi.Delta</span>
                    </div>
                    <div class="kpi-sparkline-wrap">
                        <canvas data-sparkline-index="@sparkIdx" aria-hidden="true"></canvas>
                    </div>
                </article>
                sparkIdx++;
            }
        </div>

        <div class="dashboard-grid">
            <div class="card card--dashboard-workers">
                <div class="card-header">
                    <h2>Воркеры</h2>
                </div>
                <div class="card-body">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Воркер</th>
                                <th>Статус</th>
                                <th>Аккаунтов</th>
                                <th>Откликов</th>
                                <th>Дублей</th>
                                <th>Ошибок</th>
                                <th>Последняя активность</th>
                                <th aria-hidden="true"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var w in Model.Workers)
                        {
                            <tr>
                                <td class="cell-name"><a href="@Url.Action("Details", "Workers", new { id = w.Id })">@w.DisplayName</a></td>
                                <td>
                                    <span class="status-dot @(w.IsOnline ? "" : "offline")">
                                        <i class="fa-solid fa-circle status-dot-icon" aria-hidden="true"></i>
                                        @(w.IsOnline ? "Онлайн" : "Оффлайн")
                                    </span>
                                </td>
                                <td>@w.ActiveAccounts / @w.TotalAccounts</td>
                                <td>@w.Responses</td>
                                <td>@w.Duplicates</td>
                                <td>@w.Errors</td>
                                <td><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(w.LastActivityUtc, "time"))" /></td>
                                <td class="data-table-menu">
                                    <button type="button" class="row-menu-btn" aria-label="Действия">
                                        <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <a class="card-footer-btn" href="@Url.Action("Index", "Workers")">Показать все воркеры</a>
                </div>
            </div>
            <div class="card card--chart-hourly">
                <div class="card-header">
                    <h2>Отклики по времени</h2>
                    <div class="chart-period-select-wrap">
                        <select class="chart-period-select" aria-label="Период">
                            <option>Сегодня</option>
                        </select>
                        <i class="fa-solid fa-chevron-down chart-period-caret" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-canvas-wrap chart-canvas-wrap--hourly">
                        <canvas id="chart-hourly-responses" aria-label="Отклики по времени"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="dashboard-grid-bottom">
            <div class="card card--dashboard-events">
                <div class="card-header">
                    <h2>Последние события</h2>
                </div>
                <div class="card-body">
                    <partial name="_DashboardEventList" model="Model.Events" />
                    <a class="card-footer-btn" href="@Url.Action("Index", "Events")">Показать все события</a>
                </div>
            </div>
            <div class="card card--account-stats">
                <div class="card-header">
                    <h2>Состояние аккаунтов</h2>
                </div>
                @{
                    var stats = Model.AccountStats;
                    var total = Math.Max(1, stats.Total);
                }
                <div class="account-stats-widget">
                    <div class="account-stats-chart">
                        <div class="account-stats-donut">
                            <div class="chart-canvas-wrap chart-canvas-wrap--account-donut">
                                <canvas id="chart-account-status" aria-label="Состояние аккаунтов"></canvas>
                            </div>
                            <div class="account-stats-center">
                                <span class="account-stats-total-num">@stats.Total</span>
                                <span class="account-stats-total-lbl">Всего</span>
                            </div>
                        </div>
                    </div>
                    <div class="account-stats-legend">
                        <div class="account-stats-list">
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#22c55e"></span>
                                    Активны
                                </span>
                                <span class="account-stats-value">@stats.Active (@FmtPct(stats.Active, total))</span>
                            </div>
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#94a3b8"></span>
                                    Неактивны
                                </span>
                                <span class="account-stats-value">@stats.Inactive (@FmtPct(stats.Inactive, total))</span>
                            </div>
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#ef4444"></span>
                                    Заблокированы
                                </span>
                                <span class="account-stats-value">@stats.Blocked (@FmtPct(stats.Blocked, total))</span>
                            </div>
                            <div class="account-stats-row">
                                <span class="account-stats-label">
                                    <span class="account-stats-dot" style="background:#f59e0b"></span>
                                    Ошибки
                                </span>
                                <span class="account-stats-value">@stats.Errors (@FmtPct(stats.Errors, total))</span>
                            </div>
                        </div>
                        <div class="account-stats-footer">
                            <div class="account-stats-row account-stats-row--summary">
                                <span class="account-stats-summary-label">Всего</span>
                                <span class="account-stats-summary-value">@stats.Total</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script id="dashboard-charts-data" type="application/json">@Html.Raw(chartsJson)</script>
    }
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/orbita-dashboard.js" asp-append-version="true"></script>
}

@functions {
    private static string FmtPct(int value, int total) => $"{value * 100 / total}%";
}