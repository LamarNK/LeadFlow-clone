@model LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Вход";
    // Trace the planet limb in the 1536 × 1024 background image's coordinates.
    const string sculptedEdge = "M1156 0V300Q1156 314 1149 329C1118 389 1104 448 1104 520C1104 587 1121 650 1155 711Q1164 728 1164 747V1024";
}
<!DOCTYPE html>
<html lang="ru" class="auth-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Орбита — Вход</title>
    <link rel="icon" type="image/png" sizes="48x48" href="~/images/favicon-48x48.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" sizes="any" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
<div class="auth-bg" aria-hidden="true">
    <img class="auth-bg-img" src="~/images/auth-bg.jpg" alt="" asp-append-version="true" />
</div>
<div class="auth-page">
    <main class="auth-card" aria-labelledby="auth-heading">
        <svg class="auth-sculpted-edge" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            <defs>
                <clipPath id="auth-main-sculpted-clip" clipPathUnits="objectBoundingBox">
                    <path d="@(sculptedEdge + "H-4096V0Z")" transform="matrix(.000617825 0 0 .0009765625 .0510204 0)" />
                </clipPath>
            </defs>
            <path class="auth-sculpted-edge__glow" d="@sculptedEdge" transform="matrix(.617825 0 0 .9765625 51.0204 0)" fill="none" />
        </svg>
        <section class="auth-main">
        <header class="auth-brand">
            <img class="auth-logo" src="~/images/logo.png" alt="" asp-append-version="true" />
            <div class="auth-brand-text">
                <p class="auth-title">Орбита</p>
                <p class="auth-subtitle">Панель управления</p>
            </div>
        </header>
        <p class="auth-mantra" aria-hidden="true">Ближе<br />к большему<span></span></p>

        <div class="auth-intro">
            <h1 id="auth-heading">С <span>возвращением</span></h1>
            <p>Войдите, чтобы продолжить работу<br class="auth-copy-break" /> в вашей вселенной.</p>
        </div>

        <form class="auth-form" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="auth-error-block">@Model.ErrorMessage</div>
            }
            else if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="auth-error-block" asp-validation-summary="All"></div>
            }

            <div class="auth-field">
                <label class="visually-hidden" for="Email">Email</label>
                <div class="auth-input-wrap auth-input-wrap--email">
                    <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                    <input asp-for="Email"
                           id="Email"
                           class="auth-input"
                           type="email"
                           autocomplete="username"
                           placeholder="Введите email" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label class="visually-hidden" for="passwordInput">Пароль</label>
                <div class="auth-input-wrap auth-input-wrap--password">
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                    <input asp-for="Password"
                           id="passwordInput"
                           class="auth-input"
                           type="password"
                           autocomplete="current-password"
                           placeholder="Введите пароль" />
                    <button type="button"
                            class="auth-toggle-pwd"
                            data-toggle-password="passwordInput"
                            aria-label="Показать пароль">
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>

            <button class="auth-submit" type="submit">
                <span>Войти</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
        </form>

        <p class="auth-footer">Технологии, которые движут дальше <span>•</span> Орбита</p>
        </section>

        <aside class="auth-visual" aria-hidden="true">
            <p>Управляй<br />сегодня.<br />Создавай<br />завтра.</p>
            <span></span>
        </aside>
    </main>
</div>
<script src="~/js/auth.js" asp-append-version="true"></script>
</body>
</html>
