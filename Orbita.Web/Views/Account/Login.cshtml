@model LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Вход";
}
<!DOCTYPE html>
<html lang="ru" class="auth-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Орбита — Вход</title>
    <link rel="icon" type="image/png" sizes="48x48" href="~/images/favicon-48x48.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" sizes="any" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
<div class="auth-bg" aria-hidden="true">
    <img class="auth-bg-img" src="~/images/auth-bg.jpg" alt="" asp-append-version="true" />
    <canvas class="auth-dots" id="authDots"></canvas>
</div>
<div class="auth-page">
    <div class="auth-card">
        <header class="auth-brand">
            <img class="auth-logo" src="~/images/logo.png" alt="" asp-append-version="true" />
            <div class="auth-brand-text">
                <h1 class="auth-title">Орбита</h1>
                <p class="auth-subtitle">Панель управления</p>
            </div>
        </header>

        <form class="auth-form" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="auth-error-block">@Model.ErrorMessage</div>
            }
            else if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="auth-error-block" asp-validation-summary="All"></div>
            }

            <div class="auth-field">
                <label for="Email">Email</label>
                <div class="auth-input-wrap">
                    <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                    <input asp-for="Email"
                           id="Email"
                           class="auth-input"
                           type="email"
                           autocomplete="username"
                           placeholder="Введите email" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label for="passwordInput">Пароль</label>
                <div class="auth-input-wrap auth-input-wrap--password">
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                    <input asp-for="Password"
                           id="passwordInput"
                           class="auth-input"
                           type="password"
                           autocomplete="current-password"
                           placeholder="Введите пароль" />
                    <button type="button"
                            class="auth-toggle-pwd"
                            data-toggle-password="passwordInput"
                            aria-label="Показать пароль">
                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>

            <div class="auth-row">
                <span class="auth-remember auth-remember--muted">Сессия сохраняется 14 дней</span>
                <span class="auth-forgot auth-forgot--muted">Забыли пароль?</span>
            </div>

            <button class="auth-submit" type="submit">Войти</button>
        </form>

        @if (Model.DesignPreviewEnabled)
        {
            <p class="auth-preview-hint">Режим просмотра дизайна — PostgreSQL и API не нужны. Пароль: <strong>OrbitaAdmin1!</strong></p>
        }

        <div class="auth-divider"><span>или</span></div>

        <p class="auth-footer">
            Нет аккаунта? Обратитесь к администратору.
        </p>
    </div>
</div>
<script src="~/js/orbita/layout.js" asp-append-version="true"></script>
<script src="~/js/orbita/sidebar.js" asp-append-version="true"></script>
<script src="~/js/orbita/feedback.js" asp-append-version="true"></script>
<script src="~/js/orbita/workers.js" asp-append-version="true"></script>
<script src="~/js/orbita/filters.js" asp-append-version="true"></script>
<script src="~/js/orbita/detail-modal.js" asp-append-version="true"></script>
<script src="~/js/orbita/navigation.js" asp-append-version="true"></script>
<script src="~/js/orbita/entry.js" asp-append-version="true"></script>
<script src="~/js/auth-dots.js" asp-append-version="true"></script>
</body>
</html>
