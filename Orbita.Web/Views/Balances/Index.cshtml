@model BalancesIndexViewModel
@using Orbita.Contracts
@{
    ViewData["Title"] = "Балансы";
    var activeTab = (string?)ViewData["BalancesTab"] ?? "low";
    var query = (string?)ViewData["BalancesQuery"];
    var excludedWorkerIds = Model.ExcludedWorkerIds;
    var pagination = Model.Pagination;
    var balancesFormAction = Url.Action("Index", "Balances");
    var isHistoryTab = activeTab == "history";
    var isRequestedTopUpsTab = activeTab == "requested";

    string BalancesUrl(string tab, bool history = false, int? page = null, bool includeQuery = true)
    {
        var url = Url.Action("Index", "Balances", new
        {
            tab,
            q = includeQuery ? query : null,
            history,
            page
        })!;

        foreach (var workerId in excludedWorkerIds)
        {
            url += $"{(url.Contains('?') ? '&' : '?')}excludedWorkerIds={Uri.EscapeDataString(workerId.ToString())}";
        }

        return url;
    }

    var statusLabel = (string status) => status switch
    {
        TopUpSessionStatuses.Requested => "В очереди",
        TopUpSessionStatuses.Started => "В работе",
        TopUpSessionStatuses.PaymentClaimed => "В работе",
        TopUpSessionStatuses.QrReady => "QR готов",
        TopUpSessionStatuses.AwaitingBalance => "Проверка оплаты",
        TopUpSessionStatuses.Completed => "Подтверждено",
        TopUpSessionStatuses.VerificationRequired => "Проверка оплаты",
        TopUpSessionStatuses.Failed => "Ошибка",
        TopUpSessionStatuses.Expired => "Истекло",
        TopUpSessionStatuses.Cancelled => "Отменено",
        _ => status
    };
}
<partial name="_PageHeader" model="Model.Header" />
<main class="orbita-main balances-page"
      data-balances-page
      data-balances-tab="@activeTab"
      data-snapshot-url="@Url.Action("Snapshot", "Balances")@Context.Request.QueryString"
      data-mark-paid-url="@Url.Action("MarkPaid", "Balances")"
      data-cancel-url="@Url.Action("Cancel", "Balances")"
      data-batch-url="@Url.Action("CreateBatch", "Balances")">
    <div class="kpi-row balances-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <nav class="balances-tabs" aria-label="Фильтр балансов">
        <a class="balances-tab @(activeTab == "low" ? "balances-tab--active" : "")" href="@BalancesUrl("low", page: 1)" aria-current="@(activeTab == "low" ? "page" : null)">Требуют пополнения</a>
        <a class="balances-tab @(activeTab == "queue" ? "balances-tab--active" : "")" href="@BalancesUrl("queue", page: 1)" aria-current="@(activeTab == "queue" ? "page" : null)">В очереди</a>
        <a class="balances-tab @(activeTab == "working" ? "balances-tab--active" : "")" href="@BalancesUrl("working", page: 1)" aria-current="@(activeTab == "working" ? "page" : null)">В работе</a>
        <a class="balances-tab @(activeTab == "awaiting" ? "balances-tab--active" : "")" href="@BalancesUrl("awaiting", page: 1)" aria-current="@(activeTab == "awaiting" ? "page" : null)">Проверка оплаты</a>
        <a class="balances-tab @(isRequestedTopUpsTab ? "balances-tab--active" : "")" href="@BalancesUrl("requested", page: 1)" aria-current="@(isRequestedTopUpsTab ? "page" : null)">Запрошенные пополнения</a>
        <a class="balances-tab @(isHistoryTab ? "balances-tab--active" : "")" href="@BalancesUrl("history", true, 1)" aria-current="@(isHistoryTab ? "page" : null)">История</a>
    </nav>

    @{
        var balancesFilterBar = new ListFiltersBarViewModel
        {
            FormAction = balancesFormAction!,
            FormClass = "orbita-filters-form balances-filters",
            SearchName = "q",
            SearchPlaceholder = "Поиск по аккаунту, субпрофилю или воркеру",
            SearchValue = query,
            FilterPanelId = "balancesFilterPanel",
            FilterToggleClass = "orbita-filters-toggle balances-filter-btn",
            HasActiveFilters = excludedWorkerIds.Count > 0,
            ActiveFilterCount = excludedWorkerIds.Count,
            ResetUrl = Url.Action("Index", "Balances", new { tab = activeTab, history = isHistoryTab })!,
            FilterFieldsPartialName = "_BalancesFilterFields",
            FilterFieldsModel = Model,
            ExtraFormContent = $"<input type=\"hidden\" name=\"tab\" value=\"{activeTab}\" /><input type=\"hidden\" name=\"history\" value=\"{(isHistoryTab ? "true" : "false")}\" />"
        };
    }
    <partial name="_ListFiltersBar" model="balancesFilterBar" />

    @if (!isHistoryTab && !isRequestedTopUpsTab)
    {
        <div class="balances-bulkbar" data-balances-bulkbar>
            <label><input type="checkbox" data-balances-select-all /> Выбрать доступные (@Model.SelectableCount)</label>
            <span data-balances-selected>0 выбрано</span>
            <button type="button" class="balances-primary" data-balances-batch disabled>Запросить пополнение</button>
        </div>
    }

    @if (!isRequestedTopUpsTab)
    {
    <div class="card card--balances-table">
        <div class="card-body card-body-table balances-table-wrap">
            @if ((isHistoryTab && Model.Sessions.Count == 0) || (!isHistoryTab && Model.Rows.Count == 0))
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-wallet",
                    Title = "Нет записей",
                    Description = isHistoryTab ? "История пополнений пуста." : "Нет субпрофилей, соответствующих текущему фильтру.",
                    CtaLabel = "Показать все",
                    CtaUrl = BalancesUrl("all", includeQuery: false)
                })" />
            }
            else if (isHistoryTab)
            {
                <table class="data-table data-table--cards balances-table balances-table--history">
                    <thead><tr><th>Дата</th><th>Где</th><th>Баланс до</th><th>Сумма</th><th>Баланс после</th><th>Статус</th><th>Оператор</th></tr></thead>
                    <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        var workerUrl = Url.Action("Details", "Workers", new { id = session.WorkerId });
                        var accountUrl = Url.Action("Index", "Accounts", new { q = session.AccountName });
                        <tr>
                            <td data-label="Дата"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(session.CompletedAtUtc ?? session.CreatedAtUtc, "datetime"))" /></td>
                            <td data-label="Где" class="balance-location">
                                <div class="balance-location__primary">
                                    <a href="@workerUrl">@session.WorkerName</a>
                                    <span aria-hidden="true">/</span>
                                    <a href="@accountUrl">@session.AccountName</a>
                                </div>
                                <div class="balance-location__subprofile">@session.SubProfileName</div>
                            </td>
                            <td data-label="Баланс до">@session.CurrentBalance.ToString("N0") ₽</td>
                            <td data-label="Сумма">@session.RequestedAmount.ToString("N0") ₽</td>
                            <td data-label="Баланс после">@(session.BalanceAfter?.ToString("N0") ?? "—")@(session.BalanceAfter.HasValue ? " ₽" : "")</td>
                            <td data-label="Статус"><span class="balance-status balance-status--@session.Status">@statusLabel(session.Status)</span></td>
                            <td data-label="Оператор">@session.OperatorDisplayName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <table class="data-table data-table--cards balances-table balances-table--list">
                    <thead><tr><th class="balances-check" aria-label="Выбор"></th><th>Где</th><th>Баланс</th><th>Рекомендуемое пополнение</th><th>Статус</th><th>Последняя операция</th><th class="balances-actions">Действия</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var session = row.Session;
                        var canSelect = row.IsLowBalance && row.WorkerOnline && session is null;
                        var statusDetail = session?.Status switch
                        {
                            TopUpSessionStatuses.AwaitingBalance =>
                                "Оплата отмечена. На следующем проходе проверим историю операций Avito.",
                            TopUpSessionStatuses.VerificationRequired =>
                                "Проверяем историю операций Avito перед отменой.",
                            TopUpSessionStatuses.Completed when session.HistoryConfirmedAtUtc is not null =>
                                "Пополнение подтверждено историей операций Avito.",
                            _ => session?.ProgressMessage ?? session?.FailureMessage
                        };
                        var workerUrl = Url.Action("Details", "Workers", new { id = row.WorkerId });
                        var accountUrl = Url.Action("Index", "Accounts", new { q = row.AccountName });
                        <tr class="@(row.IsLowBalance ? "is-low" : "")" data-balance-row data-worker-id="@row.WorkerId" data-account-id="@row.AccountId" data-subprofile-id="@row.SubProfileId" data-account-name="@row.AccountName" data-subprofile-name="@row.SubProfileName" data-session-id="@(session?.Id.ToString() ?? "")" data-session-status="@(session?.Status ?? "")">
                            <td class="balances-check"><input type="checkbox" data-balance-select @(canSelect ? null : "disabled") /></td>
                            <td data-label="Где" class="balance-location">
                                <div class="balance-location__primary">
                                    <a href="@workerUrl">@row.WorkerName</a>
                                    <span aria-hidden="true">/</span>
                                    <a href="@accountUrl">@row.AccountName</a>
                                </div>
                                <div class="balance-location__subprofile">@row.SubProfileName</div>
                            </td>
                            <td data-label="Баланс">
                                <strong>@row.Balance.ToString("N0") ₽</strong>
                                <small>
                                    @if (row.LastUpdatedAtUtc is not null)
                                    {
                                        <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(row.LastUpdatedAtUtc, "short"))" />
                                    }
                                    else
                                    {
                                        <text>Нет снимка</text>
                                    }
                                    · @(row.IsStale ? "данные устарели" : row.WorkerOnline ? "воркер онлайн" : "воркер офлайн")
                                </small>
                            </td>
                            <td data-label="Рекомендуемое пополнение"><strong>+@row.RecommendedAmount.ToString("N0") ₽</strong><small>станет ~@row.RecommendedTarget.ToString("N0") ₽ · @row.TodayResponses откликов</small></td>
                            <td data-label="Статус" data-balance-status>
                                @if (session is null)
                                {
                                    if (row.TopUpCooldownActive)
                                    {
                                        <span class="balance-status balance-status--completed">Пополнено недавно</span>
                                    }
                                    else
                                    {
                                        <span class="balance-status balance-status--low">Низкий баланс</span>
                                    }
                                }
                                else
                                {
                                    <span class="balance-status balance-status--@session.Status">@statusLabel(session.Status)</span>
                                }
                                <small data-balance-status-detail @(string.IsNullOrWhiteSpace(statusDetail) ? "hidden" : null)>@statusDetail</small>
                            </td>
                            <td data-label="Последняя операция">
                                @if (session is not null)
                                {
                                    <strong>@session.RequestedAmount.ToString("N0") ₽</strong><small>@session.OperatorDisplayName</small>
                                }
                                else { <span>—</span> }
                            </td>
                            <td class="balances-actions" data-label="Действия">
                                @if (session is not null && session.Status == TopUpSessionStatuses.QrReady)
                                {
                                    <button type="button" class="balances-primary balances-primary--small" data-topup-paid="@session.Id">Оплачено</button>
                                }
                                @if (session is not null && TopUpSessionStatuses.IsActive(session.Status))
                                {
                                    <button type="button" class="balances-link" data-topup-cancel="@session.Id">Отменить</button>
                                }
                                @if (session is null && canSelect)
                                {
                                    <button type="button" class="balances-link" data-single-topup>Пополнить</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = Model.Pagination,
                Controller = "Balances",
                Action = "Index",
                RouteValues = new { tab = activeTab, q = query, history = isHistoryTab, excludedWorkerIds },
                ExtraClass = "balances-pagination"
            })" />
        </div>
    </div>
    }

    @{
        var activeTopUpSessions = Model.Sessions
            .Where(x => TopUpSessionStatuses.IsActive(x.Status))
            .OrderByDescending(x => x.Status == TopUpSessionStatuses.QrReady)
            .ThenBy(x => x.CreatedAtUtc)
            .ToList();
        var qrSessions = activeTopUpSessions
            .Where(x => x.Status == TopUpSessionStatuses.QrReady)
            .ToList();
        var preparingTopUpCount = activeTopUpSessions.Count - qrSessions.Count;
        var workspaceSignature = string.Join(
            '|',
            activeTopUpSessions
                .Select(x => $"{x.Id:N}:{x.Status}".ToLowerInvariant())
                .OrderBy(x => x, StringComparer.Ordinal));
    }
    @if (isRequestedTopUpsTab && activeTopUpSessions.Count > 0)
    {
        <section class="balances-workspace"
                 aria-labelledby="balancesQrTitle"
                 data-topup-workspace
                 data-topup-workspace-signature="@workspaceSignature">
            <div class="balances-workspace__queue">
                <div class="balances-workspace__queue-heading">
                    <h2 id="balancesQrTitle">Запрошенные пополнения</h2>
                    <p>@activeTopUpSessions.Count всего · @qrSessions.Count QR готовы · @preparingTopUpCount готовятся</p>
                </div>
                @foreach (var session in activeTopUpSessions)
                {
                    var isQrReady = session.Status == TopUpSessionStatuses.QrReady;
                    var pendingLabel = session.Status switch
                    {
                        TopUpSessionStatuses.Requested => "В очереди",
                        TopUpSessionStatuses.Started => "Формируем QR",
                        TopUpSessionStatuses.PaymentClaimed => "Формируем QR",
                        _ => statusLabel(session.Status)
                    };
                    @if (isQrReady)
                    {
                        <button type="button" class="balances-workspace__queue-item balances-workspace__queue-item--ready" data-qr-select="@session.Id" data-qr-src="@(!string.IsNullOrWhiteSpace(session.QrImageBase64) ? $"data:image/png;base64,{session.QrImageBase64}" : session.QrImageUrl)" data-qr-account="@session.AccountName" data-qr-profile="@session.SubProfileName" data-qr-amount="@session.RequestedAmount.ToString("N0") ₽" data-qr-expires-at="@session.ExpiresAtUtc.ToUniversalTime().ToString("O")">
                            <strong>@session.AccountName</strong>
                            <span>@session.SubProfileName · @session.RequestedAmount.ToString("N0") ₽</span>
                            <span class="balances-workspace__queue-meta">
                                <span class="balances-workspace__queue-state balances-workspace__queue-state--ready"><i class="fa-solid fa-qrcode" aria-hidden="true"></i> QR готов</span>
                                <span class="balances-workspace__queue-timer" data-qr-list-timer data-qr-list-expires-at="@session.ExpiresAtUtc.ToUniversalTime().ToString("O")" aria-live="polite"></span>
                                <span>Запрошено <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(session.CreatedAtUtc, "datetime"))" /></span>
                            </span>
                        </button>
                    }
                    else
                    {
                        <div class="balances-workspace__queue-item balances-workspace__queue-item--pending" data-topup-workspace-item data-topup-session-id="@session.Id" data-topup-session-status="@session.Status">
                            <strong>@session.AccountName</strong>
                            <span>@session.SubProfileName · @session.RequestedAmount.ToString("N0") ₽</span>
                            <span class="balances-workspace__queue-meta">
                                <span class="balances-workspace__queue-state"><i class="fa-solid fa-spinner" aria-hidden="true"></i> @pendingLabel</span>
                                <span>Запрошено <partial name="_UtcTime" model="@(new UtcTimeDisplayModel(session.CreatedAtUtc, "datetime"))" /></span>
                            </span>
                        </div>
                    }
                }
            </div>
            <div class="balances-workspace__qr">
                <div><span data-qr-account-label>@(qrSessions.Count > 0 ? "Выберите QR" : "QR ещё готовятся")</span><strong data-qr-amount-label></strong></div>
                @if (qrSessions.Any(x => !string.IsNullOrWhiteSpace(x.QrImageBase64) || !string.IsNullOrWhiteSpace(x.QrImageUrl)))
                {
                    <img data-qr-image src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="QR-код для оплаты" hidden />
                }
                <p data-qr-profile-label>@(qrSessions.Count > 0
                    ? "Готовые QR остаются на одной странице — переключайтесь без возврата к воркерам."
                    : "Следим за подготовкой QR-кодов. Список обновится автоматически.")</p>
                <p class="balances-workspace__timer" data-qr-timer aria-live="polite" hidden></p>
                <div class="balances-workspace__actions">
                    <button type="button" class="balances-primary" data-qr-paid disabled>Оплачено</button>
                    <button type="button" class="balances-link balances-link--danger" data-qr-cancel disabled>Отменить</button>
                </div>
            </div>
        </section>
    }
    else if (isRequestedTopUpsTab)
    {
        <div class="card card--balances-table">
            <div class="card-body">
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-wallet",
                    Title = "Нет запрошенных пополнений",
                    Description = "Активные заявки и готовые QR-коды появятся здесь.",
                    CtaLabel = "Требуют пополнения",
                    CtaUrl = BalancesUrl("low", includeQuery: false)
                })" />
            </div>
        </div>
    }
</main>

@section Scripts {
    <script src="~/js/orbita-balances.js" asp-append-version="true"></script>
}
