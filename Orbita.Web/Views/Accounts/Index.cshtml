@model AccountsIndexViewModel
@{
    ViewData["Title"] = "Аккаунты";
    var pagination = Model.Pagination;
    var snapshotUrl = Url.Action("Snapshot", "Accounts", new { q = Model.SearchQuery, tab = Model.ActiveTab, page = pagination.Page })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main accounts-page"
     data-orbita-live
     data-orbita-live-page="accounts"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-responses-filter-url="@Url.Action("Index", "Responses", new { accountId = "__id__" })">
    <nav class="orbita-breadcrumbs orbita-breadcrumbs--accounts" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="kpi-row accounts-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <div class="accounts-control-bar">
        <nav class="accounts-tabs" aria-label="Фильтр аккаунтов">
            @foreach (var tab in Model.Tabs)
            {
                var isActive = tab.Id == Model.ActiveTab;
                <a class="accounts-tab @(isActive ? "accounts-tab--active" : "")"
                   href="@Url.Action("Index", new { tab = tab.Id, q = Model.SearchQuery, page = 1 })"
                   aria-current="@(isActive ? "page" : null)">@tab.Label</a>
            }
        </nav>
        <div class="accounts-toolbar">
            <form class="accounts-search" method="get" asp-action="Index" role="search">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <i class="fa-solid fa-magnifying-glass accounts-search-icon" aria-hidden="true"></i>
                <input type="search"
                       name="q"
                       value="@Model.SearchQuery"
                       placeholder="Поиск по аккаунтам..."
                       aria-label="Поиск по аккаунтам" />
            </form>
            <button type="button" class="accounts-filter-btn" aria-label="Фильтры">
                <i class="fa-solid fa-filter" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <div class="card card--accounts-table">
        <div class="card-body card-body-table accounts-table-wrap">
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-users",
                    Title = "Аккаунты не найдены",
                    Description = "Измените вкладку, поиск или дождитесь синхронизации с воркерами.",
                    CtaLabel = string.IsNullOrWhiteSpace(Model.SearchQuery) ? "Показать все" : "Сбросить поиск",
                    CtaUrl = Url.Action("Index", new { tab = "all" })
                })" />
            }
            else
            {
            <table class="data-table data-table--accounts-list data-table--cards">
                <thead>
                    <tr>
                        <th>Аккаунт</th>
                        <th>Воркер</th>
                        <th>Статус</th>
                        <th class="cell-num">Баланс</th>
                        <th class="cell-num">Откликов</th>
                        <th class="cell-num">Уникальных</th>
                        <th class="cell-num">Ошибок</th>
                        <th>Последняя активность</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody data-orbita-live-body="accounts">
                @foreach (var account in Model.Accounts)
                {
                    var workerUrl = Url.Action("Details", "Workers", new { id = account.WorkerId });
                    var accountUrl = Url.Action("Index", "Accounts", new { q = account.AccountName });
                    var responsesUrl = Url.Action("Index", "Responses", new { accountId = account.Id });
                    <tr class="accounts-row" data-href="@accountUrl">
                        <td class="cell-account" data-label="Аккаунт">
                            <a href="@accountUrl">@account.AccountName</a>
                            @if (account.CanRefreshSubProfiles || account.HasSubProfiles)
                            {
                                <div class="subprofiles-toolbar">
                                    @if (account.HasSubProfiles)
                                    {
                                        <button type="button"
                                                class="subprofiles-toggle"
                                                data-subprofiles-toggle
                                                aria-expanded="false"
                                                aria-controls="subprofiles-acc-@account.Id">
                                            <i class="fa-solid fa-chevron-right subprofiles-toggle-icon" aria-hidden="true"></i>
                                            <span>@account.SubProfilesSummary</span>
                                        </button>
                                    }
                                    else if (account.CanRefreshSubProfiles)
                                    {
                                        <span class="subprofiles-empty-hint">Субпрофили не обнаружены</span>
                                    }
                                    <partial name="_SubProfilesRefreshBtn" model="(account.WorkerId, account.Id, account.CanRefreshSubProfiles, account.IsSubProfilesRefreshPending)" />
                                </div>
                                @if (account.HasSubProfiles)
                                {
                                    <div class="subprofiles-panel" id="subprofiles-acc-@account.Id" hidden>
                                        <partial name="_SubProfilesList" model="@(new SubProfilesListViewModel { WorkerId = account.WorkerId, AccountId = account.Id, Items = account.SubProfiles })" />
                                    </div>
                                }
                            }
                        </td>
                        <td class="cell-worker" data-label="Воркер">
                            <a href="@workerUrl">@account.WorkerName</a>
                        </td>
                        <td data-label="Статус">
                            <span class="account-status account-status--@account.StatusTone">
                                <i class="fa-solid fa-circle account-status-dot" aria-hidden="true"></i>
                                @account.StatusLabel
                            </span>
                            @if (!string.IsNullOrWhiteSpace(account.LastErrorMessage))
                            {
                                <span class="account-error-hint" title="@account.LastErrorMessage">@account.LastErrorMessage</span>
                            }
                        </td>
                        <td class="cell-num" data-label="Баланс">@account.Balance.ToString("N0") ₽</td>
                        <td class="cell-num" data-label="Откликов">@account.Responses</td>
                        <td class="cell-num" data-label="Уникальных">@account.UniqueResponses</td>
                        <td class="cell-num" data-label="Ошибок">@account.Errors</td>
                        <td data-label="Последняя активность"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.LastActivityUtc, "time"))" /></td>
                        <td class="data-table-menu" data-label="">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown row-menu-dropdown--accounts" hidden>
                                    <a class="row-menu-item" href="@accountUrl">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Просмотр
                                    </a>
                                    <a class="row-menu-item" href="@(workerUrl + "#worker-accounts")">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                        Настройки на воркере
                                    </a>
                                    <a class="row-menu-item" href="@responsesUrl">
                                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                        История откликов
                                    </a>
                                    @if (account.IsEnabledInPanel)
                                    {
                                        <button type="button"
                                                class="row-menu-item row-menu-item--danger"
                                                data-account-toggle
                                                data-worker-id="@account.WorkerId"
                                                data-account-id="@account.Id"
                                                data-enabled="false">
                                            <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                            Отключить в панели
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="row-menu-item"
                                                data-account-toggle
                                                data-worker-id="@account.WorkerId"
                                                data-account-id="@account.Id"
                                                data-enabled="true">
                                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                            Включить в панели
                                        </button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = pagination,
                Controller = "Accounts",
                Action = "Index",
                RouteValues = new { q = Model.SearchQuery, tab = Model.ActiveTab },
                ExtraClass = "orbita-live-pagination"
            })" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/orbita-accounts.js" asp-append-version="true"></script>
}