@model AccountsIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Аккаунты";
    var subProfileJsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var pagination = Model.Pagination;
    var accountsSortRoute = new
    {
        q = Model.SearchQuery,
        tab = Model.ActiveTab,
        workerId = Model.WorkerId,
        pageSize = pagination.PageSize,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    };
    var snapshotUrl = Url.Action("Snapshot", "Accounts", new
    {
        q = Model.SearchQuery,
        tab = Model.ActiveTab,
        workerId = Model.WorkerId,
        page = pagination.Page,
        pageSize = pagination.PageSize,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main accounts-page"
     data-orbita-live
     data-orbita-live-page="accounts"
     data-orbita-snapshot="@snapshotUrl"
     data-show-office-column="@(Model.ShowOfficeColumn ? "true" : "false")"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-responses-filter-url="@Url.Action("Index", "Responses", new { accountId = "__id__" })"
     data-metric-today="@DateTime.Today.ToString("yyyy-MM-dd")"
     data-account-metric-responses-url="@($"/Responses?from=__today__&to=__today__&workerId=__workerId__&accountId=__accountId__")"
     data-account-metric-unique-url="@($"/Responses?from=__today__&to=__today__&status=unique&workerId=__workerId__&accountId=__accountId__")"
     data-account-metric-errors-url="@($"/Events?level=errors&workerId=__workerId__&accountId=__accountId__")">
    <div class="kpi-row accounts-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <nav class="accounts-tabs" aria-label="Фильтр аккаунтов">
        @foreach (var tab in Model.Tabs)
        {
            var isActive = tab.Id == Model.ActiveTab;
            <a class="accounts-tab @(isActive ? "accounts-tab--active" : "")"
               href="@Url.Action("Index", new { tab = tab.Id, q = Model.SearchQuery, workerId = Model.WorkerId, pageSize = pagination.PageSize, sort = Model.Sort.Column, dir = Model.Sort.Dir, page = 1 })"
               aria-current="@(isActive ? "page" : null)">@tab.Label</a>
        }
    </nav>

    @{
        var accountsFormAction = Url.Action("Index", "Accounts");
        var accountsFilterBar = new ListFiltersBarViewModel
        {
            FormAction = accountsFormAction!,
            FormClass = "orbita-filters-form accounts-filters",
            SearchName = "q",
            SearchPlaceholder = "Поиск по аккаунтам...",
            SearchValue = Model.SearchQuery,
            FilterPanelId = "accountsFilterPanel",
            FilterToggleClass = "orbita-filters-toggle accounts-filter-btn",
            HasActiveFilters = Model.HasActiveFilters,
            ActiveFilterCount = Model.ActiveFilterCount,
            ActiveFilterChips = Model.ActiveFilterChips,
            ResetUrl = accountsFormAction!,
            FilterFieldsPartialName = "_AccountsFilterFields",
            FilterFieldsModel = Model,
            ExtraFormContent = $"<input type=\"hidden\" name=\"sort\" value=\"{Model.Sort.Column}\" /><input type=\"hidden\" name=\"dir\" value=\"{Model.Sort.Dir}\" />"
        };
    }
    <partial name="_ListFiltersBar" model="accountsFilterBar" />

    <div class="card card--accounts-table">
        <div class="card-body card-body-table accounts-table-wrap">
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-solid fa-users",
                    Title = "Аккаунты не найдены",
                    Description = "Измените вкладку, поиск или дождитесь синхронизации с воркерами.",
                    CtaLabel = string.IsNullOrWhiteSpace(Model.SearchQuery) ? "Показать все" : "Сбросить поиск",
                    CtaUrl = Url.Action("Index", new { tab = "all" })
                })" />
            }
            else
            {
            <table class="data-table data-table--accounts-list data-table--cards">
                        <thead>
                            <tr>
                                <th class="cell-toggle">Вкл</th>
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Аккаунт", Column = "account", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Воркер", Column = "worker", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute })" />
                                @if (Model.ShowOfficeColumn)
                                {
                                    <th>Офис</th>
                                }
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Статус", Column = "status", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute })" />
                                <th>Сейчас</th>
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Баланс", Column = "balance", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute, Numeric = true })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Откликов", Column = "responses", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute, Numeric = true })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Уникальных", Column = "unique", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute, Numeric = true })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Ошибок", Column = "errors", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute, Numeric = true })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Последняя активность", Column = "activity", Sort = Model.Sort, Controller = "Accounts", Action = "Index", RouteValues = accountsSortRoute })" />
                                <th aria-hidden="true">Действия</th>
                            </tr>
                        </thead>
                <tbody data-orbita-live-body="accounts">
                @foreach (var account in Model.Accounts)
                {
                    var workerUrl = Url.Action("Details", "Workers", new { id = account.WorkerId });
                    var accountUrl = Url.Action("Index", "Accounts", new { q = account.AccountName });
                    var responsesUrl = Url.Action("Index", "Responses", new { accountId = account.Id });
                    <tr class="accounts-row@(account.IsProcessingNow ? " accounts-row--processing" : "")"
                        data-href="@accountUrl"
                        data-account-id="@account.Id"
                        data-subprofiles-layout="accounts"
                        data-subprofiles-show-office="@(Model.ShowOfficeColumn ? "true" : "false")"
                        data-processing-subprofile-id="@(account.IsProcessingNow ? account.ProcessingSubProfileId : null)"
                        data-subprofiles-json="@JsonSerializer.Serialize(account.SubProfiles, subProfileJsonOptions)">
                        <td class="cell-toggle" data-label="Вкл">
                            <label class="worker-toggle" title="@(account.IsEnabledInPanel ? "Отключить аккаунт в панели" : "Включить аккаунт в панели")">
                                <input type="checkbox"
                                       data-account-enable-toggle
                                       data-toggle-url="@Url.Action("Toggle", "Accounts")"
                                       data-toggle-refresh="Accounts"
                                       data-worker-id="@account.WorkerId"
                                       data-account-id="@account.Id"
                                       @(account.IsEnabledInPanel ? "checked" : null) />
                                <span class="worker-toggle-slider"></span>
                            </label>
                        </td>
                        <td class="cell-account" data-label="Аккаунт">
                            <a href="@accountUrl">@account.AccountName</a>
                            @if (account.HasAvitoCredentials)
                            {
                                <span class="worker-account-sub worker-account-sub--ok" title="@(account.AvitoLogin ?? "логин задан")">
                                    <i class="fa-solid fa-key" aria-hidden="true"></i> логин Avito
                                </span>
                            }
                            <partial name="_SubProfilesSection" model="@(new SubProfilesSectionViewModel
                            {
                                WorkerId = account.WorkerId,
                                AccountId = account.Id,
                                PanelIdPrefix = "subprofiles-acc",
                                CanRefreshSubProfiles = account.CanRefreshSubProfiles,
                                IsSubProfilesRefreshPending = account.IsSubProfilesRefreshPending,
                                HasSubProfiles = account.HasSubProfiles,
                                ProcessingSubProfileId = account.IsProcessingNow ? account.ProcessingSubProfileId : null,
                                Items = account.SubProfiles
                            })" />
                        </td>
                        <td class="cell-worker" data-label="Воркер">
                            <a href="@workerUrl">@account.WorkerName</a>
                        </td>
                        @if (Model.ShowOfficeColumn)
                        {
                            <td data-label="Офис">@account.OfficeName</td>
                        }
                        <td data-label="Статус">
                            <span class="account-status account-status--@account.StatusTone">
                                <i class="fa-solid fa-circle account-status-dot" aria-hidden="true"></i>
                                @account.StatusLabel
                            </span>
                            @if (!string.IsNullOrWhiteSpace(account.LastErrorMessage))
                            {
                                <span class="account-error-hint" title="@account.LastErrorMessage">@account.LastErrorMessage</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(account.ErrorHint))
                            {
                                <span class="account-error-hint" title="@account.ErrorHint">@account.ErrorHint</span>
                            }
                        </td>
                        <td data-label="Сейчас">
                            @if (!string.IsNullOrWhiteSpace(account.ProcessingLabel))
                            {
                                <partial name="_WorkerActivityPillFromRow" model="@(account.ProcessingLabel, account.ProcessingTone, account.IsProcessingNow)" />
                            }
                            else
                            {
                                <span class="worker-activity-pill worker-activity-pill--muted">—</span>
                            }
                        </td>
                        <td class="cell-num cell-balance" data-label="Баланс">
                            <div class="account-balance">
                                <span class="account-balance-total" title="@(account.HasMultipleSubProfiles ? "Сумма авансов по субпрофилям" : "Аванс")">@account.Balance.ToString("N0") ₽</span>
                                @if (!string.IsNullOrWhiteSpace(account.BalanceSubtitle))
                                {
                                    <span class="account-balance-breakdown">@account.BalanceSubtitle</span>
                                }
                            </div>
                        </td>
                        <td class="cell-num" data-label="Откликов">
                            <partial name="_MetricLink" model="@AccountMetricLinks.Responses(account.WorkerId, account.Id, account.Responses)" />
                        </td>
                        <td class="cell-num" data-label="Уникальных">
                            <partial name="_MetricLink" model="@AccountMetricLinks.Unique(account.WorkerId, account.Id, account.UniqueResponses)" />
                        </td>
                        <td class="cell-num" data-label="Ошибок">
                            <partial name="_MetricLink" model="@AccountMetricLinks.Errors(account.WorkerId, account.Id, account.Errors)" />
                        </td>
                        <td data-label="Последняя активность"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(account.LastActivityUtc, "activity"))" /></td>
                        <td class="data-table-menu" data-label="">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown row-menu-dropdown--accounts" hidden>
                                    <a class="row-menu-item" href="@accountUrl">
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Просмотр
                                    </a>
                                    <a class="row-menu-item" href="@(workerUrl + "#worker-accounts")">
                                        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i>
                                        Настройки на воркере
                                    </a>
                                    <button type="button"
                                            class="row-menu-item"
                                            data-avito-credentials
                                            data-worker-id="@account.WorkerId"
                                            data-account-id="@account.Id"
                                            data-account-name="@account.AccountName"
                                            data-login="@(account.AvitoLogin ?? "")"
                                            data-has-password="@(account.HasAvitoCredentials ? "true" : "false")"
                                            data-post-url="@Url.Action("UpdateCredentials", "Accounts")">
                                        <i class="fa-solid fa-key" aria-hidden="true"></i>
                                        Логин / пароль Avito
                                    </button>
                                    <a class="row-menu-item" href="@responsesUrl">
                                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                        История откликов
                                    </a>
                                    @if (account.IsEnabledInPanel)
                                    {
                                        <button type="button"
                                                class="row-menu-item row-menu-item--danger"
                                                data-account-toggle
                                                data-worker-id="@account.WorkerId"
                                                data-account-id="@account.Id"
                                                data-enabled="false">
                                            <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                            Отключить в панели
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="row-menu-item"
                                                data-account-toggle
                                                data-worker-id="@account.WorkerId"
                                                data-account-id="@account.Id"
                                                data-enabled="true">
                                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                                            Включить в панели
                                        </button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                    @if (account.HasSubProfiles)
                    {
                        <partial name="_SubProfileTableRows" model="@(new SubProfileTableRowsViewModel
                        {
                            WorkerId = account.WorkerId,
                            AccountId = account.Id,
                            PanelId = $"subprofiles-acc-{account.Id}",
                            ProcessingSubProfileId = account.IsProcessingNow ? account.ProcessingSubProfileId : null,
                            Layout = SubProfileTableLayout.Accounts,
                            ShowOfficeColumn = Model.ShowOfficeColumn,
                            Items = account.SubProfiles
                        })" />
                    }
                }
                </tbody>
            </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = pagination,
                Controller = "Accounts",
                Action = "Index",
                RouteValues = new { q = Model.SearchQuery, tab = Model.ActiveTab, pageSize = pagination.PageSize, sort = Model.Sort.Column, dir = Model.Sort.Dir },
                ExtraClass = "orbita-live-pagination"
            })" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__ORBITA_SSR_SUBPROFILES__ = @Html.Raw(JsonSerializer.Serialize(
            Model.Accounts
                .Where(a => a.HasSubProfiles)
                .Select(a => new {
                    accountId = a.Id,
                    items = a.SubProfiles.Select(s => new { s.Id, s.Name, s.BalanceText, s.Category }).ToList()
                })
                .ToList(),
            subProfileJsonOptions));
    </script>
    <script src="~/js/orbita-accounts.js" asp-append-version="true"></script>
}