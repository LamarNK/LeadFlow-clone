@model EventsIndexViewModel
@{
    ViewData["Title"] = "События";
    var isErrorsView = Model.JournalView == "errors";
    var errorsPage = Model.ErrorsPage;
    var pagination = isErrorsView && errorsPage is not null ? errorsPage.Pagination : Model.Pagination;
    var formAction = Url.Action("Index", "Events");
    var eventsSortRoute = new
    {
        view = Model.JournalView == "all" ? null : Model.JournalView,
        q = Model.Filters.SearchQuery,
        type = Model.Filters.Type,
        workerId = Model.Filters.WorkerId,
        accountId = Model.Filters.AccountId,
        level = Model.Filters.Level,
        sort = Model.Sort.Column,
        dir = Model.Sort.Dir
    };
    var snapshotUrl = isErrorsView && errorsPage is not null
        ? Url.Action("Snapshot", "Events", new
        {
            view = "errors",
            q = errorsPage.Filters.SearchQuery,
            severity = errorsPage.Filters.Severity,
            type = errorsPage.Filters.Type,
            workerId = errorsPage.Filters.WorkerId,
            accountId = errorsPage.Filters.AccountId,
            page = pagination.Page,
            sort = errorsPage.Sort.Column,
            dir = errorsPage.Sort.Dir
        })!
        : Url.Action("Snapshot", "Events", new
        {
            eventsSortRoute.view,
            eventsSortRoute.q,
            eventsSortRoute.type,
            eventsSortRoute.workerId,
            eventsSortRoute.accountId,
            eventsSortRoute.level,
            page = pagination.Page,
            eventsSortRoute.sort,
            eventsSortRoute.dir
        })!;
    var resetUrl = isErrorsView
        ? Url.Action("Index", "Events", new { view = "errors" })
        : Url.Action("Index", "Events", new { view = Model.JournalView == "all" ? null : Model.JournalView });
    var filterBar = isErrorsView && errorsPage is not null
        ? new ListFiltersBarViewModel
        {
            FormAction = formAction,
            FormClass = "orbita-filters-form errors-filters",
            SearchName = "q",
            SearchPlaceholder = "Поиск по ошибкам...",
            SearchValue = errorsPage.Filters.SearchQuery,
            FilterPanelId = "errorsFilterPanel",
            FilterToggleClass = "orbita-filters-toggle errors-filter-btn",
            HasActiveFilters = errorsPage.HasActiveFilters,
            ActiveFilterCount = errorsPage.ActiveFilterCount,
            ActiveFilterChips = errorsPage.ActiveFilterChips,
            ResetUrl = resetUrl,
            FilterFieldsPartialName = "_ErrorsFilterFields",
            FilterFieldsModel = errorsPage,
            ExtraFormContent = $"<input type=\"hidden\" name=\"sort\" value=\"{errorsPage.Sort.Column}\" /><input type=\"hidden\" name=\"dir\" value=\"{errorsPage.Sort.Dir}\" />"
        }
        : new ListFiltersBarViewModel
        {
            FormAction = formAction,
            FormClass = "orbita-filters-form events-filters",
            SearchName = "q",
            SearchPlaceholder = "Поиск по событиям...",
            SearchValue = Model.Filters.SearchQuery,
            FilterPanelId = "eventsFilterPanel",
            FilterToggleClass = "orbita-filters-toggle events-filter-btn",
            HasActiveFilters = Model.HasActiveFilters,
            ActiveFilterCount = Model.ActiveFilterCount,
            ActiveFilterChips = Model.ActiveFilterChips,
            ResetUrl = resetUrl,
            FilterFieldsPartialName = "_EventsFilterFields",
            FilterFieldsModel = Model,
            ExtraFormContent = $"<input type=\"hidden\" name=\"sort\" value=\"{Model.Sort.Column}\" /><input type=\"hidden\" name=\"dir\" value=\"{Model.Sort.Dir}\" />"
        };
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main events-page journal-page"
     data-orbita-live
     data-orbita-live-page="journal"
     data-orbita-journal-view="@Model.JournalView"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-settings-logs-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = "__id__" })"
     data-response-detail-json-url="@Url.Action("DetailJson", "Responses", new { id = "__id__" })">
    <nav class="journal-tabs" aria-label="Журнал событий">
        <a class="journal-tab @(Model.JournalView == "all" ? "journal-tab--active" : "")"
           href="@Url.Action("Index", "Events")"
           aria-current="@(Model.JournalView == "all" ? "page" : null)">Все</a>
        <a class="journal-tab @(Model.JournalView == "warnings" ? "journal-tab--active" : "")"
           href="@Url.Action("Index", "Events", new { view = "warnings" })"
           aria-current="@(Model.JournalView == "warnings" ? "page" : null)">Предупреждения</a>
        <a class="journal-tab @(Model.JournalView == "errors" ? "journal-tab--active" : "")"
           href="@Url.Action("Index", "Events", new { view = "errors" })"
           aria-current="@(Model.JournalView == "errors" ? "page" : null)">Ошибки</a>
    </nav>

    <div class="kpi-row events-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <partial name="_ListFiltersBar" model="filterBar" />

    @if (isErrorsView && errorsPage is not null)
    {
        <partial name="_JournalErrorsTable" model="errorsPage" />
    }
    else
    {
        <div class="card card--events-table">
            <div class="card-body card-body-table events-table-wrap">
                @if (pagination.TotalItems == 0)
                {
                    <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                    {
                        IconClass = "fa-regular fa-clipboard",
                        Title = "События не найдены",
                        Description = "За выбранные фильтры записей нет.",
                        CtaLabel = "Сбросить фильтры",
                        CtaUrl = resetUrl
                    })" />
                }
                else
                {
                    <table class="data-table data-table--events data-table--cards">
                        <thead>
                            <tr>
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Время", Column = "time", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Тип события", Column = "type", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Уровень", Column = "level", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Аккаунт", Column = "account", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Воркер", Column = "worker", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <partial name="_TableSortTh" model="@(new TableSortThViewModel { Label = "Описание", Column = "description", Sort = Model.Sort, Controller = "Events", Action = "Index", RouteValues = eventsSortRoute })" />
                                <th aria-hidden="true">Действия</th>
                            </tr>
                        </thead>
                        <tbody data-orbita-live-body="events">
                        @foreach (var evt in Model.Events)
                        {
                            var workerUrl = Url.Action("Details", "Workers", new { id = evt.WorkerId });
                            var accountUrl = string.IsNullOrWhiteSpace(evt.AccountName)
                                ? null
                                : Url.Action("Index", "Accounts", new { q = evt.AccountName });
                            <tr class="events-row"
                                data-event-id="@evt.Id"
                                data-copy="@evt.CopyText"
                                data-detail-title="@evt.EventTypeLabel"
                                data-detail-subtitle="@evt.WorkerName · @evt.LevelLabel"
                                data-detail-body="@evt.Description"
                                data-detail-attachment="@(evt.AttachmentId is not null ? $"/Diagnostics/Image/{evt.AttachmentId}" : "")"
                                data-detail-log-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = evt.WorkerId })"
                                data-detail-worker-url="@workerUrl"
                                data-detail-account-url="@(accountUrl ?? "")">
                                <td class="events-time" data-label="Время"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(evt.OccurredAtUtc, "datetime-seconds"))" /></td>
                                <td data-label="Тип события">
                                    <span class="event-type event-type--@evt.EventTypeTone">
                                        <i class="@evt.EventTypeIcon event-type-icon" aria-hidden="true"></i>
                                        <span>@evt.EventTypeLabel</span>
                                    </span>
                                </td>
                                <td data-label="Уровень">
                                    <span class="event-level-badge event-level-badge--@evt.Level">@evt.LevelLabel</span>
                                </td>
                                <td class="cell-link" data-label="Аккаунт">
                                    @if (accountUrl is not null)
                                    {
                                        <a href="@accountUrl">@evt.AccountName</a>
                                    }
                                    else
                                    {
                                        <span class="events-muted">—</span>
                                    }
                                </td>
                                <td class="cell-link" data-label="Воркер">
                                    <a href="@workerUrl">@evt.WorkerName</a>
                                </td>
                                <td class="events-desc" data-label="Описание" title="@evt.Description">@evt.Description</td>
                                <td class="data-table-menu" data-label="">
                                    <div class="row-menu" data-row-menu>
                                        <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                        </button>
                                        <div class="row-menu-dropdown row-menu-dropdown--events" hidden>
                                            <a class="row-menu-item" href="@Url.Action("Index", "Settings", new { tab = "logs", workerId = evt.WorkerId })">
                                                <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                                                Открыть лог
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }

                <partial name="_Pagination" model="@(new PaginationPartialViewModel
                {
                    Pagination = pagination,
                    Controller = "Events",
                    Action = "Index",
                    RouteValues = eventsSortRoute
                })" />
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/orbita-journal.js" asp-append-version="true"></script>
}