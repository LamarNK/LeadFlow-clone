@model EventsIndexViewModel
@{
    ViewData["Title"] = "События";
    var pagination = Model.Pagination;
    var formAction = Url.Action("Index", "Events");
    var snapshotUrl = Url.Action("Snapshot", "Events", new
    {
        q = Model.Filters.SearchQuery,
        type = Model.Filters.Type,
        workerId = Model.Filters.WorkerId,
        account = Model.Filters.Account,
        level = Model.Filters.Level,
        page = pagination.Page
    })!;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main events-page"
     data-orbita-live
     data-orbita-live-page="events"
     data-orbita-snapshot="@snapshotUrl"
     data-worker-details-url="@Url.Action("Details", "Workers", new { id = "__id__" })"
     data-account-search-url="@Url.Action("Index", "Accounts", new { q = "__q__" })"
     data-settings-logs-url="@Url.Action("Index", "Settings", new { tab = "logs", workerId = "__id__" })">
    <nav class="orbita-breadcrumbs orbita-breadcrumbs--events" aria-label="Навигация">
        @for (var i = 0; i < Model.Breadcrumbs.Count; i++)
        {
            var crumb = Model.Breadcrumbs[i];
            if (i > 0)
            {
                <span class="orbita-breadcrumbs-sep" aria-hidden="true">&gt;</span>
            }
            if (crumb.IsActive || string.IsNullOrEmpty(crumb.Url))
            {
                <span class="orbita-breadcrumbs-current">@crumb.Label</span>
            }
            else
            {
                <a class="orbita-breadcrumbs-link" href="@crumb.Url">@crumb.Label</a>
            }
        }
    </nav>

    <div class="kpi-row events-kpi-row">
        @{ var kpiIdx = 0; }
        @foreach (var kpi in Model.KpiCards)
        {
            <partial name="_KpiCard" model="@(new KpiCardPartialViewModel { Card = kpi, Index = kpiIdx, Layout = KpiCardLayout.StatDelta, ExtraClass = " kpi-card--stat" })" />
            kpiIdx++;
        }
    </div>

    <div class="card card--events-filters">
        <form class="events-filters" method="get" action="@formAction">
            <div class="events-filters-row">
                <label class="events-filter-field">
                    <span class="events-filter-label">Тип события</span>
                    <select name="type" class="events-select" aria-label="Тип события">
                        @foreach (var opt in Model.EventTypes)
                        {
                            if (opt.Value == (Model.Filters.Type ?? ""))
                            {
                                <option value="@opt.Value" selected>@opt.Label</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        }
                    </select>
                </label>
                <label class="events-filter-field">
                    <span class="events-filter-label">Воркер</span>
                    <select name="workerId" class="events-select" aria-label="Воркер">
                        @foreach (var opt in Model.Workers)
                        {
                            if (opt.Value == (Model.Filters.WorkerId?.ToString() ?? ""))
                            {
                                <option value="@opt.Value" selected>@opt.Label</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        }
                    </select>
                </label>
                <label class="events-filter-field">
                    <span class="events-filter-label">Аккаунт</span>
                    <select name="account" class="events-select" aria-label="Аккаунт">
                        @foreach (var opt in Model.Accounts)
                        {
                            if (opt.Value == (Model.Filters.Account ?? ""))
                            {
                                <option value="@opt.Value" selected>@opt.Label</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        }
                    </select>
                </label>
                <label class="events-filter-field">
                    <span class="events-filter-label">Уровень</span>
                    <select name="level" class="events-select" aria-label="Уровень">
                        @foreach (var opt in Model.Levels)
                        {
                            if (opt.Value == (Model.Filters.Level ?? ""))
                            {
                                <option value="@opt.Value" selected>@opt.Label</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        }
                    </select>
                </label>
            </div>
            <div class="events-filters-actions">
                <div class="events-search">
                    <i class="fa-solid fa-magnifying-glass events-search-icon" aria-hidden="true"></i>
                    <input type="search"
                           name="q"
                           value="@Model.Filters.SearchQuery"
                           placeholder="Поиск по событиям..."
                           aria-label="Поиск по событиям" />
                </div>
                <button type="button" class="events-filter-btn" aria-label="Фильтры">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                </button>
                <a class="events-reset-btn" href="@formAction">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                    <span>Сбросить фильтры</span>
                </a>
            </div>
        </form>
    </div>

    <div class="card card--events-table">
        <div class="card-body card-body-table events-table-wrap">
            @if (pagination.TotalItems == 0)
            {
                <partial name="_TableEmptyState" model="@(new TableEmptyStateViewModel
                {
                    IconClass = "fa-regular fa-clipboard",
                    Title = "События не найдены",
                    Description = "За выбранные фильтры записей нет.",
                    CtaLabel = "Сбросить фильтры",
                    CtaUrl = formAction
                })" />
            }
            else
            {
            <table class="data-table data-table--events data-table--cards">
                <thead>
                    <tr>
                        <th>Время</th>
                        <th>Тип события</th>
                        <th>Уровень</th>
                        <th>Аккаунт</th>
                        <th>Воркер</th>
                        <th>Описание</th>
                        <th aria-hidden="true">Действия</th>
                    </tr>
                </thead>
                <tbody data-orbita-live-body="events">
                @foreach (var evt in Model.Events)
                {
                    var workerUrl = Url.Action("Details", "Workers", new { id = evt.WorkerId });
                    var accountUrl = string.IsNullOrWhiteSpace(evt.AccountName)
                        ? null
                        : Url.Action("Index", "Accounts", new { q = evt.AccountName });
                    <tr class="events-row"
                        data-copy="@evt.CopyText"
                        data-detail-title="@evt.EventTypeLabel"
                        data-detail-subtitle="@evt.WorkerName · @evt.LevelLabel"
                        data-detail-body="@evt.Description"
                        data-detail-attachment="@(evt.AttachmentId is not null ? $"/Diagnostics/Image/{evt.AttachmentId}" : "")">
                        <td class="events-time" data-label="Время"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(evt.OccurredAtUtc, "datetime-seconds"))" /></td>
                        <td data-label="Тип события">
                            <span class="event-type event-type--@evt.EventTypeTone">
                                <i class="@evt.EventTypeIcon event-type-icon" aria-hidden="true"></i>
                                <span>@evt.EventTypeLabel</span>
                            </span>
                        </td>
                        <td data-label="Уровень">
                            <span class="event-level-badge event-level-badge--@evt.Level">@evt.LevelLabel</span>
                        </td>
                        <td class="cell-link" data-label="Аккаунт">
                            @if (accountUrl is not null)
                            {
                                <a href="@accountUrl">@evt.AccountName</a>
                            }
                            else
                            {
                                <span class="events-muted">—</span>
                            }
                        </td>
                        <td class="cell-link" data-label="Воркер">
                            <a href="@workerUrl">@evt.WorkerName</a>
                        </td>
                        <td class="events-desc" data-label="Описание" title="@evt.Description">@evt.Description</td>
                        <td class="data-table-menu" data-label="">
                            <div class="row-menu" data-row-menu>
                                <button type="button" class="row-menu-btn" aria-label="Действия" aria-expanded="false" aria-haspopup="true">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="row-menu-dropdown row-menu-dropdown--events" hidden>
                                    <button type="button" class="row-menu-item" data-orbita-detail-open>
                                        <i class="fa-regular fa-eye" aria-hidden="true"></i>
                                        Просмотреть детали
                                    </button>
                                    <a class="row-menu-item" href="@Url.Action("Index", "Settings", new { tab = "logs", workerId = evt.WorkerId })">
                                        <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                                        Открыть лог
                                    </a>
                                    @if (accountUrl is not null)
                                    {
                                        <a class="row-menu-item" href="@accountUrl">
                                            <i class="fa-regular fa-user" aria-hidden="true"></i>
                                            Перейти к аккаунту
                                        </a>
                                    }
                                    <a class="row-menu-item" href="@workerUrl">
                                        <i class="fa-solid fa-server" aria-hidden="true"></i>
                                        Перейти к воркеру
                                    </a>
                                    <button type="button" class="row-menu-item" data-copy-event>
                                        <i class="fa-regular fa-copy" aria-hidden="true"></i>
                                        Копировать сообщение
                                    </button>
                                    <button type="button" class="row-menu-item" data-event-dismiss data-event-id="@evt.Id">
                                        <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
                                        Отметить обработанным
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }

            <partial name="_Pagination" model="@(new PaginationPartialViewModel
            {
                Pagination = pagination,
                Controller = "Events",
                Action = "Index",
                RouteValues = new
                {
                    q = Model.Filters.SearchQuery,
                    type = Model.Filters.Type,
                    workerId = Model.Filters.WorkerId,
                    account = Model.Filters.Account,
                    level = Model.Filters.Level
                }
            })" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/orbita-events.js" asp-append-version="true"></script>
}