@model MySettingsIndexViewModel
@{
    ViewData["Title"] = "Настройки";
    var profile = Model.Profile;
    var bitrixInstances = Model.BitrixInstances;
    var distribution = Model.Distribution;
}
<partial name="_PageHeader" model="Model.Header" />
<div class="orbita-main settings-page">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="settings-alert settings-alert--success" role="status">@Model.StatusMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="settings-alert settings-alert--error" role="alert">@Model.ErrorMessage</div>
    }

    <div class="settings-control-bar">
        <nav class="settings-tabs" aria-label="Разделы настроек">
            @foreach (var tab in Model.Tabs)
            {
                var isActive = tab.Id == Model.ActiveTab;
                <a class="settings-tab @(isActive ? "settings-tab--active" : "")"
                   href="@Url.Action("Index", new { tab = tab.Id })"
                   aria-current="@(isActive ? "page" : null)">@tab.Label</a>
            }
        </nav>
    </div>

    @if (Model.ActiveTab == "profile" && profile is not null)
    {
        <div class="settings-grid settings-grid--profile">
            <div class="card card--settings-profile-self">
                <div class="card-header settings-card-header">
                    <div>
                        <h2 class="settings-card-title">Мой профиль</h2>
                        <p class="settings-card-subtitle">Учётная запись в панели Орбита</p>
                    </div>
                </div>
                <div class="card-body settings-profile-self-body">
                    <div class="settings-profile-self-row">
                        <span class="settings-field-label">Email</span>
                        <span class="settings-profile-self-value">@profile.Email</span>
                    </div>
                    <div class="settings-profile-self-row">
                        <span class="settings-field-label">Роль</span>
                        <span class="settings-role-pill">@profile.RoleLabel</span>
                    </div>
                </div>
            </div>

            <div class="card card--settings-change-password">
                <div class="card-header settings-card-header">
                    <h2 class="settings-card-title">Сменить пароль</h2>
                </div>
                <div class="card-body">
                    @if (profile.PasswordPolicy is not null)
                    {
                        <p class="settings-password-policy">Требования: @profile.PasswordPolicy.Summary</p>
                    }
                    <form asp-action="ChangeOwnPassword" method="post" class="settings-create-form">
                        @Html.AntiForgeryToken()
                        <label class="settings-field">
                            <span class="settings-field-label">Текущий пароль</span>
                            <input type="password" name="CurrentPassword" required autocomplete="current-password" />
                        </label>
                        <label class="settings-field">
                            <span class="settings-field-label">Новый пароль</span>
                            <input type="password"
                                   name="NewPassword"
                                   required
                                   minlength="@(profile.PasswordPolicy?.RequiredLength ?? 8)"
                                   autocomplete="new-password" />
                        </label>
                        <label class="settings-field">
                            <span class="settings-field-label">Подтверждение</span>
                            <input type="password"
                                   name="ConfirmPassword"
                                   required
                                   minlength="@(profile.PasswordPolicy?.RequiredLength ?? 8)"
                                   autocomplete="new-password" />
                        </label>
                        <button type="submit" class="settings-primary-btn">
                            <i class="fa-solid fa-key" aria-hidden="true"></i>
                            <span>Обновить пароль</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "bitrix" && bitrixInstances is not null)
    {
        <partial name="_BitrixInstancesRegistry" model="bitrixInstances" />
    }
    else if (Model.ActiveTab == "distribution" && distribution is not null)
    {
        <partial name="_DistributionEditor" model="distribution" />
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/drawflow/dist/drawflow.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita-distribution.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/orbita-bitrix-instances.js" asp-append-version="true"></script>
    @if (Model.ActiveTab == "bitrix")
    {
        <script src="~/js/orbita-bitrix-settings.js" asp-append-version="true"></script>
    }
    @if (Model.ActiveTab == "distribution")
    {
        <script src="~/lib/drawflow/dist/drawflow.min.js" asp-append-version="true"></script>
        <script src="~/js/orbita-distribution-editor.js" asp-append-version="true"></script>
    }
}