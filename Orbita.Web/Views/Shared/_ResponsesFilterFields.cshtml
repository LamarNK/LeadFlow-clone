@model ResponsesIndexViewModel
<div class="orbita-filters-fields responses-filters-row" id="responsesFilterPanel" data-orbita-collapsible-filters hidden>
    <label class="responses-filter-field">
        <span class="responses-filter-label">Воркер</span>
        <select name="workerId" class="responses-select" aria-label="Воркер">
            @foreach (var opt in Model.Workers)
            {
                <option value="@opt.Value" selected="@(opt.Value == (Model.Filters.WorkerId?.ToString() ?? ""))">@opt.Label</option>
            }
        </select>
    </label>
    <label class="responses-filter-field">
        <span class="responses-filter-label">Аккаунт</span>
        <partial name="_AccountCombobox" model="@(new AccountComboboxViewModel {
            FieldName = "accountId",
            SelectedValue = Model.Filters.AccountId?.ToString() ?? "",
            Options = Model.Accounts
        })" />
    </label>
    <label class="responses-filter-field responses-filter-field--grow">
        <span class="responses-filter-label">Вакансия</span>
        <input type="search"
               name="vacancy"
               class="responses-input"
               value="@Model.Filters.VacancyQuery"
               placeholder="Название или ID объявления..."
               list="responsesVacancySuggestions"
               aria-label="Фильтр по вакансии" />
        @if (Model.Vacancies.Count > 0)
        {
            <datalist id="responsesVacancySuggestions">
                @foreach (var opt in Model.Vacancies)
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </datalist>
        }
    </label>
    <label class="responses-filter-field">
        <span class="responses-filter-label">Пол</span>
        <select name="gender" class="responses-select" aria-label="Пол">
            @foreach (var opt in Model.Genders)
            {
                <option value="@opt.Value" selected="@(opt.Value == (Model.Filters.Gender ?? ""))">@opt.Label</option>
            }
        </select>
    </label>
    <label class="responses-filter-field responses-filter-field--age">
        <span class="responses-filter-label">Возраст</span>
        <div class="responses-age-range">
            <input type="number"
                   name="ageFrom"
                   class="responses-input responses-input--age"
                   value="@(Model.Filters.AgeFrom?.ToString() ?? "")"
                   min="0"
                   max="120"
                   placeholder="от"
                   aria-label="Возраст от" />
            <span class="responses-age-range-sep" aria-hidden="true">—</span>
            <input type="number"
                   name="ageTo"
                   class="responses-input responses-input--age"
                   value="@(Model.Filters.AgeTo?.ToString() ?? "")"
                   min="0"
                   max="120"
                   placeholder="до"
                   aria-label="Возраст до" />
        </div>
    </label>
    @{
        var selectedStatuses = ResponseStatusFilterValues.Parse(Model.Filters.Status);
        var selectableStatuses = Model.Statuses.Where(opt => !string.IsNullOrWhiteSpace(opt.Value)).ToList();
        var allStatusesSelected = selectedStatuses.Count == selectableStatuses.Count;
        var defaultStatusesSelected = ResponseStatusFilterValues.IsDefault(Model.Filters.Status);
        var statusTriggerText = allStatusesSelected
            ? "Все статусы"
            : defaultStatusesSelected
                ? "Все, кроме дублей"
                : selectedStatuses.Count == 0
                    ? "Не выбрано"
                    : $"{selectedStatuses.Count} из {selectableStatuses.Count} статусов";
    }
    <div class="responses-filter-field">
        <span class="responses-filter-label" id="responsesStatusLabel">Статус</span>
        <div class="responses-status-picker" data-responses-status-picker>
            <input type="hidden"
                   name="status"
                   value="@Model.Filters.Status"
                   data-responses-status-value />
            <button type="button"
                    class="responses-status-trigger"
                    data-responses-status-trigger
                    aria-labelledby="responsesStatusLabel responsesStatusTriggerText"
                    aria-expanded="false"
                    aria-controls="responsesStatusOptions">
                <span id="responsesStatusTriggerText" data-responses-status-trigger-text>@statusTriggerText</span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="responses-status-menu" id="responsesStatusOptions" data-responses-status-menu hidden>
                <label class="responses-status-option responses-status-option--all">
                    <input type="checkbox"
                           data-responses-status-all
                           checked="@allStatusesSelected" />
                    <span>Все статусы</span>
                </label>
                <div class="responses-status-options" role="group" aria-label="Статусы откликов">
                    @foreach (var opt in selectableStatuses)
                    {
                        <label class="responses-status-option">
                            <input type="checkbox"
                                   value="@opt.Value"
                                   data-responses-status-option
                                   checked="@selectedStatuses.Contains(opt.Value, StringComparer.Ordinal)" />
                            <span>@opt.Label</span>
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>
    <label class="responses-filter-field">
        <span class="responses-filter-label">CRM</span>
        <select name="bitrixDestination" class="responses-select" aria-label="Куда отправлен">
            @foreach (var opt in Model.BitrixDestinations)
            {
                <option value="@opt.Value" selected="@(opt.Value == (Model.Filters.BitrixDestination ?? ""))">@opt.Label</option>
            }
        </select>
    </label>
    <partial name="_PageSizeFilterField" model="Model.Pagination.PageSize" />
</div>
