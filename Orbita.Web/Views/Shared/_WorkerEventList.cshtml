@model IReadOnlyList<Orbita.Web.Models.ViewModels.DashboardEventRowViewModel>
@if (Model.Count == 0)
{
    <p class="dash-event-empty">Событий пока нет.</p>
}
else
{
    <div class="dash-event-list">
        @foreach (var evt in Model)
        {
            var workerUrl = Url.Action("Details", "Workers", new { id = evt.WorkerId });
            var accountUrl = string.IsNullOrWhiteSpace(evt.AccountName)
                ? null
                : Url.Action("Index", "Accounts", new { q = evt.AccountName });
            var logUrl = Url.Action("Index", "Settings", new { tab = "logs", workerId = evt.WorkerId });
            var attachmentUrl = evt.AttachmentId is not null ? $"/Diagnostics/Image/{evt.AttachmentId}" : "";
            <div class="dash-event-row dash-event-row--detail" role="button" tabindex="0"
                 data-event-id="@evt.Id"
                 @if (evt.CanSolveCaptcha && !string.IsNullOrWhiteSpace(evt.CaptchaUrl) && evt.AccountId is not null)
                 {
                     @:data-captcha-can-solve="1"
                     @:data-captcha-url="@evt.CaptchaUrl"
                     @:data-captcha-kind="@evt.CaptchaKind"
                     @:data-captcha-account-id="@evt.AccountId"
                     @:data-captcha-worker-id="@evt.WorkerId"
                     @:data-captcha-account-name="@evt.AccountName"
                     if (!string.IsNullOrWhiteSpace(evt.CaptchaSubProfileId))
                     {
                         @:data-captcha-subprofile-id="@evt.CaptchaSubProfileId"
                     }
                 }
                 data-copy="@evt.CopyText"
                 data-detail-title="@evt.DetailTitle"
                 data-detail-subtitle="@evt.DetailSubtitle"
                 data-detail-body="@evt.DetailBody"
                 data-detail-attachment="@attachmentUrl"
                 data-detail-log-url="@logUrl"
                 data-detail-worker-url="@workerUrl"
                 data-detail-account-url="@(accountUrl ?? "")"
                 data-is-error="@(evt.IsError ? "true" : "false")">
                <div class="dash-event-icon dash-event-icon--@evt.IconTone">
                    <i class="@evt.IconClass" aria-hidden="true"></i>
                </div>
                <div class="dash-event-body">
                    <div class="dash-event-title" title="@evt.Message">@evt.Message</div>
                    @if (!string.IsNullOrWhiteSpace(evt.Subtitle))
                    {
                        <div class="dash-event-subtitle" title="@evt.Subtitle">@evt.Subtitle</div>
                    }
                </div>
                <div class="dash-event-side">
                    <div class="dash-event-time"><partial name="_UtcTime" model="@(new UtcTimeDisplayModel(evt.TimeUtc, "time-short"))" /></div>
                </div>
            </div>
        }
    </div>
}
