@model IReadOnlyList<ActiveFilterChipViewModel>
@if (Model.Count > 0)
{
    <div class="orbita-filter-chips" data-orbita-filter-chips aria-label="Активные фильтры">
        @foreach (var chip in Model)
        {
            <a class="orbita-filter-chip" href="@chip.RemoveUrl" title="Убрать фильтр">
                <span class="orbita-filter-chip__label">@chip.Label</span>
                <i class="fa-solid fa-xmark orbita-filter-chip__remove" aria-hidden="true"></i>
            </a>
        }
    </div>
}