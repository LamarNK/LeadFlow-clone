@using System.Security.Claims
@model PageHeaderViewModel
@inject Orbita.Web.Services.IOfficeContext OfficeContext
@{
    var userDisplayName = User.Identity?.Name ?? Model.UserDisplayName;
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? Model.UserEmail;
    var userInitial = !string.IsNullOrWhiteSpace(userDisplayName)
        ? char.ToUpperInvariant(userDisplayName.Trim()[0]).ToString()
        : Model.UserInitial;
}
<div class="orbita-topbar">
    <div class="orbita-topbar-left">
        <button type="button"
                class="orbita-mobile-menu-btn"
                data-orbita-mobile-menu
                aria-label="Открыть меню"
                aria-controls="orbitaPrimaryNavigation"
                aria-expanded="false">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div class="orbita-topbar-heading">
            <h1>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="orbita-topbar-sub">@Model.Subtitle</p>
            }
        </div>
    </div>
    <div class="orbita-topbar-actions">
        @await Component.InvokeAsync("OfficeSwitcher")
        <button type="button" class="orbita-search-trigger" data-orbita-search-open title="Поиск (Ctrl+K)" aria-label="Открыть поиск (Ctrl+K)">
            <span class="orbita-search-trigger-leading">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="orbita-search-trigger-label">Поиск...</span>
            </span>
            <kbd class="orbita-search-kbd">Ctrl+K</kbd>
        </button>
        @if (User.HasClaim(PanelPermissions.ClaimType, PanelPermissions.Crm)
             && OfficeContext.EffectiveOfficeId is Guid)
        {
            <div class="orbita-notifications" data-crm-notifications hidden>
                @Html.AntiForgeryToken()
                <button type="button"
                        class="orbita-notifications__trigger"
                        data-crm-notifications-toggle
                        aria-label="Уведомления CRM"
                        aria-haspopup="true"
                        aria-expanded="false">
                    <i class="fa-regular fa-bell" aria-hidden="true"></i>
                    <span data-crm-notifications-badge hidden></span>
                </button>
                <section class="orbita-notifications__dropdown" data-crm-notifications-dropdown hidden>
                    <header>
                        <div><strong>Уведомления</strong><span data-crm-notifications-caption>CRM-задачи</span></div>
                        <button type="button" data-crm-notifications-read-all hidden>Прочитать все</button>
                    </header>
                    <div class="orbita-notifications__list" data-crm-notifications-list>
                        <p class="orbita-notifications__empty">Загрузка…</p>
                    </div>
                    <footer><a asp-controller="Crm" asp-action="Tasks">Открыть задачи</a></footer>
                </section>
            </div>
        }
        <span class="orbita-topbar-sep" aria-hidden="true"></span>
        @if (Model.ShowRefresh)
        {
            <div class="orbita-updated-block">
                <a href="@(Context.Request.Path + Context.Request.QueryString)"
                   class="orbita-refresh-btn"
                   title="Обновить"
                   data-orbita-refresh>
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                </a>
                <span class="orbita-updated-text">
                    Обновлено:
                    <time class="orbita-updated-time"
                          data-orbita-utc="@OrbitaTime.ToIsoUtc(Model.UpdatedAtUtc)"
                          data-orbita-format="time"></time>
                </span>
            </div>
        }
        @if (Model.ShowRefresh && Model.ShowDateRange)
        {
            <span class="orbita-topbar-sep" aria-hidden="true"></span>
        }
        @if (Model.ShowDateRange)
        {
            <div class="orbita-period-menu" data-orbita-period-menu>
                <button type="button"
                        class="orbita-period-picker"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-label="Выбор периода">
                    <i class="fa-regular fa-calendar orbita-period-icon" aria-hidden="true"></i>
                    <span class="orbita-period-label">@Model.DateRangeLabel</span>
                    <i class="fa-solid fa-chevron-down orbita-period-caret" aria-hidden="true"></i>
                </button>
                <div class="orbita-period-dropdown" hidden>
                    <div class="orbita-period-presets" role="group" aria-label="Быстрый выбор периода">
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "all" ? " is-active" : "")"
                                data-period-preset="all">Все</button>
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "today" ? " is-active" : "")"
                                data-period-preset="today">Сегодня</button>
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "yesterday" ? " is-active" : "")"
                                data-period-preset="yesterday">Вчера</button>
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "7d" ? " is-active" : "")"
                                data-period-preset="7d">7 дней</button>
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "14d" ? " is-active" : "")"
                                data-period-preset="14d">14 дней</button>
                        <button type="button"
                                class="orbita-period-preset@(Model.ActivePeriodPreset == "30d" ? " is-active" : "")"
                                data-period-preset="30d">30 дней</button>
                    </div>
                    <div class="orbita-period-custom">
                        <div class="orbita-period-custom-fields">
                            <label class="orbita-period-field">
                                <span class="orbita-period-field-label">С</span>
                                <input type="date"
                                       class="orbita-period-input"
                                       data-period-from
                                       value="@Model.DateFrom.ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </label>
                            <label class="orbita-period-field">
                                <span class="orbita-period-field-label">По</span>
                                <input type="date"
                                       class="orbita-period-input"
                                       data-period-to
                                       value="@Model.DateTo.ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </label>
                        </div>
                        <button type="button" class="orbita-period-apply" data-period-apply>Применить</button>
                    </div>
                </div>
            </div>
        }
        @if ((Model.ShowRefresh || Model.ShowDateRange))
        {
            <span class="orbita-topbar-sep" aria-hidden="true"></span>
        }
        <div class="orbita-user-menu" data-orbita-user-menu>
            <button type="button" class="orbita-user-trigger" aria-expanded="false" aria-haspopup="true">
                <span class="orbita-user-avatar">@userInitial</span>
                <span class="orbita-user-name">@userDisplayName</span>
                <i class="fa-solid fa-chevron-down orbita-user-caret" aria-hidden="true"></i>
            </button>
            <div class="orbita-user-dropdown" hidden>
                <span class="orbita-user-dropdown-email">@userEmail</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="orbita-user-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="orbita-user-dropdown-item">Выйти</button>
                </form>
            </div>
        </div>
    </div>
</div>
