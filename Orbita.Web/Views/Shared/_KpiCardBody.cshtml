@model KpiCardPartialViewModel
@using System.Globalization
@{
    var card = Model.Card;
    var isAvgCard = card.Label == "Среднее время сбора откликов" || card.PreferTextValue;
    var useCaption = Model.Layout == KpiCardLayout.StatStacked && (isAvgCard || card.Delta == "За выбранный период");
    var hasSegments = card.Segments.Count > 0;
    var segmentTotal = hasSegments ? card.Segments.Sum(s => s.Value) : 0;
    var hasSegmentData = segmentTotal > 0
        && !(card.Segments.Count == 1 && card.Segments[0].Label == "Нет данных");
}
<header class="kpi-card-head">
    <div class="kpi-icon-box kpi-icon-box--@card.IconTone">
        <i class="@card.IconClass" aria-hidden="true"></i>
    </div>
    <span class="kpi-card-label">@card.Label</span>
</header>
@if (Model.Layout == KpiCardLayout.Dashboard)
{
    <div class="kpi-card-metric">
        <span class="kpi-value"
              data-kpi-count="@card.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
              data-kpi-suffix="@(card.ValueSuffix ?? "")">0@(card.ValueSuffix)</span>
        <span class="kpi-delta-pill kpi-delta-@card.DeltaTone">@card.Delta</span>
        @if (!string.IsNullOrWhiteSpace(card.Rate))
        {
            <span class="kpi-rate" data-kpi-rate title="Средняя скорость за выбранный период">@card.Rate</span>
        }
    </div>
    <div class="kpi-sparkline-wrap@(hasSegments ? " kpi-sparkline-wrap--segments" : "")">
        @if (hasSegments)
        {
            <div class="kpi-segment-track" data-kpi-segment-track role="img" aria-label="@card.Label">
                @foreach (var segment in card.Segments)
                {
                    var pct = hasSegmentData
                        ? segment.Value * 100.0 / segmentTotal
                        : 100.0;
                    <span class="kpi-segment-piece"
                          style="width: @pct.ToString("0.####", CultureInfo.InvariantCulture)%; background-color: @segment.Color"
                          title="@segment.Label: @segment.Value"
                          data-segment-label="@segment.Label"
                          data-segment-value="@segment.Value"></span>
                }
            </div>
        }
        else
        {
            <canvas data-sparkline-index="@Model.Index" aria-hidden="true"></canvas>
        }
    </div>
}
else if (Model.Layout == KpiCardLayout.Stat)
{
    <div class="kpi-card-metric kpi-card-metric--solo">
        <span class="kpi-value"
              data-kpi-count="@card.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)">0</span>
    </div>
}
else if (Model.Layout == KpiCardLayout.StatStacked)
{
    <div class="kpi-card-metric kpi-card-metric--stacked">
        @if (isAvgCard)
        {
            <span class="kpi-value kpi-value--text">@card.Value</span>
        }
        else
        {
            <span class="kpi-value"
                  data-kpi-count="@card.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)">0</span>
        }
        @if (useCaption)
        {
            <span class="kpi-card-caption">@card.Delta</span>
        }
        else
        {
            <span class="kpi-delta-pill kpi-delta-@card.DeltaTone">@card.Delta</span>
        }
    </div>
}
else
{
    <div class="kpi-card-metric">
        @if (card.Label == "Время работы" || card.PreferTextValue)
        {
            <span class="kpi-value kpi-value--text">@card.Value</span>
        }
        else
        {
            <span class="kpi-value"
                  data-kpi-count="@card.CountValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                  data-kpi-suffix="@(card.ValueSuffix ?? "")">0@(card.ValueSuffix)</span>
        }
        <span class="kpi-delta-pill kpi-delta-@card.DeltaTone">@card.Delta</span>
    </div>
}
