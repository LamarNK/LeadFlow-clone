@model StatisticsViewModel
<div class="orbita-filters-fields statistics-filters-row" id="statisticsFilterPanel" data-orbita-collapsible-filters hidden>
    <div class="statistics-filters__context">
        <span><i class="fa-solid fa-chart-simple" aria-hidden="true"></i>Срез отчёта</span>
        <small>Уточните данные за период: @Model.Header.DateRangeLabel</small>
    </div>
    <div class="orbita-filters-field statistics-filter-field">
        <span class="orbita-filters-label statistics-filter-label">Воркер</span>
        <partial name="_StatisticsMultiSelect" model="@(new StatisticsMultiSelectViewModel
        {
            FieldName = "workerIds",
            Label = "Воркеры",
            AllLabel = "Все воркеры",
            SelectedIds = Model.Filters.WorkerIds,
            Options = Model.WorkerOptions
        })" />
    </div>
    <div class="orbita-filters-field statistics-filter-field statistics-filter-field--account">
        <span class="orbita-filters-label statistics-filter-label">Аккаунт</span>
        <partial name="_StatisticsMultiSelect" model="@(new StatisticsMultiSelectViewModel
        {
            FieldName = "accountIds",
            Label = "Аккаунты",
            AllLabel = "Все аккаунты",
            SelectedIds = Model.Filters.AccountIds,
            Options = Model.AccountOptions
        })" />
    </div>
    <label class="orbita-filters-field statistics-filter-field statistics-filter-field--vacancy">
        <span class="orbita-filters-label statistics-filter-label">Вакансия</span>
        <input type="search"
               name="vacancy"
               class="orbita-filters-input statistics-input"
               value="@Model.Filters.VacancyQuery"
               placeholder="Название или ID объявления..."
               aria-label="Фильтр по вакансии" />
    </label>
</div>
