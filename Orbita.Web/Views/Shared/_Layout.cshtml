@using Microsoft.Extensions.Options
@using Orbita.Contracts
@using Orbita.Web.Authorization
@using Orbita.Web.Options
@inject Orbita.Web.Services.ThemeService Theme
@inject Orbita.Web.Services.IOfficeContext OfficeContext
@inject IOptions<DesignPreviewOptions> PreviewOptions
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // A fragment is requested only by the in-app navigation script. Query parameters must
    // still render a complete document when they are opened directly in a browser.
    var contentOnly = Context.Request.Headers.ContainsKey("X-Orbita-Content-Only");
    var polishOperationsUi = ViewContext.RouteData.Values["controller"]?.ToString()
        is "Dashboard" or "Workers" or "Accounts" or "Statistics" or "Responses"
        or "Events" or "Errors" or "Settings" or "MySettings" or "TelephonySettings";
    // Fast navigation keeps the outer shell (including the sidebar) alive between pages.
    // The assembly MVID changes on every build and lets the client detect that the shell
    // was rendered by an older deployment and must be refreshed as a complete document.
    var shellVersion = typeof(Orbita.Web.Controllers.AccountController)
        .Assembly.ManifestModule.ModuleVersionId.ToString("N");
}
@if (contentOnly)
{
    IgnoreSection("Scripts");
    IgnoreSection("Styles");
    @if (polishOperationsUi)
    {
        <span data-orbita-ui-polish hidden></span>
    }
    <div class="orbita-page-meta"
         data-orbita-page-title="@((ViewData["Title"] as string ?? "") + " — Орбита")"
         data-orbita-controller="@(ViewContext.RouteData.Values["controller"]?.ToString() ?? "")"
         data-orbita-shell-version="@shellVersion"
         style="display:none"></div>
    @if (PreviewOptions.Value.Enabled)
    {
        <div class="orbita-preview-banner">Режим просмотра дизайна — демо-данные, без БД и API</div>
    }
    @RenderBody()
}
else
{
<!DOCTYPE html>
<html lang="ru" data-theme="@Theme.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    @if (!PreviewOptions.Value.Enabled && User.Identity?.IsAuthenticated == true)
    {
        <meta name="orbita-antiforgery-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    <title>@ViewData["Title"] — Орбита</title>
    <link rel="icon" type="image/png" sizes="48x48" href="~/images/favicon-48x48.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96x96.png" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" sizes="any" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" asp-append-version="true" />
    <script>
        try {
            if (localStorage.getItem('orbita-sidebar-collapsed') === '1') {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/workers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/worker-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/accounts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/events.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/errors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/responses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/search-and-filters.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/responsive-data-tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/statistics.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/crm.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/crm-notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/crm-analytics.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/scrollbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita-mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/orbita/operations-polish.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-orbita-selected-office="@(OfficeContext.EffectiveOfficeId?.ToString("D") ?? "")"
      data-orbita-shell-version="@shellVersion">
<div class="orbita-app">
    <aside class="orbita-sidebar" id="orbitaPrimaryNavigation">
        <div class="orbita-sidebar-header">
            <div class="orbita-sidebar-brand">
                <img src="~/images/logo.png" alt="" asp-append-version="true" />
                <span>Орбита</span>
            </div>
            <button type="button"
                    class="orbita-sidebar-toggle"
                    data-orbita-sidebar-toggle
                    aria-label="Свернуть меню"
                    aria-expanded="true">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
        </div>
        <nav class="orbita-nav" aria-label="Основная навигация">
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                var act = ViewContext.RouteData.Values["action"]?.ToString();
                var can = new Func<string, bool>(permission =>
                    User.HasClaim(PanelPermissions.ClaimType, permission)
                    || (permission is PanelPermissions.CrmBoard or PanelPermissions.CrmTasks or PanelPermissions.CrmAnalytics
                        && User.HasClaim(PanelPermissions.ClaimType, PanelPermissions.Crm)));
                var canDashboard = can(PanelPermissions.Dashboard);
                var canWorkers = can(PanelPermissions.Workers);
                var canAccounts = can(PanelPermissions.Accounts);
                var canStatistics = can(PanelPermissions.Statistics);
                var canResponses = can(PanelPermissions.Responses);
                var canCrmBoard = can(PanelPermissions.CrmBoard);
                var canCrmAnalytics = can(PanelPermissions.CrmAnalytics);
                var canCrmTasks = can(PanelPermissions.CrmTasks);
                var canCrmTeam = can(PanelPermissions.CrmTeam);
                var canEvents = can(PanelPermissions.Events);
                var canSettings = can(PanelPermissions.Settings);
                var canTelephony = can(PanelPermissions.Administration) || User.IsInRole(PanelRoles.OfficeLead);
                var canAdministration = can(PanelPermissions.Administration);
            }
            @if (canDashboard || canWorkers || canAccounts || canStatistics || canResponses)
            {
                <section class="orbita-nav-section orbita-nav-section--primary" aria-labelledby="navMainTitle">
                    <h2 class="orbita-nav-section-title" id="navMainTitle">Основное</h2>
                    <div class="orbita-nav-section-items">
                        @if (canDashboard)
                        {
                            <a class="nav-item @(ctrl == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")" title="Панель управления"><i class="fa-solid fa-house" aria-hidden="true"></i><span class="nav-item-label">Панель управления</span></a>
                        }
                        @if (canWorkers)
                        {
                            <a class="nav-item @(ctrl == "Workers" ? "active" : "")" href="@Url.Action("Index", "Workers")" title="Воркеры"><i class="fa-solid fa-server" aria-hidden="true"></i><span class="nav-item-label">Воркеры</span></a>
                        }
                        @if (canAccounts)
                        {
                            <a class="nav-item @(ctrl == "Accounts" ? "active" : "")" href="@Url.Action("Index", "Accounts")" title="Аккаунты"><i class="fa-solid fa-users" aria-hidden="true"></i><span class="nav-item-label">Аккаунты</span></a>
                        }
                        @if (canStatistics)
                        {
                            <a class="nav-item @(ctrl == "Statistics" ? "active" : "")" href="@Url.Action("Index", "Statistics")" title="Статистика"><i class="fa-solid fa-chart-line" aria-hidden="true"></i><span class="nav-item-label">Статистика</span></a>
                        }
                        @if (canResponses)
                        {
                            <a class="nav-item @(ctrl == "Responses" ? "active" : "")" href="@Url.Action("Index", "Responses")" title="Отклики"><i class="fa-solid fa-inbox" aria-hidden="true"></i><span class="nav-item-label">Отклики</span><span class="nav-badge" data-nav-badge="responses" hidden></span></a>
                        }
                    </div>
                </section>
            }
            @if (canCrmBoard || canCrmAnalytics || canCrmTasks || canCrmTeam)
            {
                <section class="orbita-nav-section orbita-nav-section--crm" aria-labelledby="navCrmTitle">
                    <h2 class="orbita-nav-section-title" id="navCrmTitle">CRM</h2>
                    <div class="orbita-nav-section-items">
                        @if (canCrmBoard)
                        {
                            <a class="nav-item @(ctrl == "Crm" && act is "Index" or "Card" or null ? "active" : "")" href="@Url.Action("Index", "Crm")" title="CRM менеджеров"><i class="fa-solid fa-columns" aria-hidden="true"></i><span class="nav-item-label">CRM</span></a>
                        }
                        @if (canCrmAnalytics)
                        {
                            <a class="nav-item @(ctrl == "Crm" && act == "Analytics" ? "active" : "")" href="@Url.Action("Analytics", "Crm")" title="Аналитика CRM"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span class="nav-item-label">Аналитика CRM</span></a>
                        }
                        @if (canCrmTasks)
                        {
                            <a class="nav-item @(ctrl == "Crm" && act is "Tasks" or "TaskDetails" ? "active" : "")" href="@Url.Action("Tasks", "Crm")" title="Мои задачи"><i class="fa-solid fa-list-check" aria-hidden="true"></i><span class="nav-item-label">Задачи</span><span class="nav-badge" data-nav-badge="crm-tasks" hidden></span></a>
                        }
                        @if (canCrmTeam)
                        {
                            <a class="nav-item @(ctrl == "Crm" && act == "Team" ? "active" : "")" href="@Url.Action("Team", "Crm")" title="Команда CRM"><i class="fa-solid fa-people-group" aria-hidden="true"></i><span class="nav-item-label">Команда CRM</span></a>
                        }
                    </div>
                </section>
            }
            @if (canEvents || canSettings || canTelephony || canAdministration)
            {
                <section class="orbita-nav-section orbita-nav-section--other" aria-labelledby="navOtherTitle">
                    <h2 class="orbita-nav-section-title" id="navOtherTitle">Другое</h2>
                    <div class="orbita-nav-section-items">
                        @if (canEvents)
                        {
                            <a class="nav-item @(ctrl is "Events" or "Errors" ? "active" : "")" href="@Url.Action("Index", "Events")" title="События"><i class="fa-regular fa-clipboard" aria-hidden="true"></i><span class="nav-item-label">События</span><span class="nav-badge" data-nav-badge="errors" hidden></span></a>
                        }
                        @if (canSettings)
                        {
                            <a class="nav-item @(ctrl == "MySettings" ? "active" : "")" href="@Url.Action("Index", "MySettings")" title="Настройки"><i class="fa-solid fa-gear" aria-hidden="true"></i><span class="nav-item-label">Настройки</span></a>
                        }
                        @* Старые браузерные сессии могут содержать актуальные разрешения, но не содержать
                           role claim. Для администратора ориентируемся на то же разрешение, по которому
                           показывается раздел «Администрирование»; роль руководителя оставляем отдельным
                           условием, поскольку у неё этого разрешения намеренно нет. *@
                        @if (canTelephony)
                        {
                            <a class="nav-item @(ctrl == "TelephonySettings" ? "active" : "")" href="@Url.Action("Telephony", "TelephonySettings")" title="Телефония"><i class="fa-solid fa-phone-volume" aria-hidden="true"></i><span class="nav-item-label">Телефония</span></a>
                        }
                        @if (canAdministration)
                        {
                            <a class="nav-item @(ctrl == "Settings" ? "active" : "")" href="@Url.Action("Index", "Settings")" title="Администрирование"><i class="fa-solid fa-user-shield" aria-hidden="true"></i><span class="nav-item-label">Администрирование</span></a>
                        }
                    </div>
                </section>
            }
        </nav>
        <div class="orbita-sidebar-footer">
            <span class="orbita-nav-section-title orbita-nav-section-title--footer">Прочее</span>
            <form asp-controller="Settings" asp-action="ToggleTheme" method="post" class="theme-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-btn sidebar-btn--theme" title="@(Theme.IsLight ? "Тёмная тема" : "Светлая тема")"><i class="@(Theme.IsLight ? "fa-regular fa-moon" : "fa-regular fa-sun")" aria-hidden="true"></i><span class="sidebar-btn-label">@(Theme.IsLight ? "Тёмная тема" : "Светлая тема")</span></button>
            </form>
            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-btn sidebar-btn--logout" title="Выйти"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span class="sidebar-btn-label">Выйти</span></button>
            </form>
        </div>
    </aside>
    <div class="orbita-content">
        @if (polishOperationsUi)
        {
            <span data-orbita-ui-polish hidden></span>
        }
        @if (PreviewOptions.Value.Enabled)
        {
            <div class="orbita-preview-banner">Режим просмотра дизайна — демо-данные, без БД и API</div>
        }
        @RenderBody()
    </div>
    <div class="orbita-sidebar-backdrop" data-orbita-sidebar-backdrop hidden></div>
    <div class="orbita-toast-host" data-orbita-toast-host aria-live="polite" aria-atomic="true"></div>
    <div class="orbita-softphone" data-orbita-softphone hidden>
        <section class="orbita-softphone__panel" role="dialog" aria-labelledby="orbitaSoftphoneTitle">
            <div class="orbita-softphone__icon" aria-hidden="true"><i class="fa-solid fa-phone-volume"></i></div>
            <div class="orbita-softphone__copy">
                <span class="orbita-softphone__eyebrow">Звонок из Орбиты</span>
                <h2 id="orbitaSoftphoneTitle" data-orbita-softphone-target>Подключение…</h2>
                <p data-orbita-softphone-status aria-live="polite">Подготавливаем защищённую SIP-линию</p>
            </div>
            <div class="orbita-softphone__actions">
                <button type="button" class="orbita-softphone__answer" data-orbita-softphone-answer hidden>
                    <i class="fa-solid fa-phone" aria-hidden="true"></i>
                    Ответить
                </button>
                <button type="button" class="orbita-softphone__hangup" data-orbita-softphone-hangup disabled>
                    <i class="fa-solid fa-phone-slash" aria-hidden="true"></i>
                    <span data-orbita-softphone-hangup-label>Завершить</span>
                </button>
            </div>
        </section>
    </div>
    <audio data-orbita-softphone-audio autoplay playsinline hidden></audio>
    <div class="orbita-confirm" id="orbitaConfirmDialog" hidden>
        <div class="orbita-confirm__backdrop" data-orbita-confirm-cancel></div>
        <div class="orbita-confirm__dialog" role="alertdialog" aria-modal="true" aria-labelledby="orbitaConfirmTitle" aria-describedby="orbitaConfirmMessage">
            <h2 class="orbita-confirm__title" id="orbitaConfirmTitle"></h2>
            <p class="orbita-confirm__message" id="orbitaConfirmMessage"></p>
            <div class="orbita-confirm__actions">
                <button type="button" class="orbita-confirm__btn orbita-confirm__btn--ghost" data-orbita-confirm-cancel>Отмена</button>
                <button type="button" class="orbita-confirm__btn orbita-confirm__btn--primary" data-orbita-confirm-ok>Подтвердить</button>
            </div>
        </div>
    </div>
</div>
<div class="orbita-detail-modal" id="orbitaDetailModal" hidden>
    <div class="orbita-detail-modal__backdrop" data-orbita-detail-close></div>
    <div class="orbita-detail-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="orbitaDetailTitle">
        <header class="orbita-detail-modal__head">
            <div>
                <h2 class="orbita-detail-modal__title" id="orbitaDetailTitle"></h2>
                <p class="orbita-detail-modal__subtitle" id="orbitaDetailSubtitle" hidden></p>
            </div>
            <button type="button" class="orbita-detail-modal__close" data-orbita-detail-close aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <div class="orbita-detail-modal__body" id="orbitaDetailBody"></div>
        <footer class="orbita-detail-modal__foot" id="orbitaDetailFoot" hidden>
            <div class="orbita-detail-modal__nav" id="orbitaDetailNav" hidden></div>
            <div class="orbita-detail-modal__foot-actions" id="orbitaDetailFootActions">
                <div class="orbita-detail-modal__primary" id="orbitaDetailPrimary" hidden></div>
                <button type="button" class="orbita-detail-modal__action orbita-detail-modal__action--ghost" id="orbitaDetailCopy" hidden>
                    <i class="fa-regular fa-copy" aria-hidden="true"></i>
                    <span id="orbitaDetailCopyLabel">Копировать</span>
                </button>
                <button type="button" class="orbita-detail-modal__dismiss" id="orbitaDetailDismiss" data-orbita-detail-dismiss hidden>
                    <i class="fa-regular fa-circle-check" aria-hidden="true"></i>
                    <span id="orbitaDetailDismissLabel"></span>
                </button>
            </div>
        </footer>
    </div>
</div>
<div class="orbita-search" id="orbitaSearchPalette" hidden>
    <div class="orbita-search__backdrop" data-orbita-search-close></div>
    <div class="orbita-search__dialog" role="dialog" aria-modal="true" aria-label="Глобальный поиск">
        <div class="orbita-search__head">
            <span class="orbita-search__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="search"
                   class="orbita-search__input"
                   data-orbita-search-input
                   aria-label="Поиск по сайту"
                   placeholder="Воркеры, аккаунты, отклики, события..."
                   autocomplete="off"
                   spellcheck="false"
                   aria-controls="orbitaSearchResults"
                   aria-autocomplete="list" />
            <span class="orbita-search__spinner" data-orbita-search-spinner hidden aria-hidden="true">
                <i class="fa-solid fa-spinner fa-spin"></i>
            </span>
            <button type="button" class="orbita-search__close" data-orbita-search-close aria-label="Закрыть">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="orbita-search__results" id="orbitaSearchResults" data-orbita-search-results role="listbox"></div>
        <div class="orbita-search__footer">
            <span class="orbita-search__shortcut"><kbd>↑</kbd><kbd>↓</kbd> выбор</span>
            <span class="orbita-search__shortcut"><kbd>Enter</kbd> открыть</span>
            <span class="orbita-search__shortcut"><kbd>Esc</kbd> закрыть</span>
        </div>
    </div>
</div>
<script src="~/js/orbita-time.js" asp-append-version="true"></script>
<script src="~/js/orbita-presence.js" asp-append-version="true"></script>
<script src="~/js/orbita-crm-deadlines.js" asp-append-version="true"></script>
<script src="~/js/orbita-live-shared.js" asp-append-version="true"></script>
<script src="~/js/orbita/layout.js" asp-append-version="true"></script>
<script src="~/js/orbita/sidebar.js" asp-append-version="true"></script>
<script src="~/js/orbita/feedback.js" asp-append-version="true"></script>
<script src="~/js/orbita/workers.js" asp-append-version="true"></script>
<script src="~/js/orbita/filters.js" asp-append-version="true"></script>
<script src="~/js/orbita/detail-modal.js" asp-append-version="true"></script>
<script src="~/js/orbita/navigation.js" asp-append-version="true"></script>
<script src="~/js/orbita/entry.js" asp-append-version="true"></script>
<script src="~/js/orbita-crm-notifications.js" asp-append-version="true"></script>
@if (!PreviewOptions.Value.Enabled)
{
<script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
<script src="~/js/orbita-realtime.js" asp-append-version="true"></script>
}
<script src="~/js/orbita-browser-frame.js" asp-append-version="true"></script>
<script src="~/js/orbita-captcha-solver.js" asp-append-version="true"></script>
<script src="~/js/orbita-search.js" asp-append-version="true"></script>
<script src="~/lib/jssip/jssip.min.js" asp-append-version="true"></script>
<script src="~/js/orbita-crm-softphone.js" asp-append-version="true"></script>
<script src="~/js/orbita-telephony-settings.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
}
