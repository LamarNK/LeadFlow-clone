@model IReadOnlyList<Orbita.Contracts.WorkerEventListItem>
@if (Model.Count == 0)
{
    <p class="muted">Событий пока нет.</p>
}
else
{
    <div class="event-list">
        @foreach (var evt in Model)
        {
            var cls = evt.Level.Equals("Error", StringComparison.OrdinalIgnoreCase) ? "error"
                : evt.Level.Equals("Warning", StringComparison.OrdinalIgnoreCase) ? "warning" : "success";
            var icon = evt.Level.Equals("Error", StringComparison.OrdinalIgnoreCase) ? "fa-regular fa-circle-xmark"
                : evt.Level.Equals("Warning", StringComparison.OrdinalIgnoreCase) ? "fa-solid fa-triangle-exclamation" : "fa-regular fa-circle-check";
            <div class="event-row">
                <div class="event-icon @cls"><i class="@icon" aria-hidden="true"></i></div>
                <div class="event-text">
                    <strong>@evt.Message</strong>
                    <div class="event-meta">@evt.WorkerDisplayName · @evt.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</div>
                </div>
            </div>
        }
    </div>
}