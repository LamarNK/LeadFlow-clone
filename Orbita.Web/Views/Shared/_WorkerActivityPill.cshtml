@model WorkerActivityViewModel
@{
    if (string.IsNullOrWhiteSpace(Model.Label))
    {
        return;
    }
    var liveClass = Model.IsLive ? " worker-activity-pill--live" : "";
    var nextCycleIso = OrbitaTime.ToIsoUtc(Model.NextCycleAtUtc);
}
<span class="worker-activity-pill worker-activity-pill--@Model.Tone@liveClass"
      title="@Model.Label"
      data-activity-phase="@Model.Phase"
      data-next-cycle-at="@nextCycleIso">
    @if (Model.IsLive)
    {
        <span class="worker-activity-pill-dot" aria-hidden="true"></span>
    }
    <span class="worker-activity-pill-text">@Model.Label</span>
</span>
